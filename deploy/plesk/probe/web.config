<?xml version="1.0" encoding="utf-8"?>
<!--
  KTS 5.0 · server probe for Plesk/IIS.
  Upload probe.cmd, probe.py and this web.config into the document root of the
  subdomain, then open https://<subdomain>/ in a browser:
    * a JSON page  -> HttpPlatformHandler works and shows which Python was found
    * HTTP 500.21  -> the HttpPlatformHandler module is not installed on the server
    * HTTP 502.3   -> the module is there but Python was not found; see probe-result.txt
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="cmd.exe" arguments="/c probe.cmd" startupTimeLimit="60" startupRetryCount="1" stdoutLogEnabled="true" stdoutLogFile=".\probe-stdout">
      <environmentVariables>
        <environmentVariable name="HTTP_PLATFORM_PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
