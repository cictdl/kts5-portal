<?xml version="1.0" encoding="utf-8"?>
<!--
  KTS 5.0 · diagnostic web.config (temporary).
  Upload this as web.config in the subdomain folder, open the site, and IIS
  prints the exact reason for the failure (module missing, section locked…).
  Replace it with deploy\plesk\web.config afterwards.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>
