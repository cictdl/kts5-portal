<?xml version="1.0" encoding="utf-8"?>
<!--
  KTS 5.0 portal · IIS configuration (reverse-proxy mode).
  Use when HttpPlatformHandler cannot be installed but URL Rewrite and
  Application Request Routing (ARR) are present. The portal runs as a
  Windows service (install-service.ps1) on 127.0.0.1:__PORT__ and IIS
  forwards requests to it. ARR proxying must be enabled at server level
  (setup-iis.ps1 -Mode Proxy does this).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="KTS5 reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:__PORT__/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
