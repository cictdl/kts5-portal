{"n":101,"kurals":[{"n":1001,"l":["வைத்தான்வாய் சான்ற பெரும்பொருள் அஃதுண்ணான்","செத்தான் செயக்கிடந்தது இல்."],"w":[["வைத்தான்வாய்",1,"Vaiththaanvaai","he who stored; place/where (in the home)"],["சான்ற",1,"Saandra","full/abundant (qualifying)"],["பெரும்பொருள்",1,"Perumporul","great; wealth"],["அஃதுண்ணான்",1,"Aqdhunnaan","that (wealth); does not enjoy/consume"],["செத்தான்",2,"Seththaan","he died"],["செயக்கிடந்தது",2,"Seyakkitandhadhu","to do/be done; that which lay (to be done)"],["இல்",2,"Il","is not / nothing"]]},{"n":1002,"l":["பொருளானாம் எல்லாமென்று ஈயாது இவறும்","மருளானாம் மாணாப் பிறப்பு"],"w":[["பொருளானாம்",1,"Porulaanaam","by/with wealth; becomes/is possible"],["எல்லாமென்று",1,"Ellaamendru","everything/all; saying/thinking thus"],["ஈயாது",1,"Eeyaadhu","without giving"],["இவறும்",1,"Ivarum","(one who) clings miserly (qualifying மருளான்)"],["மருளானாம்",2,"Marulaanaam","by delusion; comes to be"],["மாணாப்",2,"Maanaap","not-worthy / inferior (qualifying)"],["பிறப்பு",2,"Pirappu","birth/existence"]]},{"n":1003,"l":["ஈட்டம் இவறி இசைவேண்டா ஆடவர்","தோற்றம் நிலக்குப் பொறை."],"w":[["ஈட்டம்",1,"Eettam","hoarding/accumulation"],["இவறி",1,"Ivari","clinging miserly"],["இசைவேண்டா",1,"Isaiventaa","fame/praise; not desiring (qualifying ஆடவர்)"],["ஆடவர்",1,"Aatavar","men/people"],["தோற்றம்",2,"Thotram","birth/appearance"],["நிலக்குப்",2,"Nilakkup","to/for the earth"],["பொறை",2,"Porai","burden/load"]]},{"n":1004,"l":["எச்சமென்று என்எண்ணுங் கொல்லோ ஒருவரால்","நச்சப் படாஅ தவன்."],"w":[["எச்சமென்று",1,"Echchamendru","remnant/legacy; as / saying thus"],["என்எண்ணுங்",1,"Enennung","what; will (he) think"],["கொல்லோ",1,"Kollo","doubt particle; interrogative/wonder"],["ஒருவரால்",1,"Oruvaraal","by anyone"],["நச்சப்",2,"Nachchap","to be desired"],["படாஅ",2,"Pataaa","not being (qualifying அவன்)"],["தவன்",2,"Thavan","he"]]},{"n":1005,"l":["கொடுப்பதூஉம் துய்ப்பதூஉம் இல்லார்க்கு அடுக்கிய","கோடியுண் டாயினும் இல்."],"w":[["கொடுப்பதூஉம்",1,"Kotuppadhooum","the act of giving; and (conjunctive)"],["துய்ப்பதூஉம்",1,"Thuyppadhooum","the act of enjoying; and (conjunctive)"],["இல்லார்க்கு",1,"Illaarkku","to those without"],["அடுக்கிய",1,"Atukkiya","heaped/piled (qualifying)"],["கோடியுண்",2,"Kotiyun","crore; exists/there is"],["டாயினும்",2,"Taayinum","even if it be"],["இல்",2,"Il","is not / of no use"]]},{"n":1006,"l":["ஏதம் பெருஞ்செல்வம் தான்துவ்வான் தக்கார்க்கொன்று","ஈதல் இயல்பிலா தான்."],"w":[["ஏதம்",1,"Edham","harm/disease/fault"],["பெருஞ்செல்வம்",1,"Perunjelvam","great; wealth"],["தான்துவ்வான்",1,"Thaandhuvvaan","he himself; does not enjoy/consume"],["தக்கார்க்கொன்று",1,"Thakkaarkkondru","to the worthy; one thing/something"],["ஈதல்",2,"Eedhal","giving/charity"],["இயல்பிலா",2,"Iyalpilaa","nature/disposition; without (qualifying)"],["தான்",2,"Thaan","he (the one who)"]]},{"n":1007,"l":["அற்றார்க்கொன்று ஆற்றாதான் செல்வம் மிகநலம்","பெற்றாள் தமியள்மூத் தற்று."],"w":[["அற்றார்க்கொன்று",1,"Atraarkkondru","to the destitute; one thing/something"],["ஆற்றாதான்",1,"Aatraadhaan","he who cannot/does not do"],["செல்வம்",1,"Selvam","wealth"],["மிகநலம்",1,"Mikanalam","greatly/much; beauty/goodness"],["பெற்றாள்",2,"Petraal","she who has (beauty)"],["தமியள்மூத்",2,"Thamiyalmooth","she being alone; having aged"],["தற்று",2,"Thatru","like that / so (comparison)"]]},{"n":1008,"l":["நச்சப் படாதவன் செல்வம் நடுவூருள்","நச்சு மரம்பழுத் தற்று."],"w":[["நச்சப்",1,"Nachchap","to be desired"],["படாதவன்",1,"Pataadhavan","he who is not (desired)"],["செல்வம்",1,"Selvam","wealth"],["நடுவூருள்",1,"Natuvoorul","middle of the town; within/in"],["நச்சு",2,"Nachchu","poison"],["மரம்பழுத்",2,"Marampazhuth","tree; having borne fruit"],["தற்று",2,"Thatru","like that / so (comparison)"]]},{"n":1009,"l":["அன்பொரீஇத் தற்செற்று அறநோக்காது ஈட்டிய","ஒண்பொருள் கொள்வார் பிறர்."],"w":[["அன்பொரீஇத்",1,"Anporeeith","love; having abandoned/removed"],["தற்செற்று",1,"Tharsetru","oneself; having afflicted"],["அறநோக்காது",1,"Aranokkaadhu","virtue/dharma; without regarding"],["ஈட்டிய",1,"Eettiya","amassed (qualifying)"],["ஒண்பொருள்",2,"Onporul","bright/fine; wealth/riches"],["கொள்வார்",2,"Kolvaar","(others) will take"],["பிறர்",2,"Pirar","others"]]},{"n":1010,"l":["சீருடைச் செல்வர் சிறுதுனி மாரி","வறங்கூர்ந் தனையது உடைத்து."],"w":[["சீருடைச்",1,"Seerutaich","excellence/fame; possessing (qualifying செல்வர்)"],["செல்வர்",1,"Chelvar","the wealthy ones"],["சிறுதுனி",1,"Sirudhuni","small; distress/want"],["மாரி",1,"Maari","rain/rain-cloud"],["வறங்கூர்ந்",2,"Varangoorn","drought/want; having intensified"],["தனையது",2,"Thanaiyadhu","of that kind / such"],["உடைத்து",2,"Utaiththu","possesses/has the nature of"]]}]}