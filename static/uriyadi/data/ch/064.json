{"n":64,"kurals":[{"n":631,"l":["கருவியும் காலமும் செய்கையும் செய்யும்","அருவினையும் மாண்டது அமைச்சு."],"w":[["கருவியும்",1,"Karuviyum","means/instrument; and (enumerative)"],["காலமும்",1,"Kaalamum","time; and (enumerative)"],["செய்கையும்",1,"Seykaiyum","mode/manner of doing; and (enumerative)"],["செய்யும்",1,"Seyyum","that one does / is to be done (qualifying அருவினை)"],["அருவினையும்",2,"Aruvinaiyum","the rare/difficult deed; and (enumerative)"],["மாண்டது",2,"Maantadhu","that which excelled/became great"],["அமைச்சு",2,"Amaichchu","minister(ship)"]]},{"n":632,"l":["வன்கண் குடிகாத்தல் கற்றறிதல் ஆள்வினையோடு","ஐந்துடன் மாண்டது அமைச்சு."],"w":[["வன்கண்",1,"Vankan","fearlessness/firmness"],["குடிகாத்தல்",1,"Kutikaaththal","the people/subjects (obj.); protecting"],["கற்றறிதல்",1,"Katraridhal","having learnt; knowing (by learning)"],["ஆள்வினையோடு",1,"Aalvinaiyotu","effort/manly exertion; along with"],["ஐந்துடன்",2,"Aindhutan","the five (qualities); together (with)"],["மாண்டது",2,"Maantadhu","that which is perfected"],["அமைச்சு",2,"Amaichchu","minister(ship)"]]},{"n":633,"l":["பிரித்தலும் பேணிக் கொளலும் பிரிந்தார்ப்","பொருத்தலும் வல்ல தமைச்சு."],"w":[["பிரித்தலும்",1,"Piriththalum","separating (foes' allies); and"],["பேணிக்",1,"Penik","cherishing/protecting"],["கொளலும்",1,"Kolalum","keeping/holding (them); and"],["பிரிந்தார்ப்",1,"Pirindhaarp","those who parted/separated (obj.)"],["பொருத்தலும்",2,"Poruththalum","reuniting/joining; and"],["வல்ல",2,"Valla","is capable (of these)"],["தமைச்சு",2,"Thamaichchu","minister(ship)"]]},{"n":634,"l":["தெரிதலும் தேர்ந்து செயலும் ஒருதலையாச்","சொல்லலும் வல்லது அமைச்சு."],"w":[["தெரிதலும்",1,"Theridhalum","discerning/examining; and"],["தேர்ந்து",1,"Therndhu","having examined/chosen"],["செயலும்",1,"Seyalum","acting/doing; and"],["ஒருதலையாச்",1,"Orudhalaiyaach","decisively/with certainty"],["சொல்லலும்",2,"Chollalum","telling/declaring; and"],["வல்லது",2,"Valladhu","is capable"],["அமைச்சு",2,"Amaichchu","minister(ship)"]]},{"n":635,"l":["அறனறிந்து ஆன்றமைந்த சொல்லான்எஞ் ஞான்றுந்","திறனறிந்தான் தேர்ச்சித் துணை."],"w":[["அறனறிந்து",1,"Aranarindhu","virtue (obj.); having known"],["ஆன்றமைந்த",1,"Aandramaindha","being full/abundant; that is settled/composed (qualifying சொல்)"],["சொல்லான்எஞ்",1,"Sollaanenj","he of (composed) speech; whenever/at all times (begins here, spans சீர்)"],["ஞான்றுந்",1,"Gnaandrun","time/day (in எஞ்ஞான்றும்); ever (முற்றும்மை)"],["திறனறிந்தான்",2,"Thiranarindhaan","the way/skill (obj.); he who has known"],["தேர்ச்சித்",2,"Therchchith","deliberation/counsel"],["துணை",2,"Thunai","helper/aid"]]},{"n":636,"l":["மதிநுட்பம் நூலோடு உடையார்க்கு அதிநுட்பம்","யாவுள முன்நிற் பவை."],"w":[["மதிநுட்பம்",1,"Madhinutpam","intellect's; subtlety"],["நூலோடு",1,"Noolotu","with book-learning; along with"],["உடையார்க்கு",1,"Utaiyaarkku","those who possess; to/for (them)"],["அதிநுட்பம்",1,"Adhinutpam","very/exceeding; subtle stratagem"],["யாவுள",2,"Yaavula","what (things); exist/are there"],["முன்நிற்",2,"Munnir","in front/before; those that will stand (against); begins here, spans சீர்"],["பவை",2,"Pavai","those that stand (continuation of முன்நிற்பவை)"]]},{"n":637,"l":["செயற்கை அறிந்தக் கடைத்தும் உலகத்து","இயற்கை அறிந்து செயல்."],"w":[["செயற்கை",1,"Seyarkai","art/learned method"],["அறிந்தக்",1,"Arindhak","having known (qualifying கடை)"],["கடைத்தும்",1,"Kataiththum","at the point/occasion (even when); even (concessive)"],["உலகத்து",1,"Ulakaththu","of/in the world"],["இயற்கை",2,"Iyarkai","nature/natural ways"],["அறிந்து",2,"Arindhu","having known"],["செயல்",2,"Seyal","let (one) act / do it!"]]},{"n":638,"l":["அறிகொன்று அறியான் எனினும் உறுதி","உழையிருந்தான் கூறல் கடன்."],"w":[["அறிகொன்று",1,"Arikondru","(advisor's) knowledge (obj.); having destroyed/slighted"],["அறியான்",1,"Ariyaan","he knows not"],["எனினும்",1,"Eninum","even if (it be so)"],["உறுதி",1,"Urudhi","what is beneficial/firm (obj.)"],["உழையிருந்தான்",2,"Uzhaiyirundhaan","near/by the side; he who remained (near, i.e. minister)"],["கூறல்",2,"Kooral","telling/declaring"],["கடன்",2,"Katan","duty"]]},{"n":639,"l":["பழுதெண்ணும் மந்திரியின் பக்கத்துள் தெவ்வோர்","எழுபது கோடி உறும்."],"w":[["பழுதெண்ணும்",1,"Pazhudhennum","fault/harm (obj.); (minister) who thinks/plans"],["மந்திரியின்",1,"Mandhiriyin","than the minister; than (comparison)"],["பக்கத்துள்",1,"Pakkaththul","at the side; in/within (locative)"],["தெவ்வோர்",1,"Thevvor","enemies"],["எழுபது",2,"Ezhupadhu","seventy"],["கோடி",2,"Koti","crore (ten million)"],["உறும்",2,"Urum","is better/fitting"]]},{"n":640,"l":["முறைப்படச் சூழ்ந்தும் முடிவிலவே செய்வர்","திறப்பாடு இலாஅ தவர்."],"w":[["முறைப்படச்",1,"Muraippatach","in due order/methodically"],["சூழ்ந்தும்",1,"Choozhndhum","having planned/deliberated; even (concessive)"],["முடிவிலவே",1,"Mutivilave","(things) without completion (substantivized); only/just (emphatic)"],["செய்வர்",1,"Seyvar","they will do"],["திறப்பாடு",2,"Thirappaatu","skill/competence"],["இலாஅ",2,"Ilaaa","not having (skill); அளபெடை இலா-அ"],["தவர்",2,"Thavar","those (persons)"]]}]}