{"n":88,"kurals":[{"n":871,"l":["பகைஎன்னும் பண்பி லதனை ஒருவன்","நகையேயும் வேண்டற்பாற்று அன்று."],"w":[["பகைஎன்னும்",1,"Pakaiennum","enmity; called/named (rel.)"],["பண்பி",1,"Panpi","quality/virtue"],["லதனை",1,"Ladhanai","without/lacking; it (acc.)"],["ஒருவன்",1,"Oruvan","a person/one man"],["நகையேயும்",2,"Nakaiyeyum","jest/sport/laughter; even (emphatic); even/also"],["வேண்டற்பாற்று",2,"Ventarpaatru","is of the nature to be desired"],["அன்று",2,"Andru","is not"]]},{"n":872,"l":["வில்லேர் உழவர் பகைகொளினும் கொள்ளற்க","சொல்லேர் உழவர் பகை."],"w":[["வில்லேர்",1,"Viller","bow; plough"],["உழவர்",1,"Uzhavar","ploughmen/warriors"],["பகைகொளினும்",1,"Pakaikolinum","enmity (obj.); even if (one) takes/holds"],["கொள்ளற்க",1,"Kollarka","do not take/hold"],["சொல்லேர்",2,"Soller","word; plough"],["உழவர்",2,"Uzhavar","ploughmen/scholars"],["பகை",2,"Pakai","enmity (obj.)"]]},{"n":873,"l":["ஏமுற் றவரினும் ஏழை தமியனாய்ப்","பல்லார் பகைகொள் பவன்."],"w":[["ஏமுற்",1,"Emur","being deluded/intoxicated"],["றவரினும்",1,"Ravarinum","than those (who)"],["ஏழை",1,"Ezhai","fool/ignorant one"],["தமியனாய்ப்",1,"Thamiyanaaip","being alone/solitary"],["பல்லார்",2,"Pallaar","of many (people)"],["பகைகொள்",2,"Pakaikol","enmity (obj.); taking/holding"],["பவன்",2,"Pavan","he who (does)"]]},{"n":874,"l":["பகைநட்பாக் கொண்டொழுகும் பண்புடை யாளன்","தகைமைக்கண் தங்கிற்று உலகு."],"w":[["பகைநட்பாக்",1,"Pakainatpaak","enmity (obj.); as friendship"],["கொண்டொழுகும்",1,"Kontozhukum","having taken; who conducts/lives (rel.)"],["பண்புடை",1,"Panputai","virtue; having/possessing"],["யாளன்",1,"Yaalan","the man (of virtue)"],["தகைமைக்கண்",2,"Thakaimaikkan","greatness/nobility; in/at (loc.)"],["தங்கிற்று",2,"Thangitru","(it) rested/abided"],["உலகு",2,"Ulaku","world"]]},{"n":875,"l":["தன்துணை இன்றால் பகையிரண்டால் தான்ஒருவன்","இன்துணையாக் கொள்கவற்றின் ஒன்று."],"w":[["தன்துணை",1,"Thandhunai","one's own; support/ally"],["இன்றால்",1,"Indraal","is not/absent; (expletive)"],["பகையிரண்டால்",1,"Pakaiyirantaal","enmity; two; (expletive)"],["தான்ஒருவன்",1,"Thaanoruvan","oneself; one (man)"],["இன்துணையாக்",2,"Indhunaiyaak","sweet/pleasant; ally; as/being (ஆக)"],["கொள்கவற்றின்",2,"Kolkavatrin","let (one) make/take; of those (two)"],["ஒன்று",2,"Ondru","one (of them, obj.)"]]},{"n":876,"l":["தேறினும் தேறா விடினும் அழிவின்கண்","தேறான் பகாஅன் விடல்."],"w":[["தேறினும்",1,"Therinum","even if (one) trusts/discerns"],["தேறா",1,"Theraa","not trusting"],["விடினும்",1,"Vitinum","even if (one) leaves"],["அழிவின்கண்",1,"Azhivinkan","ruin/distress; at the time of (loc.)"],["தேறான்",2,"Theraan","without trusting"],["பகாஅன்",2,"Pakaaan","without parting/separating"],["விடல்",2,"Vital","leaving/letting be"]]},{"n":877,"l":["நோவற்க நொந்தது அறியார்க்கு மேவற்க","மென்மை பகைவர் அகத்து."],"w":[["நோவற்க",1,"Novarka","let (one) not grieve/tell"],["நொந்தது",1,"Nondhadhu","that which pained (obj.)"],["அறியார்க்கு",1,"Ariyaarkku","to those who know not"],["மேவற்க",1,"Mevarka","let (one) not cling/show"],["மென்மை",2,"Menmai","weakness/softness (obj.)"],["பகைவர்",2,"Pakaivar","enemies"],["அகத்து",2,"Akaththu","in (the mind/midst)"]]},{"n":878,"l":["வகையறிந்து தற்செய்து தற்காப்ப மாயும்","பகைவர்கண் பட்ட செருக்கு."],"w":[["வகையறிந்து",1,"Vakaiyarindhu","the way/manner (obj.); having known"],["தற்செய்து",1,"Tharseydhu","oneself (obj.); having strengthened/made"],["தற்காப்ப",1,"Tharkaappa","oneself (obj.); guarding/if one guards"],["மாயும்",1,"Maayum","that will perish (rel.)"],["பகைவர்கண்",2,"Pakaivarkan","enemies; in/with (loc.)"],["பட்ட",2,"Patta","that arose/occurred (rel.)"],["செருக்கு",2,"Serukku","pride/arrogance"]]},{"n":879,"l":["இளைதாக முள்மரம் கொல்க களையுநர்","கைகொல்லும் காழ்த்த இடத்து."],"w":[["இளைதாக",1,"Ilaidhaaka","while (it is) young"],["முள்மரம்",1,"Mulmaram","thorn; tree (obj.)"],["கொல்க",1,"Kolka","let (one) kill/cut"],["களையுநர்",1,"Kalaiyunar","those who remove/clear"],["கைகொல்லும்",2,"Kaikollum","the hand (obj.); (it) will hurt/cut"],["காழ்த்த",2,"Kaazhththa","having hardened (rel.)"],["இடத்து",2,"Itaththu","at the place/time"]]},{"n":880,"l":["உயிர்ப்ப உளரல்லர் மன்ற செயிர்ப்பவர்","செம்மல் சிதைக்கலா தார்."],"w":[["உயிர்ப்ப",1,"Uyirppa","(time enough) to breathe"],["உளரல்லர்",1,"Ularallar","they exist/live; are not"],["மன்ற",1,"Mandra","certainly (asseverative)"],["செயிர்ப்பவர்",1,"Seyirppavar","those who are hostile"],["செம்மல்",2,"Semmal","pride/eminence (obj.)"],["சிதைக்கலா",2,"Sidhaikkalaa","who cannot destroy (rel.)"],["தார்",2,"Thaar","those who (do not)"]]}]}