{"n":36,"kurals":[{"n":351,"l":["பொருளல்ல வற்றைப் பொருளென்று உணரும்","மருளானாம் மாணாப் பிறப்பு."],"w":[["பொருளல்ல",1,"Porulalla","things/substances; (those which) are not"],["வற்றைப்",1,"Vatraip","those (things)"],["பொருளென்று",1,"Porulendru","(true) substance; as/saying"],["உணரும்",1,"Unarum","(that) perceives"],["மருளானாம்",2,"Marulaanaam","by/through delusion; (it) results/comes to be"],["மாணாப்",2,"Maanaap","non-excellent / ignoble"],["பிறப்பு",2,"Pirappu","birth"]]},{"n":352,"l":["இருள்நீங்கி இன்பம் பயக்கும் மருள்நீங்கி","மாசறு காட்சி யவர்க்கு."],"w":[["இருள்நீங்கி",1,"Irulneengi","darkness/ignorance; having departed"],["இன்பம்",1,"Inpam","bliss/delight"],["பயக்கும்",1,"Payakkum","(it) yields"],["மருள்நீங்கி",1,"Marulneengi","delusion; having departed"],["மாசறு",2,"Maasaru","blemish; spotless (that-which-removes-blemish)"],["காட்சி",2,"Kaatchi","vision/insight"],["யவர்க்கு",2,"Yavarkku","to those (who have)"]]},{"n":353,"l":["ஐயத்தின் நீங்கித் தெளிந்தார்க்கு வையத்தின்","வானம் நணிய துடைத்து."],"w":[["ஐயத்தின்",1,"Aiyaththin","from doubt"],["நீங்கித்",1,"Neengith","having departed"],["தெளிந்தார்க்கு",1,"Thelindhaarkku","to those who became clear"],["வையத்தின்",1,"Vaiyaththin","than the earth"],["வானம்",2,"Vaanam","heaven/sky"],["நணிய",2,"Naniya","near (things)"],["துடைத்து",2,"Thutaiththu","it has (is the case)"]]},{"n":354,"l":["ஐயுணர்வு எய்தியக் கண்ணும் பயமின்றே","மெய்யுணர்வு இல்லா தவர்க்கு."],"w":[["ஐயுணர்வு",1,"Aiyunarvu","five; (sense) knowledge"],["எய்தியக்",1,"Eydhiyak","(having) attained"],["கண்ணும்",1,"Kannum","in (the case); even"],["பயமின்றே",1,"Payamindre","benefit; is not; (emphatic)"],["மெய்யுணர்வு",2,"Meyyunarvu","truth; true knowledge"],["இல்லா",2,"Illaa","(who) do not have"],["தவர்க்கு",2,"Thavarkku","to those"]]},{"n":355,"l":["எப்பொருள் எத்தன்மைத் தாயினும் அப்பொருள்","மெய்ப்பொருள் காண்பது அறிவு."],"w":[["எப்பொருள்",1,"Epporul","which; thing"],["எத்தன்மைத்",1,"Eththanmaith","what; of (what) nature"],["தாயினும்",1,"Thaayinum","even if it be"],["அப்பொருள்",1,"Apporul","that; thing"],["மெய்ப்பொருள்",2,"Meypporul","true; true reality"],["காண்பது",2,"Kaanpadhu","the seeing"],["அறிவு",2,"Arivu","(is) knowledge"]]},{"n":356,"l":["கற்றீண்டு மெய்ப்பொருள் கண்டார் தலைப்படுவர்","மற்றீண்டு வாரா நெறி."],"w":[["கற்றீண்டு",1,"Katreentu","having learnt; here (in this world)"],["மெய்ப்பொருள்",1,"Meypporul","true; true reality"],["கண்டார்",1,"Kantaar","those who saw/realised"],["தலைப்படுவர்",1,"Thalaippatuvar","they will attain"],["மற்றீண்டு",2,"Matreentu","moreover/again; here (in this world)"],["வாரா",2,"Vaaraa","(to which one) does not return"],["நெறி",2,"Neri","path"]]},{"n":357,"l":["ஓர்த்துள்ளம் உள்ளது உணரின் ஒருதலையாப்","பேர்த்துள்ள வேண்டா பிறப்பு."],"w":[["ஓர்த்துள்ளம்",1,"Orththullam","having examined; the mind"],["உள்ளது",1,"Ulladhu","that which truly is"],["உணரின்",1,"Unarin","if (it) perceives"],["ஒருதலையாப்",1,"Orudhalaiyaap","certainly/decisively"],["பேர்த்துள்ள",2,"Perththulla","again/anew; to think (of)"],["வேண்டா",2,"Ventaa","no need"],["பிறப்பு",2,"Pirappu","(re)birth"]]},{"n":358,"l":["பிறப்பென்னும் பேதைமை நீங்கச் சிறப்பென்னும்","செம்பொருள் காண்பது அறிவு."],"w":[["பிறப்பென்னும்",1,"Pirappennum","birth; called"],["பேதைமை",1,"Pedhaimai","folly/ignorance"],["நீங்கச்",1,"Neengach","so as to depart"],["சிறப்பென்னும்",1,"Chirappennum","excellence (liberation); called"],["செம்பொருள்",2,"Semporul","right/true; true essence"],["காண்பது",2,"Kaanpadhu","the seeing"],["அறிவு",2,"Arivu","(is) knowledge"]]},{"n":359,"l":["சார்புணர்ந்து சார்பு கெடஒழுகின் மற்றழித்துச்","சார்தரா சார்தரு நோய்."],"w":[["சார்புணர்ந்து",1,"Saarpunarndhu","the support/refuge; having realised"],["சார்பு",1,"Saarpu","attachment/bondage"],["கெடஒழுகின்",1,"Ketaozhukin","so as to perish; if (one) lives/conducts"],["மற்றழித்துச்",1,"Matrazhiththuch","moreover; having destroyed"],["சார்தரா",2,"Chaardharaa","(they) do not approach"],["சார்தரு",2,"Saardharu","(that) come to attach"],["நோய்",2,"Noi","afflictions/sorrows"]]},{"n":360,"l":["காமம் வெகுளி மயக்கம் இவைமூன்றன்","நாமம் கெடக்கெடும் நோய்."],"w":[["காமம்",1,"Kaamam","desire/lust"],["வெகுளி",1,"Vekuli","anger/wrath"],["மயக்கம்",1,"Mayakkam","delusion"],["இவைமூன்றன்",1,"Ivaimundran","these; of the three"],["நாமம்",2,"Naamam","the (very) name"],["கெடக்கெடும்",2,"Ketakketum","as (they) perish; (it) will perish"],["நோய்",2,"Noi","afflictions"]]}]}