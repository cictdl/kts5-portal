{"n":41,"kurals":[{"n":401,"l":["அரங்கின்றி வட்டாடி யற்றே நிரம்பிய","நூலின்றிக் கோட்டி கொளல்."],"w":[["அரங்கின்றி",1,"Arangindri","playing-floor/board; without"],["வட்டாடி",1,"Vattaati","having played dice"],["யற்றே",1,"Yatre","is like that (comparison); (particle)"],["நிரம்பிய",1,"Nirampiya","complete/full (that which)"],["நூலின்றிக்",2,"Noolindrik","book/learning; without"],["கோட்டி",2,"Kotti","learned assembly/debate"],["கொளல்",2,"Kolal","taking up / engaging in"]]},{"n":402,"l":["கல்லாதான் சொற்கா முறுதல் முலையிரண்டும்","இல்லாதாள் பெண்காமுற் றற்று."],"w":[["கல்லாதான்",1,"Kallaadhaan","the unlearned man"],["சொற்கா",1,"Sorkaa","word/speech (obj); (part of) desiring"],["முறுதல்",1,"Murudhal","desiring (to speak)"],["முலையிரண்டும்",1,"Mulaiyirantum","breast; two; both (incl.)"],["இல்லாதாள்",2,"Illaadhaal","she who has not"],["பெண்காமுற்",2,"Penkaamur","womanhood; desired (split across sira)"],["றற்று",2,"Ratru","is like that (comparison)"]]},{"n":403,"l":["கல்லா தவரும் நனிநல்லர் கற்றார்முன்","சொல்லா திருக்கப் பெறின்."],"w":[["கல்லா",1,"Kallaa","un-learning (who do not learn)"],["தவரும்",1,"Thavarum","those (who do not learn); even"],["நனிநல்லர்",1,"Naninallar","very/much; are good"],["கற்றார்முன்",1,"Katraarmun","the learned; before/in front of"],["சொல்லா",2,"Sollaa","without speaking"],["திருக்கப்",2,"Thirukkap","to remain"],["பெறின்",2,"Perin","if (one) gets/can"]]},{"n":404,"l":["கல்லாதான் ஒட்பம் கழியநன் றாயினும்","கொள்ளார் அறிவுடை யார்."],"w":[["கல்லாதான்",1,"Kallaadhaan","the unlearned man's"],["ஒட்பம்",1,"Otpam","wisdom/cleverness"],["கழியநன்",1,"Kazhiyanan","exceedingly; good (split)"],["றாயினும்",1,"Raayinum","even though it be; even"],["கொள்ளார்",2,"Kollaar","will not accept (they)"],["அறிவுடை",2,"Arivutai","knowledge; possessing"],["யார்",2,"Yaar","the wise (subject)"]]},{"n":405,"l":["கல்லா ஒருவன் தகைமை தலைப்பெய்து","சொல்லாடச் சோர்வு படும்."],"w":[["கல்லா",1,"Kallaa","unlearned (who)"],["ஒருவன்",1,"Oruvan","a (single) man"],["தகைமை",1,"Thakaimai","worth/di