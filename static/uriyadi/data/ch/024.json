{"n":24,"kurals":[{"n":231,"l":["ஈதல் இசைபட வாழ்தல் அதுவல்லது","ஊதியம் இல்லை உயிர்க்கு."],"w":[["ஈதல்",1,"Eedhal","giving (act of)"],["இசைபட",1,"Isaipata","fame, renown; so that (fame) arises"],["வாழ்தல்",1,"Vaazhdhal","living (act of)"],["அதுவல்லது",1,"Adhuvalladhu","that; other than"],["ஊதியம்",2,"Oodhiyam","profit, gain"],["இல்லை",2,"Illai","is not / there is none"],["உயிர்க்கு",2,"Uyirkku","for life / for living beings"]]},{"n":232,"l":["உரைப்பார் உரைப்பவை எல்லாம் இரப்பார்க்கொன்று","ஈவார்மேல் நிற்கும் புகழ்."],"w":[["உரைப்பார்",1,"Uraippaar","those who speak/praise"],["உரைப்பவை",1,"Uraippavai","the things they say"],["எல்லாம்",1,"Ellaam","all"],["இரப்பார்க்கொன்று",1,"Irappaarkkondru","to those who beg; one thing"],["ஈவார்மேல்",2,"Eevaarmel","those who give; upon / on"],["நிற்கும்",2,"Nirkum","that stands/rests"],["புகழ்",2,"Pukazh","fame, renown"]]},{"n":233,"l":["ஒன்றா உலகத்து உயர்ந்த புகழல்லால்","பொன்றாது நிற்பதொன் றில்."],"w":[["ஒன்றா",1,"Ondraa","unequalled, peerless"],["உலகத்து",1,"Ulakaththu","in the world"],["உயர்ந்த",1,"Uyarndha","exalted, high"],["புகழல்லால்",1,"Pukazhallaal","fame; other than, except"],["பொன்றாது",2,"Pondraadhu","without perishing"],["நிற்பதொன்",2,"Nirpadhon","that which stands/endures; one thing"],["றில்",2,"Ril","is not / there is none"]]},{"n":234,"l":["நிலவரை நீள்புகழ் ஆற்றின் புலவரைப்","போற்றாது புத்தேள் உலகு."],"w":[["நிலவரை",1,"Nilavarai","extent of the earth"],["நீள்புகழ்",1,"Neelpukazh","long-lasting fame"],["ஆற்றின்",1,"Aatrin","if (one) achieves/performs"],["புலவரைப்",1,"Pulavaraip","the learned (acc.)"],["போற்றாது",2,"Potraadhu","without honouring"],["புத்தேள்",2,"Puththel","god, celestial"],["உலகு",2,"Ulaku","world (heaven)"]]},{"n":235,"l":["நத்தம்போல் கேடும் உளதாகும் சாக்காடும்","வித்தகர்க் கல்லால் அரிது."],"w":[["நத்தம்போல்",1,"Naththampol","abundance, prosperity; like, as"],["கேடும்",1,"Ketum","ruin, decline; also, even"],["உளதாகும்",1,"Uladhaakum","will become / will exist"],["சாக்காடும்",1,"Saakkaatum","death; also, even"],["வித்தகர்க்",2,"Viththakark","for the wise/skilled"],["கல்லால்",2,"Kallaal","except, other than"],["அரிது",2,"Aridhu","is rare/difficult"]]},{"n":236,"l":["தோன்றின் புகழொடு தோன்றுக அஃதிலார்","தோன்றலின் தோன்றாமை நன்று."],"w":[["தோன்றின்",1,"Thondrin","if (one) appears/is born"],["புகழொடு",1,"Pukazhotu","with fame"],["தோன்றுக",1,"Thondruka","let (one) appear"],["அஃதிலார்",1,"Aqdhilaar","that (fame); those without (it)"],["தோன்றலின்",2,"Thondralin","than appearing"],["தோன்றாமை",2,"Thondraamai","not appearing"],["நன்று",2,"Nandru","is good"]]},{"n":237,"l":["புகழ்பட வாழாதார் தந்நோவார் தம்மை","இகழ்வாரை நோவது எவன்?"],"w":[["புகழ்பட",1,"Pukazhpata","fame; so that (it) arises"],["வாழாதார்",1,"Vaazhaadhaar","those who do not live (with fame)"],["தந்நோவார்",1,"Thannovaar","themselves; (they) do not grieve (over themselves)"],["தம்மை",1,"Thammai","them (acc.)"],["இகழ்வாரை",2,"Ikazhvaarai","those who scorn (acc.)"],["நோவது",2,"Novadhu","the grieving (act)"],["எவன்",2,"Evan","what / why"]]},{"n":238,"l":["வசையென்ப வையத்தார்க் கெல்லாம் இசையென்னும்","எச்சம் பெறாஅ விடின்."],"w":[["வசையென்ப",1,"Vasaiyenpa","blame, disgrace; they say (it to be)"],["வையத்தார்க்",1,"Vaiyaththaark","for the people of the world"],["கெல்லாம்",1,"Kellaam","all"],["இசையென்னும்",1,"Isaiyennum","fame, renown; called, named"],["எச்சம்",2,"Echcham","remainder, legacy"],["பெறாஅ",2,"Peraaa","without obtaining"],["விடின்",2,"Vitin","if (one) lets/fails"]]},{"n":239,"l":["வசையிலா வண்பயன் குன்றும் இசையிலா","யாக்கை பொறுத்த நிலம்."],"w":[["வசையிலா",1,"Vasaiyilaa","blameless"],["வண்பயன்",1,"Vanpayan","rich yield/benefit"],["குன்றும்",1,"Kundrum","will diminish"],["இசையிலா",1,"Isaiyilaa","fame-less"],["யாக்கை",2,"Yaakkai","body"],["பொறுத்த",2,"Poruththa","that bore/carried"],["நிலம்",2,"Nilam","land, earth"]]},{"n":240,"l":["வசையொழிய வாழ்வாரே வாழ்வார் இசையொழிய","வாழ்வாரே வாழா தவர்."],"w":[["வசையொழிய",1,"Vasaiyozhiya","blame; so as to be free of / departing"],["வாழ்வாரே",1,"Vaazhvaare","those who live; (emphatic) indeed"],["வாழ்வார்",1,"Vaazhvaar","(are the ones who truly) live"],["இசையொழிய",1,"Isaiyozhiya","fame; departing / being without"],["வாழ்வாரே",2,"Vaazhvaare","those who live (in disgrace); (emphatic) indeed"],["வாழா",2,"Vaazhaa","not living"],["தவர்",2,"Thavar","those who do not live"]]}]}