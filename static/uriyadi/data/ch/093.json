{"n":93,"kurals":[{"n":921,"l":["உட்கப் படாஅர் ஒளியிழப்பர் எஞ்ஞான்றும்","கட்காதல் கொண்டொழுகு வார்."],"w":[["உட்கப்",1,"Utkap","so as to fear/dread"],["படாஅர்",1,"Pataaar","are not (feared/affected)"],["ஒளியிழப்பர்",1,"Oliyizhappar","glory, fame; will lose"],["எஞ்ஞான்றும்",1,"Egngnaandrum","what day / (with உம்) every day, always; even/all (emphatic)"],["கட்காதல்",2,"Katkaadhal","toddy, palm-wine; desire, love (for)"],["கொண்டொழுகு",2,"Kontozhuku","having taken/held; who conduct/live (in)"],["வார்",2,"Vaar","those who (live/conduct)"]]},{"n":922,"l":["உண்ணற்க கள்ளை உணில்உண்க சான்றோரான்","எண்ணப் படவேண்டா தார்."],"w":[["உண்ணற்க",1,"Unnarka","let (one) not drink / one should not drink"],["கள்ளை",1,"Kallai","toddy (acc.)"],["உணில்உண்க",1,"Unilunka","if (one) drinks; let (them) drink"],["சான்றோரான்",1,"Saandroraan","by the wise/noble"],["எண்ணப்",2,"Ennap","(so as) to be esteemed"],["படவேண்டா",2,"Pataventaa","to be (esteemed); (who) do not wish/need"],["தார்",2,"Thaar","those who (do not wish)"]]},{"n":923,"l":["ஈன்றாள் முகத்தேயும் இன்னாதால் என்மற்றுச்","சான்றோர் முகத்துக் களி."],"w":[["ஈன்றாள்",1,"Eendraal","she who bore (mother)"],["முகத்தேயும்",1,"Mukaththeyum","in/at the face; even"],["இன்னாதால்",1,"Innaadhaal","is painful/grievous; (expletive particle)"],["என்மற்றுச்",1,"Enmatruch","what (then); moreover (particle)"],["சான்றோர்",2,"Chaandror","the wise/noble"],["முகத்துக்",2,"Mukaththuk","at the face/presence"],["களி",2,"Kali","drunken joy, intoxication (subject)"]]},{"n":924,"l":["நாண்என்னும் நல்லாள் புறங்கொடுக்கும் கள்ளென்னும்","பேணாப் பெருங்குற்றத் தார்க்கு."],"w":[["நாண்என்னும்",1,"Naanennum","modesty, shame; called, named"],["நல்லாள்",1,"Nallaal","good; woman/person"],["புறங்கொடுக்கும்",1,"Purangotukkum","back; will give (turn the back, flee)"],["கள்ளென்னும்",1,"Kallennum","toddy; called, named"],["பேணாப்",2,"Penaap","uncherished, undesirable (which one does not cherish)"],["பெருங்குற்றத்",2,"Perungutrath","great; fault, sin"],["தார்க்கு",2,"Thaarkku","for those who have (the fault)"]]},{"n":925,"l":["கையறி யாமை உடைத்தே பொருள்கொடுத்து","மெய்யறி யாமை கொளல்."],"w":[["கையறி",1,"Kaiyari","deed, act (lit. hand); to know"],["யாமை",1,"Yaamai","not knowing (ignorance of action)"],["உடைத்தே",1,"Utaiththe","possesses, has (the quality); (emphatic/assertive)"],["பொருள்கொடுத்து",1,"Porulkotuththu","money, wealth; having given (paying)"],["மெய்யறி",2,"Meyyari","body, self; to know"],["யாமை",2,"Yaamai","the not-knowing (of body/self)"],["கொளல்",2,"Kolal","the taking/acquiring (act)"]]},{"n":926,"l":["துஞ்சினார் செத்தாரின் வேறல்லர் எஞ்ஞான்றும்","நஞ்சுண்பார் கள்ளுண் பவர்."],"w":[["துஞ்சினார்",1,"Thunjinaar","those who slept"],["செத்தாரின்",1,"Seththaarin","than the dead"],["வேறல்லர்",1,"Verallar","different, apart; are not"],["எஞ்ஞான்றும்",1,"Egngnaandrum","what day / always; even/all"],["நஞ்சுண்பார்",2,"Nanjunpaar","poison; those who eat (poison)"],["கள்ளுண்",2,"Kallun","toddy; drinking"],["பவர்",2,"Pavar","those who (drink)"]]},{"n":927,"l":["உள்ளொற்றி உள்ளூர் நகப்படுவர் எஞ்ஞான்றும்","கள்ளொற்றிக் கண்சாய் பவர்"],"w":[["உள்ளொற்றி",1,"Ullotri","inner matters, secrets; having spied/probed"],["உள்ளூர்",1,"Ulloor","townsfolk / those in the town"],["நகப்படுவர்",1,"Nakappatuvar","to laugh (at); will be (laughed at)"],["எஞ்ஞான்றும்",1,"Egngnaandrum","always; even/all"],["கள்ளொற்றிக்",2,"Kallotrik","toddy; having drunk secretly"],["கண்சாய்",2,"Kansaai","eye; (eyes) drooping/swooning"],["பவர்",2,"Pavar","those who (swoon)"]]},{"n":928,"l":["களித்தறியேன் என்பது கைவிடுக நெஞ்சத்து","ஒளித்ததூஉம் ஆங்கே மிகும்."],"w":[["களித்தறியேன்",1,"Kaliththariyen","having got drunk; I have never (known/experienced)"],["என்பது",1,"Enpadhu","that which one says (the saying)"],["கைவிடுக",1,"Kaivituka","let (one) give up / give it up"],["நெஞ்சத்து",1,"Nenjaththu","in the heart/mind"],["ஒளித்ததூஉம்",2,"Oliththadhooum","that which was hidden; also/even"],["ஆங்கே",2,"Aange","there, then (at that very moment); (emphatic)"],["மிகும்",2,"Mikum","will increase / come out"]]},{"n":929,"l":["களித்தானைக் காரணம் காட்டுதல் கீழ்நீர்க்","குளித்தானைத் தீத்துரீஇ அற்று."],"w":[["களித்தானைக்",1,"Kaliththaanaik","him who got drunk"],["காரணம்",1,"Kaaranam","reason, cause"],["காட்டுதல்",1,"Kaattudhal","the showing (act) — subject"],["கீழ்நீர்க்",1,"Keezhneerk","below, beneath; water (under)"],["குளித்தானைத்",2,"Kuliththaanaith","him who dived/sank"],["தீத்துரீஇ",2,"Theeththureei","fire, torch; searching (with), driving (alapedai form)"],["அற்று",2,"Atru","like that, of that kind (comparison)"]]},{"n":930,"l":["கள்ளுண்ணாப் போழ்திற் களித்தானைக் காணுங்கால்","உள்ளான்கொல் உண்டதன் சோர்வு."],"w":[["கள்ளுண்ணாப்",1,"Kallunnaap","toddy; not drinking (qualifying போழ்து)"],["போழ்திற்",1,"Pozhdhir","at the time"],["களித்தானைக்",1,"Kaliththaanaik","him who got drunk"],["காணுங்கால்",1,"Kaanungaal","when (one) sees"],["உள்ளான்கொல்",2,"Ullaankol","does he not think? (he thinks not); (doubt/interrogative particle)"],["உண்டதன்",2,"Untadhan","of that which was drunk"],["சோர்வு",2,"Sorvu","the lapse/exhaustion"]]}]}