{"n":102,"kurals":[{"n":1011,"l":["கருமத்தால் நாணுதல் நாணுத் திருநுதல்","நல்லவர் நாணுப் பிற."],"w":[["கருமத்தால்",1,"Karumaththaal","by/because of (a) deed"],["நாணுதல்",1,"Naanudhal","feeling shame (the act of)"],["நாணுத்",1,"Naanuth","(that) is/becomes shame"],["திருநுதல்",1,"Thirunudhal","beautiful/auspicious; forehead (=fair-browed woman, by அன்மொழித்தொகை)"],["நல்லவர்",2,"Nallavar","good ones (women)"],["நாணுப்",2,"Naanup","shame/modesty"],["பிற",2,"Pira","(are) other/different (kinds)"]]},{"n":1012,"l":["ஊணுடை எச்சம் உயிர்க்கெல்லாம் வேறல்ல","நாணுடைமை மாந்தர் சிறப்பு."],"w":[["ஊணுடை",1,"Oonutai","food; clothing"],["எச்சம்",1,"Echcham","the rest/remainder"],["உயிர்க்கெல்லாம்",1,"Uyirkkellaam","for (all) lives; all"],["வேறல்ல",1,"Veralla","different/separate; are not"],["நாணுடைமை",2,"Naanutaimai","possessing shame/modesty"],["மாந்தர்",2,"Maandhar","of humans/people"],["சிறப்பு",2,"Sirappu","(is the) distinction/excellence"]]},{"n":1013,"l":["ஊனைக் குறித்த உயிரெல்லாம் நாண்என்னும்","நன்மை குறித்தது சால்பு."],"w":[["ஊனைக்",1,"Oonaik","the flesh/body (acc.)"],["குறித்த",1,"Kuriththa","that took (as abode)"],["உயிரெல்லாம்",1,"Uyirellaam","lives; all"],["நாண்என்னும்",1,"Naanennum","shame/modesty; called/named (that which is)"],["நன்மை",2,"Nanmai","goodness/good quality (obj.)"],["குறித்தது",2,"Kuriththadhu","that which took (as abode)"],["சால்பு",2,"Saalpu","perfection/nobility"]]},{"n":1014,"l":["அணிஅன்றோ நாணுடைமை சான்றோர்க்கு அஃதின்றேல்","பிணிஅன்றோ பீடு நடை."],"w":[["அணிஅன்றோ",1,"Aniandro","ornament/jewel; is it not (so); (interrogative/affirmative)"],["நாணுடைமை",1,"Naanutaimai","possessing shame/modesty"],["சான்றோர்க்கு",1,"Saandrorkku","for the noble/wise"],["அஃதின்றேல்",1,"Aqdhindrel","that; if it is not (present)"],["பிணிஅன்றோ",2,"Piniandro","disease/affliction; is it not (so); (interrogative/affirmative)"],["பீடு",2,"Peetu","pride/grandeur"],["நடை",2,"Natai","gait/walk"]]},{"n":1015,"l":["பிறர்பழியும் தம்பழியும் நாணுவார் நாணுக்கு","உறைபதி என்னும் உலகு."],"w":[["பிறர்பழியும்",1,"Pirarpazhiyum","others'; blame/disgrace; and/also (incl.)"],["தம்பழியும்",1,"Thampazhiyum","their own; (own) blame; and/also (incl.)"],["நாணுவார்",1,"Naanuvaar","those who feel shame"],["நாணுக்கு",1,"Naanukku","for shame/modesty"],["உறைபதி",2,"Uraipadhi","dwelling-; abode/dwelling place"],["என்னும்",2,"Ennum","(that the world) calls/says"],["உலகு",2,"Ulaku","the world (=people)"]]},{"n":1016,"l":["நாண்வேலி கொள்ளாது மன்னோ வியன்ஞாலம்","பேணலர் மேலா யவர்."],"w":[["நாண்வேலி",1,"Naanveli","shame-; fence/hedge"],["கொள்ளாது",1,"Kollaadhu","without taking/holding"],["மன்னோ",1,"Manno","(expletive/emphasis); (emphatic/lament)"],["வியன்ஞாலம்",1,"Viyangnaalam","vast/wide; the world/earth (obj.)"],["பேணலர்",2,"Penalar","(they) do not cherish/desire"],["மேலா",2,"Melaa","high/superior"],["யவர்",2,"Yavar","those who are (the great)"]]},{"n":1017,"l":["நாணால் உயிரைத் துறப்பர் உயிர்ப்பொருட்டால்","நாண்துறவார் நாணாள் பவர்."],"w":[["நாணால்",1,"Naanaal","due to/for shame"],["உயிரைத்",1,"Uyiraith","the life (acc.)"],["துறப்பர்",1,"Thurappar","(they) will give up"],["உயிர்ப்பொருட்டால்",1,"Uyirpporuttaal","life-; for the sake of"],["நாண்துறவார்",2,"Naandhuravaar","shame (obj.); (they) will not forsake"],["நாணாள்",2,"Naanaal","(who) value/cherish shame"],["பவர்",2,"Pavar","those who hold (shame dear)"]]},{"n":1018,"l":["பிறர்நாணத் தக்கது தான்நாணா னாயின்","அறம்நாணத் தக்கது உடைத்து."],"w":[["பிறர்நாணத்",1,"Pirarnaanath","others; (so that others) feel shame"],["தக்கது",1,"Thakkadhu","that which is fit/worthy"],["தான்நாணா",1,"Thaannaanaa","he himself; not feeling shame"],["னாயின்",1,"Naayin","if it be / if so"],["அறம்நாணத்",2,"Aramnaanath","virtue/righteousness; (such that) virtue is ashamed"],["தக்கது",2,"Thakkadhu","that which is fit (cause for shame)"],["உடைத்து",2,"Utaiththu","(it) possesses/has"]]},{"n":1019,"l":["குலஞ்சுடும் கொள்கை பிழைப்பின் நலஞ்சுடும்","நாணின்மை நின்றக் கடை."],"w":[["குலஞ்சுடும்",1,"Kulanjutum","the lineage/family (obj.); (it) will burn/harm"],["கொள்கை",1,"Kolkai","conduct/principle"],["பிழைப்பின்",1,"Pizhaippin","if (it/the conduct) errs/fails"],["நலஞ்சுடும்",1,"Nalanjutum","the good/welfare (obj.); (it) will burn/destroy"],["நாணின்மை",2,"Naaninmai","shamelessness"],["நின்றக்",2,"Nindrak","that stood/persisted"],["கடை",2,"Katai","when/at the point (idiom: நின்றக்கடை = when it persists)"]]},{"n":1020,"l":["நாண்அகத் தில்லார் இயக்கம் மரப்பாவை","நாணால் உயிர்மருட்டி அற்று."],"w":[["நாண்அகத்",1,"Naanakath","shame; in the mind/within"],["தில்லார்",1,"Thillaar","those who do not have"],["இயக்கம்",1,"Iyakkam","movement/activity"],["மரப்பாவை",1,"Marappaavai","wood/wooden; puppet/doll"],["நாணால்",2,"Naanaal","by string/cord"],["உயிர்மருட்டி",2,"Uyirmarutti","life (obj.); having deluded (as if alive)"],["அற்று",2,"Atru","like that / is like (உவம உருபுப் பொருள்)"]]}]}