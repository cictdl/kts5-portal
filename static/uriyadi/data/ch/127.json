{"n":127,"kurals":[{"n":1261,"l":["வாளற்றுப் புற்கென்ற கண்ணும் அவர்சென்ற","நாளொற்றித் தேய்ந்த விரல்."],"w":[["வாளற்றுப்",1,"Vaalatrup","brightness/lustre (of eyes); having lost"],["புற்கென்ற",1,"Purkendra","that grew dim/dull"],["கண்ணும்",1,"Kannum","eyes; and/too (எச்ச உம்மை)"],["அவர்சென்ற",1,"Avarsendra","he (honorific); that (he) went"],["நாளொற்றித்",2,"Naalotrith","days (counted); touching/marking"],["தேய்ந்த",2,"Theyndha","that wore away"],["விரல்",2,"Viral","fingers"]]},{"n":1262,"l":["இலங்கிழாய் இன்று மறப்பின்என் தோள்மேல்","கலங்கழியும் காரிகை நீத்து."],"w":[["இலங்கிழாய்",1,"Ilangizhaai","O bright-jewelled woman (vocative)"],["இன்று",1,"Indru","today"],["மறப்பின்என்",1,"Marappinen","if (I) forget; my"],["தோள்மேல்",1,"Tholmel","shoulder; upon (postposition)"],["கலங்கழியும்",2,"Kalangazhiyum","ornaments/bracelets; will slip off"],["காரிகை",2,"Kaarikai","beauty"],["நீத்து",2,"Neeththu","having departed/left"]]},{"n":1263,"l":["உரன்நசைஇ உள்ளம் துணையாகச் சென்றார்","வரல்நசைஇ இன்னும் உளேன்."],"w":[["உரன்நசைஇ",1,"Urannasaii","firmness/will/strength; desiring (அளபெடை)"],["உள்ளம்",1,"Ullam","mind/heart (as companion)"],["துணையாகச்",1,"Thunaiyaakach","companion/aid; being/as"],["சென்றார்",1,"Chendraar","he who went (honorific)"],["வரல்நசைஇ",2,"Varalnasaii","(his) coming/return; desiring (அளபெடை)"],["இன்னும்",2,"Innum","still/yet"],["உளேன்",2,"Ulen","I exist/remain alive"]]},{"n":1264,"l":["கூடிய காமம் பிரிந்தார் வரவுள்ளிக்","கோடுகொ டேறுமென் நெஞ்சு."],"w":[["கூடிய",1,"Kootiya","that was united/enjoyed"],["காமம்",1,"Kaamam","love/desire"],["பிரிந்தார்",1,"Pirindhaar","he who parted"],["வரவுள்ளிக்",1,"Varavullik","(his) arrival; thinking of"],["கோடுகொ",2,"Kotuko","branch/bough; taking (கொண்டு)"],["டேறுமென்",2,"Terumen","(my heart) climbs/rises; my"],["நெஞ்சு",2,"Nenju","heart"]]},{"n":1265,"l":["காண்கமன் கொண்கனைக் கண்ணாரக் கண்டபின்","நீங்கும்என் மென்தோள் பசப்பு."],"w":[["காண்கமன்",1,"Kaankaman","may I behold; (wish/expletive particle)"],["கொண்கனைக்",1,"Konkanaik","the lord/spouse (of seashore); accusative -ai"],["கண்ணாரக்",1,"Kannaarak","eyes; to the full (eyes being satisfied)"],["கண்டபின்",1,"Kantapin","having seen; after"],["நீங்கும்என்",2,"Neengumen","will leave/depart; my"],["மென்தோள்",2,"Mendhol","soft; shoulder"],["பசப்பு",2,"Pasappu","pallor/sallowness"]]},{"n":1266,"l":["வருகமன் கொண்கன் ஒருநாள் பருகுவன்","பைதல்நோய் எல்லாம் கெட."],"w":[["வருகமன்",1,"Varukaman","may (he) come; (wish/expletive particle)"],["கொண்கன்",1,"Konkan","the lord/spouse"],["ஒருநாள்",1,"Orunaal","one; day"],["பருகுவன்",1,"Parukuvan","I will drink/savour"],["பைதல்நோய்",2,"Paidhalnoi","sorrow/affliction; malady/pain"],["எல்லாம்",2,"Ellaam","all"],["கெட",2,"Keta","so as to perish/be cured"]]},{"n":1267,"l":["புலப்பேன்கொல் புல்லுவேன் கொல்லோ கலப்பேன்கொல்","கண்அன்ன கேளிர் வரின்."],"w":[["புலப்பேன்கொல்",1,"Pulappenkol","shall I sulk/be cross; (doubt/interrogative particle)"],["புல்லுவேன்",1,"Pulluven","shall I embrace"],["கொல்லோ",1,"Kollo","(doubt particle); interrogative/emphatic O"],["கலப்பேன்கொல்",1,"Kalappenkol","shall I mingle/do both; (doubt particle)"],["கண்அன்ன",2,"Kananna","eye; like/resembling (உவம உருபு)"],["கேளிர்",2,"Kelir","kinsman/beloved (honorific)"],["வரின்",2,"Varin","if (he) comes (conditional)"]]},{"n":1268,"l":["வினைகலந்து வென்றீக வேந்தன் மனைகலந்து","மாலை அயர்கம் விருந்து."],"w":[["வினைகலந்து",1,"Vinaikalandhu","deed/war-task; engaging in"],["வென்றீக",1,"Vendreeka","having won; may (he) grant"],["வேந்தன்",1,"Vendhan","the king"],["மனைகலந்து",1,"Manaikalandhu","wife/home; uniting with"],["மாலை",2,"Maalai","evening"],["அயர்கம்",2,"Ayarkam","we shall hold/celebrate"],["விருந்து",2,"Virundhu","feast"]]},{"n":1269,"l":["ஒருநாள் எழுநாள்போல் செல்லும்சேண் சென்றார்","வருநாள்வைத்து ஏங்கு பவர்க்கு."],"w":[["ஒருநாள்",1,"Orunaal","one; day"],["எழுநாள்போல்",1,"Ezhunaalpol","seven; days; like (உவம உருபு)"],["செல்லும்சேண்",1,"Sellumsen","(the place to) which one goes / far-extending; distant place/far"],["சென்றார்",1,"Sendraar","the one who went (honorific)"],["வருநாள்வைத்து",2,"Varunaalvaiththu","(of his) coming; the day; having set (in mind)"],["ஏங்கு",2,"Engu","who pine/yearn (root before பவர்)"],["பவர்க்கு",2,"Pavarkku","to those who (yearn); dative -ku"]]},{"n":1270,"l":["பெறின்என்னாம் பெற்றக்கால் என்னாம் உறினென்னாம்","உள்ளம் உடைந்துக்கக் கால்."],"w":[["பெறின்என்னாம்",1,"Perinennaam","if (one) obtains; what; will it become/be (of use)"],["பெற்றக்கால்",1,"Petrakkaal","having obtained; when/the time"],["என்னாம்",1,"Ennaam","what; will it become/be (of use)"],["உறினென்னாம்",1,"Urinennaam","if (one) unites/attains; what; will it become/be (of use)"],["உள்ளம்",2,"Ullam","heart/mind"],["உடைந்துக்கக்",2,"Utaindhukkak","having broken; having perished/spilled away"],["கால்",2,"Kaal","when/at the time"]]}]}