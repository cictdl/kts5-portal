{"n":65,"kurals":[{"n":641,"l":["நாநலம் என்னும் நலனுடைமை அந்நலம்","யாநலத்து உள்ளதூஉம் அன்று."],"w":[["நாநலம்",1,"Naanalam","tongue (speech); goodness/excellence"],["என்னும்",1,"Ennum","that is called"],["நலனுடைமை",1,"Nalanutaimai","goodness; possession/wealth"],["அந்நலம்",1,"Annalam","that; that goodness"],["யாநலத்து",2,"Yaanalaththu","which/any; in goodness"],["உள்ளதூஉம்",2,"Ulladhooum","that which is contained; even (inclusive)"],["அன்று",2,"Andru","is not"]]},{"n":642,"l":["ஆக்கமுங் கேடும் அதனால் வருதலால்","காத்தோம்பல் சொல்லின்கட் சோர்வு."],"w":[["ஆக்கமுங்",1,"Aakkamung","gain/prosperity; and (conjunctive)"],["கேடும்",1,"Ketum","ruin/loss; and (conjunctive)"],["அதனால்",1,"Adhanaal","by that (speech)"],["வருதலால்",1,"Varudhalaal","because it comes"],["காத்தோம்பல்",2,"Kaaththompal","guarding; protecting/cherishing"],["சொல்லின்கட்",2,"Sollinkat","in speech; (connective); in/at (loc.)"],["சோர்வு",2,"Sorvu","slip/lapse"]]},{"n":643,"l":["கேட்டார்ப் பிணிக்கும் தகையவாய்க் கேளாரும்","வேட்ப மொழிவதாம் சொல்."],"w":[["கேட்டார்ப்",1,"Kettaarp","those who heard"],["பிணிக்கும்",1,"Pinikkum","that binds/captivates"],["தகையவாய்க்",1,"Thakaiyavaaik","qualities/merits; being/possessing"],["கேளாரும்",1,"Kelaarum","those who do not hear; even"],["வேட்ப",2,"Vetpa","so as to desire"],["மொழிவதாம்",2,"Mozhivadhaam","that which is spoken; is/becomes"],["சொல்",2,"Sol","(good) speech"]]},{"n":644,"l":["திறனறிந்து சொல்லுக சொல்லை அறனும்","பொருளும் அதனினூஉங்கு இல்."],"w":[["திறனறிந்து",1,"Thiranarindhu","manner/fitness; having known"],["சொல்லுக",1,"Solluka","let one speak"],["சொல்லை",1,"Sollai","the word/speech"],["அறனும்",1,"Aranum","virtue; and"],["பொருளும்",2,"Porulum","wealth; and"],["அதனினூஉங்கு",2,"Adhaninooungu","than that; beyond/more than"],["இல்",2,"Il","there is none"]]},{"n":645,"l":["சொல்லுக சொல்லைப் பிறிதோர்சொல் அச்சொல்லை","வெல்லுஞ்சொல் இன்மை அறிந்து."],"w":[["சொல்லுக",1,"Solluka","let one speak"],["சொல்லைப்",1,"Sollaip","the word"],["பிறிதோர்சொல்",1,"Piridhorsol","another; one; word"],["அச்சொல்லை",1,"Achchollai","that; that word"],["வெல்லுஞ்சொல்",2,"Vellunjol","that conquers; word"],["இன்மை",2,"Inmai","absence/non-existence"],["அறிந்து",2,"Arindhu","having known"]]},{"n":646,"l":["வேட்பத்தாஞ் சொல்லிப் பிறர்சொல் பயன்கோடல்","மாட்சியின் மாசற்றார் கோள்."],"w":[["வேட்பத்தாஞ்",1,"Vetpaththaanj","so as to desire; they themselves"],["சொல்லிப்",1,"Chollip","having spoken"],["பிறர்சொல்",1,"Pirarsol","others'; speech"],["பயன்கோடல்",1,"Payankotal","benefit/substance; grasping/accepting"],["மாட்சியின்",2,"Maatchiyin","greatness/excellence; in/of (5th case)"],["மாசற்றார்",2,"Maasatraar","blemish; those rid (of it)"],["கோள்",2,"Kol","principle/tenet"]]},{"n":647,"l":["சொலல்வல்லன் சோர்விலன் அஞ்சான் அவனை","இகல்வெல்லல் யார்க்கும் அரிது."],"w":[["சொலல்வல்லன்",1,"Solalvallan","speaking; is able (he)"],["சோர்விலன்",1,"Sorvilan","weariness/lapse; is without (he)"],["அஞ்சான்",1,"Anjaan","he fears not"],["அவனை",1,"Avanai","him"],["இகல்வெல்லல்",2,"Ikalvellal","by enmity/conflict; conquering"],["யார்க்கும்",2,"Yaarkkum","for anyone; even (all-inclusive)"],["அரிது",2,"Aridhu","is difficult"]]},{"n":648,"l":["விரைந்து தொழில்கேட்கும் ஞாலம் நிரந்தினிது","சொல்லுதல் வல்லார்ப் பெறின்."],"w":[["விரைந்து",1,"Viraindhu","quickly/hastening"],["தொழில்கேட்கும்",1,"Thozhilketkum","task/command; that obeys/heeds"],["ஞாலம்",1,"Gnaalam","the world"],["நிரந்தினிது",1,"Nirandhinidhu","arranging in order; sweetly/pleasantly"],["சொல்லுதல்",2,"Solludhal","speaking"],["வல்லார்ப்",2,"Vallaarp","those able (ones)"],["பெறின்",2,"Perin","if (one) obtains"]]},{"n":649,"l":["பலசொல்லக் காமுறுவர் மன்றமா சற்ற","சிலசொல்லல் தேற்றா தவர்."],"w":[["பலசொல்லக்",1,"Palasollak","many (words); so as to speak"],["காமுறுவர்",1,"Kaamuruvar","they desire"],["மன்றமா",1,"Mandramaa","certainly (expletive); blemish (mā-su, சீர்-சந்தியால் பிரிந்தது)"],["சற்ற",1,"Satra","devoid of (blemish-free)"],["சிலசொல்லல்",2,"Silasollal","few (words); speaking"],["தேற்றா",2,"Thetraa","not capable/clear"],["தவர்",2,"Thavar","tho