{"n":51,"kurals":[{"n":501,"l":["அறம்பொருள் இன்பம் உயிரச்சம் நான்கின்","திறந்தெரிந்து தேறப் படும்."],"w":[["அறம்பொருள்",1,"Aramporul","virtue; wealth"],["இன்பம்",1,"Inpam","pleasure"],["உயிரச்சம்",1,"Uyirachcham","life (fear for life); fear"],["நான்கின்",1,"Naankin","of the four (kinds)"],["திறந்தெரிந்து",2,"Thirandherindhu","ways/aspects; having examined"],["தேறப்",2,"Therap","so as to be confident"],["படும்",2,"Patum","is/will be (trusted) — passive"]]},{"n":502,"l":["குடிப்பிறந்து குற்றத்தின் நீங்கி வடுப்பரியும்","நாணுடையான் கட்டே தெளிவு."],"w":[["குடிப்பிறந்து",1,"Kutippirandhu","(in) family/lineage; having been born"],["குற்றத்தின்",1,"Kutraththin","from fault"],["நீங்கி",1,"Neengi","having separated/withdrawn"],["வடுப்பரியும்",1,"Vatuppariyum","blemish/stain; that dreads/shrinks from"],["நாணுடையான்",2,"Naanutaiyaan","shame/modesty; one who possesses"],["கட்டே",2,"Katte","the pointing-out/indication; emphatic/exclusive (alone)"],["தெளிவு",2,"Thelivu","(the) clarity/choice"]]},{"n":503,"l":["அரியகற்று ஆசற்றார் கண்ணும் தெரியுங்கால்","இன்மை அரிதே வெளிறு."],"w":[["அரியகற்று",1,"Ariyakatru","rare (texts); having learnt"],["ஆசற்றார்",1,"Aasatraar","fault/flaw; those without (it)"],["கண்ணும்",1,"Kannum","in/at (locative urupu); even"],["தெரியுங்கால்",1,"Theriyungaal","when examined"],["இன்மை",2,"Inmai","absence/non-existence"],["அரிதே",2,"Aridhe","is rare/difficult; emphatic (தேற்றம்)"],["வெளிறு",2,"Veliru","ignorance/immaturity"]]},{"n":504,"l":["குணம்நாடிக் குற்றமும் நாடி அவற்றுள்","மிகைநாடி மிக்க கொளல்."],"w":[["குணம்நாடிக்",1,"Kunamnaatik","virtue/good quality; having examined"],["குற்றமும்",1,"Kutramum","fault; also"],["நாடி",1,"Naati","having examined"],["அவற்றுள்",1,"Avatrul","among them"],["மிகைநாடி",2,"Mikainaati","the excess/predominance; having examined"],["மிக்க",2,"Mikka","that prevail/abound"],["கொளல்",2,"Kolal","(one) should accept/take"]]},{"n":505,"l":["பெருமைக்கும் ஏனைச் சிறுமைக்கும் தத்தம்","கருமமே கட்டளைக் கல்."],"w":[["பெருமைக்கும்",1,"Perumaikkum","for greatness; both/and"],["ஏனைச்",1,"Enaich","the other"],["சிறுமைக்கும்",1,"Chirumaikkum","for smallness/meanness; both/and"],["தத்தம்",1,"Thaththam","their own respective"],["கருமமே",2,"Karumame","deed/action; indeed (தேற்றம்)"],["கட்டளைக்",2,"Kattalaik","standard/measuring"],["கல்",2,"Kal","stone (touchstone)"]]},{"n":506,"l":["அற்றாரைத் தேறுதல் ஓம்புக மற்றவர்","பற்றிலர் நாணார் பழி."],"w":[["அற்றாரைத்",1,"Atraaraith","those without (kin)"],["தேறுதல்",1,"Therudhal","trusting"],["ஓம்புக",1,"Ompuka","let one avoid/guard against"],["மற்றவர்",1,"Matravar","moreover (expletive); they/those"],["பற்றிலர்",2,"Patrilar","attachment; they have not (are without)"],["நாணார்",2,"Naanaar","they will not be ashamed"],["பழி",2,"Pazhi","(at) blame/disgrace"]]},{"n":507,"l":["காதன்மை கந்தா அறிவறியார்த் தேறுதல்","பேதைமை எல்லாந் தரும்."],"w":[["காதன்மை",1,"Kaadhanmai","affection/love"],["கந்தா",1,"Kandhaa","support/prop (as basis)"],["அறிவறியார்த்",1,"Arivariyaarth","knowledge; those who do not know"],["தேறுதல்",1,"Therudhal","trusting"],["பேதைமை",2,"Pedhaimai","folly/ignorance"],["எல்லாந்",2,"Ellaan","all"],["தரும்",2,"Tharum","will give/cause"]]},{"n":508,"l":["தேரான் பிறனைத் தெளிந்தான் வழிமுறை","தீரா இடும்பை தரும்."],"w":[["தேரான்",1,"Theraan","one who does not examine"],["பிறனைத்",1,"Piranaith","another/stranger (acc.)"],["தெளிந்தான்",1,"Thelindhaan","one who trusted"],["வழிமுறை",1,"Vazhimurai","(for) lineage/descendants"],["தீரா",2,"Theeraa","unending/that does not end"],["இடும்பை",2,"Itumpai","suffering/grief"],["தரும்",2,"Tharum","will give"]]},{"n":509,"l":["தேறற்க யாரையும் தேராது தேர்ந்தபின்","தேறுக தேறும் பொருள்."],"w":[["தேறற்க",1,"Therarka","let none trust (do not trust)"],["யாரையும்",1,"Yaaraiyum","anyone (whoever); even/at all"],["தேராது",1,"Theraadhu","without examining"],["தேர்ந்தபின்",1,"Therndhapin","having examined; after"],["தேறுக",2,"Theruka","let one be confident/trust"],["தேறும்",2,"Therum","that may be trusted"],["பொருள்",2,"Porul","matter/thing (to trust)"]]},{"n":510,"l":["தேரான் தெளிவும் தெளிந்தான்கண் ஐயுறவும்","தீரா இடும்பை தரும்."],"w":[["தேரான்",1,"Theraan","of one who does not examine"],["தெளிவும்",1,"Thelivum","(the) confidence/decision; and"],["தெளிந்தான்கண்",1,"Thelindhaankan","in/about one who trusted; in/at (locative urupu)"],["ஐயுறவும்",1,"Aiyuravum","(the) doubting; and"],["தீரா",2,"Theeraa","unending"],["இடும்பை",2,"Itumpai","suffering"],["தரும்",2,"Tharum","will give"]]}]}