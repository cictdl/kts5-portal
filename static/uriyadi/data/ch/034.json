{"n":34,"kurals":[{"n":331,"l":["நில்லாத வற்றை நிலையின என்றுணரும்","புல்லறி வாண்மை கடை."],"w":[["நில்லாத",1,"Nillaadha","that do not last"],["வற்றை",1,"Vatrai","those (things), acc."],["நிலையின",1,"Nilaiyina","are permanent (they stand)"],["என்றுணரும்",1,"Endrunarum","saying/thinking thus; that understands"],["புல்லறி",2,"Pullari","base/petty; knowledge"],["வாண்மை",2,"Vaanmai","the quality of having (petty knowledge)"],["கடை",2,"Katai","lowest/basest"]]},{"n":332,"l":["கூத்தாட்டு அவைக்குழாத் தற்றே பெருஞ்செல்வம்","போக்கும் அதுவிளிந் தற்று."],"w":[["கூத்தாட்டு",1,"","dance-performance"],["அவைக்குழாத்",1,"","assembly/hall; in the crowd"],["தற்றே",1,"","is like that; emphatic particle"],["பெருஞ்செல்வம்",1,"","great; wealth"],["போக்கும்",2,"","its passing/loss; too (its loss as well)"],["அதுவிளிந்",2,"","it (that show); having perished/ended"],["தற்று",2,"","is like that"]]},{"n":333,"l":["அற்கா இயல்பிற்றுச் செல்வம் அதுபெற்றால்","அற்குப ஆங்கே செயல்."],"w":[["அற்கா",1,"Arkaa","non-enduring (that does not last)"],["இயல்பிற்றுச்",1,"Iyalpitruch","has (such) a nature"],["செல்வம்",1,"Chelvam","wealth"],["அதுபெற்றால்",1,"Adhupetraal","it (wealth), acc.; if (one) obtains"],["அற்குப",2,"Arkupa","things that will endure"],["ஆங்கே",2,"Aange","there/then; emphatic (right then)"],["செயல்",2,"Seyal","(it is) to be done / doing"]]},{"n":334,"l":["நாளென ஒன்றுபோற் காட்டி உயிர்ஈரும்","வாளது உணர்வார்ப் பெறின்."],"w":[["நாளென",1,"","day; as / saying 'day'"],["ஒன்றுபோற்",1,"","one (a single thing); like"],["காட்டி",1,"","showing"],["உயிர்ஈரும்",1,"","life (acc.); that saws/cuts"],["வாளது",2,"","sword; is (a sword)"],["உணர்வார்ப்",2,"","those who realize (acc.)"],["பெறின்",2,"","if (one) gets/finds"]]},{"n":335,"l":["நாச்செற்று விக்குள்மேல் வாராமுன் நல்வினை","மேற்சென்று செய்யப் படும்"],"w":[["நாச்செற்று",1,"Naachchetru","tongue (acc.); having blocked/stilled"],["விக்குள்மேல்",1,"Vikkulmel","hiccough; upon/over"],["வாராமுன்",1,"Vaaraamun","before (it) comes; before (time)"],["நல்வினை",1,"Nalvinai","good; deed/act"],["மேற்சென்று",2,"Mersendru","forward/upon; going forth"],["செய்யப்",2,"Seyyap","to do"],["படும்",2,"Patum","should be (done) — passive aux."]]},{"n":336,"l":["நெருநல் உளனொருவன் இன்றில்லை என்னும்","பெருமை உடைத்துஇவ் வுலகு."],"w":[["நெருநல்",1,"Nerunal","yesterday"],["உளனொருவன்",1,"Ulanoruvan","was present (he); a certain man"],["இன்றில்லை",1,"Indrillai","today; is not (here) / is gone"],["என்னும்",1,"Ennum","that says (so)"],["பெருமை",2,"Perumai","greatness (here: the trait/state)"],["உடைத்துஇவ்",2,"Utaiththuiv","possesses / has; this"],["வுலகு",2,"Vulaku","the world"]]},{"n":337,"l":["ஒருபொழுதும் வாழ்வது அறியார் கருதுப","கோடியும் அல்ல பல."],"w":[["ஒருபொழுதும்",1,"Orupozhudhum","one; moment/time; even (a single moment)"],["வாழ்வது",1,"Vaazhvadhu","the living / that one lives"],["அறியார்",1,"Ariyaar","(they) do not know"],["கருதுப",1,"Karudhupa","(they) imagine/devise"],["கோடியும்",2,"Kotiyum","crore (ten million); even a crore"],["அல்ல",2,"Alla","are not (merely)"],["பல",2,"Pala","many (things they devise)"]]},{"n":338,"l":["குடம்பை தனித்துஒழியப் புள்பறந் தற்றே","உடம்பொடு உயிரிடை நட்பு."],"w":[["குடம்பை",1,"","egg / nest"],["தனித்துஒழியப்",1,"","being alone; remaining/left behind"],["புள்பறந்",1,"","bird; having flown"],["தற்றே",1,"","is like that; emphatic"],["உடம்பொடு",2,"","with the body"],["உயிரிடை",2,"","life/soul; between"],["நட்பு",2,"","friendship/bond"]]},{"n":339,"l":["உறங்கு வதுபோலுஞ் சாக்காடு உறங்கி","விழிப்பது போலும் பிறப்பு."],"w":[["உறங்கு",1,"Urangu","the sleeping (carried to next sira)"],["வதுபோலுஞ்",1,"Vadhupolunj","(sleep)ing — tail of உறங்கு+வது; is like"],["சாக்காடு",1,"Chaakkaatu","death"],["உறங்கி",1,"Urangi","having slept"],["விழிப்பது",2,"Vizhippadhu","the waking"],["போலும்",2,"Polum","is like"],["பிறப்பு",2,"Pirappu","birth"]]},{"n":340,"l":["புக்கில் அமைந்தின்று கொல்லோ உடம்பினுள்","துச்சில் இருந்த உயிர்க்கு."],"w":[["புக்கில்",1,"Pukkil","abode/dwelling to enter"],["அமைந்தின்று",1,"Amaindhindru","has not been arranged"],["கொல்லோ",1,"Kollo","doubt particle; interrogative/wonder ஓ"],["உடம்பினுள்",1,"Utampinul","within the body"],["துச்சில்",2,"Thuchchil","a cramped corner / temporary shelter"],["இருந்த",2,"Irundha","that dwelt"],["உயிர்க்கு",2,"Uyirkku","for the soul/life"]]}]}