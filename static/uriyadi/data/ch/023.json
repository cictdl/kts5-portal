{"n":23,"kurals":[{"n":221,"l":["வறியார்க்கொன்று ஈவதே ஈகைமற் றெல்லாம்","குறியெதிர்ப்பை நீர துடைத்து."],"w":[["வறியார்க்கொன்று",1,"Variyaarkkondru","to the poor; one (thing)"],["ஈவதே",1,"Eevadhe","that which is given; indeed (emphatic)"],["ஈகைமற்",1,"Eekaimar","charity / giving; and / moreover (the rest)"],["றெல்லாம்",1,"Rellaam","all (the rest)"],["குறியெதிர்ப்பை",2,"Kuriyedhirppai","an expected return / loan transaction"],["நீர",2,"Neera","having the nature of"],["துடைத்து",2,"Thutaiththu","possesses / has"]]},{"n":222,"l":["நல்லாறு எனினும் கொளல்தீது மேலுலகம்","இல்லெனினும் ஈதலே நன்று."],"w":[["நல்லாறு",1,"Nallaaru","good; way / path"],["எனினும்",1,"Eninum","even if (one) says; even (concessive)"],["கொளல்தீது",1,"Kolaldheedhu","receiving / taking; (is) evil"],["மேலுலகம்",1,"Melulakam","upper / high; world / heaven"],["இல்லெனினும்",2,"Illeninum","not (is not); even if (it) is said; even (concessive)"],["ஈதலே",2,"Eedhale","giving; indeed (emphatic)"],["நன்று",2,"Nandru","(is) good"]]},{"n":223,"l":["இலனென்னும் எவ்வம் உரையாமை ஈதல்","குலனுடையான் கண்ணே யுள."],"w":[["இலனென்னும்",1,"Ilanennum","(he is) destitute; that says / so-called"],["எவ்வம்",1,"Evvam","distress / grief"],["உரையாமை",1,"Uraiyaamai","not uttering"],["ஈதல்",1,"Eedhal","giving"],["குலனுடையான்",2,"Kulanutaiyaan","(noble) lineage; one who possesses"],["கண்ணே",2,"Kanne","at / in (locative); alone / indeed"],["யுள",2,"Yula","(they) exist / are present"]]},{"n":224,"l":["இன்னாது இரக்கப் படுதல் இரந்தவர்","இன்முகங் காணும் அளவு."],"w":[["இன்னாது",1,"Innaadhu","(is) painful"],["இரக்கப்",1,"Irakkap","so as to be begged"],["படுதல்",1,"Patudhal","being subjected (to)"],["இரந்தவர்",1,"Irandhavar","those who begged"],["இன்முகங்",2,"Inmukang","pleasant; face"],["காணும்",2,"Kaanum","(until one) sees"],["அளவு",2,"Alavu","extent / until the time"]]},{"n":225,"l":["ஆற்றுவார் ஆற்றல் பசிஆற்றல் அப்பசியை","மாற்றுவார் ஆற்றலின் பின்."],"w":[["ஆற்றுவார்",1,"Aatruvaar","those who are capable (ascetics)"],["ஆற்றல்",1,"Aatral","strength / power"],["பசிஆற்றல்",1,"Pasiaatral","hunger; enduring (hunger)"],["அப்பசியை",1,"Appasiyai","that; that hunger (obj.)"],["மாற்றுவார்",2,"Maatruvaar","those who remove (it)"],["ஆற்றலின்",2,"Aatralin","than (their) power"],["பின்",2,"Pin","after / second to"]]},{"n":226,"l":["அற்றார் அழிபசி தீர்த்தல் அஃதொருவன்","பெற்றான் பொருள்வைப் புழி."],"w":[["அற்றார்",1,"Atraar","those who have nothing (destitute)"],["அழிபசி",1,"Azhipasi","destroying / severe; hunger"],["தீர்த்தல்",1,"Theerththal","removing / relieving"],["அஃதொருவன்",1,"Aqdhoruvan","that; a man / one person"],["பெற்றான்",2,"Petraan","(he who) obtained"],["பொருள்வைப்",2,"Porulvaip","wealth; storing / deposit"],["புழி",2,"Puzhi","place"]]},{"n":227,"l":["பாத்தூண் மரீஇ யவனைப் பசியென்னும்","தீப்பிணி தீண்டல் அரிது."],"w":[["பாத்தூண்",1,"Paaththoon","having shared; food / eating"],["மரீஇ",1,"Mareei","being accustomed to"],["யவனைப்",1,"Yavanaip","him (obj.)"],["பசியென்னும்",1,"Pasiyennum","hunger; called / named"],["தீப்பிணி",2,"Theeppini","evil / cruel; disease"],["தீண்டல்",2,"Theental","touching / afflicting"],["அரிது",2,"Aridhu","(is) rare / difficult"]]},{"n":228,"l":["ஈத்துவக்கும் இன்பம் அறியார்கொல் தாமுடைமை","வைத்திழக்கும் வன்க ணவர்."],"w":[["ஈத்துவக்கும்",1,"Eeththuvakkum","having given; that rejoices"],["இன்பம்",1,"Inpam","joy"],["அறியார்கொல்",1,"Ariyaarkol","do they not know; interrogative/doubt particle"],["தாமுடைமை",1,"Thaamutaimai","they (themselves); possession / wealth"],["வைத்திழக்கும்",2,"Vaiththizhakkum","having kept; that loses"],["வன்க",2,"Vanka","hard / unfeeling; eye (here: heart/nature)"],["ணவர்",2,"Navar","those (people)"]]},{"n":229,"l":["இரத்தலின் இன்னாது மன்ற நிரப்பிய","தாமே தமியர் உணல்."],"w":[["இரத்தலின்",1,"Iraththalin","than begging"],["இன்னாது",1,"Innaadhu","(is) more painful"],["மன்ற",1,"Mandra","certainly (asseverative)"],["நிரப்பிய",1,"Nirappiya","(wealth) amassed to fill (want)"],["தாமே",2,"Thaame","themselves; alone (exclusive)"],["தமியர்",2,"Thamiyar","(being) alone / solitary"],["உணல்",2,"Unal","eating"]]},{"n":230,"l":["சாதலின் இன்னாத தில்லை இனிததூஉம்","ஈதல் இயையாக் கடை."],"w":[["சாதலின்",1,"Saadhalin","than dying"],["இன்னாத",1,"Innaadha","(thing) that is painful"],["தில்லை",1,"Thillai","that (thing); there is none"],["இனிததூஉம்",1,"Inidhadhooum","(is) sweet / pleasant; that too; even / too"],["ஈதல்",2,"Eedhal","giving"],["இயையாக்",2,"Iyaiyaak","not possible / not achievable"],["கடை",2,"Katai","occasion / when (the time)"]]}]}