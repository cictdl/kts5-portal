{"n":5,"kurals":[{"n":41,"l":["இல்வாழ்வான் என்பான் இயல்புடைய மூவர்க்கும்","நல்லாற்றின் நின்ற துணை."],"w":[["இல்வாழ்வான்",1,"Ilvaazhvaan","the householder / one who lives domestic life"],["என்பான்",1,"Enpaan","he who is so called"],["இயல்புடைய",1,"Iyalputaiya","natural quality / virtue; possessing (qualifying மூவர்)"],["மூவர்க்கும்",1,"Moovarkkum","to the three (orders of persons); dative case suffix (to/for); inclusive 'um' (all three)"],["நல்லாற்றின்",2,"Nallaatrin","good; in the (good) way / path; locative case suffix (in/on)"],["நின்ற",2,"Nindra","that stood / abided (qualifying துணை)"],["துணை",2,"Thunai","support / helper"]]},{"n":42,"l":["துறந்தார்க்கும் துவ்வா தவர்க்கும் இறந்தார்க்கும்","இல்வாழ்வான் என்பான் துணை."],"w":[["துறந்தார்க்கும்",1,"Thurandhaarkkum","to those who have renounced (ascetics); dative case suffix; inclusive 'um'"],["துவ்வா",1,"Thuvvaa",""],["தவர்க்கும்",1,"Dhavarkkum",""],["இறந்தார்க்கும்",1,"Irandhaarkkum","to those who have died / passed (the helpless dead); dative case suffix; inclusive 'um'"],["இல்வாழ்வான்",2,"Ilvaazhvaan","the householder"],["என்பான்",2,"Enpaan","he who is so called"],["துணை",2,"Thunai","support / helper"]]},{"n":43,"l":["தென்புலத்தார் தெய்வம் விருந்தொக்கல் தானென்றாங்கு","ஐம்புலத்தாறு ஓம்பல் தலை."],"w":[["தென்புலத்தார்",1,"Thenpulaththaar","those of the southern region (the manes / ancestors)"],["தெய்வம்",1,"Theyvam","the gods / deity"],["விருந்தொக்கல்",1,"Virundhokkal","guests; kinsfolk / relatives"],["தானென்றாங்கு",1,"Thaanendraangu","oneself; saying / namely (quotative); thus / there (expletive)"],["ஐம்புலத்தாறு",2,"Aimpulaththaaru","five; field / domain; way / duty (the fivefold dharma)"],["ஓம்பல்",2,"Ompal","cherishing / protecting"],["தலை",2,"Thalai","the foremost / chief (duty)"]]},{"n":44,"l":["பழியஞ்சிப் பாத்தூண் உடைத்தாயின் வாழ்க்கை","வழியெஞ்சல் எஞ்ஞான்றும் இல்."],"w":[["பழியஞ்சிப்",1,"Pazhiyanjip","blame / sin; fearing"],["பாத்தூண்",1,"Paaththoon","having shared / dividing; eating / food"],["உடைத்தாயின்",1,"Utaiththaayin","possesses / is endowed with; if (it) be"],["வாழ்க்கை",1,"Vaazhkkai","life / living"],["வழியெஞ்சல்",2,"Vazhiyenjal","lineage / continuity; diminishing / decaying"],["எஞ்ஞான்றும்",2,"Egngnaandrum","any time / ever; ever (with negation: never)"],["இல்",2,"Il","is not / there is no"]]},{"n":45,"l":["அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை","பண்பும் பயனும் அது."],"w":[["அன்பும்",1,"Anpum","love; and (conjunctive)"],["அறனும்",1,"Aranum","virtue / dharma; and (conjunctive)"],["உடைத்தாயின்",1,"Utaiththaayin","possesses / is endowed with; if (it) be"],["இல்வாழ்க்கை",1,"Ilvaazhkkai","home / household; domestic life"],["பண்பும்",2,"Panpum","good quality / nature; and (conjunctive)"],["பயனும்",2,"Payanum","benefit / fruit; and (conjunctive)"],["அது",2,"Adhu","that (very thing)"]]},{"n":46,"l":["அறத்தாற்றின் இல்வாழ்க்கை ஆற்றின் புறத்தாற்றில்","போஒய்ப் பெறுவ தெவன்?"],"w":[["அறத்தாற்றின்",1,"Araththaatrin","of virtue; in the path (of virtue); locative case suffix"],["இல்வாழ்க்கை",1,"Ilvaazhkkai","home / household; domestic life"],["ஆற்றின்",1,"Aatrin","having conducted / if one fares"],["புறத்தாற்றில்",1,"Puraththaatril","outer / external; in the (other) path; locative case suffix"],["போஒய்ப்",2,"Pooip","having gone"],["பெறுவ",2,"Peruva","that which is obtained"],["தெவன்",2,"Thevan","what? (interrogative)"]]},{"n":47,"l":["இயல்பினான் இல்வாழ்க்கை வாழ்பவன் என்பான்","முயல்வாருள் எல்லாம் தலை."],"w":[["இயல்பினான்",1,"Iyalpinaan","(by) the natural way / proper character; euphonic glide (சாரியை); instrumental case suffix"],["இல்வாழ்க்கை",1,"Ilvaazhkkai","home / household; domestic life"],["வாழ்பவன்",1,"Vaazhpavan","he who lives"],["என்பான்",1,"Enpaan","he who is so called"],["முயல்வாருள்",2,"Muyalvaarul","among those who strive; locative 'among/in'"],["எல்லாம்",2,"Ellaam","all"],["தலை",2,"Thalai","the foremost / chief"]]},{"n":48,"l":["ஆற்றின் ஒழுக்கி அறனிழுக்கா இல்வாழ்க்கை","நோற்பாரின் நோன்மை உடைத்து."],"w":[["ஆற்றின்",1,"Aatrin","in the (right) way; locative case suffix"],["ஒழுக்கி",1,"Ozhukki","having led / made (others) conduct"],["அறனிழுக்கா",1,"Aranizhukkaa","virtue; not swerving from / not failing"],["இல்வாழ்க்கை",1,"Ilvaazhkkai","home / household; domestic life"],["நோற்பாரின்",2,"Norpaarin","than those who do penance (ascetics); ablative/comparative 'than'"],["நோன்மை",2,"Nonmai","strength of austerity / endurance"],["உடைத்து",2,"Utaiththu","possesses / is endowed with"]]},{"n":49,"l":["அறனெனப் பட்டதே இல்வாழ்க்கை அஃதும்","பிறன்பழிப்ப தில்லாயின் நன்று."],"w":[["அறனெனப்",1,"","virtue / dharma; as (saying) / called"],["பட்டதே",1,"","that which is (so) called/esteemed; emphatic 'ē' (it alone)"],["இல்வாழ்க்கை",1,"","home / household; domestic life"],["அஃதும்",1,"","that (too); even / also"],["பிறன்பழிப்ப",2,"","another (person); (that which) another blames"],["தில்லாயின்",2,"","that (resumptive 't-', சந்திச் சிதைவு of பழிப்பது-வின் 'து'); if there be not (no blame)"],["நன்று",2,"","(it) is good"]]},{"n":50,"l":["வையத்துள் வாழ்வாங்கு வாழ்பவன் வான்உறையும்","தெய்வத்துள் வைக்கப் படும்."],"w":[["வையத்துள்",1,"Vaiyaththul","in the world; locative 'within/in'"],["வாழ்வாங்கு",1,"Vaazhvaangu","(the proper) living; as / in the manner that"],["வாழ்பவன்",1,"Vaazhpavan","he who lives"],["வான்உறையும்",1,"Vaanuraiyum","(in) the sky / heaven; that dwell (qualifying தெய்வம்)"],["தெய்வத்துள்",2,"Theyvaththul","among the gods; locative 'among/in'"],["வைக்கப்",2,"Vaikkap","to be placed / esteemed (infinitive)"],["படும்",2,"Patum","will be (counted) — passive auxiliary"]]}]}