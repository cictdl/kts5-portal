{"n":113,"kurals":[{"n":1121,"l":["பாலொடு தேன்கலந் தற்றே பணிமொழி","வாலெயிறு ஊறிய நீர்."],"w":[["பாலொடு",1,"Paalotu","milk; with (3rd case suffix)"],["தேன்கலந்",1,"Thenkalan","honey (object); having mixed"],["தற்றே",1,"Thatre","of that nature (so); emphatic/expletive particle"],["பணிமொழி",1,"Panimozhi","soft/humble (quality); she of soft speech (=the woman)"],["வாலெயிறு",2,"Vaaleyiru","white (purity); teeth (in/of the teeth)"],["ஊறிய",2,"Ooriya","which oozed/welled up"],["நீர்",2,"Neer","water/dew (here saliva)"]]},{"n":1122,"l":["உடம்பொடு உயிரிடை என்னமற் றன்ன","மடந்தையொடு எம்மிடை நட்பு."],"w":[["உடம்பொடு",1,"Utampotu","body; with"],["உயிரிடை",1,"Uyiritai","soul/life; between/in-between"],["என்னமற்",1,"Ennamar","what kind (whatever the nature); expletive particle"],["றன்ன",1,"Ranna","of that same nature (such)"],["மடந்தையொடு",2,"Matandhaiyotu","the young woman; with"],["எம்மிடை",2,"Emmitai","us/our (between us); between"],["நட்பு",2,"Natpu","friendship/bond"]]},{"n":1123,"l":["கருமணியிற் பாவாய்நீ போதாயாம் வீழும்","திருநுதற்கு இல்லை இடம்."],"w":[["கருமணியிற்",1,"Karumaniyir","black/dark; pupil/gem (locative: in); in (locative)"],["பாவாய்நீ",1,"Paavaainee","O image/doll! (vocative); you"],["போதாயாம்",1,"Podhaayaam","depart! / go away (you); we/I"],["வீழும்",1,"Veezhum","(whom we) love/desire"],["திருநுதற்கு",2,"Thirunudharku","beautiful/sacred; fair-browed one (forehead, =the woman); for/to (dative)"],["இல்லை",2,"Illai","is not / there is no"],["இடம்",2,"Itam","room/place"]]},{"n":1124,"l":["வாழ்தல் உயிர்க்கன்னள் ஆயிழை சாதல்","அதற்கன்னள் நீங்கும் இடத்து."],"w":[["வாழ்தல்",1,"Vaazhdhal","living/life"],["உயிர்க்கன்னள்",1,"Uyirkkannal","to/for the soul; to/for (dative); she is such/like (that)"],["ஆயிழை",1,"Aayizhai","chosen/selected; she of choice jewels (=the woman)"],["சாதல்",1,"Saadhal","dying/death"],["அதற்கன்னள்",2,"Adharkannal","to that (death); to/for; she is like (that)"],["நீங்கும்",2,"Neengum","(at the time of) parting"],["இடத்து",2,"Itaththu","at the moment/place (when)"]]},{"n":1125,"l":["உள்ளுவன் மன்யான் மறப்பின் மறப்பறியேன்","ஒள்ளமர்க் கண்ணாள் குணம்."],"w":[["உள்ளுவன்",1,"Ulluvan","I would recall/think of"],["மன்யான்",1,"Manyaan","expletive (here: contrary/wishful sense); I"],["மறப்பின்",1,"Marappin","if (I) forget"],["மறப்பறியேன்",1,"Marappariyen","forgetting; I know not (I never forget)"],["ஒள்ளமர்க்",2,"Ollamark","bright/lustrous; battle/conflict (of eyes)"],["கண்ணாள்",2,"Kannaal","she with (such) eyes"],["குணம்",2,"Kunam","qualities/charms (object)"]]},{"n":1126,"l":["கண்ணுள்ளின் போகார் இமைப்பின் பருவரார்","நுண்ணியர்எம் காத லவர்."],"w":[["கண்ணுள்ளின்",1,"Kannullin","eye; within/inside; from (ablative)"],["போகார்",1,"Pokaar","(they) do not go/leave"],["இமைப்பின்",1,"Imaippin","if (eyes) blink/close"],["பருவரார்",1,"Paruvaraar","(they) are not pained / do not suffer"],["நுண்ணியர்எம்",2,"Nunniyarem","(they) are subtle ones; our/my"],["காத",2,"Kaadha","love (part of காதலவர்)"],["லவர்",2,"Lavar","the loved one (=my lover, honorific plural)"]]},{"n":1127,"l":["கண்ணுள்ளார் காத லவராகக் கண்ணும்","எழுதேம் கரப்பாக்கு அறிந்து."],"w":[["கண்ணுள்ளார்",1,"Kannullaar","eye; (he who) is within (the eye)"],["காத",1,"Kaadha","love (part of காதலவர்)"],["லவராகக்",1,"Lavaraakak","the loved one (=my lover); being / since (he) is"],["கண்ணும்",1,"Kannum","eye (even/also the eye); even/also (emphatic)"],["எழுதேம்",2,"Ezhudhem","we will not paint/draw (collyrium)"],["கரப்பாக்கு",2,"Karappaakku","(his) hiding/concealment"],["அறிந்து",2,"Arindhu","knowing/having known"]]},{"n":1128,"l":["நெஞ்சத்தார் காத லவராக வெய்துண்டல்","அஞ்சுதும் வேபாக் கறிந்து."],"w":[["நெஞ்சத்தார்",1,"Nenjaththaar","heart (in the heart); (he who) dwells (=lover)"],["காத",1,"Kaadha","love (part of காதலவர்)"],["லவராக",1,"Lavaraaka","the loved one (=my lover); being / since (he) is"],["வெய்துண்டல்",1,"Veydhuntal","hot (thing); eating"],["அஞ்சுதும்",2,"Anjudhum","we fear"],["வேபாக்",2,"Vepaak","(his) getting burnt/scorched"],["கறிந்து",2,"Karindhu","knowing/having known"]]},{"n":1129,"l":["இமைப்பின் கரப்பாக்கு அறிவல் அனைத்திற்கே","ஏதிலர் என்னும்இவ் வூர்."],"w":[["இமைப்பின்",1,"","if (eyes) blink"],["கரப்பாக்கு",1,"","(his) hiding/concealment"],["அறிவல்",1,"","I know/realize"],["அனைத்திற்கே",1,"","for just that much; for/to; emphatic ஏ (only/even)"],["ஏதிலர்",2,"","(he is) a stranger / loveless one"],["என்னும்இவ்",2,"",""],["வூர்",2,"","the town(s-folk)"]]},{"n":1130,"l":["உவந்துறைவர் உள்ளத்துள் என்றும் இகந்துறைவர்","ஏதிலர் என்னும்இவ் வூர்."],"w":[["உவந்துறைவர்",1,"","rejoicing/being glad; (he) dwells"],["உள்ளத்துள்",1,"","heart/mind; within (in the heart)"],["என்றும்",1,"","always/ever; ever (inclusive உம்)"],["இகந்துறைவர்",1,"","departing/being apart; (they say he) dwells apart"],["ஏதிலர்",2,"","(he is) loveless/stranger"],["என்னும்இவ்",2,"",""],["வூர்",2,"","the townsfolk"]]}]}