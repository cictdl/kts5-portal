{"n":57,"kurals":[{"n":561,"l":["தக்காங்கு நாடித் தலைச்செல்லா வண்ணத்தால்","ஒத்தாங்கு ஒறுப்பது வேந்து."],"w":[["தக்காங்கு",1,"Thakkaangu","fittingly/duly"],["நாடித்",1,"Naatith","having examined/investigated"],["தலைச்செல்லா",1,"Thalaichchellaa","not recurring/not advancing again"],["வண்ணத்தால்",1,"Vannaththaal","in the manner/way that"],["ஒத்தாங்கு",2,"Oththaangu","befittingly/proportionately"],["ஒறுப்பது",2,"Oruppadhu","the act of/that which punishes"],["வேந்து",2,"Vendhu","king/sovereign"]]},{"n":562,"l":["கடிதோச்சி மெல்ல எறிக நெடிதாக்கம்","நீங்காமை வேண்டு பவர்."],"w":[["கடிதோச்சி",1,"Katidhochchi","swiftly/sharply; having raised/wielded"],["மெல்ல",1,"Mella","softly/gently"],["எறிக",1,"Erika","let (him) strike/lay (it) down gently"],["நெடிதாக்கம்",1,"Netidhaakkam","long (in time); prosperity/gain"],["நீங்காமை",2,"Neengaamai","not departing/remaining"],["வேண்டு",2,"Ventu","those who desire (head of வேண்டுபவர்)"],["பவர்",2,"Pavar","tail of வேண்டுபவர் = 'those who'"]]},{"n":563,"l":["வெருவந்த செய்தொழுகும் வெங்கோல னாயின்","ஒருவந்தம் ஒல்லைக் கெடும்."],"w":[["வெருவந்த",1,"Veruvandha","(deeds) that cause fear"],["செய்தொழுகும்",1,"Seydhozhukum","having done; who conducts/lives (acting thus)"],["வெங்கோல",1,"Vengola","tyrant/cruel-sceptred one"],["னாயின்",1,"Naayin","if (he) be"],["ஒருவந்தம்",2,"Oruvandham","certainly/assuredly"],["ஒல்லைக்",2,"Ollaik","quickly/soon"],["கெடும்",2,"Ketum","will perish/be ruined"]]},{"n":564,"l":["இறைகடியன் என்றுரைக்கும் இன்னாச்சொல் வேந்தன்","உறைகடுகி ஒல்லைக் கெடும்."],"w":[["இறைகடியன்",1,"Iraikatiyan","king/sovereign; is harsh/cruel"],["என்றுரைக்கும்",1,"Endruraikkum","saying that/thus; that is uttered"],["இன்னாச்சொல்",1,"Innaachchol","harsh/painful; word"],["வேந்தன்",1,"Vendhan","king"],["உறைகடுகி",2,"Uraikatuki","lifespan/period of dwelling; having hastened/shortened"],["ஒல்லைக்",2,"Ollaik","quickly/soon"],["கெடும்",2,"Ketum","will perish"]]},{"n":565,"l":["அருஞ்செவ்வி இன்னா முகத்தான் பெருஞ்செல்வம்","பேஎய்கண் டன்னது உடைத்து."],"w":[["அருஞ்செவ்வி",1,"Arunjevvi","rare/hard (to get); opportune time/access"],["இன்னா",1,"Innaa","unpleasant/sour"],["முகத்தான்",1,"Mukaththaan","he of (the sour) face"],["பெருஞ்செல்வம்",1,"Perunjelvam","great/large; wealth"],["பேஎய்கண்",2,"Peeykan","ghost/ghoul; having seen/possessed"],["டன்னது",2,"Tannadhu","that which is like (it)"],["உடைத்து",2,"Utaiththu","it has/possesses (that nature)"]]},{"n":566,"l":["கடுஞ்சொல்லன் கண்ணிலன் ஆயின் நெடுஞ்செல்வம்","நீடின்றி ஆங்கே கெடும்."],"w":[["கடுஞ்சொல்லன்",1,"Katunjollan","harsh-tongued one"],["கண்ணிலன்",1,"Kannilan","is graceless/lacks kindly look"],["ஆயின்",1,"Aayin","if (he) be"],["நெடுஞ்செல்வம்",1,"Netunjelvam","great/long-lasting; wealth"],["நீடின்றி",2,"Neetindri","lasting/endurance; without"],["ஆங்கே",2,"Aange","there/then itself; emphatic ē (right there/then)"],["கெடும்",2,"Ketum","will perish"]]},{"n":567,"l":["கடுமொழியும் கையிகந்த தண்டமும் வேந்தன்","அடுமுரண் தேய்க்கும் அரம்."],"w":[["கடுமொழியும்",1,"Katumozhiyum","harsh speech; and (enumerative um)"],["கையிகந்த",1,"Kaiyikandha","measure/limit; that exceeded (the limit)"],["தண்டமும்",1,"Thantamum","punishment; and (enumerative um)"],["வேந்தன்",1,"Vendhan","(of the) king"],["அடுமுரண்",2,"Atumuran","killing/conquering; (victorious) strength/might"],["தேய்க்கும்",2,"Theykkum","that wears down/files away"],["அரம்",2,"Aram","file (tool)"]]},{"n":568,"l":["இனத்தாற்றி எண்ணாத வேந்தன் சினத்தாற்றிச்","சீறிற் சிறுகும் திரு."],"w":[["இனத்தாற்றி",1,"Inaththaatri","(with/among his) kin-circle; having conducted/consulted"],["எண்ணாத",1,"Ennaadha","who does not deliberate"],["வேந்தன்",1,"Vendhan","king"],["சினத்தாற்றிச்",1,"Sinaththaatrich","(in/by) anger; having let (himself) go (in anger)"],["சீறிற்",2,"Cheerir","if (he) rages"],["சிறுகும்",2,"Sirukum","will diminish/shrink"],["திரு",2,"Thiru","wealth/fortune"]]},{"n":569,"l":["செருவந்த போழ்திற் சிறைசெய்யா வேந்தன்","வெருவந்து வெய்து கெடும்."],"w":[["செருவந்த",1,"Seruvandha","war/battle; that has come"],["போழ்திற்",1,"Pozhdhir","at the time (of war)"],["சிறைசெய்யா",1,"Siraiseyyaa","fortification/defence; who has not made"],["வேந்தன்",1,"Vendhan","king"],["வெருவந்து",2,"Veruvandhu","having become afraid"],["வெய்து",2,"Veydhu","quickly/swiftly"],["கெடும்",2,"Ketum","will perish"]]},{"n":570,"l":["கல்லார்ப் பிணிக்கும் கடுங்கோல் அதுவல்லது","இல்லை நிலக்குப் பொறை."],"w":[["கல்லார்ப்",1,"Kallaarp","the unlearned (obj.)"],["பிணிக்கும்",1,"Pinikkum","that binds/attaches (to itself)"],["கடுங்கோல்",1,"Katungol","tyranny/cruel rule (cruel sceptre)"],["அதுவல்லது",1,"Adhuvalladhu","that; other than/except"],["இல்லை",2,"Illai","there is not"],["நிலக்குப்",2,"Nilakkup","for the earth"],["பொறை",2,"Porai","burden/load"]]}]}