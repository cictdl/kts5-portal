{"n":25,"kurals":[{"n":241,"l":["அருட்செல்வம் செல்வத்துள் செல்வம் பொருட்செல்வம்","பூரியார் கண்ணும் உள."],"w":[["அருட்செல்வம்",1,"Arutchelvam","grace; wealth"],["செல்வத்துள்",1,"Selvaththul","wealth (oblique stem); within / among"],["செல்வம்",1,"Selvam","the wealth"],["பொருட்செல்வம்",1,"Porutchelvam","material thing; wealth"],["பூரியார்",2,"Pooriyaar","base / mean people"],["கண்ணும்",2,"Kannum","at / in; even (concessive)"],["உள",2,"Ula","they exist"]]},{"n":242,"l":["நல்லாற்றால் நாடி அருளாள்க பல்லாற்றால்","தேரினும் அஃதே துணை."],"w":[["நல்லாற்றால்",1,"Nallaatraal","good; by the way / path"],["நாடி",1,"Naati","having sought / examined"],["அருளாள்க",1,"Arulaalka","let (one) bear grace"],["பல்லாற்றால்",1,"Pallaatraal","many; by ways / means"],["தேரினும்",2,"Therinum","though examining; even though"],["அஃதே",2,"Aqdhe","that (grace); indeed (emphatic / தேற்றம்)"],["துணை",2,"Thunai","support / aid"]]},{"n":243,"l":["அருள்சேர்ந்த நெஞ்சினார்க் கில்லை இருள்சேர்ந்த","இன்னா உலகம் புகல்."],"w":[["அருள்சேர்ந்த",1,"Arulserndha","grace; that has joined"],["நெஞ்சினார்க்",1,"Nenjinaark","to those of (such) heart"],["கில்லை",1,"Killai","there is no / is not"],["இருள்சேர்ந்த",1,"Irulserndha","darkness (ignorance); that is joined with"],["இன்னா",2,"Innaa","painful / grievous"],["உலகம்",2,"Ulakam","world"],["புகல்",2,"Pukal","entering / resort"]]},{"n":244,"l":["மன்னுயிர் ஓம்பி அருளாள்வார்க்கு இல்லென்ப","தன்னுயிர் அஞ்சும் வினை."],"w":[["மன்னுயிர்",1,"Mannuyir","lasting / abiding (which abides); life / beings"],["ஓம்பி",1,"Ompi","having protected"],["அருளாள்வார்க்கு",1,"Arulaalvaarkku","grace; to those who wield (grace)"],["இல்லென்ப",1,"Illenpa","not / absent; they say"],["தன்னுயிர்",2,"Thannuyir","one's own; life"],["அஞ்சும்",2,"Anjum","(which) fears"],["வினை",2,"Vinai","(evil) deed"]]},{"n":245,"l":["அல்லல் அருளாள்வார்க்கு இல்லை வளிவழங்கும்","மல்லன்மா ஞாலங் கரி."],"w":[["அல்லல்",1,"Allal","sorrow / distress"],["அருளாள்வார்க்கு",1,"Arulaalvaarkku","grace; to those who wield (grace)"],["இல்லை",1,"Illai","there is none"],["வளிவழங்கும்",1,"Valivazhangum","wind; (in which) moves"],["மல்லன்மா",2,"Mallanmaa","fertile / abundant; great / large"],["ஞாலங்",2,"Gnaalang","world / earth"],["கரி",2,"Kari","witness"]]},{"n":246,"l":["பொருள்நீங்கிப் பொச்சாந்தார் என்பர் அருள்நீங்கி","அல்லவை செய்தொழுகு வார்."],"w":[["பொருள்நீங்கிப்",1,"Porulneengip","from wealth / virtue; having departed"],["பொச்சாந்தார்",1,"Pochchaandhaar","those who forgot"],["என்பர்",1,"Enpar","they say"],["அருள்நீங்கி",1,"Arulneengi","from grace; having departed"],["அல்லவை",2,"Allavai","non-virtuous things"],["செய்தொழுகு",2,"Seydhozhuku","having done; conducting (life)"],["வார்",2,"Vaar","those who (live thus)"]]},{"n":247,"l":["அருளில்லார்க்கு அவ்வுலகம் இல்லை பொருளில்லார்க்கு","இவ்வுலகம் இல்லாகி யாங்கு."],"w":[["அருளில்லார்க்கு",1,"Arulillaarkku","grace; to those without (grace)"],["அவ்வுலகம்",1,"Avvulakam","that (yonder); world (next)"],["இல்லை",1,"Illai","there is none"],["பொருளில்லார்க்கு",1,"Porulillaarkku","wealth; to those without (wealth)"],["இவ்வுலகம்",2,"Ivvulakam","this (here); world (this)"],["இல்லாகி",2,"Illaaki","having become non-existent"],["யாங்கு",2,"Yaangu","as / in the manner that"]]},{"n":248,"l":["பொருளற்றார் பூப்பர் ஒருகால் அருளற்றார்","அற்றார்மற் றாதல் அரிது."],"w":[["பொருளற்றார்",1,"Porulatraar","wealth; those bereft (of wealth)"],["பூப்பர்",1,"Pooppar","will flourish / bloom"],["ஒருகால்",1,"Orukaal","one; time / occasion"],["அருளற்றார்",1,"Arulatraar","grace; those bereft (of grace)"],["அற்றார்மற்",2,"Atraarmar","(those) bereft are bereft indeed; (expletive / emphatic)"],["றாதல்",2,"Raadhal","becoming (graceful again)"],["அரிது",2,"Aridhu","is difficult / rare"]]},{"n":249,"l":["தெருளாதான் மெய்ப்பொருள் கண்டற்றால் தேரின்","அருளாதான் செய்யும் அறம்."],"w":[["தெருளாதான்",1,"Therulaadhaan","one who is not clear-minded"],["மெய்ப்பொருள்",1,"Meypporul","true; essential truth / meaning"],["கண்டற்றால்",1,"Kantatraal","like having seen; (expletive)"],["தேரின்",1,"Therin","if one examines"],["அருளாதான்",2,"Arulaadhaan","one who shows no grace"],["செய்யும்",2,"Seyyum","(the virtue) he does"],["அறம்",2,"Aram","virtue / righteousness"]]},{"n":250,"l":["வலியார்முன் தன்னை நினைக்கதான் தன்னின்","மெலியார்மேல் செல்லு மிடத்து."],"w":[["வலியார்முன்",1,"","the strong; before / in front of"],["தன்னை",1,"","oneself (acc.)"],["நினைக்கதான்",1,"","let (one) reflect / one should reflect; (emphatic expletive)"],["தன்னின்",1,"","than oneself"],["மெலியார்மேல்",2,"","the weak; upon / against"],["செல்லு",2,"","(when) going"],["மிடத்து",2,"","at the time / place (when)"]]}]}