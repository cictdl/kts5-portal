{"n":94,"kurals":[{"n":931,"l":["வேண்டற்க வென்றிடினும் சூதினை வென்றதூஉம்","தூண்டிற்பொன் மீன்விழுங்கி அற்று."],"w":[["வேண்டற்க",1,"Ventarka","do not desire"],["வென்றிடினும்",1,"Vendritinum","even if (one) wins"],["சூதினை",1,"Soodhinai","gambling (acc.)"],["வென்றதூஉம்",1,"Vendradhooum","that which was won; even (emphatic)"],["தூண்டிற்பொன்",2,"Thoontirpon","fishing-hook's; iron (of the hook)"],["மீன்விழுங்கி",2,"Meenvizhungi","fish (obj.); having swallowed"],["அற்று",2,"Atru","is of that nature (simile)"]]},{"n":932,"l":["ஒன்றெய்தி நூறிழக்கும் சூதர்க்கும் உண்டாங்கொல்","நன்றெய்தி வாழ்வதோர் ஆறு."],"w":[["ஒன்றெய்தி",1,"Ondreydhi","one (obj.); having gained"],["நூறிழக்கும்",1,"Noorizhakkum","hundred (obj.); who lose"],["சூதர்க்கும்",1,"Soodharkkum","for gamblers (dat.); even (for)"],["உண்டாங்கொல்",1,"Untaangol","there is; expletive; doubt particle (would it be?)"],["நன்றெய்தி",2,"Nandreydhi","good (obj.); having attained"],["வாழ்வதோர்",2,"Vaazhvadhor","that by which (one) lives; a / one"],["ஆறு",2,"Aaru","way / path"]]},{"n":933,"l":["உருளாயம் ஓவாது கூறின் பொருளாயம்","போஒய்ப் புறமே படும்."],"w":[["உருளாயம்",1,"Urulaayam","rolling die; gains (from dice)"],["ஓவாது",1,"Ovaadhu","without ceasing"],["கூறின்",1,"Koorin","if (one) talks of / reckons"],["பொருளாயம்",1,"Porulaayam","wealth; income"],["போஒய்ப்",2,"Pooip","having gone"],["புறமே",2,"Purame","to the outside/foe; emphatic ē"],["படும்",2,"Patum","will fall/settle"]]},{"n":934,"l":["சிறுமை பலசெய்து சீரழிக்கும் சூதின்","வறுமை தருவதொன்று இல்."],"w":[["சிறுமை",1,"Sirumai","afflictions / meanness"],["பலசெய்து",1,"Palaseydhu","many; having caused"],["சீரழிக்கும்",1,"Seerazhikkum","fame (obj.); which destroys"],["சூதின்",1,"Soodhin","like gambling (compar.)"],["வறுமை",2,"Varumai","poverty (obj.)"],["தருவதொன்று",2,"Tharuvadhondru","that which gives; one (thing)"],["இல்",2,"Il","is not / there is none"]]},{"n":935,"l":["கவறும் கழகமும் கையும் தருக்கி","இவறியார் இல்லாகி யார்."],"w":[["கவறும்",1,"Kavarum","dice / gambling; and"],["கழ