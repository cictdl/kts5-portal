{"n":82,"kurals":[{"n":811,"l":["பருகுவார் போலினும் பண்பிலார் கேண்மை","பெருகலிற் குன்றல் இனிது."],"w":[["பருகுவார்",1,"Parukuvaar","those who drink/swallow"],["போலினும்",1,"Polinum","though (they seem) like"],["பண்பிலார்",1,"Panpilaar","those without good qualities"],["கேண்மை",1,"Kenmai","friendship"],["பெருகலிற்",2,"Perukalir","than growing/increasing"],["குன்றல்",2,"Kundral","waning/diminishing"],["இனிது",2,"Inidhu","is good/pleasant"]]},{"n":812,"l":["உறின்நட்டு அறினொரூஉம் ஒப்பிலார் கேண்மை","பெறினும் இழப்பினும் என்?"],"w":[["உறின்நட்டு",1,"Urinnattu","if (benefit) accrues; having befriended"],["அறினொரூஉம்",1,"Arinoruum","if (it) is cut off / ceases; departing/separating"],["ஒப்பிலார்",1,"Oppilaar","those without equal/worthiness"],["கேண்மை",1,"Kenmai","friendship (obj.)"],["பெறினும்",2,"Perinum","even if (one) gains"],["இழப்பினும்",2,"Izhappinum","even if (one) loses"],["என்",2,"En","what (use)?"]]},{"n":813,"l":["உறுவது சீர்தூக்கும் நட்பும் பெறுவது","கொள்வாரும் கள்வரும் நேர்."],"w":[["உறுவது",1,"Uruvadhu","that which accrues/benefit"],["சீர்தூக்கும்",1,"Seerdhookkum","weight/measure (obj.); that weighs/measures"],["நட்பும்",1,"Natpum","friendship; also (conjunctive)"],["பெறுவது",1,"Peruvadhu","that which is got (the gain)"],["கொள்வாரும்",2,"Kolvaarum","those who take (whores); and (correlative)"],["கள்வரும்",2,"Kalvarum","thieves; and (correlative)"],["நேர்",2,"Ner","are equal/alike"]]},{"n":814,"l":["அமரகத்து ஆற்றறுக்கும் கல்லாமா அன்னார்","தமரின் தனிமை தலை."],"w":[["அமரகத்து",1,"Amarakaththu","in the battlefield"],["ஆற்றறுக்கும்",1,"Aatrarukkum","the way/means (obj.); that cuts off (the means)"],["கல்லாமா",1,"Kallaamaa","untrained/unlearned; horse/animal"],["அன்னார்",1,"Annaar","those who are like (such)"],["தமரின்",2,"Thamarin","than kin/relations"],["தனிமை",2,"Thanimai","solitude/being alone"],["தலை",2,"Thalai","is foremost/best"]]},{"n":815,"l":["செய்தேமஞ் சாராச் சிறியவர் புன்கேண்மை","எய்தலின் எய்தாமை நன்று."],"w":[["செய்தேமஞ்",1,"Seydhemanj","having made/done; protection/safeguard"],["சாராச்",1,"Chaaraach","(safety) that does not result/cling"],["சிறியவர்",1,"Chiriyavar","low/mean people"],["புன்கேண்மை",1,"Punkenmai","base/petty; friendship"],["எய்தலின்",2,"Eydhalin","than attaining"],["எய்தாமை",2,"Eydhaamai","not attaining"],["நன்று",2,"Nandru","is good"]]},{"n":816,"l":["பேதை பெருங்கெழீஇ நட்பின் அறிவுடையார்","ஏதின்மை கோடி உறும்."],"w":[["பேதை",1,"Pedhai","fool('s)"],["பெருங்கெழீஇ",1,"Perungezheei","great/close; being intimate/united"],["நட்பின்",1,"Natpin","than friendship"],["அறிவுடையார்",1,"Arivutaiyaar","the wise ('s)"],["ஏதின்மை",2,"Edhinmai","enmity/estrangement"],["கோடி",2,"Koti","crore (ten million)"],["உறும்",2,"Urum","will accrue/be (better)"]]},{"n":817,"l":["நகைவகைய ராகிய நட்பின் பகைவரால்","பத்தடுத்த கோடி உறும்."],"w":[["நகைவகைய",1,"Nakaivakaiya","of the laughing kind"],["ராகிய",1,"Raakiya","who are/being"],["நட்பின்",1,"Natpin","than the friendship"],["பகைவரால்",1,"Pakaivaraal","by/from enemies"],["பத்தடுத்த",2,"Paththatuththa","ten; multiplied/added (tenfold)"],["கோடி",2,"Koti","crore"],["உறும்",2,"Urum","will accrue/be (better)"]]},{"n":818,"l":["ஒல்லும் கருமம் உடற்று பவர்கேண்மை","சொல்லாடார் சோர விடல்."],"w":[["ஒல்லும்",1,"Ollum","that is possible/feasible"],["கருமம்",1,"Karumam","deed/task (obj.)"],["உடற்று",1,"Utatru","spoiling/obstructing"],["பவர்கேண்மை",1,"Pavarkenmai","those who (do); friendship (obj.)"],["சொல்லாடார்",2,"Sollaataar","they do not speak / without speaking"],["சோர",2,"Sora","so as to slacken/loosen"],["விடல்",2,"Vital","should let go / abandon"]]},{"n":819,"l":["கனவினும் இன்னாது மன்னோ வினைவேறு","சொல்வேறு பட்டார் தொடர்பு."],"w":[["கனவினும்",1,"Kanavinum","even in dream (loc.); even (இழிவுசிறப்பு)"],["இன்னாது",1,"Innaadhu","is painful/bad"],["மன்னோ",1,"Manno","(expletive, emphasis); (emphatic/pity ஓ)"],["வினைவேறு",1,"Vinaiveru","deed; different/apart"],["சொல்வேறு",2,"Solveru","word/speech; different/apart"],["பட்டார்",2,"Pattaar","those who became (differ)"],["தொடர்பு",2,"Thotarpu","connection/friendship"]]},{"n":820,"l":["எனைத்தும் குறுகுதல் ஓம்பல் மனைக்கெழீஇ","மன்றில் பழிப்பார் தொடர்பு."],"w":[["எனைத்தும்",1,"Enaiththum","however much / any extent; even (any whatsoever)"],["குறுகுதல்",1,"Kurukudhal","approaching/drawing near (obj.)"],["ஓம்பல்",1,"Ompal","should guard against / avoid"],["மனைக்கெழீஇ",1,"Manaikkezheei","at/to the house; being intimate (at home)"],["மன்றில்",2,"Mandril","in the public assembly"],["பழிப்பார்",2,"Pazhippaar","those who revile"],["தொடர்பு",2,"Thotarpu","connection/friendship (obj.)"]]}]}