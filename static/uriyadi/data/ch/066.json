{"n":66,"kurals":[{"n":651,"l":["துணைநலம் ஆக்கம் தரூஉம் வினைநலம்","வேண்டிய எல்லாந் தரும்."],"w":[["துணைநலம்",1,"Thunainalam","help/ally; goodness/benefit"],["ஆக்கம்",1,"Aakkam","prosperity/gain"],["தரூஉம்",1,"Tharooum","(it) gives"],["வினைநலம்",1,"Vinainalam","action/deed; goodness/purity"],["வேண்டிய",2,"Ventiya","(things) desired"],["எல்லாந்",2,"Ellaan","everything"],["தரும்",2,"Tharum","(it) gives"]]},{"n":652,"l":["என்றும் ஒருவுதல் வேண்டும் புகழொடு","நன்றி பயவா வினை."],"w":[["என்றும்",1,"Endrum","always/ever"],["ஒருவுதல்",1,"Oruvudhal","forsaking/avoiding"],["வேண்டும்",1,"Ventum","is needed/ought"],["புகழொடு",1,"Pukazhotu","fame; with/along with"],["நன்றி",2,"Nandri","good/virtue"],["பயவா",2,"Payavaa","that yield not"],["வினை",2,"Vinai","deeds"]]},{"n":653,"l":["ஓஒதல் வேண்டும் ஒளிமாழ்கும் செய்வினை","ஆஅதும் என்னு மவர்."],"w":[["ஓஒதல்",1,"Oodhal","forsaking/avoiding"],["வேண்டும்",1,"Ventum","is needed/ought"],["ஒளிமாழ்கும்",1,"Olimaazhkum","lustre/fame; that dims"],["செய்வினை",1,"Seyvinai","(deed) done; the deed (one does)"],["ஆஅதும்",2,"Aaadhum","we shall become"],["என்னு",2,"Ennu","who say"],["மவர்",2,"Mavar","those (people)"]]},{"n":654,"l":["இடுக்கண் படினும் இளிவந்த செய்யார்","நடுக்கற்ற காட்சி யவர்."],"w":[["இடுக்கண்",1,"Itukkan","distress/affliction"],["படினும்",1,"Patinum","though (they) fall into"],["இளிவந்த",1,"Ilivandha","that are degrading"],["செய்யார்",1,"Seyyaar","(they) will not do"],["நடுக்கற்ற",2,"Natukkatra","wavering; free from"],["காட்சி",2,"Kaatchi","insight/clear vision"],["யவர்",2,"Yavar","those (people)"]]},{"n":655,"l":["எற்றென்று இரங்குவ செய்யற்க செய்வானேல்","மற்றன்ன செய்யாமை நன்று."],"w":[["எற்றென்று",1,"Etrendru","what (is this); saying thus"],["இரங்குவ",1,"Iranguva","things one will grieve over"],["செய்யற்க",1,"Seyyarka","let (one) not do"],["செய்வானேல்",1,"Seyvaanel","if (he) does"],["மற்றன்ன",2,"Matranna","again/moreover (expletive); such (deeds)"],["செய்யாமை",2,"Seyyaamai","not doing"],["நன்று",2,"Nandru","(is) good"]]},{"n":656,"l":["ஈன்றாள் பசிகாண்பான் ஆயினுஞ் செய்யற்க","சான்றோர் பழிக்கும் வினை."],"w":[["ஈன்றாள்",1,"Eendraal","she who bore (mother)"],["பசிகாண்பான்",1,"Pasikaanpaan","hunger; he who sees"],["ஆயினுஞ்",1,"Aayinunj","even if (it be)"],["செய்யற்க",1,"Cheyyarka","let (one) not do"],["சான்றோர்",2,"Saandror","the wise/noble"],["பழிக்கும்",2,"Pazhikkum","that (they) blame"],["வினை",2,"Vinai","deed"]]},{"n":657,"l":["பழிமலைந்து எய்திய ஆக்கத்தின் சான்றோர்","கழிநல் குரவே தலை."],"w":[["பழிமலைந்து",1,"Pazhimalaindhu","blame/guilt; having taken on/contended"],["எய்திய",1,"Eydhiya","(that one) attained"],["ஆக்கத்தின்",1,"Aakkaththin","than the wealth"],["சான்றோர்",1,"Saandror","the wise (of/the wise's)"],["கழிநல்",2,"Kazhinal","extreme/much; good"],["குரவே",2,"Kurave","poverty/distress; (emphatic/exclusive)"],["தலை",2,"Thalai","(is) supreme/best"]]},{"n":658,"l":["கடிந்த கடிந்தொரார் செய்தார்க்கு அவைதாம்","முடிந்தாலும் பீழை தரும்."],"w":[["கடிந்த",1,"Katindha","(deeds) forbidden"],["கடிந்தொரார்",1,"Katindhoraar","having shunned; (those who) do not forsake"],["செய்தார்க்கு",1,"Seydhaarkku","to those who did"],["அவைதாம்",1,"Avaidhaam","those (deeds); (emphatic)"],["முடிந்தாலும்",2,"Mutindhaalum","even if accomplished"],["பீழை",2,"Peezhai","trouble/affliction"],["தரும்",2,"Tharum","(they) give"]]},{"n":659,"l":["அழக்கொண்ட எல்லாம் அழப்போம் இழப்பினும்","பிற்பயக்கும் நற்பா லவை."],"w":[["அழக்கொண்ட",1,"","so (others) weep; (wealth) seized"],["எல்லாம்",1,"","all (of it)"],["அழப்போம்",1,"","so (we) weep; (it) will go"],["இழப்பினும்",1,"","even if lost"],["பிற்பயக்கும்",2,"","afterwards; (they) yield (benefit)"],["நற்பா",2,"","good; share/nature"],["லவை",2,"","those (good things)"]]},{"n":660,"l":["சலத்தால் பொருள்செய்தே மார்த்தல் பசுமண்","கலத்துள்நீர் பெய்திரீஇ யற்று."],"w":[["சலத்தால்",1,"Salaththaal","by deceit/fraud"],["பொருள்செய்தே",1,"Porulseydhe","wealth; having amassed"],["மார்த்தல்",1,"Maarththal","guarding/keeping"],["பசுமண்",1,"Pasuman","fresh/wet; clay"],["கலத்துள்நீர்",2,"Kalaththulneer","within the vessel; water"],["பெய்திரீஇ",2,"Peydhireei","having poured and kept"],["யற்று",2,"Yatru","is like (that)"]]}]}