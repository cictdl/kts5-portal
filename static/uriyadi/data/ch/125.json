{"n":125,"kurals":[{"n":1241,"l":["நினைத்தொன்று சொல்லாயோ நெஞ்சே எனைத்தொன்றும்","எவ்வநோய் தீர்க்கும் மருந்து."],"w":[["நினைத்தொன்று",1,"Ninaiththondru","having thought/considered; one (thing), object of சொல்"],["சொல்லாயோ",1,"Sollaayo","you will not say (negative finite, read as question); interrogative particle"],["நெஞ்சே",1,"Nenje","O heart! (vocative); vocative particle"],["எனைத்தொன்றும்",1,"Enaiththondrum","however much / whatever (quantity); one (thing) at all; even/at-all (inclusive)"],["எவ்வநோய்",2,"Evvanoi","grief/affliction (attributive); affliction/disease (of love)"],["தீர்க்கும்",2,"Theerkkum","(that) will cure — qualifies மருந்து"],["மருந்து",2,"Marundhu","remedy/medicine"]]},{"n":1242,"l":["காதல் அவரிலர் ஆகநீ நோவது","பேதைமை வாழியென் நெஞ்சு."],"w":[["காதல்",1,"Kaadhal","love/affection"],["அவரிலர்",1,"Avarilar","he/they (lover, honorific); (he/they) is/are without (love)"],["ஆகநீ",1,"Aakanee","while being / so (as it is); you"],["நோவது",1,"Novadhu","the grieving (that which grieves)"],["பேதைமை",2,"Pedhaimai","folly/ignorance (is)"],["வாழியென்",2,"Vaazhiyen","may (you) live / bless!; my"],["நெஞ்சு",2,"Nenju","O heart! (vocative)"]]},{"n":1243,"l":["இருந்துள்ளி என்பரிதல் நெஞ்சே பரிந்துள்ளல்","பைதல்நோய் செய்தார்கண் இல்."],"w":[["இருந்துள்ளி",1,"Irundhulli","remaining/staying (and); having thought of (him)"],["என்பரிதல்",1,"Enparidhal","why? (what for); grieving/pining"],["நெஞ்சே",1,"Nenje","O heart! (vocative); vocative particle"],["பரிந்துள்ளல்",1,"Parindhullal","pitying/loving (and); the thinking/remembering"],["பைதல்நோய்",2,"Paidhalnoi","sorrow/pallor (attributive); (the) grieving affliction"],["செய்தார்கண்",2,"Seydhaarkan","(the one) who caused (it); in/at (7th case)"],["இல்",2,"Il","is not / does not exist (pity)"]]},{"n":1244,"l":["கண்ணும் கொளச்சேறி நெஞ்சே இவையென்னைத்","தின்னும் அவர்க்காணல் உற்று."],"w":[["கண்ணும்",1,"Kannum","eyes (also); also/too (inclusive)"],["கொளச்சேறி",1,"Kolachcheri","so as to take (along); you go / go!"],["நெஞ்சே",1,"Nenje","O heart! (vocative); vocative particle"],["இவையென்னைத்",1,"Ivaiyennaith","these (eyes); me"],["தின்னும்",2,"Thinnum","(they) will devour/eat"],["அவர்க்காணல்",2,"Avarkkaanal","him (lover, honorific obj); the seeing (of him)"],["உற்று",2,"Utru","desiring/intent on (having set upon)"]]},{"n":1245,"l":["செற்றார் எனக்கை விடல்உண்டோ நெஞ்சேயாம்","உற்றால் உறாஅ தவர்."],"w":[["செற்றார்",1,"Setraar","(those who) hated/turned hostile"],["எனக்கை",1,"Enakkai","thinking that / so saying (quotative); act/conduct (of giving up)"],["விடல்உண்டோ",1,"Vitalunto","abandoning/giving up; is there / exists?; interrogative particle"],["நெஞ்சேயாம்",1,"Nenjeyaam","O heart! (vocative); vocative particle; we/I"],["உற்றால்",2,"Utraal","if (we) approach/love (conditional)"],["உறாஅ",2,"Uraaa","(who) do not draw near/love"],["தவர்",2,"Thavar","(those) persons (= உறாதவர், who do not love)"]]},{"n":1246,"l":["கலந்துணர்த்தும் காதலர்க் கண்டாற் புலந்துணராய்","பொய்க்காய்வு காய்திஎன் நெஞ்சு."],"w":[["கலந்துணர்த்தும்",1,"Kalandhunarththum","uniting/embracing (and); (who) reconciles/makes-up — qualifies காதலர்"],["காதலர்க்",1,"Kaadhalark","the beloved/lover"],["கண்டாற்",1,"Kantaar","if (you) see (him) — conditional"],["புலந்துணராய்",1,"Pulandhunaraai","sulking/feigning anger (and); you do not relent/feel"],["பொய்க்காய்வு",2,"Poikkaaivu","false (attributive); anger/burning (false wrath)"],["காய்திஎன்",2,"Kaaidhien","you flare up/are angry (archaic -தி); my"],["நெஞ்சு",2,"Nenju","O heart! (vocative)"]]},{"n":1247,"l":["காமம் விடுஒன்றோ நாண்விடு நன்னெஞ்சே","யானோ பொறேன்இவ் விரண்டு."],"w":[["காமம்",1,"Kaamam","(sexual) love/desire"],["விடுஒன்றோ",1,"Vituondro","give up! / let go!; one (of the two); or (alternative particle)"],["நாண்விடு",1,"Naanvitu","modesty/shame; give up! / let go!"],["நன்னெஞ்சே",1,"Nannenje","good (attributive); O (good) heart! (vocative); vocative particle"],["யானோ",2,"Yaano","I; as for (me)? (emphatic/interrog)"],["பொறேன்இவ்",2,"Poreniv","I cannot bear/endure; these (proximate dem.)"],["விரண்டு",2,"Virantu","the two (things)"]]},{"n":1248,"l":["பரிந்தவர் நல்காரென்று ஏங்கிப் பிரிந்தவர்","பின்செல்வாய் பேதைஎன் நெஞ்சு."],"w":[["பரிந்தவர்",1,"Parindhavar","(he who) felt pity / loved"],["நல்காரென்று",1,"Nalkaarendru","(he) will not grace/show love; saying/thinking that (quotative)"],["ஏங்கிப்",1,"Engip","yearning/pining (and)"],["பிரிந்தவர்",1,"Pirindhavar","(he) who parted/left"],["பின்செல்வாய்",2,"Pinselvaai","behind/after; you go/follow"],["பேதைஎன்",2,"Pedhaien","(a) fool/simpleton; my"],["நெஞ்சு",2,"Nenju","(my) heart (= the fool)"]]},{"n":1249,"l":["உள்ளத்தார் காத லவராக உள்ளிநீ","யாருழைச் சேறியென் நெஞ்சு."],"w":[["உள்ளத்தார்",1,"Ullaththaar","(he who) is in (my) heart"],["காத",1,"Kaadha","love (part of காதலவர், split by சீர்)"],["லவராக",1,"Lavaraaka","the lover (காதலவர், by/of); by/with (3rd case)"],["உள்ளிநீ",1,"Ullinee","thinking of (him); you"],["யாருழைச்",2,"Yaaruzhaich","whom/who; to the place/presence of"],["சேறியென்",2,"Cheriyen","do you go?; my"],["நெஞ்சு",2,"Nenju","O (my) heart! (vocative)"]]},{"n":1250,"l":["துன்னாத் துறந்தாரை நெஞ்சத்து உடையேமா","இன்னும் இழத்தும் கவின்."],"w":[["துன்னாத்",1,"Thunnaath","(who) did not join/unite (with us) — qualifies துறந்தார்"],["துறந்தாரை",1,"Thurandhaarai","(him) who abandoned/forsook; (accusative marker)"],["நெஞ்சத்து",1,"Nenjaththu","in (our) heart"],["உடையேமா",1,"Utaiyemaa","we possess/hold; (since/as) — concessive/interrog particle"],["இன்னும்",2,"Innum","still/yet more"],["இழத்தும்",2,"Izhaththum","we (shall) lose"],["கவின்",2,"Kavin","beauty/charm"]]}]}