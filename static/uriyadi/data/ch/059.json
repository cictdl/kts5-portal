{"n":59,"kurals":[{"n":581,"l":["ஒற்றும் உரைசான்ற நூலும் இவையிரண்டும்","தெற்றென்க மன்னவன் கண்."],"w":[["ஒற்றும்",1,"Otrum","spy; and (inclusive)"],["உரைசான்ற",1,"Uraisaandra","of established repute"],["நூலும்",1,"Noolum","treatise/law-book; and (inclusive)"],["இவையிரண்டும்",1,"Ivaiyirantum","these; two; both (inclusive)"],["தெற்றென்க",2,"Thetrenka","let (him) regard clearly"],["மன்னவன்",2,"Mannavan","king's"],["கண்",2,"Kan","eye(s)"]]},{"n":582,"l":["எல்லார்க்கும் எல்லாம் நிகழ்பவை எஞ்ஞான்றும்","வல்லறிதல் வேந்தன் தொழில்."],"w":[["எல்லார்க்கும்",1,"Ellaarkkum","to all (persons); all (inclusive)"],["எல்லாம்",1,"Ellaam","all things"],["நிகழ்பவை",1,"Nikazhpavai","things that happen"],["எஞ்ஞான்றும்",1,"Egngnaandrum","at all times; every (inclusive)"],["வல்லறிதல்",2,"Vallaridhal","swiftly/ably; the knowing"],["வேந்தன்",2,"Vendhan","king's"],["தொழில்",2,"Thozhil","duty/task"]]},{"n":583,"l":["ஒற்றினான் ஒற்றிப் பொருள்தெரியா மன்னவன்","கொற்றங் கொளக்கிடந்தது இல்."],"w":[["ஒற்றினான்",1,"Otrinaan","by the spy"],["ஒற்றிப்",1,"Otrip","having spied"],["பொருள்தெரியா",1,"Poruldheriyaa","meaning/matter; who does not discern"],["மன்னவன்",1,"Mannavan","king"],["கொற்றங்",2,"Kotrang","victory/sovereignty"],["கொளக்கிடந்தது",2,"Kolakkitandhadhu","to attain; that which lies (a way)"],["இல்",2,"Il","there is none"]]},{"n":584,"l":["வினைசெய்வார் தம்சுற்றம் வேண்டாதார் என்றாங்கு","அனைவரையும் ஆராய்வது ஒற்று."],"w":[["வினைசெய்வார்",1,"Vinaiseyvaar","work/duty; those who do (work)"],["தம்சுற்றம்",1,"Thamsutram","their own; kinsmen"],["வேண்டாதார்",1,"Ventaadhaar","those not desired (foes)"],["என்றாங்கு",1,"Endraangu","thus saying; thus/there (expletive)"],["அனைவரையும்",2,"Anaivaraiyum","all (persons); all (inclusive)"],["ஆராய்வது",2,"Aaraaivadhu","the investigating"],["ஒற்று",2,"Otru","spying (act of the spy)"]]},{"n":585,"l":["கடாஅ உருவொடு கண்ணஞ்சாது யாண்டும்","உகாஅமை வல்லதே ஒற்று."],"w":[["கடாஅ",1,"Kataaa","not suspectable"],["உருவொடு",1,"Uruvotu","with (a) form/guise"],["கண்ணஞ்சாது",1,"Kannanjaadhu","at (another's) eye; fearing not"],["யாண்டும்",1,"Yaantum","everywhere; every (inclusive)"],["உகாஅமை",2,"Ukaaamai","not letting (secret) slip"],["வல்லதே",2,"Valladhe","that which is able; (emphatic) indeed"],["ஒற்று",2,"Otru","(is the) spy"]]},{"n":586,"l":["துறந்தார் படிவத்த ராகி இறந்தாராய்ந்து","என்செயினும் சோர்விலது ஒற்று."],"w":[["துறந்தார்",1,"Thurandhaar","ascetics'"],["படிவத்த",1,"Pativaththa","those of (ascetic) form"],["ராகி",1,"Raaki","having become"],["இறந்தாராய்ந்து",1,"Irandhaaraaindhu","passing (into places); having investigated"],["என்செயினும்",2,"Enseyinum","what; whatever (they) do"],["சோர்விலது",2,"Sorviladhu","slackness; that which is without (slackness)"],["ஒற்று",2,"Otru","(is the) spy"]]},{"n":587,"l":["மறைந்தவை கேட்கவற் றாகி அறிந்தவை","ஐயப்பாடு இல்லதே ஒற்று."],"w":[["மறைந்தவை",1,"Maraindhavai","hidden things"],["கேட்கவற்",1,"Ketkavar","able to hear/ask"],["றாகி",1,"Raaki","having become"],["அறிந்தவை",1,"Arindhavai","things known"],["ஐயப்பாடு",2,"Aiyappaatu","doubt"],["இல்லதே",2,"Illadhe","that which is without; (emphatic) indeed"],["ஒற்று",2,"Otru","(is the) spy"]]},{"n":588,"l":["ஒற்றொற்றித் தந்த பொருளையும் மற்றுமோர்","ஒற்றினால் ஒற்றிக் கொளல்."],"w":[["ஒற்றொற்றித்",1,"Otrotrith","a spy; having spied out"],["தந்த",1,"Thandha","that (he) gave"],["பொருளையும்",1,"Porulaiyum","the matter/report; even (inclusive)"],["மற்றுமோர்",1,"Matrumor","moreover/another; one"],["ஒற்றினால்",2,"Otrinaal","by (another) spy"],["ஒற்றிக்",2,"Otrik","having spied/verified"],["கொளல்",2,"Kolal","let (him) accept"]]},{"n":589,"l":["ஒற்றொற் றுணராமை ஆள்க உடன்மூவர்","சொற்றொக்க தேறப் படும்."],"w":[["ஒற்றொற்",1,"Otrot","a spy (obj.); what kind / what(other)"],["றுணராமை",1,"Runaraamai","without (one) knowing (another)"],["ஆள்க",1,"Aalka","let (him) employ/deploy"],["உடன்மூவர்",1,"Utanmoovar","together; three persons"],["சொற்றொக்க",2,"Sotrokka","word/report; agreeing/matching"],["தேறப்",2,"Therap","to be clarified/trusted"],["படும்",2,"Patum","will be (accepted)"]]},{"n":59