{"n":13,"kurals":[{"n":121,"l":["அடக்கம் அமரருள் உய்க்கும் அடங்காமை","ஆரிருள் உய்த்து விடும்."],"w":[["அடக்கம்",1,"Atakkam","self-restraint"],["அமரருள்",1,"Amararul","among the immortals/gods; in/among (locative)"],["உய்க்கும்",1,"Uykkum","leads/conveys (to)"],["அடங்காமை",1,"Atangaamai","lack of self-restraint"],["ஆரிருள்",2,"Aarirul","full/dense; darkness (dire life)"],["உய்த்து",2,"Uyththu","having conveyed/driven"],["விடும்",2,"Vitum","will leave/cast"]]},{"n":122,"l":["காக்க பொருளா அடக்கத்தை ஆக்கம்","அதனினூஉங் கில்லை உயிர்க்கு."],"w":[["காக்க",1,"Kaakka","let (one) guard"],["பொருளா",1,"Porulaa","as wealth/treasure"],["அடக்கத்தை",1,"Atakkaththai","self-restraint (acc.); euphonic infix; accusative marker"],["ஆக்கம்",1,"Aakkam","gain/prosperity"],["அதனினூஉங்",2,"Adhaninooung","than that; than (ablative/comparative); more/beyond (comparative particle)"],["கில்லை",2,"Killai","there is not"],["உயிர்க்கு",2,"Uyirkku","to/for life; dative marker"]]},{"n":123,"l":["செறிவறிந்து சீர்மை பயக்கும் அறிவறிந்து","ஆற்றின் அடங்கப் பெறின்."],"w":[["செறிவறிந்து",1,"Serivarindhu","restraint/firmness (obj.); having known/perceived"],["சீர்மை",1,"Seermai","greatness/excellence"],["பயக்கும்",1,"Payakkum","(it) yields/gives"],["அறிவறிந்து",1,"Arivarindhu","what is to be known (obj.); having known"],["ஆற்றின்",2,"Aatrin","in the (right) way; in (locative)"],["அடங்கப்",2,"Atangap","so as to be restrained"],["பெறின்",2,"Perin","if (one) attains"]]},{"n":124,"l":["நிலையின் திரியாது அடங்கியான் தோற்றம்","மலையினும் மாணப் பெரிது."],"w":[["நிலையின்",1,"Nilaiyin","from (one's) state; from (ablative)"],["திரியாது",1,"Thiriyaadhu","without deviating"],["அடங்கியான்",1,"Atangiyaan","he who lives restrained"],["தோற்றம்",1,"Thotram","stature/appearance"],["மலையினும்",2,"Malaiyinum","than a mountain; than (comparative); even (emphatic)"],["மாணப்",2,"Maanap","greatly/exceedingly"],["பெரிது",2,"Peridhu","(is) great"]]},{"n":125,"l":["எல்லார்க்கும் நன்றாம் பணிதல் அவருள்ளும்","செல்வர்க்கே செல்வம் தகைத்து."],"w":[["எல்லார்க்கும்",1,"Ellaarkkum","to all; dative marker; all (inclusive உம்)"],["நன்றாம்",1,"Nandraam","(it) is good"],["பணிதல்",1,"Panidhal","humility/bowing"],["அவருள்ளும்",1,"Avarullum","among them; among (locative); even/inclusive"],["செல்வர்க்கே",2,"Selvarkke","to the rich; dative marker; alone/only (பிரிநிலை ஏ)"],["செல்வம்",2,"Selvam","wealth"],["தகைத்து",2,"Thakaiththu","(is) of the nature/worth (of)"]]},{"n":126,"l":["ஒருமையுள் ஆமைபோல் ஐந்தடக்கல் ஆற்றின்","எழுமையும் ஏமாப் புடைத்து."],"w":[["ஒருமையுள்",1,"Orumaiyul","in one birth; in (locative)"],["ஆமைபோல்",1,"Aamaipol","tortoise; like (simile particle போல்)"],["ஐந்தடக்கல்",1,"Aindhatakkal","the five (senses); restraining"],["ஆற்றின்",1,"Aatrin","if (one) is able"],["எழுமையும்",2,"Ezhumaiyum","the seven births; even (in all seven)"],["ஏமாப்",2,"Emaap","protection/safeguard"],["புடைத்து",2,"Putaiththu","(it) has/possesses"]]},{"n":127,"l":["யாகாவா ராயினும் நாகாக்க காவாக்கால்","சோகாப்பர் சொல்லிழுக்குப் பட்டு."],"w":[["யாகாவா",1,"Yaakaavaa","what(ever things); not guarding (those which)"],["ராயினும்",1,"Raayinum","even though (it be)"],["நாகாக்க",1,"Naakaakka","the tongue (obj.); let (one) guard"],["காவாக்கால்",1,"Kaavaakkaal","if (one) does not guard"],["சோகாப்பர்",2,"Sokaappar","(they) will grieve/suffer"],["சொல்லிழுக்குப்",2,"Sollizhukkup","of speech; fault/slip"],["பட்டு",2,"Pattu","having been caught (in)"]]},{"n":128,"l":["ஒன்றானுந் தீச்சொல் பொருட்பயன் உண்டாயின்","நன்றாகா தாகி விடும்."],"w":[["ஒன்றானுந்",1,"Ondraanun","by even one; by/with (instrumental); even"],["தீச்சொல்",1,"Theechchol","evil/bad; word"],["பொருட்பயன்",1,"Porutpayan","of (its) meaning; result/effect"],["உண்டாயின்",1,"Untaayin","if there be"],["நன்றாகா",2,"Nandraakaa","not becoming good"],["தாகி",2,"Thaaki","becoming (so)"],["விடும்",2,"Vitum","will (it) become"]]},{"n":129,"l":["தீயினாற் சுட்டபுண் உள்ளாறும் ஆறாதே","நாவினாற் சுட்ட வடு."],"w":[["தீயினாற்",1,"Theeyinaar","by fire; euphonic infix; by/with (instrumental)"],["சுட்டபுண்",1,"Suttapun","burnt (which); wound"],["உள்ளாறும்",1,"Ullaarum","inside; (it) heals (within)"],["ஆறாதே",1,"Aaraadhe","does not heal; (emphatic/assertive ஏ)"],["நாவினாற்",2,"Naavinaar","by the tongue; euphonic infix; by/with (instrumental)"],["சுட்ட",2,"Sutta","burnt (which)"],["வடு",2,"Vatu","scar"]]},{"n":130,"l":["கதங்காத்துக் கற்றடங்கல் ஆற்றுவான் செவ்வி","அறம்பார்க்கும் ஆற்றின் நுழைந்து."],"w":[["கதங்காத்துக்",1,"Kadhangaaththuk","anger (obj.); having guarded against"],["கற்றடங்கல்",1,"Katratangal","having learnt; being restrained"],["ஆற்றுவான்",1,"Aatruvaan","he who is able"],["செவ்வி",1,"Sevvi","(right) moment/access"],["அறம்பார்க்கும்",2,"Arampaarkkum","virtue (subj.); (virtue) will watch for"],["ஆற்றின்",2,"Aatrin","in the way/path; in (locative)"],["நுழைந்து",2,"Nuzhaindhu","having entered"]]}]}