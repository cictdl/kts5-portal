{"n":28,"kurals":[{"n":271,"l":["வஞ்ச மனத்தான் படிற்றொழுக்கம் பூதங்கள்","ஐந்தும் அகத்தே நகும்."],"w":[["வஞ்ச",1,"Vanja","deceit/guile (attributive)"],["மனத்தான்",1,"Manaththaan","he of (deceitful) mind"],["படிற்றொழுக்கம்",1,"Patitrozhukkam","falsehood/deceit; false conduct (object)"],["பூதங்கள்",1,"Poodhangal","the (five) elements"],["ஐந்தும்",2,"Aindhum","five; all (totality um)"],["அகத்தே",2,"Akaththe","inside/within; indeed (emphatic)"],["நகும்",2,"Nakum","(they) laugh/mock"]]},{"n":272,"l":["வானுயர் தோற்றம் எவன்செய்யும் தன்னெஞ்சம்","தான்அறி குற்றப் படின்."],"w":[["வானுயர்",1,"Vaanuyar","sky; lofty (as sky)"],["தோற்றம்",1,"Thotram","(outward) appearance/show"],["எவன்செய்யும்",1,"Evanseyyum","what (interrog); will (it) do (avail)"],["தன்னெஞ்சம்",1,"Thannenjam","one's own; (one's) heart/mind"],["தான்அறி",2,"Thaanari","(it)self; (it)self knows (adj)"],["குற்றப்",2,"Kutrap","in (its own) fault"],["படின்",2,"Patin","if (it) abides/falls"]]},{"n":273,"l":["வலியில் நிலைமையான் வல்லுருவம் பெற்றம்","புலியின்தோல் போர்த்துமேய்ந் தற்று."],"w":[["வலியில்",1,"Valiyil","strength (of mind); without/lacking"],["நிலைமையான்",1,"Nilaimaiyaan","he of (weak) condition"],["வல்லுருவம்",1,"Valluruvam","strong/austere (intens); (ascetic) form/guise"],["பெற்றம்",1,"Petram","cow/ox"],["புலியின்தோல்",2,"Puliyindhol","tiger's; skin/hide"],["போர்த்துமேய்ந்",2,"Porththumeyn","having covered/draped; (that) grazed"],["தற்று",2,"Thatru","is like that (simile-clitic)"]]},{"n":274,"l":["தவமறைந்து அல்லவை செய்தல் புதல்மறைந்து","வேட்டுவன் புள்சிமிழ்த் தற்று."],"w":[["தவமறைந்து",1,"Thavamaraindhu","(in) penance/austerity; hiding (in)"],["அல்லவை",1,"Allavai","wrong/evil things"],["செய்தல்",1,"Seydhal","doing (the act of)"],["புதல்மறைந்து",1,"Pudhalmaraindhu","(in the) bush/thicket; hiding (in)"],["வேட்டுவன்",2,"Vettuvan","hunter/fowler"],["புள்சிமிழ்த்",2,"Pulsimizhth","birds (object); (that) snared/trapped"],["தற்று",2,"Thatru","is like that (simile-clitic)"]]},{"n":275,"l":["பற்றற்றேம் என்பார் படிற்றொழுக்கம் எற்றெற்றென்று","ஏதம் பலவுந் தரும்."],"w":[["பற்றற்றேம்",1,"Patratrem","attachment; we have become free of"],["என்பார்",1,"Enpaar","those who say (so)"],["படிற்றொழுக்கம்",1,"Patitrozhukkam","falsehood/deceit; false conduct (subject)"],["எற்றெற்றென்று",1,"Etretrendru","what (have we done)?; what? (reduplicated); saying thus"],["ஏதம்",2,"Edham","harm/distress (object)"],["பலவுந்",2,"Palavun","many; (many) too (totality um)"],["தரும்",2,"Tharum","(it) gives/brings"]]},{"n":276,"l":["நெஞ்சின் துறவார் துறந்தார்போல் வஞ்சித்து","வாழ்வாரின் வன்கணார் இல்."],"w":[["நெஞ்சின்",1,"Nenjin","in (the) heart/mind"],["துறவார்",1,"Thuravaar","(they) renounce not"],["துறந்தார்போல்",1,"Thurandhaarpol","those who renounced; like/as (simile)"],["வஞ்சித்து",1,"Vanjiththu","deceiving"],["வாழ்வாரின்",2,"Vaazhvaarin","than those who live (thus); than (comparison)"],["வன்கணார்",2,"Vankanaar","the pitiless/hard-hearted"],["இல்",2,"Il","(there) is none"]]},{"n":277,"l":["புறங்குன்றி கண்டனைய ரேனும் அகங்குன்றி","மூக்கிற் கரியார் உடைத்து."],"w":[["புறங்குன்றி",1,"Purangundri","outside/exterior; gunja berry/seed"],["கண்டனைய",1,"Kantanaiya","as seen; such/like that"],["ரேனும்",1,"Renum","even though (they be); even (concessive)"],["அகங்குன்றி",1,"Akangundri","inside/interior; gunja berry/seed"],["மூக்கிற்",2,"Mookkir","like (its) nose/tip"],["கரியார்",2,"Kariyaar","the black-(hearted) ones"],["உடைத்து",2,"Utaiththu","(the world) has/contains"]]},{"n":278,"l":["மனத்தது மாசாக மாண்டார் நீராடி","மறைந்தொழுகு மாந்தர் பலர்."],"w":[["மனத்தது",1,"Manaththadhu","that which is of the mind"],["மாசாக",1,"Maasaaka","stain/impurity; being/while (it is)"],["மாண்டார்",1,"Maantaar","the dignified/great (ones)"],["நீராடி",1,"Neeraati","(in) water; having bathed"],["மறைந்தொழுகு",2,"Maraindhozhuku","hiding/concealing; who behave/live"],["மாந்தர்",2,"Maandhar","people/men"],["பலர்",2,"Palar","(are) many"]]},{"n":279,"l":["கணைகொடிது யாழ்கோடு செவ்விதுஆங் கன்ன","வினைபடு பாலால் கொளல்."],"w":[["கணைகொடிது",1,"Kanaikotidhu","arrow; is cruel/harmful"],["யாழ்கோடு",1,"Yaazhkotu","lute/yaazh; (its) bent neck/horn"],["செவ்விதுஆங்",1,"Sevvidhuaang","is good/pleasant; thus/so (expletive)"],["கன்ன",1,"Kanna","such/like these"],["வினைபடு",2,"Vinaipatu","deed/action; that arises from (deeds)"],["பாலால்",2,"Paalaal","by (their) nature/quality"],["கொளல்",2,"Kolal","(one should) grasp/judge"]]},{"n":280,"l":["மழித்தலும் நீட்டலும் வேண்டா உலகம்","பழித்தது ஒழித்து விடின்."],"w":[["மழித்தலும்",1,"Mazhiththalum","shaving (the head); and (conjunctive um)"],["நீட்டலும்",1,"Neettalum","growing (matted hair); and (conjunctive um)"],["வேண்டா",1,"Ventaa","are not needed"],["உலகம்",1,"Ulakam","the world/people"],["பழித்தது",2,"Pazhiththadhu","that which (the world) blamed"],["ஒழித்து",2,"Ozhiththu","having given up/removed"],["விடின்",2,"Vitin","if (one) gives up"]]}]}