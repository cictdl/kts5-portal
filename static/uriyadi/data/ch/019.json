{"n":19,"kurals":[{"n":181,"l":["அறங்கூறான் அல்ல செயினும் ஒருவன்","புறங்கூறான் என்றல் இனிது."],"w":[["அறங்கூறான்",1,"Arangooraan","virtue (obj); he who does not tell (of virtue)"],["அல்ல",1,"Alla","things that are not (virtuous)"],["செயினும்",1,"Seyinum","even if (he) does"],["ஒருவன்",1,"Oruvan","a man"],["புறங்கூறான்",2,"Purangooraan","slander/back (obj); he who does not backbite"],["என்றல்",2,"Endral","the saying (that)"],["இனிது",2,"Inidhu","is good/pleasant"]]},{"n":182,"l":["அறனழீஇ அல்லவை செய்தலின் தீதே","புறனழீஇப் பொய்த்து நகை."],"w":[["அறனழீஇ",1,"Aranazheei","virtue (obj); having destroyed/decried"],["அல்லவை",1,"Allavai","things that are not (right)"],["செய்தலின்",1,"Seydhalin","than doing"],["தீதே",1,"Theedhe","is (more) evil; indeed (emphatic)"],["புறனழீஇப்",2,"Puranazheeip","back/absence (obj); having slandered (in absence)"],["பொய்த்து",2,"Poiththu","having falsely (smiled)"],["நகை",2,"Nakai","laughter/smile"]]},{"n":183,"l":["புறங்கூறிப் பொய்த்துயிர் வாழ்தலின் சாதல்","அறங்கூறும் ஆக்கந் தரும்."],"w":[["புறங்கூறிப்",1,"Purangoorip","slander (obj); having backbitten"],["பொய்த்துயிர்",1,"Poiththuyir","having lied; life"],["வாழ்தலின்",1,"Vaazhdhalin","than living"],["சாதல்",1,"Saadhal","dying"],["அறங்கூறும்",2,"Arangoorum","virtue (obj of கூறு); that (virtue-texts) declare"],["ஆக்கந்",2,"Aakkan","gain/prosperity (obj)"],["தரும்",2,"Tharum","(it/dying) gives"]]},{"n":184,"l":["கண்ணின்று கண்ணறச் சொல்லினும் சொல்லற்க","முன்னின்று பின்நோக்காச் சொல்."],"w":[["கண்ணின்று",1,"Kannindru","in (one's) presence; standing"],["கண்ணறச்",1,"Kannarach","eye/grace (கண்ணோட்டம்); so as to be without (grace)"],["சொல்லினும்",1,"Chollinum","even if (one) speaks"],["சொல்லற்க",1,"Sollarka","do not speak (prohibitive)"],["முன்னின்று",2,"Munnindru","in front; standing"],["பின்நோக்காச்",2,"Pinnokkaach","the after(-effect); not considering (that which)"],["சொல்",2,"Chol","word/speech (obj)"]]},{"n":185,"l":["அறஞ்சொல்லும் நெஞ்சத்தான் அன்மை புறஞ்சொல்லும்","புன்மையாற் காணப் படும்."],"w":[["அறஞ்சொல்லும்",1,"Aranjollum","virtue (obj); that speaks (of)"],["நெஞ்சத்தான்",1,"Nenjaththaan","one with a heart (that...)"],["அன்மை",1,"Anmai","the not-being"],["புறஞ்சொல்லும்",1,"Puranjollum","slander (obj); that backbites"],["புன்மையாற்",2,"Punmaiyaar","by the meanness"],["காணப்",2,"Kaanap","to be seen"],["படும்",2,"Patum","will be (seen)"]]},{"n":186,"l":["பிறன்பழி கூறுவான் தன்பழி யுள்ளும்","திறன்தெரிந்து கூறப் படும்."],"w":[["பிறன்பழி",1,"Piranpazhi","another's; fault/blame (obj)"],["கூறுவான்",1,"Kooruvaan","he who tells"],["தன்பழி",1,"Thanpazhi","his own; fault/blame"],["யுள்ளும்",1,"Yullum","among; even (emphatic)"],["திறன்தெரிந்து",2,"Thirandherindhu","the (grievous) kind (obj); having selected/examined"],["கூறப்",2,"Koorap","to be told"],["படும்",2,"Patum","will be (talked about)"]]},{"n":187,"l":["பகச்சொல்லிக் கேளிர்ப் பிரிப்பர் நகச்சொல்லி","நட்பாடல் தேற்றா தவர்."],"w":[["பகச்சொல்லிக்",1,"Pakachchollik","so as to divide; having spoken"],["கேளிர்ப்",1,"Kelirp","kinsmen/friends (obj)"],["பிரிப்பர்",1,"Pirippar","(they) will separate"],["நகச்சொல்லி",1,"Nakachcholli","so as to delight; having spoken"],["நட்பாடல்",2,"Natpaatal","forming friendship (obj)"],["தேற்றா",2,"Thetraa","who do not know (how to)"],["தவர்",2,"Thavar","those (who)"]]},{"n":188,"l":["துன்னியார் குற்றமும் தூற்றும் மரபினார்","என்னைகொல் ஏதிலார் மாட்டு."],"w":[["துன்னியார்",1,"Thunniyaar","those who are close"],["குற்றமும்",1,"Kutramum","fault (obj); even"],["தூற்றும்",1,"Thootrum","who proclaim/winnow"],["மரபினார்",1,"Marapinaar","those of (such) a nature"],["என்னைகொல்",2,"Ennaikol","what (will they do); (doubt particle)"],["ஏதிலார்",2,"Edhilaar","strangers"],["மாட்டு",2,"Maattu","in the matter of / towards"]]},{"n":189,"l":["அறன்நோக்கி ஆற்றுங்கொல் வையம் புறன்நோக்கிப்","புன்சொல் உரைப்பான் பொறை."],"w":[["அறன்நோக்கி",1,"Arannokki","virtue/duty (obj); considering (its duty)"],["ஆற்றுங்கொல்",1,"Aatrungol","does (it) endure/carry; (interrogative/doubt)"],["வையம்",1,"Vaiyam","the earth/world"],["புறன்நோக்கிப்",1,"Purannokkip","the absence (obj); watching (for absence)"],["புன்சொல்",2,"Punsol","mean/base; (mean) word (obj)"],["உரைப்பான்",2,"Uraippaan","he who utters"],["பொறை",2,"Porai","the burden/load (obj)"]]},{"n":190,"l":["ஏதிலார் குற்றம்போல் தங்குற்றங் காண்கிற்பின்","தீதுண்டோ மன்னும் உயிர்க்கு."],"w":[["ஏதிலார்",1,"Edhilaar","strangers'"],["குற்றம்போல்",1,"Kutrampol","fault; like (உவம உருபு)"],["தங்குற்றங்",1,"Thangutrang","their own; fault (obj)"],["காண்கிற்பின்",1,"Kaankirpin","if (they) can see"],["தீதுண்டோ",2,"Theedhunto","evil/harm; is there; ? (interrogative)"],["மன்னும்",2,"Mannum","that abides/is permanent"],["உயிர்க்கு",2,"Uyirkku","to/for the life"]]}]}