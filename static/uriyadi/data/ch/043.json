{"n":43,"kurals":[{"n":421,"l":["அறிவற்றங் காக்குங் கருவி செறுவார்க்கும்","உள்ளழிக்க லாகா அரண்."],"w":[["அறிவற்றங்",1,"Arivatrang","wisdom (subject); ruin/loss"],["காக்குங்",1,"Kaakkung","that guards"],["கருவி",1,"Karuvi","instrument/weapon"],["செறுவார்க்கும்",1,"Seruvaarkkum","to those who are hostile; even (concessive)"],["உள்ளழிக்க",2,"Ullazhikka","inner (fort/part); to destroy"],["லாகா",2,"Laakaa","cannot be / is not possible"],["அரண்",2,"Aran","fortress"]]},{"n":422,"l":["சென்ற இடத்தால் செலவிடா தீதொரீஇ","நன்றின்பால் உய்ப்ப தறிவு."],"w":[["சென்ற",1,"Sendra","that went (to)"],["இடத்தால்",1,"Itaththaal","by the way/place (it went)"],["செலவிடா",1,"Selavitaa","not letting (it) go"],["தீதொரீஇ",1,"Theedhoreei","evil (from); having removed/avoided"],["நன்றின்பால்",2,"Nandrinpaal","goodness; (euphonic) saariyai; in the side/direction of"],["உய்ப்ப",2,"Uyppa","that which drives/leads"],["தறிவு",2,"Tharivu","that which (leads); is wisdom"]]},{"n":423,"l":["எப்பொருள் யார்யார்வாய்க் கேட்பினும் அப்பொருள்","மெய்ப்பொருள் காண்ப தறிவு."],"w":[["எப்பொருள்",1,"Epporul","which/what; thing/matter"],["யார்யார்வாய்க்",1,"Yaaryaarvaaik","whoever (each one); from (the mouth of)"],["கேட்பினும்",1,"Ketpinum","if (one) hears; even (concessive)"],["அப்பொருள்",1,"Apporul","that; that thing"],["மெய்ப்பொருள்",2,"Meypporul","true; true essence/reality"],["காண்ப",2,"Kaanpa","that which sees/perceives"],["தறிவு",2,"Tharivu","that which (perceives); is wisdom"]]},{"n":424,"l":["எண்பொருள வாகச் செலச்சொல்லித் தான்பிறர்வாய்","நுண்பொருள் காண்ப தறிவு."],"w":[["எண்பொருள",1,"Enporula","easy/simple; having (such) meanings"],["வாகச்",1,"Vaakach","so as to be"],["செலச்சொல்லித்",1,"Chelachchollith","so as to reach/sink in; having spoken"],["தான்பிறர்வாய்",1,"Thaanpirarvaai","oneself; others; from (others')"],["நுண்பொருள்",2,"Nunporul","subtle; subtle meaning"],["காண்ப",2,"Kaanpa","that which perceives"],["தறிவு",2,"Tharivu","that which (perceives); is wisdom"]]},{"n":425,"l":["உலகம் தழீஇய தொட்பம் மலர்தலும்","கூம்பலும் இல்ல தறிவு."],"w":[["உலகம்",1,"Ulakam","the (wise) world"],["தழீஇய",1,"Thazheeiya","that embraces/befriends"],["தொட்பம்",1,"Thotpam","wisdom/sagacity"],["மலர்தலும்",1,"Malardhalum","blooming/expanding; and"],["கூம்பலும்",2,"Koompalum","closing/shrinking; and"],["இல்ல",2,"Illa","are without (those)"],["தறிவு",2,"Tharivu","that; is wisdom"]]},{"n":426,"l":["எவ்வ துறைவது உலகம் உலகத்தோடு","அவ்வ துறைவ தறிவு."],"w":[["எவ்வ",1,"Evva","in whatever (ways)"],["துறைவது",1,"Thuraivadhu","the way (it) abides/conducts"],["உலகம்",1,"Ulakam","the world (wise people)"],["உலகத்தோடு",1,"Ulakaththotu","together with the world"],["அவ்வ",2,"Avva","in that (same) way"],["துறைவ",2,"Thuraiva","the abiding/conducting"],["தறிவு",2,"Tharivu","that which (abides); is wisdom"]]},{"n":427,"l":["அறிவுடையார் ஆவ தறிவார் அறிவிலார்","அஃதறி கல்லா தவர்."],"w":[["அறிவுடையார்",1,"Arivutaiyaar","the wise (those who have wisdom)"],["ஆவ",1,"Aava","that which is to come"],["தறிவார்",1,"Tharivaar","that which (will come); (are those who) know"],["அறிவிலார்",1,"Arivilaar","the unwise (those without wisdom)"],["அஃதறி",2,"Aqdhari","that; to know"],["கல்லா",2,"Kallaa","unable (to learn)"],["தவர்",2,"Thavar","they (are)"]]},{"n":428,"l":["அஞ்சுவ தஞ்சாமை பேதைமை அஞ்சுவது","அஞ்சல் அறிவார் தொழில்."],"w":[["அஞ்சுவ",1,"Anjuva","that which is to be feared"],["தஞ்சாமை",1,"Thanjaamai","that which (is feared); not fearing"],["பேதைமை",1,"Pedhaimai","folly/ignorance"],["அஞ்சுவது",1,"Anjuvadhu","that which is to be feared"],["அஞ்சல்",2,"Anjal","fearing"],["அறிவார்",2,"Arivaar","of the wise"],["தொழில்",2,"Thozhil","task/duty"]]},{"n":429,"l":["எதிரதாக் காக்கும் அறிவினார்க் கில்லை","அதிர வருவதோர் நோய்."],"w":[["எதிரதாக்",1,"Edhiradhaak","the future / what is to come; so as to be (beforehand)"],["காக்கும்",1,"Kaakkum","that guards"],["அறிவினார்க்",1,"Arivinaark","for those with wisdom"],["கில்லை",1,"Killai","(there) is not"],["அதிர",2,"Adhira","so as to shake/tremble"],["வருவதோர்",2,"Varuvadhor","that which comes; a (single)"],["நோய்",2,"Noi","affliction/suffering"]]},{"n":430,"l":["அறிவுடையார் எல்லா முடையார் அறிவிலார்","என்னுடைய ரேனும் இலர்."],"w":[["அறிவுடையார்",1,"Arivutaiyaar","the wise"],["எல்லா",1,"Ellaa","everything"],["முடையார்",1,"Mutaiyaar","(are those who) possess"],["அறிவிலார்",1,"Arivilaar","the unwise"],["என்னுடைய",2,"Ennutaiya","what(ever); possessing"],["ரேனும்",2,"Renum","though they possess; even though"],["இலர்",2,"Ilar","they have nothing / are without"]]}]}