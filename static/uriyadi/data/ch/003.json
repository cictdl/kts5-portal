{"n":3,"kurals":[{"n":21,"l":["ஒழுக்கத்து நீத்தார் பெருமை விழுப்பத்து","வேண்டும் பனுவல் துணிவு."],"w":[["ஒழுக்கத்து",1,"Ozhukkaththu","in conduct"],["நீத்தார்",1,"Neeththaar","those who renounced"],["பெருமை",1,"Perumai","greatness (obj.)"],["விழுப்பத்து",1,"Vizhuppaththu","in/among excellence"],["வேண்டும்",2,"Ventum","(that which the treatises) require"],["பனுவல்",2,"Panuval","treatises/books (subject of வேண்டும்)"],["துணிவு",2,"Thunivu","firm conclusion"]]},{"n":22,"l":["துறந்தார் பெருமை துணைக்கூறின் வையத்து","இறந்தாரை எண்ணிக்கொண் டற்று."],"w":[["துறந்தார்",1,"Thurandhaar","those who renounced"],["பெருமை",1,"Perumai","greatness (obj.)"],["துணைக்கூறின்",1,"Thunaikkoorin","measure/extent; if one tells/measures"],["வையத்து",1,"Vaiyaththu","in the world"],["இறந்தாரை",2,"Irandhaarai","those who died (obj.)"],["எண்ணிக்கொண்",2,"Ennikkon","having counted; having reckoned (aux.)"],["டற்று",2,"Tatru","like that / of that nature"]]},{"n":23,"l":["இருமை வகைதெரிந்து ஈண்டுஅறம் பூண்டார்","பெருமை பிறங்கிற்று உலகு."],"w":[["இருமை",1,"Irumai","the two (states: this-world/next)"],["வகைதெரிந்து",1,"Vakaidherindhu","kinds/divisions (obj.); having discerned"],["ஈண்டுஅறம்",1,"Eentuaram","here (in this world); virtue (obj.)"],["பூண்டார்",1,"Poontaar","those who undertook"],["பெருமை",2,"Perumai","greatness (subj.)"],["பிறங்கிற்று",2,"Pirangitru","shone forth / is exalted"],["உலகு",2,"Ulaku","in the world (loc., உருபு மறைந்தது)"]]},{"n":24,"l":["உரனென்னும் தோட்டியான் ஓரைந்தும் காப்பான்","வரனென்னும் வைப்பிற்கோர் வித்து."],"w":[["உரனென்னும்",1,"Uranennum","firmness/strength of mind; called/named (modifies தோட்டி)"],["தோட்டியான்",1,"Thottiyaan","with the goad/hook"],["ஓரைந்தும்",1,"Oraindhum","the (one whole set of); all five (senses)"],["காப்பான்",1,"Kaappaan","he who guards"],["வரனென்னும்",2,"Varanennum","the supreme (heavenly abode); called/named (modifies வைப்பு)"],["வைப்பிற்கோர்",2,"Vaippirkor","for the (heavenly) abode; a/one"],["வித்து",2,"Viththu","a seed"]]},{"n":25,"l":["ஐந்தவித்தான் ஆற்றல் அகல்விசும்பு ளார்கோமான்","இந்திரனே சாலுங் கரி."],"w":[["ஐந்தவித்தான்",1,"Aindhaviththaan","the five (senses, obj.); he who extinguished"],["ஆற்றல்",1,"Aatral","for (his) power (உருபு மறைந்தது)"],["அகல்விசும்பு",1,"Akalvisumpu","wide; sky/heaven (loc.)"],["ளார்கோமான்",1,"Laarkomaan","those who dwell (in); king/lord"],["இந்திரனே",2,"Indhirane","Indra; even/emphatic"],["சாலுங்",2,"Saalung","sufficient/fitting (modifies கரி)"],["கரி",2,"Kari","witness"]]},{"n":26,"l":["செயற்கரிய செய்வார் பெரியர் சிறியர்","செயற்கரிய செய்கலா தார்."],"w":[["செயற்கரிய",1,"Seyarkariya","to do (for doing); difficult things"],["செய்வார்",1,"Seyvaar","those who do"],["பெரியர்",1,"Periyar","are the great"],["சிறியர்",1,"Siriyar","are the small"],["செயற்கரிய",2,"Seyarkariya","to do (for doing); difficult things"],["செய்கலா",2,"Seykalaa","(those) unable to do"],["தார்",2,"Thaar","those (who do not do)"]]},{"n":27,"l":["சுவைஒளி ஊறுஓசை நாற்றமென்று ஐந்தின்","வகைதெரிவான் கட்டே உலகு."],"w":[["சுவைஒளி",1,"Suvaioli","taste; sight/light"],["ஊறுஓசை",1,"Ooruosai","touch; sound"],["நாற்றமென்று",1,"Naatramendru","smell; thus (named/enumerated)"],["ஐந்தின்",1,"Aindhin","of the five"],["வகைதெரிவான்",2,"Vakaidherivaan","kinds (obj.); he who discerns"],["கட்டே",2,"Katte","in the grasp/control of; emphatic"],["உலகு",2,"Ulaku","the world (subj.)"]]},{"n":28,"l":["நிறைமொழி மாந்தர் பெருமை நிலத்து","மறைமொழி காட்டி விடும்."],"w":[["நிறைமொழி",1,"Niraimozhi","full/perfect; word/speech"],["மாந்தர்",1,"Maandhar","(of) people/men"],["பெருமை",1,"Perumai","greatness (obj.)"],["நிலத்து",1,"Nilaththu","in the land/world"],["மறைமொழி",2,"Maraimozhi","hidden/sacred (mantra); word(s) (subject of விடும்)"],["காட்டி",2,"Kaatti","having shown/revealing"],["விடும்",2,"Vitum","will (assuredly) display"]]},{"n":29,"l":["குணமென்னும் குன்றேறி நின்றார் வெகுளி","கணமேயும் காத்தல் அரிது."],"w":[["குணமென்னும்",1,"Kunamennum","virtue/quality; called/named (modifies குன்று)"],["குன்றேறி",1,"Kundreri","hill (obj.); having climbed"],["நின்றார்",1,"Nindraar","those who stood (firm)"],["வெகுளி",1,"Vekuli","wrath/anger (obj. of காத்தல்)"],["கணமேயும்",2,"Kanameyum","a moment; even (emphatic); even/also"],["காத்தல்",2,"Kaaththal","guarding/holding (anger)"],["அரிது",2,"Aridhu","is difficult"]]},{"n":30,"l":["அந்தணர் என்போர் அறவோர்மற் றெவ்வுயிர்க்கும்","செந்தண்மை பூண்டொழுக லான்."],"w":[["அந்தணர்",1,"","the noble/compassionate ones (Brahmins)"],["என்போர்",1,"","those who are called (so)"],["அறவோர்மற்",1,"","the virtuous ones; moreover/and"],["றெவ்வுயிர்க்கும்",1,"","towards every living being; all/even (inclusive)"],["செந்தண்மை",2,"","upright/good (lit. red); grace/compassion (obj.)"],["பூண்டொழுக",2,"","having taken up/wearing; to conduct/live (by)"],["லான்",2,"","because of (instr./causal)"]]}]}