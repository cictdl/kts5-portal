{"n":8,"kurals":[{"n":71,"l":["அன்பிற்கும் உண்டோ அடைக்குந்தாழ் ஆர்வலர்","புன்கணீர் பூசல் தரும்."],"w":[["அன்பிற்கும்",1,"Anpirkum","even for love; even (concessive um)"],["உண்டோ",1,"Unto","exists / is there; interrogative O"],["அடைக்குந்தாழ்",1,"Ataikkundhaazh","that bolts/shuts; bolt, latch"],["ஆர்வலர்",1,"Aarvalar","affectionate ones (the loving)"],["புன்கணீர்",2,"Punkaneer","sorrow, distress; tears, water"],["பூசல்",2,"Poosal","uproar, public proclaiming"],["தரும்",2,"Tharum","will give/cause"]]},{"n":72,"l":["அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார்","என்பும் உரியர் பிறர்க்கு."],"w":[["அன்பிலார்",1,"Anpilaar","those without love"],["எல்லாம்",1,"Ellaam","all (things)"],["தமக்குரியர்",1,"Thamakkuriyar","to themselves; are entitled/owners"],["அன்புடையார்",1,"Anputaiyaar","those possessing love"],["என்பும்",2,"Enpum","bone; even (inclusive um)"],["உரியர்",2,"Uriyar","are belonging/entitled"],["பிறர்க்கு",2,"Pirarkku","to others"]]},{"n":73,"l":["அன்போடு இயைந்த வழக்கென்ப ஆருயிர்க்கு","என்போடு இயைந்த தொடர்பு."],"w":[["அன்போடு",1,"Anpotu","with love"],["இயைந்த",1,"Iyaindha","that joined/united"],["வழக்கென்ப",1,"Vazhakkenpa","way of life, custom; they say"],["ஆருயிர்க்கு",1,"Aaruyirkku","rare, precious; for the precious life"],["என்போடு",2,"Enpotu","with bone (body)"],["இயைந்த",2,"Iyaindha","that joined/united"],["தொடர்பு",2,"Thotarpu","connection, bond"]]},{"n":74,"l":["அன்புஈனும் ஆர்வம் உடைமை அதுஈனும்","நண்பென்னும் நாடாச் சிறப்பு."],"w":[["அன்புஈனும்",1,"","love; begets, yields"],["ஆர்வம்",1,"","eagerness, attachment"],["உடைமை",1,"","possessing, having"],["அதுஈனும்",1,"","that; begets, yields"],["நண்பென்னும்",2,"",""],["நாடாச்",2,"","unsought, not-seeking"],["சிறப்பு",2,"","excellence, distinction"]]},{"n":75,"l":["அன்புற்று அமர்ந்த வழக்கென்ப வையகத்து","இன்புற்றார் எய்தும் சிறப்பு."],"w":[["அன்புற்று",1,"Anputru","having loved/attained love"],["அமர்ந்த",1,"Amarndha","that settled/dwelt in peace"],["வழக்கென்ப",1,"Vazhakkenpa","way of life, custom; they say"],["வையகத்து",1,"Vaiyakaththu","in the world"],["இன்புற்றார்",2,"Inputraar","those who attained joy"],["எய்தும்",2,"Eydhum","that they attain"],["சிறப்பு",2,"Sirappu","excellence, distinction"]]},{"n":76,"l":["அறத்திற்கே அன்புசார் பென்ப அறியார்","மறத்திற்கும் அஃதே துணை."],"w":[["அறத்திற்கே",1,"Araththirke","for virtue; only (exclusive E)"],["அன்புசார்",1,"Anpusaar","love; support, prop"],["பென்ப",1,"Penpa","they say"],["அறியார்",1,"Ariyaar","ignorant ones (those who know not)"],["மறத்திற்கும்",2,"Maraththirkum","for valour/evil deed; also (inclusive um)"],["அஃதே",2,"Aqdhe","that (love); itself, only (E)"],["துணை",2,"Thunai","aid, support"]]},{"n":77,"l":["என்பி லதனை வெயில்போலக் காயுமே","அன்பி லதனை அறம்."],"w":[["என்பி",1,"Enpi","bone; without, lacking"],["லதனை",1,"Ladhanai","that one (worm)"],["வெயில்போலக்",1,"Veyilpolak","sunshine, heat; like (comparison particle)"],["காயுமே",1,"Kaayume","scorches, burns; emphatic E (asai)"],["அன்பி",2,"Anpi","love; without, lacking"],["லதனை",2,"Ladhanai","that one (life)"],["அறம்",2,"Aram","virtue, dharma"]]},{"n":78,"l":["அன்பகத் தில்லா உயிர்வாழ்க்கை வன்பாற்கண்","வற்றல் மரந்தளிர்த் தற்று."],"w":[["அன்பகத்",1,"Anpakath","love; in the heart/inside"],["தில்லா",1,"Thillaa","that has not, lacking"],["உயிர்வாழ்க்கை",1,"Uyirvaazhkkai","life, soul; living, life-mode"],["வன்பாற்கண்",1,"Vanpaarkan","barren/harsh tract; in (locative kaN)"],["வற்றல்",2,"Vatral","dried-up, withered"],["மரந்தளிர்த்",2,"Marandhalirth","tree; having sprouted/budded"],["தற்று",2,"Thatru","like that, suchwise (comparative ending)"]]},{"n":79,"l":["புறத்துறுப் பெல்லாம் எவன்செய்யும் யாக்கை","அகத்துறுப்பு அன்பி லவர்க்கு."],"w":[["புறத்துறுப்",1,"Puraththurup","outer, external; limb, organ"],["பெல்லாம்",1,"Pellaam","all"],["எவன்செய்யும்",1,"Evanseyyum","what (interrogative); will do/avail"],["யாக்கை",1,"Yaakkai","body"],["அகத்துறுப்பு",2,"Akaththuruppu","inner, internal; limb, organ"],["அன்பி",2,"Anpi","love; without"],["லவர்க்கு",2,"Lavarkku","to those (lacking love)"]]},{"n":80,"l":["அன்பின் வழியது உயிர்நிலை அஃதிலார்க்கு","என்புதோல் போர்த்த உடம்பு."],"w":[["அன்பின்",1,"Anpin","of love"],["வழியது",1,"Vazhiyadhu","that which is on the path of"],["உயிர்நிலை",1,"Uyirnilai","life, soul; abode, state"],["அஃதிலார்க்கு",1,"Aqdhilaarkku","that (love); for those without it"],["என்புதோல்",2,"Enpudhol","bone; skin"],["போர்த்த",2,"Porththa","that covered/wrapped"],["உடம்பு",2,"Utampu","body"]]}]}