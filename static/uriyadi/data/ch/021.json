{"n":21,"kurals":[{"n":201,"l":["தீவினையார் அஞ்சார் விழுமியார் அஞ்சுவர்","தீவினை என்னும் செருக்கு."],"w":[["தீவினையார்",1,"Theevinaiyaar","those with evil deeds / sinners"],["அஞ்சார்",1,"Anjaar","fear not"],["விழுமியார்",1,"Vizhumiyaar","the worthy / noble ones"],["அஞ்சுவர்",1,"Anjuvar","(they) will fear"],["தீவினை",2,"Theevinai","evil deed"],["என்னும்",2,"Ennum","called / that is"],["செருக்கு",2,"Serukku","pride / arrogance"]]},{"n":202,"l":["தீயவை தீய பயத்தலால் தீயவை","தீயினும் அஞ்சப் படும்."],"w":[["தீயவை",1,"Theeyavai","evil things"],["தீய",1,"Theeya","evil (things) / that which is bad"],["பயத்தலால்",1,"Payaththalaal","because of yielding/producing"],["தீயவை",1,"Theeyavai","evil things"],["தீயினும்",2,"Theeyinum","than fire; even (intensive)"],["அஞ்சப்",2,"Anjap","so as to fear / to be feared"],["படும்",2,"Patum","will be (feared) / it is done"]]},{"n":203,"l":["அறிவினுள் எல்லாந் தலையென்ப தீய","செறுவார்க்கும் செய்யா விடல்."],"w":[["அறிவினுள்",1,"Arivinul","within (all) knowledge"],["எல்லாந்",1,"Ellaan","all"],["தலையென்ப",1,"Thalaiyenpa","foremost / chief; they say / it is said"],["தீய",1,"Theeya","evil (deeds)"],["செறுவார்க்கும்",2,"Seruvaarkkum","to those who harm/are hostile; even"],["செய்யா",2,"Seyyaa","not doing"],["விடல்",2,"Vital","leaving off / refraining"]]},{"n":204,"l":["மறந்தும் பிறன்கேடு சூழற்க சூழின்","அறஞ்சூழும் சூழ்ந்தவன் கேடு."],"w":[["மறந்தும்",1,"Marandhum","(even) forgetting; even"],["பிறன்கேடு",1,"Piranketu","another's; ruin / harm"],["சூழற்க",1,"Soozharka","do not plot/think (prohibitive)"],["சூழின்",1,"Soozhin","if (one) plots"],["அறஞ்சூழும்",2,"Aranjoozhum","virtue / dharma; (virtue) will plot/encircle"],["சூழ்ந்தவன்",2,"Soozhndhavan","the one who plotted"],["கேடு",2,"Ketu","ruin"]]},{"n":205,"l":["இலன்என்று தீயவை செய்யற்க செய்யின்","இலனாகும் மற்றும் பெயர்த்து."],"w":[["இலன்என்று",1,"","(I am) poor / without (wealth); thinking that / saying that"],["தீயவை",1,"","evil things"],["செய்யற்க",1,"","do not do (prohibitive)"],["செய்யின்",1,"","if (one) does"],["இலனாகும்",2,"","will become poor"],["மற்றும்",2,"","again / further"],["பெயர்த்து",2,"","again / once more (having turned)"]]},{"n":206,"l":["தீப்பால தான்பிறர்கண் செய்யற்க நோய்ப்பால","தன்னை அடல்வேண்டா தான்."],"w":[["தீப்பால",1,"Theeppaala","things of evil kind"],["தான்பிறர்கண்",1,"Thaanpirarkan","oneself; on/toward others"],["செய்யற்க",1,"Seyyarka","do not do (prohibitive)"],["நோய்ப்பால",1,"Noippaala","things of the painful/harmful kind"],["தன்னை",2,"Thannai","himself (acc.)"],["அடல்வேண்டா",2,"Atalventaa","killing / afflicting; does not desire"],["தான்",2,"Thaan","(expletive/emphatic particle)"]]},{"n":207,"l":["எனைப்பகை யுற்றாரும் உய்வர் வினைப்பகை","வீயாது பின்சென்று அடும்."],"w":[["எனைப்பகை",1,"Enaippakai","however much / what kind; enmity / foe"],["யுற்றாரும்",1,"Yutraarum","those who got/had; even"],["உய்வர்",1,"Uyvar","(they) will survive/escape"],["வினைப்பகை",1,"Vinaippakai","enmity of (one's) deeds"],["வீயாது",2,"Veeyaadhu","without perishing"],["பின்சென்று",2,"Pinsendru","after / behind; having gone (following)"],["அடும்",2,"Atum","will kill / afflict"]]},{"n":208,"l":["தீயவை செய்தார் கெடுதல் நிழல்தன்னை","வீயாது அடியுறைந் தற்று."],"w":[["தீயவை",1,"Theeyavai","evil things"],["செய்தார்",1,"Seydhaar","those who did"],["கெடுதல்",1,"Ketudhal","perishing / ruin"],["நிழல்தன்னை",1,"Nizhaldhannai","shadow; itself (acc.)"],["வீயாது",2,"Veeyaadhu","without leaving/perishing"],["அடியுறைந்",2,"Atiyurain","dwelling at the foot (having stayed)"],["தற்று",2,"Thatru","like that (உவம உருபு)"]]},{"n":209,"l":["தன்னைத்தான் காதல னாயின் எனைத்தொன்றும்","துன்னற்க தீவினைப் பால்."],"w":[["தன்னைத்தான்",1,"Thannaiththaan","himself (acc.); oneself (nom.)"],["காதல",1,"Kaadhala","(is) one who loves"],["னாயின்",1,"Naayin","if (he) is"],["எனைத்தொன்றும்",1,"Enaiththondrum","however little / whatever amount; even one (thing)"],["துன்னற்க",2,"Thunnarka","do not approach (prohibitive)"],["தீவினைப்",2,"Theevinaip","evil deed"],["பால்",2,"Paal","side / direction / portion"]]},{"n":210,"l":["அருங்கேடன் என்பது அறிக மருங்கோடித்","தீவினை செய்யான் எனின்."],"w":[["அருங்கேடன்",1,"Arungetan","one to whom harm is rare (is unharmed)"],["என்பது",1,"Enpadhu","that which is said (the fact that)"],["அறிக",1,"Arika","know (you)! (let it be known)"],["மருங்கோடித்",1,"Marungotith","side / (wrong) path; running (astray)"],["தீவினை",2,"Theevinai","evil deed (obj.)"],["செய்யான்",2,"Seyyaan","(if he) does not do"],["எனின்",2,"Enin","if (it is said) / if"]]}]}