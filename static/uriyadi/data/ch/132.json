{"n":132,"kurals":[{"n":1311,"l":["பெண்ணியலார் எல்லாரும் கண்ணின் பொதுஉண்பர்","நண்ணேன் பரத்தநின் மார்பு."],"w":[["பெண்ணியலார்",1,"Penniyalaar","those of womanly nature"],["எல்லாரும்",1,"Ellaarum","all of them; inclusive -um"],["கண்ணின்",1,"Kannin","with (their) eyes; instrumental உருபு"],["பொதுஉண்பர்",1,"Podhuunpar","common(ly); they consume/feast (with the eye)"],["நண்ணேன்",2,"Nannen","I will not approach"],["பரத்தநின்",2,"Paraththanin","O lewd one (vocative); your"],["மார்பு",2,"Maarpu","chest/bosom"]]},{"n":1312,"l":["ஊடி இருந்தேமாத் தும்மினார் யாம்தம்மை","நீடுவாழ் கென்பாக் கறிந்து."],"w":[["ஊடி",1,"Ooti","having sulked"],["இருந்தேமாத்",1,"Irundhemaath","we remained; connective (ஆக) -aa"],["தும்மினார்",1,"Thumminaar","he sneezed"],["யாம்தம்மை",1,"Yaamdhammai","we; him (honorific)"],["நீடுவாழ்",2,"Neetuvaazh","long; may (you) live"],["கென்பாக்",2,"Kenpaak","(I) being one who would say"],["கறிந்து",2,"Karindhu","having known/perceived"]]},{"n":1313,"l":["கோட்டுப்பூச் சூடினும் காயும் ஒருத்தியைக்","காட்டிய சூடினீர் என்று."],"w":[["கோட்டுப்பூச்",1,"","of/on the branch; flower"],["சூடினும்",1,"","even if (I) wear; concessive even-if -um"],["காயும்",1,"","(she) will be angry"],["ஒருத்தியைக்",1,"","a certain woman"],["காட்டிய",2,"","in order to show"],["சூடினீர்",2,"","you wore (honorific)"],["என்று",2,"","saying / thus"]]},{"n":1314,"l":["யாரினும் காதலம் என்றேனா ஊடினாள்","யாரினும் யாரினும் என்று."],"w":[["யாரினும்",1,"Yaarinum","than anyone; even/than-all -um"],["காதலம்",1,"Kaadhalam","we are loving"],["என்றேனா",1,"Endrenaa","as I said; connective (ஆக) -aa"],["ஊடினாள்",1,"Ootinaal","she sulked"],["யாரினும்",2,"Yaarinum","than whom; even/than -um"],["யாரினும்",2,"Yaarinum","than whom; even/than -um"],["என்று",2,"Endru","saying / thus"]]},{"n":1315,"l":["இம்மைப் பிறப்பில் பிரியலம் என்றேனாக்","கண்நிறை நீர்கொண் டனள்."],"w":[["இம்மைப்",1,"Immaip","this (life/birth)"],["பிறப்பில்",1,"Pirappil","in (this) birth; locative உருபு"],["பிரியலம்",1,"Piriyalam","we will not part"],["என்றேனாக்",1,"Endrenaak","as I said; as/so (connective)"],["கண்நிறை",2,"Kannirai","(in the) eye; to fill / brimming"],["நீர்கொண்",2,"Neerkon","water/tears"],["டனள்",2,"Tanal","she held/filled"]]},{"n":1316,"l":["உள்ளினேன் என்றேன்மற் றென்மறந்தீர் என்றென்னைப்","புல்லாள் புலத்தக் கனள்."],"w":[["உள்ளினேன்",1,"Ullinen","I thought/remembered"],["என்றேன்மற்",1,"Endrenmar","I said; moreover / then"],["றென்மறந்தீர்",1,"Renmarandheer","why / what; you forgot"],["என்றென்னைப்",1,"Endrennaip","saying / thus; me"],["புல்லாள்",2,"Pullaal","she did not embrace"],["புலத்தக்",2,"Pulaththak","for/to sulking"],["கனள்",2,"Kanal","she became apt (to)"]]},{"n":1317,"l":["வழுத்தினாள் தும்மினேன் ஆக அழித்தழுதாள்","யாருள்ளித் தும்மினீர் என்று."],"w":[["வழுத்தினாள்",1,"Vazhuththinaal","she blessed"],["தும்மினேன்",1,"Thumminen","I sneezed"],["ஆக",1,"Aaka","as soon as / when"],["அழித்தழுதாள்",1,"Azhiththazhudhaal","having undone (the blessing); she wept"],["யாருள்ளித்",2,"Yaarullith","whom; having thought of"],["தும்மினீர்",2,"Thummineer","you sneezed (honorific)"],["என்று",2,"Endru","saying / thus"]]},{"n":1318,"l":["தும்முச் செறுப்ப அழுதாள் நுமர்உள்ளல்","எம்மை மறைத்திரோ என்று."],"w":[["தும்முச்",1,"Thummuch","sneeze"],["செறுப்ப",1,"Cheruppa","when (I) suppressed"],["அழுதாள்",1,"Azhudhaal","she wept"],["நுமர்உள்ளல்",1,"Numarullal","your people/kin; (their) thinking (of you)"],["எம்மை",2,"Emmai","us (from us)"],["மறைத்திரோ",2,"Maraiththiro","do you hide; interrogative -ō"],["என்று",2,"Endru","saying / thus"]]},{"n":1319,"l":["தன்னை உணர்த்தினும் காயும் பிறர்க்கும்நீர்","இந்நீரர் ஆகுதிர் என்று."],"w":[["தன்னை",1,"Thannai","her(self) / the sulk"],["உணர்த்தினும்",1,"Unarththinum","even if (I) appease/reveal; concessive even-if -um"],["காயும்",1,"Kaayum","(she) will be angry"],["பிறர்க்கும்நீர்",1,"Pirarkkumneer","to others; also -um; you (honorific)"],["இந்நீரர்",2,"Inneerar","(you) of this nature"],["ஆகுதிர்",2,"Aakudhir","you will become"],["என்று",2,"Endru","saying / thus"]]},{"n":1320,"l":["நினைத்திருந்து நோக்கினும் காயும் அனைத்துநீர்","யாருள்ளி நோக்கினீர் என்று."],"w":[["நினைத்திருந்து",1,"Ninaiththirundhu","having thought; remaining (and)"],["நோக்கினும்",1,"Nokkinum","even if (I) gaze; concessive even-if -um"],["காயும்",1,"Kaayum","(she) will be angry"],["அனைத்துநீர்",1,"Anaiththuneer","all that much / so; you (honorific)"],["யாருள்ளி",2,"Yaarulli","whom; having thought of"],["நோக்கினீர்",2,"Nokkineer","you gazed (honorific)"],["என்று",2,"Endru","saying / thus"]]}]}