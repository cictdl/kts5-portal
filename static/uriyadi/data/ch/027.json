{"n":27,"kurals":[{"n":261,"l":["உற்றநோய் நோன்றல் உயிர்க்குறுகண் செய்யாமை","அற்றே தவத்திற் குரு."],"w":[["உற்றநோய்",1,"Utranoi","befallen, which has come; suffering, pain"],["நோன்றல்",1,"Nondral","enduring, bearing"],["உயிர்க்குறுகண்",1,"Uyirkkurukan","to living beings; harm, injury"],["செய்யாமை",1,"Seyyaamai","not doing, abstaining (negative verbal noun)"],["அற்றே",2,"Atre","of that kind, suchlike; emphatic/affirmative particle (தேற்றம்)"],["தவத்திற்",2,"Thavaththir","for penance"],["குரு",2,"Kuru","form, definition, nature (வடிவம்)"]]},{"n":262,"l":["தவமும் தவமுடையார்க்கு ஆகும் அவமதனை","அஃதிலார் மேற்கொள் வது."],"w":[["தவமும்",1,"Thavamum","penance; even (emphatic/inclusive)"],["தவமுடையார்க்கு",1,"Thavamutaiyaarkku","penance; to those who possess"],["ஆகும்",1,"Aakum","becomes, is fitting"],["அவமதனை",1,"Avamadhanai","it, that (the penance-state)"],["அஃதிலார்",2,"Aqdhilaar","that (penance-disposition); those who lack it (are without)"],["மேற்கொள்",2,"Merkol","undertaking (verbal base of மேற்கொள்வது)"],["வது",2,"Vadhu","the act of undertaking (is vain)"]]},{"n":263,"l":["துறந்தார்க்குத் துப்புரவு வேண்டி மறந்தார்கொல்","மற்றை யவர்கள் தவம்."],"w":[["துறந்தார்க்குத்",1,"Thurandhaarkkuth","to those who have renounced"],["துப்புரவு",1,"Thuppuravu","food/sustenance, provisions"],["வேண்டி",1,"Venti","desiring, wishing (to help)"],["மறந்தார்கொல்",1,"Marandhaarkol","did they forget; doubt/interrogative particle"],["மற்றை",2,"Matrai","the other, remaining"],["யவர்கள்",2,"Yavarkal","they, those people"],["தவம்",2,"Thavam","penance (object of மறந்தார்)"]]},{"n":264,"l":["ஒன்னார்த் தெறலும் உவந்தாரை ஆக்கலும்","எண்ணின் தவத்தான் வரும்."],"w":[["ஒன்னார்த்",1,"Onnaarth","enemies, foes"],["தெறலும்",1,"Theralum","destroying, subduing; and (conjunctive)"],["உவந்தாரை",1,"Uvandhaarai","those who are loved/friends"],["ஆக்கலும்",1,"Aakkalum","elevating, prospering; and (conjunctive)"],["எண்ணின்",2,"Ennin","if (one) thinks/intends"],["தவத்தான்",2,"Thavaththaan","by/through penance"],["வரும்",2,"Varum","will come, results"]]},{"n":265,"l":["வேண்டிய வேண்டியாங் கெய்தலால் செய்தவம்","ஈண்டு முயலப் படும்."],"w":[["வேண்டிய",1,"Ventiya","(things) desired"],["வேண்டியாங்",1,"Ventiyaang","in the manner desired, just as wished"],["கெய்தலால்",1,"Keydhalaal","because of attaining"],["செய்தவம்",1,"Seydhavam","(to be) done; penance worth doing"],["ஈண்டு",2,"Eentu","here, in this state/world"],["முயலப்",2,"Muyalap","to strive (infinitive)"],["படும்",2,"Patum","is/will be (done) — passive auxiliary"]]},{"n":266,"l":["தவஞ்செய்வார் தங்கருமஞ் செய்வார்மற் றல்லார்","அவஞ்செய்வார் ஆசையுட் பட்டு."],"w":[["தவஞ்செய்வார்",1,"","penance; those who do"],["தங்கருமஞ்",1,"","their own; duty, task"],["செய்வார்மற்",1,"","those who do (their duty); moreover / as for the rest"],["றல்லார்",1,"","those who are not (so) — negative appellative verb"],["அவஞ்செய்வார்",2,"","vain/futile deed; those who do"],["ஆசையுட்",2,"","desire; within, inside (locative)"],["பட்டு",2,"","having fallen (into)"]]},{"n":267,"l":["சுடச்சுடரும் பொன்போல் ஒளிவிடும் துன்பஞ்","சுடச்சுட நோற்கிற் பவர்க்கு."],"w":[["சுடச்சுடரும்",1,"Sutachchutarum","as it burns (the more); which shines/glows"],["பொன்போல்",1,"Ponpol","gold; like, as (உவம உருபு / simile particle)"],["ஒளிவிடும்",1,"Olivitum","light, radiance; which emits/gives off (qualifies பொன்)"],["துன்பஞ்",1,"Thunpanjjch","suffering (subject of சுட)"],["சுடச்சுட",2,"Utachchuta","as (suffering) burns more and more"],["நோற்கிற்",2,"Norkir","those who perform penance"],["பவர்க்கு",2,"Pavarkku","for those who do penance"]]},{"n":268,"l":["தன்னுயிர் தான்அறப் பெற்றானை ஏனைய","மன்னுயி ரெல்லாந் தொழும்."],"w":[["தன்னுயிர்",1,"Thannuyir","one's own; (one's) life/soul"],["தான்அறப்",1,"Thaanarap","the 'I'/self-conceit; so as to be severed/removed"],["பெற்றானை",1,"Petraanai","him who has attained"],["ஏனைய",1,"Enaiya","the other (remaining) ones"],["மன்னுயி",2,"Mannuyi","the abiding/lasting living beings"],["ரெல்லாந்",2,"Rellaan","all"],["தொழும்",2,"Thozhum","will worship/revere"]]},{"n":269,"l":["கூற்றம் குதித்தலும் கைகூடும் நோற்றலின்","ஆற்றல் தலைப்பட் டவர்க்கு."],"w":[["கூற்றம்",1,"Kootram","Yama, Death"],["குதித்தலும்",1,"Kudhiththalum","leaping over, overcoming; even (emphatic)"],["கைகூடும்",1,"Kaikootum","will be achieved, becomes possible"],["நோற்றலின்",1,"Notralin","from/by penance"],["ஆற்றல்",2,"Aatral","power, strength"],["தலைப்பட்",2,"Thalaippat","those who have attained/obtained"],["டவர்க்கு",2,"Tavarkku","for those who have attained; expletive particle (யாப்பு அசை)"]]},{"n":270,"l":["இலர்பல ராகிய காரணம் நோற்பார்","சிலர்பலர் நோலா தவர்."],"w":[["இலர்பல",1,"Ilarpala","they are without (power), the destitute; many"],["ராகிய",1,"Raakiya","being, who are"],["காரணம்",1,"Kaaranam","the cause/reason"],["நோற்பார்",1,"Norpaar","those who do penance"],["சிலர்பலர்",2,"Silarpalar","few (persons); many (persons)"],["நோலா",2,"Nolaa","who do not do penance"],["தவர்",2,"Thavar","those (people)"]]}]}