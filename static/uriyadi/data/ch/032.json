{"n":32,"kurals":[{"n":311,"l":["சிறப்பீனும் செல்வம் பெறினும் பிறர்க்குஇன்னா","செய்யாமை மாசற்றார் கோள்."],"w":[["சிறப்பீனும்",1,"","that yields glory"],["செல்வம்",1,"","wealth"],["பெறினும்",1,"","if (one) gets; even"],["பிறர்க்குஇன்னா",1,"","to others; harm, pain"],["செய்யாமை",2,"","not doing (harm)"],["மாசற்றார்",2,"","the flawless ones"],["கோள்",2,"","principle, creed"]]},{"n":312,"l":["கறுத்துஇன்னா செய்தவக் கண்ணும் மறுத்தின்னா","செய்யாமை மாசற்றார் கோள்."],"w":[["கறுத்துஇன்னா",1,"Karuththuinnaa","being angry; harm"],["செய்தவக்",1,"Seydhavak","(that one) did; that"],["கண்ணும்",1,"Kannum","in (that) case; even"],["மறுத்தின்னா",1,"Maruththinnaa","in return; harm"],["செய்யாமை",2,"Seyyaamai","not doing (harm)"],["மாசற்றார்",2,"Maasatraar","the flawless ones"],["கோள்",2,"Kol","principle"]]},{"n":313,"l":["செய்யாமல் செற்றார்க்கும் இன்னாத செய்தபின்","உய்யா விழுமந் தரும்."],"w":[["செய்யாமல்",1,"Seyyaamal","without doing"],["செற்றார்க்கும்",1,"Setraarkkum","to those who hated; even"],["இன்னாத",1,"Innaadha","harmful things"],["செய்தபின்",1,"Seydhapin","having done; after"],["உய்யா",2,"Uyyaa","inescapable"],["விழுமந்",2,"Vizhuman","grief, distress"],["தரும்",2,"Tharum","(it) will give"]]},{"n":314,"l":["இன்னாசெய் தாரை ஒறுத்தல் அவர்நாண","நன்னயஞ் செய்து விடல்."],"w":[["இன்னாசெய்",1,"Innaasey","harm; (having) done"],["தாரை",1,"Thaarai","those who (did)"],["ஒறுத்தல்",1,"Oruththal","punishing"],["அவர்நாண",1,"Avarnaana","they; so that (they) feel shame"],["நன்னயஞ்",2,"Nannayanj","good benefit"],["செய்து",2,"Cheydhu","having done"],["விடல்",2,"Vital","to let go, forget"]]},{"n":315,"l":["அறிவினான் ஆகுவ துண்டோ பிறிதின்நோய்","தந்நோய்போல் போற்றாக் கடை."],"w":[["அறிவினான்",1,"Arivinaan","by wisdom"],["ஆகுவ",1,"Aakuva","things that result"],["துண்டோ",1,"Thunto","is there?; (question)"],["பிறிதின்நோய்",1,"Piridhinnoi","another's; pain"],["தந்நோய்போல்",2,"Thannoipol","one's own pain; like"],["போற்றாக்",2,"Potraak","(if one) does not cherish"],["கடை",2,"Katai","when, in the case that"]]},{"n":316,"l":["இன்னா எனத்தான் உணர்ந்தவை துன்னாமை","வேண்டும் பிறன்கண் செயல்."],"w":[["இன்னா",1,"Innaa","harmful"],["எனத்தான்",1,"Enaththaan","as, that; oneself"],["உணர்ந்தவை",1,"Unarndhavai","things (one) realised"],["துன்னாமை",1,"Thunnaamai","not approaching/doing"],["வேண்டும்",2,"Ventum","(it) is needed"],["பிறன்கண்",2,"Pirankan","on another; on, at"],["செயல்",2,"Seyal","act, doing"]]},{"n":317,"l":["எனைத்தானும் எஞ்ஞான்றும் யார்க்கும் மனத்தானாம்","மாணாசெய் யாமை தலை."],"w":[["எனைத்தானும்",1,"Enaiththaanum","however much; even"],["எஞ்ஞான்றும்",1,"Egngnaandrum","any time; (all)"],["யார்க்கும்",1,"Yaarkkum","to anyone; (any)"],["மனத்தானாம்",1,"Manaththaanaam","by the mind; (it) is/becomes"],["மாணாசெய்",2,"Maanaasey","unworthy, ignoble; deed (of)"],["யாமை",2,"Yaamai","not doing"],["தலை",2,"Thalai","foremost, best"]]},{"n":318,"l":["தன்னுயிர்க்கு இன்னாமை தானறிவான் என்கொலோ","மன்னுயிர்க்கு இன்னா செயல்."],"w":[["தன்னுயிர்க்கு",1,"Thannuyirkku","to one's own life"],["இன்னாமை",1,"Innaamai","what is painful"],["தானறிவான்",1,"Thaanarivaan","oneself; he who knows"],["என்கொலோ",1,"Enkolo","what; (doubt particle); (question)"],["மன்னுயிர்க்கு",2,"Mannuyirkku","to abiding lives"],["இன்னா",2,"Innaa","harm"],["செயல்",2,"Seyal","doing"]]},{"n":319,"l":["பிறர்க்கின்னா முற்பகல் செய்யின் தமக்குஇன்னா","பிற்பகல் தாமே வரும்."],"w":[["பிறர்க்கின்னா",1,"","to others; harm"],["முற்பகல்",1,"","forenoon"],["செய்யின்",1,"","if (one) does"],["தமக்குஇன்னா",1,"","to oneself; harm"],["பிற்பகல்",2,"","afternoon"],["தாமே",2,"","themselves; (emphasis)"],["வரும்",2,"","(they) will come"]]},{"n":320,"l":["நோயெல்லாம் நோய்செய்தார் மேலவாம் நோய்செய்யார்","நோயின்மை வேண்டு பவர்."],"w":[["நோயெல்லாம்",1,"Noyellaam","harms, sorrows; all"],["நோய்செய்தார்",1,"Noiseydhaar","harm; those who did"],["மேலவாம்",1,"Melavaam","those upon (them); (they) are"],["நோய்செய்யார்",1,"Noiseyyaar","harm; (they) do not do"],["நோயின்மை",2,"Noyinmai","freedom from harm"],["வேண்டு",2,"Ventu","(who) desire"],["பவர்",2,"Pavar","those who (are)"]]}]}