{"n":47,"kurals":[{"n":461,"l":["அழிவதூஉம் ஆவதூஉம் ஆகி வழிபயக்கும்","ஊதியமும் சூழ்ந்து செயல்."],"w":[["அழிவதூஉம்",1,"Azhivadhooum","that which is lost; and (inclusive)"],["ஆவதூஉம்",1,"Aavadhooum","that which becomes/gains; and (inclusive)"],["ஆகி",1,"Aaki","having become/considering"],["வழிபயக்கும்",1,"Vazhipayakkum","afterwards/in turn; that yields"],["ஊதியமும்",2,"Oodhiyamum","profit, gain; and (inclusive)"],["சூழ்ந்து",2,"Soozhndhu","having weighed/considered"],["செயல்",2,"Seyal","let one do (one should do)"]]},{"n":462,"l":["தெரிந்த இனத்தொடு தேர்ந்தெண்ணிச் செய்வார்க்கு","அரும்பொருள் யாதொன்றும் இல்"],"w":[["தெரிந்த",1,"Therindha","selected/discerned (adj)"],["இனத்தொடு",1,"Inaththotu","kinsmen/associates; with (comitative)"],["தேர்ந்தெண்ணிச்",1,"Therndhennich","having examined; having thought over"],["செய்வார்க்கு",1,"Cheyvaarkku","those who do; for (dative)"],["அரும்பொருள்",2,"Arumporul","difficult, rare; thing, matter, wealth"],["யாதொன்றும்",2,"Yaadhondrum","what/which; one (anything); even (with negative: at all)"],["இல்",2,"Il","there is not"]]},{"n":463,"l":["ஆக்கம் கருதி முதலிழக்கும் செய்வினை","ஊக்கார் அறிவுடை யார்."],"w":[["ஆக்கம்",1,"Aakkam","gain, increase"],["கருதி",1,"Karudhi","intending/aiming at"],["முதலிழக்கும்",1,"Mudhalizhakkum","capital, principal; that causes (one) to lose"],["செய்வினை",1,"Seyvinai","to-be-done (verb stem in compound); action, deed (to be done)"],["ஊக்கார்",2,"Ookkaar","(they) will not undertake"],["அறிவுடை",2,"Arivutai","wisdom, knowledge; possessing"],["யார்",2,"Yaar","those (the wise ones) — ending of அறிவுடையார்"]]},{"n":464,"l":["தெளிவி லதனைத் தொடங்கார் இளிவென்னும்","ஏதப்பாடு அஞ்சு பவர்."],"w":[["தெளிவி",1,"Thelivi","clarity, certainty"],["லதனைத்",1,"Ladhanaith","without (privative of தெளிவு); that (the unclear thing)"],["தொடங்கார்",1,"Thotangaar","(they) will not begin"],["இளிவென்னும்",1,"Ilivennum","disgrace, contempt; called/named (that which is)"],["ஏதப்பாடு",2,"Edhappaatu","fault, blemish"],["அஞ்சு",2,"Anju","fear (verb stem before பவர்)"],["பவர்",2,"Pavar","those who (fear)"]]},{"n":465,"l":["வகையறச் சூழா தெழுதல் பகைவரைப்","பாத்திப் படுப்பதோ ராறு."],"w":[["வகையறச்",1,"Vakaiyarach","kind, method, plan; completely (lit. so as to be exhausted)"],["சூழா",1,"Choozhaa","without considering"],["தெழுதல்",1,"Thezhudhal","rising up/setting out"],["பகைவரைப்",1,"Pakaivaraip","enemies; (accusative)"],["பாத்திப்",2,"Paaththip","garden-bed, plot"],["படுப்பதோ",2,"Patuppadho","that which establishes/plants"],["ராறு",2,"Raaru","a, one; way, means"]]},{"n":466,"l":["செய்தக்க அல்ல செயக்கெடும் செய்தக்க","செய்யாமை யானுங் கெடும்."],"w":[["செய்தக்க",1,"","fit to be done (adj)"],["அல்ல",1,"","are not (those unfit)"],["செயக்கெடும்",1,"","by doing (purposive); will be ruined"],["செய்தக்க",1,"","fit to be done (adj)"],["செய்யாமை",2,"","not-doing (omission)"],["யானுங்",2,"","by (instrumental); even (concessive)"],["கெடும்",2,"","will be ruined"]]},{"n":467,"l":["எண்ணித் துணிக கருமம் துணிந்தபின்","எண்ணுவம் என்பது இழுக்கு."],"w":[["எண்ணித்",1,"Ennith","having thought/planned"],["துணிக",1,"Thunika","let one resolve/dare"],["கருமம்",1,"Karumam","act, deed, task"],["துணிந்தபின்",1,"Thunindhapin","having resolved (adj); after, afterwards"],["எண்ணுவம்",2,"Ennuvam","we shall think"],["என்பது",2,"Enpadhu","that which says (the saying)"],["இழுக்கு",2,"Izhukku","fault, blemish, error"]]},{"n":468,"l":["ஆற்றின் வருந்தா வருத்தம் பலர்நின்று","போற்றினும் பொத்துப் படும்."],"w":[["ஆற்றின்",1,"Aatrin","way, method; by/through (the proper way)"],["வருந்தா",1,"Varundhaa","not-toiled-for (adj)"],["வருத்தம்",1,"Varuththam","effort, toil"],["பலர்நின்று",1,"Palarnindru","many people; standing by (helping)"],["போற்றினும்",2,"Potrinum","even though they protect/support"],["பொத்துப்",2,"Poththup","defect, flaw"],["படும்",2,"Patum","will incur/become"]]},{"n":469,"l":["நன்றாற்ற லுள்ளுந் தவறுண்டு அவரவர்","பண்பறிந் தாற்றாக் கடை."],"w":[["நன்றாற்ற",1,"Nandraatra","good (deed); in doing/performing"],["லுள்ளுந்",1,"Lullun","within, among; even (concessive)"],["தவறுண்டு",1,"Thavaruntu","fault, error; there is"],["அவரவர்",1,"Avaravar","each one's"],["பண்பறிந்",2,"Panparin","nature, quality; having known"],["தாற்றாக்",2,"Thaatraak","not performing (adj)"],["கடை",2,"Katai","when/in the case that"]]},{"n":470,"l":["எள்ளாத எண்ணிச் செயல்வேண்டும் தம்மொடு","கொள்ளாத கொள்ளாது உலகு."],"w":[["எள்ளாத",1,"Ellaadha","not-despised (which one does not scorn)"],["எண்ணிச்",1,"Ennich","having considered"],["செயல்வேண்டும்",1,"Cheyalventum","doing, action; (it) is necessary"],["தம்மொடு",1,"Thammotu","one's own self; with (one's station)"],["கொள்ளாத",2,"Kollaadha","what is not befitting (not accepted with)"],["கொள்ளாது",2,"Kollaadhu","(the world) does not accept"],["உலகு",2,"Ulaku","the world (people)"]]}]}