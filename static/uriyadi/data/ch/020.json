{"n":20,"kurals":[{"n":191,"l":["பல்லார் முனியப் பயனில சொல்லுவான்","எல்லாரும் எள்ளப் படும்."],"w":[["பல்லார்",1,"Pallaar","many people"],["முனியப்",1,"Muniyap","so as to detest/be vexed"],["பயனில",1,"Payanila","useless (lit. profit-less)"],["சொல்லுவான்",1,"Solluvaan","he who speaks"],["எல்லாரும்",2,"Ellaarum","everyone; inclusive/totality -um"],["எள்ளப்",2,"Ellap","so as to despise"],["படும்",2,"Patum","will be (subjected to)"]]},{"n":192,"l":["பயனில பல்லார்முன் சொல்லல் நயனில","நட்டார்கண் செய்தலிற் றீது."],"w":[["பயனில",1,"Payanila","useless (things)"],["பல்லார்முன்",1,"Pallaarmun","many people; before/in front of"],["சொல்லல்",1,"Sollal","the act of speaking"],["நயனில",1,"Nayanila","lacking virtue/justice"],["நட்டார்கண்",2,"Nattaarkan","friends; in/upon (locative)"],["செய்தலிற்",2,"Seydhalir","than the doing of; than (comparative)"],["றீது",2,"Reedhu","(is) evil/worse"]]},{"n":193,"l":["நயனிலன் என்பது சொல்லும் பயனில","பாரித் துரைக்கும் உரை."],"w":[["நயனிலன்",1,"Nayanilan","one without virtue"],["என்பது",1,"Enpadhu","that which says/the saying that"],["சொல்லும்",1,"Sollum","(that) tells/proclaims"],["பயனில",1,"Payanila","useless (things)"],["பாரித்",2,"Paarith","having expanded/elaborated"],["துரைக்கும்",2,"Thuraikkum","(that) speaks/utters"],["உரை",2,"Urai","speech/words"]]},{"n":194,"l":["நயன்சாரா நன்மையின் நீக்கும் பயன்சாராப்","பண்பில்சொல் பல்லா ரகத்து."],"w":[["நயன்சாரா",1,"Nayansaaraa","virtue/justice; not joining/not allied with"],["நன்மையின்",1,"Nanmaiyin","from goodness; from (ablative)"],["நீக்கும்",1,"Neekkum","removes/will remove"],["பயன்சாராப்",1,"Payansaaraap","profit/benefit; not yielding (profit)"],["பண்பில்சொல்",2,"Panpilsol","lacking quality/character; word/speech"],["பல்லா",2,"Pallaa","many people"],["ரகத்து",2,"Rakaththu","within/in the midst (of the assembly)"]]},{"n":195,"l":["சீர்மை சிறப்பொடு நீங்கும் பயனில","நீர்மை யுடையார் சொலின்."],"w":[["சீர்மை",1,"Seermai","excellence/greatness"],["சிறப்பொடு",1,"Sirappotu","distinction/honour; with/together