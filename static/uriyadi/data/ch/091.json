{"n":91,"kurals":[{"n":901,"l":["மனைவிழைவார் மாண்பயன் எய்தார் வினைவிழைவார்","வேண்டாப் பொருளும் அது."],"w":[["மனைவிழைவார்",1,"Manaivizhaivaar","wife (home); those who desire"],["மாண்பயன்",1,"Maanpayan","excellent; benefit"],["எய்தார்",1,"Eydhaar","do not attain"],["வினைவிழைவார்",1,"Vinaivizhaivaar","deed, duty; those who desire"],["வேண்டாப்",2,"Ventaap","not-wanted (which they do not desire)"],["பொருளும்",2,"Porulum","wealth/object; also (inclusive)"],["அது",2,"Adhu","that (the same)"]]},{"n":902,"l":["பேணாது பெண்விழைவான் ஆக்கம் பெரியதோர்","நாணாக நாணுத் தரும்."],"w":[["பேணாது",1,"Penaadhu","without cherishing/heeding"],["பெண்விழைவான்",1,"Penvizhaivaan","woman/wife; he who desires"],["ஆக்கம்",1,"Aakkam","wealth/prosperity"],["பெரியதோர்",1,"Periyadhor","great; a/one"],["நாணாக",2,"Naanaaka","shame; as/being (adverbial)"],["நாணுத்",2,"Naanuth","shame"],["தரும்",2,"Tharum","(it) gives"]]},{"n":903,"l":["இல்லாள்கண் தாழ்ந்த இயல்பின்மை எஞ்ஞான்றும்","நல்லாருள் நாணுத் தரும்."],"w":[["இல்லாள்கண்",1,"Illaalkan","the housewife; in/at (locative)"],["தாழ்ந்த",1,"Thaazhndha","lowered/submissive (which)"],["இயல்பின்மை",1,"Iyalpinmai","nature/quality; lack of, baseness"],["எஞ்ஞான்றும்",1,"Egngnaandrum","every time/always; ever (inclusive)"],["நல்லாருள்",2,"Nallaarul","the good (people); amongst"],["நாணுத்",2,"Naanuth","shame"],["தரும்",2,"Tharum","(it) gives"]]},{"n":904,"l":["மனையாளை அஞ்சும் மறுமையி லாளன்","வினையாண்மை வீறெய்த லின்று."],"w":[["மனையாளை",1,"Manaiyaalai","the housewife (obj); accusative"],["அஞ்சும்",1,"Anjum","who fears (which)"],["மறுமையி",1,"Marumaiyi","next world/afterlife (in)"],["லாளன்",1,"Laalan","the man (lacking)"],["வினையாண்மை",2,"Vinaiyaanmai","in action/deed; manliness/capability"],["வீறெய்த",2,"Veereydha","greatness/distinction; to attain"],["லின்று",2,"Lindru","is not / does not happen"]]},{"n":905,"l":["இல்லாளை அஞ்சுவான் அஞ்சுமற் றெஞ்ஞான்றும்","நல்லார்க்கு நல்ல செயல்."],"w":[["இல்லாளை",1,"Illaalai","the housewife (obj); accusative"],["அஞ்சுவான்",1,"Anjuvaan