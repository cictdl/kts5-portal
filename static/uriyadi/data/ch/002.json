{"n":2,"kurals":[{"n":11,"l":["வான்நின்று உலகம் வழங்கி வருதலால்","தான்அமிழ்தம் என்றுணரற் பாற்று."],"w":[["வான்நின்று",1,"Vaannindru","rain/sky; standing/being"],["உலகம்",1,"Ulakam","world"],["வழங்கி",1,"Vazhangi","thriving/proceeding"],["வருதலால்",1,"Varudhalaal","coming/happening; by/because"],["தான்அமிழ்தம்",2,"Thaanamizhdham","itself (expletive); ambrosia/nectar"],["என்றுணரற்",2,"Endrunarar","saying/that; realizing/knowing"],["பாற்று",2,"Paatru","is of the nature of"]]},{"n":12,"l":["துப்பார்க்குத் துப்பாய துப்பாக்கித் துப்பார்க்குத்","துப்பாய தூஉம் மழை."],"w":[["துப்பார்க்குத்",1,"Thuppaarkkuth","those who eat/enjoy; for/to"],["துப்பாய",1,"Thuppaaya","that are food/sustenance"],["துப்பாக்கித்",1,"Thuppaakkith","having made into food"],["துப்பார்க்குத்",1,"Thuppaarkkuth","those who eat/enjoy; for/to"],["துப்பாய",2,"Thuppaaya","that is food/sustenance"],["தூஉம்",2,"Thooum","food/that which is consumed"],["மழை",2,"Mazhai","rain"]]},{"n":13,"l":["விண்இன்று பொய்ப்பின் விரிநீர் வியனுலகத்து","உள்நின்று உடற்றும் பசி."],"w":[["விண்இன்று",1,"Vinindru","sky; not being/without"],["பொய்ப்பின்",1,"Poippin","if it fails"],["விரிநீர்",1,"Virineer","spreading/wide; water (sea)"],["வியனுலகத்து",1,"Viyanulakaththu","wide/vast; in the world"],["உள்நின்று",2,"Ulnindru","inside/within; remaining/standing"],["உடற்றும்",2,"Utatrum","will torment"],["பசி",2,"Pasi","hunger"]]},{"n":14,"l":["ஏரின் உழாஅர் உழவர் புயல்என்னும்","வாரி வளங்குன்றிக் கால்."],"w":[["ஏரின்",1,"Erin","plough; with/by"],["உழாஅர்",1,"Uzhaaar","will not plough"],["உழவர்",1,"Uzhavar","ploughmen/farmers"],["புயல்என்னும்",1,"Puyalennum","rain/cloud; called/named"],["வாரி",2,"Vaari","wealth/revenue source"],["வளங்குன்றிக்",2,"Valangundrik","abundance; having diminished"],["கால்",2,"Kaal","channel/source (of water)"]]},{"n":15,"l":["கெடுப்பதூஉம் கெட்டார்க்குச் சார்வாய்மற் றாங்கே","எடுப்பதூஉம் எல்லாம் மழை."],"w":[["கெடுப்பதூஉம்",1,"Ketuppadhooum","that which destroys; also/and"],["கெட்டார்க்குச்",1,"Kettaarkkuch","those who 