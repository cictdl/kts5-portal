{"n":110,"kurals":[{"n":1091,"l":["இருநோக்கு இவளுண்கண் உள்ளது ஒருநோக்கு","நோய்நோக்கொன் றந்நோய் மருந்து."],"w":[["இருநோக்கு",1,"Irunokku","two; glance/look"],["இவளுண்கண்",1,"Ivalunkan","her/this woman's; the collyrium-painted eye"],["உள்ளது",1,"Ulladhu","that which exists"],["ஒருநோக்கு",1,"Orunokku","one; glance"],["நோய்நோக்கொன்",2,"Noinokkon","affliction/sickness; (is) the glance (causing sickness); one (of them)"],["றந்நோய்",2,"Rannoi","for that affliction"],["மருந்து",2,"Marundhu","medicine/remedy"]]},{"n":1092,"l":["கண்களவு கொள்ளும் சிறுநோக்கம் காமத்தில்","செம்பாகம் அன்று பெரிது."],"w":[["கண்களவு",1,"Kankalavu","by the eye; stealth"],["கொள்ளும்",1,"Kollum","that takes (steals)"],["சிறுநோக்கம்",1,"Sirunokkam","small/slight; glance"],["காமத்தில்",1,"Kaamaththil","in love/desire"],["செம்பாகம்",2,"Sempaakam","exact/equal; half/portion"],["அன்று",2,"Andru","is not"],["பெரிது",2,"Peridhu","(is) greater"]]},{"n":1093,"l":["நோக்கினாள் நோக்கி இறைஞ்சினாள் அஃதவள்","யாப்பினுள் அட்டிய நீர்."],"w":[["நோக்கினாள்",1,"Nokkinaal","she looked"],["நோக்கி",1,"Nokki","looking"],["இறைஞ்சினாள்",1,"Irainjinaal","she bowed (her head)"],["அஃதவள்",1,"Aqdhaval","that (act); her"],["யாப்பினுள்",2,"Yaappinul","within (her) binding love"],["அட்டிய",2,"Attiya","that (she) poured"],["நீர்",2,"Neer","water"]]},{"n":1094,"l":["யான்நோக்கும் காலை நிலன்நோக்கும் நோக்காக்கால்","தான்நோக்கி மெல்ல நகும்."],"w":[["யான்நோக்கும்",1,"Yaannokkum","I; (when I) look"],["காலை",1,"Kaalai","at the time (when)"],["நிலன்நோக்கும்",1,"Nilannokkum","the ground; (she) looks at"],["நோக்காக்கால்",1,"Nokkaakkaal","when (I) do not look"],["தான்நோக்கி",2,"Thaannokki","she herself; looking (at me)"],["மெல்ல",2,"Mella","gently/softly"],["நகும்",2,"Nakum","(she) smiles"]]},{"n":1095,"l":["குறிக்கொண்டு நோக்காமை அல்லால் ஒருகண்","சிறக்கணித்தாள் போல நகும்"],"w":[["குறிக்கொண்டு",1,"Kurikkontu","a mark/aim; taking (aim), fixedly"],["நோக்காமை",1,"Nokkaamai","not looking"],["அல்லால்",1,"Allaal","except/other than"],["ஒருகண்",1,"Orukan","one; (one) eye"],["சிறக்கணித்தாள்",2,"Sirakkaniththaal","(she who) narrowed (an eye)"],["போல",2,"Pola","like/as if"],["நகும்",2,"Nakum","(she) smiles"]]},{"n":1096,"l":["உறாஅ தவர்போல் சொலினும் செறாஅர்சொல்","ஒல்லை உணரப் படும்."],"w":[["உறாஅ",1,"Uraaa","not loving/close"],["தவர்போல்",1,"Thavarpol","those (persons); like"],["சொலினும்",1,"Solinum","even if (they) speak"],["செறாஅர்சொல்",1,"Seraaarsol","those without enmity; (their) word"],["ஒல்லை",2,"Ollai","quickly/soon"],["உணரப்",2,"Unarap","to be understood"],["படும்",2,"Patum","will be (understood)"]]},{"n":1097,"l":["செறாஅச் சிறுசொல்லும் செற்றார்போல் நோக்கும்","உறாஅர்போன்று உற்றார் குறிப்பு."],"w":[["செறாஅச்",1,"Seraaach","without enmity"],["சிறுசொல்லும்",1,"Chirusollum","harsh/petty; word; and/even"],["செற்றார்போல்",1,"Setraarpol","those who hate; like"],["நோக்கும்",1,"Nokkum","(angry) look, and; and/even"],["உறாஅர்போன்று",2,"Uraaarpondru","strangers/the unattached; as if"],["உற்றார்",2,"Utraar","(of) the loving ones"],["குறிப்பு",2,"Kurippu","(secret) sign/hint"]]},{"n":1098,"l":["அசையியற்கு உண்டாண்டோர் ஏஎர்யான் நோக்கப்","பசையினள் பைய நகும்."],"w":[["அசையியற்கு",1,"Asaiyiyarku","for the slender-natured maid"],["உண்டாண்டோர்",1,"Untaantor","there is; there/at that (time); a/one"],["ஏஎர்யான்",1,"Eeryaan","beauty/grace; I"],["நோக்கப்",1,"Nokkap","when (I) look"],["பசையினள்",2,"Pasaiyinal","(she) softens with affection"],["பைய",2,"Paiya","gently/slowly"],["நகும்",2,"Nakum","(she) smiles"]]},{"n":1099,"l":["ஏதிலார் போலப் பொதுநோக்கு நோக்குதல்","காதலார் கண்ணே உள."],"w":[["ஏதிலார்",1,"Edhilaar","strangers"],["போலப்",1,"Polap","like"],["பொதுநோக்கு",1,"Podhunokku","common/indifferent; (common) glance"],["நோக்குதல்",1,"Nokkudhal","the looking"],["காதலார்",2,"Kaadhalaar","(of) lovers"],["கண்ணே",2,"Kanne","in/among; (emphatic)"],["உள",2,"Ula","(they) exist"]]},{"n":1100,"l":["கண்ணொடு கண்இணை நோக்கொக்கின் வாய்ச்சொற்கள்","என்ன பயனும் இல."],"w":[["கண்ணொடு",1,"Kannotu","with the eye"],["கண்இணை",1,"Kaninai","(of the other's) eye; pair/the (joining) eye"],["நோக்கொக்கின்",1,"Nokkokkin","in glance; if (they) agree/match"],["வாய்ச்சொற்கள்",1,"Vaaichchorkal","of the mouth; words"],["என்ன",2,"Enna","what(ever)"],["பயனும்",2,"Payanum","use/benefit; even (any)"],["இல",2,"Ila","(they) are none/useless"]]}]}