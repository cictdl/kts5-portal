{"n":61,"kurals":[{"n":601,"l":["குடியென்னும் குன்றா விளக்கம் மடியென்னும்","மாசூர மாய்ந்து கெடும்."],"w":[["குடியென்னும்",1,"Kutiyennum","family/lineage; called/named (qualifying)"],["குன்றா",1,"Kundraa","undiminishing (qualifying)"],["விளக்கம்",1,"Vilakkam","lamp/light"],["மடியென்னும்",1,"Matiyennum","sloth/idleness; called/named (qualifying)"],["மாசூர",2,"Maasoora","stain/blemish; as it spreads/clings"],["மாய்ந்து",2,"Maaindhu","having faded"],["கெடும்",2,"Ketum","will perish"]]},{"n":602,"l":["மடியை மடியா ஒழுகல் குடியைக்","குடியாக வேண்டு பவர்."],"w":[["மடியை",1,"Matiyai","sloth (acc.)"],["மடியா",1,"Matiyaa","as sloth (treating it as sloth)"],["ஒழுகல்",1,"Ozhukal","conducting/living"],["குடியைக்",1,"Kutiyaik","family (acc.)"],["குடியாக",2,"Kutiyaaka","as a (good) family"],["வேண்டு",2,"Ventu","desire (qualifying base of வேண்டுபவர்)"],["பவர்",2,"Pavar","those who (desire)"]]},{"n":603,"l":["மடிமடிக் கொண்டொழுகும் பேதை பிறந்த","குடிமடியும் தன்னினும் முந்து."],"w":[["மடிமடிக்",1,"Matimatik","sloth itself (emphatic)"],["கொண்டொழுகும்",1,"Kontozhukum","having taken; who lives/conducts (qualifying)"],["பேதை",1,"Pedhai","fool"],["பிறந்த",1,"Pirandha","(in which he) was born"],["குடிமடியும்",2,"Kutimatiyum","family; will perish"],["தன்னினும்",2,"Thanninum","than himself; even"],["முந்து",2,"Mundhu","before/earlier"]]},{"n":604,"l":["குடிமடிந்து குற்றம் பெருகும் மடிமடிந்து","மாண்ட உஞற்றி லவர்க்கு."],"w":[["குடிமடிந்து",1,"Kutimatindhu","family; having decayed"],["குற்றம்",1,"Kutram","fault/blemish"],["பெருகும்",1,"Perukum","will increase"],["மடிமடிந்து",1,"Matimatindhu","sloth; having sunk (in sloth)"],["மாண்ட",2,"Maanta","excellent/noble (qualifying)"],["உஞற்றி",2,"Ugnatri","having striven"],["லவர்க்கு",2,"Lavarkku","to those without (striving)"]]},{"n":605,"l":["நெடுநீர் மறவி மடிதுயில் நான்கும்","கெடுநீரார் காமக் கலன்."],"w":[["நெடுநீர்",1,"Netuneer","procrastination/delaying"],["மறவி",1,"Maravi","forgetfulness"],["மடிதுயில்",1,"Matidhuyil","sloth; sleep"],["நான்கும்",1,"Na