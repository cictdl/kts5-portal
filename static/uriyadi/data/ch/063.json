{"n":63,"kurals":[{"n":621,"l":["இடுக்கண் வருங்கால் நகுக அதனை","அடுத்தூர்வது அஃதொப்ப தில்."],"w":[["இடுக்கண்",1,"Itukkan","trouble"],["வருங்கால்",1,"Varungaal","when it comes"],["நகுக",1,"Nakuka","let one laugh"],["அதனை",1,"Adhanai","it (the trouble)"],["அடுத்தூர்வது",2,"Atuththoorvadhu","that which presses on and conquers"],["அஃதொப்ப",2,"Aqdhoppa","that; being equal to"],["தில்",2,"Thil","expletive (desiderative)"]]},{"n":622,"l":["வெள்ளத் தனைய இடும்பை அறிவுடையான்","உள்ளத்தின் உள்ளக் கெடும்."],"w":[["வெள்ளத்",1,"Vellath","flood"],["தனைய",1,"Thanaiya","as much as"],["இடும்பை",1,"Itumpai","sorrow"],["அறிவுடையான்",1,"Arivutaiyaan","the wise man"],["உள்ளத்தின்",2,"Ullaththin","by the mind"],["உள்ளக்",2,"Ullak","on thinking"],["கெடும்",2,"Ketum","(it) will perish"]]},{"n":623,"l":["இடும்பைக்கு இடும்பை படுப்பர் இடும்பைக்கு","இடும்பை படாஅ தவர்."],"w":[["இடும்பைக்கு",1,"Itumpaikku","to the trouble"],["இடும்பை",1,"Itumpai","trouble (obj.)"],["படுப்பர்",1,"Patuppar","will cause to suffer"],["இடும்பைக்கு",1,"Itumpaikku","to the trouble"],["இடும்பை",2,"Itumpai","trouble (obj.)"],["படாஅ",2,"Pataaa","not suffering (rel.)"],["தவர்",2,"Thavar","those who"]]},{"n":624,"l":["மடுத்தவா யெல்லாம் பகடன்னான் உற்ற","இடுக்கண் இடர்ப்பாடு உடைத்து."],"w":[["மடுத்தவா",1,"Matuththavaa","obstructed; place/spot"],["யெல்லாம்",1,"Yellaam","all"],["பகடன்னான்",1,"Pakatannaan","draught-ox; one like (the ox)"],["உற்ற",1,"Utra","that befell"],["இடுக்கண்",2,"Itukkan","trouble"],["இடர்ப்பாடு",2,"Itarppaatu","distress/suffering"],["உடைத்து",2,"Utaiththu","possesses/has"]]},{"n":625,"l":["அடுக்கி வரினும் அழிவிலான் உற்ற","இடுக்கண் இடுக்கட் படும்."],"w":[["அடுக்கி",1,"Atukki","piling up"],["வரினும்",1,"Varinum","if it comes; even (concessive)"],["அழிவிலான்",1,"Azhivilaan","the unshaken man"],["உற்ற",1,"Utra","that befell"],["இடுக்கண்",2,"Itukkan","trouble"],["இடுக்கட்",2,"Itukkat","into trouble"],["படும்",2,"Patum","will suffer"]]},{"n":626,"l":["அற்றேமென்று அல்லற் படுபவோ பெற்றேமென்று","ஓம்புதல் தேற்றா தவர்."],"w":[["அற்றேமென்று",1,"Atremendru","we are ruined; saying thus"],["அல்லற்",1,"Allar","distress (obj.)"],["படுபவோ",1,"Patupavo","would they suffer; interrogative (no)"],["பெற்றேமென்று",1,"Petremendru","we have gained; saying thus"],["ஓம்புதல்",2,"Ompudhal","guarding/hoarding"],["தேற்றா",2,"Thetraa","not knowing/practising (rel.)"],["தவர்",2,"Thavar","those who"]]},{"n":627,"l":["இலக்கம் உடம்பிடும்பைக் கென்று கலக்கத்தைக்","கையாறாக் கொள்ளாதாம் மேல்."],"w":[["இலக்கம்",1,"Ilakkam","target/mark"],["உடம்பிடும்பைக்",1,"Utampitumpaik","body; trouble (of the body)"],["கென்று",1,"Kendru","for (dative); thus knowing"],["கலக்கத்தைக்",1,"Kalakkaththaik","the agitation (obj.)"],["கையாறாக்",2,"Kaiyaaraak","dejection/helplessness; as"],["கொள்ளாதாம்",2,"Kollaadhaam","(they) do not take/regard; expletive (affirmative)"],["மேல்",2,"Mel","the noble/superior ones (மேலோர்)"]]},{"n":628,"l":["இன்பம் விழையான் இடும்பை இயல்பென்பான்","துன்பம் உறுதல் இலன்."],"w":[["இன்பம்",1,"Inpam","pleasure (obj.)"],["விழையான்",1,"Vizhaiyaan","he who desires not"],["இடும்பை",1,"Itumpai","trouble"],["இயல்பென்பான்",1,"Iyalpenpaan","natural; he who says"],["துன்பம்",2,"Thunpam","sorrow (obj.)"],["உறுதல்",2,"Urudhal","experiencing"],["இலன்",2,"Ilan","he has not / does not"]]},{"n":629,"l":["இன்பத்துள் இன்பம் விழையாதான் துன்பத்துள்","துன்பம் உறுதல் இலன்."],"w":[["இன்பத்துள்",1,"Inpaththul","amid pleasure"],["இன்பம்",1,"Inpam","pleasure (obj.)"],["விழையாதான்",1,"Vizhaiyaadhaan","he who desires not"],["துன்பத்துள்",1,"Thunpaththul","amid sorrow"],["துன்பம்",2,"Thunpam","sorrow (obj.)"],["உறுதல்",2,"Urudhal","experiencing"],["இலன்",2,"Ilan","he does not"]]},{"n":630,"l":["இன்னாமை இன்பம் எனக்கொளின் ஆகுந்தன்","ஒன்னார் விழையுஞ் சிறப்பு."],"w":[["இன்னாமை",1,"Innaamai","suffering/pain"],["இன்பம்",1,"Inpam","pleasure"],["எனக்கொளின்",1,"Enakkolin","as; if one takes/regards"],["ஆகுந்தன்",1,"Aakundhan","will become/accrue; his (own)"],["ஒன்னார்",2,"Onnaar","enemies"],["விழையுஞ்",2,"Vizhaiyunj","(that they) desire"],["சிறப்பு