{"n":76,"kurals":[{"n":751,"l":["பொருளல் லவரைப் பொருளாகச் செய்யும்","பொருளல்லது இல்லை பொருள்."],"w":[["பொருளல்",1,"Porulal","worth/value; not (negation)"],["லவரைப்",1,"Lavaraip","those who are not (worthy)"],["பொருளாகச்",1,"Porulaakach","as worth/men of worth; so as to become"],["செய்யும்",1,"Cheyyum","that makes"],["பொருளல்லது",2,"Porulalladhu","wealth; other than / except"],["இல்லை",2,"Illai","is not / does not exist"],["பொருள்",2,"Porul","wealth (the precious thing)"]]},{"n":752,"l":["இல்லாரை எல்லாரும் எள்ளுவர் செல்வரை","எல்லாரும் செய்வர் சிறப்பு."],"w":[["இல்லாரை",1,"Illaarai","the have-nots (acc.)"],["எல்லாரும்",1,"Ellaarum","all (people); all-inclusive um"],["எள்ளுவர்",1,"Elluvar","(they) despise"],["செல்வரை",1,"Selvarai","the wealthy (acc.)"],["எல்லாரும்",2,"Ellaarum","all (people); all-inclusive um"],["செய்வர்",2,"Seyvar","(they) do/render"],["சிறப்பு",2,"Sirappu","honour/distinction"]]},{"n":753,"l":["பொருளென்னும் பொய்யா விளக்கம் இருளறுக்கும்","எண்ணிய தேயத்துச் சென்று."],"w":[["பொருளென்னும்",1,"Porulennum","wealth; called/named (as)"],["பொய்யா",1,"Poiyaa","unfailing/never-false"],["விளக்கம்",1,"Vilakkam","light/lamp"],["இருளறுக்கும்",1,"Irularukkum","darkness (obj.); cuts/removes"],["எண்ணிய",2,"Enniya","thought-of/intended"],["தேயத்துச்",2,"Theyaththuch","to/at the land"],["சென்று",2,"Chendru","having gone"]]},{"n":754,"l":["அறன்ஈனும் இன்பமும் ஈனும் திறனறிந்து","தீதின்றி வந்த பொருள்."],"w":[["அறன்ஈனும்",1,"Araneenum","virtue (obj.); yields/gives"],["இன்பமும்",1,"Inpamum","bliss/pleasure (obj.); also (um)"],["ஈனும்",1,"Eenum","yields/gives"],["திறனறிந்து",1,"Thiranarindhu","the right way/method; having known"],["தீதின்றி",2,"Theedhindri","evil/harm; without"],["வந்த",2,"Vandha","that came/was acquired"],["பொருள்",2,"Porul","wealth"]]},{"n":755,"l":["அருளொடும் அன்பொடும் வாராப் பொருளாக்கம்","புல்லார் புரள விடல்."],"w":[["அருளொடும்",1,"Arulotum","with grace; with (sociative) + um"],["அன்பொடும்",1,"Anpotum","with love; with (sociative) + um"],["வாராப்",1,"Vaaraa