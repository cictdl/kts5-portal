{"n":38,"kurals":[{"n":371,"l":["ஆகூழால் தோன்றும் அசைவின்மை கைப்பொருள்","போகூழால் தோன்றும் மடி."],"w":[["ஆகூழால்",1,"Aakoozhaal","by gaining-fate"],["தோன்றும்",1,"Thondrum","appears/arises"],["அசைவின்மை",1,"Asaivinmai","non-slackness, tirelessness"],["கைப்பொருள்",1,"Kaipporul","wealth-in-hand"],["போகூழால்",2,"Pokoozhaal","by losing-fate"],["தோன்றும்",2,"Thondrum","appears/arises"],["மடி",2,"Mati","sloth"]]},{"n":372,"l":["பேதைப் படுக்கும் இழவூழ் அறிவகற்றும்","ஆகலூழ் உற்றக் கடை."],"w":[["பேதைப்",1,"Pedhaip","(into a) fool"],["படுக்கும்",1,"Patukkum","makes/casts into (which)"],["இழவூழ்",1,"Izhavoozh","loss-fate"],["அறிவகற்றும்",1,"Arivakatrum","wisdom (acc.); widens/expands (which)"],["ஆகலூழ்",2,"Aakaloozh","gain-fate"],["உற்றக்",2,"Utrak","having occurred (which)"],["கடை",2,"Katai","at the time/when"]]},{"n":373,"l":["நுண்ணிய நூல்பல கற்பினும் மற்றுந்தன்","உண்மை யறிவே மிகும்."],"w":[["நுண்ணிய",1,"Nunniya","subtle (attrib.)"],["நூல்பல",1,"Noolpala","books/treatises; many"],["கற்பினும்",1,"Karpinum","even if (one) learns; even (concessive)"],["மற்றுந்தன்",1,"Matrundhan","moreover (expletive); his/one's own"],["உண்மை",2,"Unmai","innate/real"],["யறிவே",2,"Yarive","wisdom; indeed (emphatic)"],["மிகும்",2,"Mikum","will prevail"]]},{"n":374,"l":["இருவேறு உலகத்து இயற்கை திருவேறு","தெள்ளிய ராதலும் வேறு."],"w":[["இருவேறு",1,"Iruveru","two; kinds/difference"],["உலகத்து",1,"Ulakaththu","of the world"],["இயற்கை",1,"Iyarkai","nature"],["திருவேறு",1,"Thiruveru","wealth; (is) different"],["தெள்ளிய",2,"Thelliya","the clear-minded/wise"],["ராதலும்",2,"Raadhalum","becoming; also"],["வேறு",2,"Veru","(is) different"]]},{"n":375,"l":["நல்லவை எல்லாஅந் தீயவாம் தீயவும்","நல்லவாம் செல்வம் செயற்கு."],"w":[["நல்லவை",1,"Nallavai","good things"],["எல்லாஅந்",1,"Ellaaan","all"],["தீயவாம்",1,"Theeyavaam","become bad"],["தீயவும்",1,"Theeyavum","bad things; also"],["நல்லவாம்",2,"Nallavaam","become good"],["செல்வம்",2,"Selvam","wealth"],["செயற்கு",2,"Seyarku","for the effort/deed"]]},{"n":376,"l":["பரியினும் ஆகாவாம் பாலல்ல உய்த்துச்","சொரியினும் போகா தம."],"w":[["பரியினும்",1,"Pariyinum","even if (one) cherishes; even (concessive)"],["ஆகாவாம்",1,"Aakaavaam","will not become (ours)"],["பாலல்ல",1,"Paalalla","share/lot (destined); (things) are not one's lot"],["உய்த்துச்",1,"Uyththuch","having carried/driven"],["சொரியினும்",2,"Choriyinum","even if (one) pours away; even (concessive)"],["போகா",2,"Pokaa","will not depart"],["தம",2,"Thama","things that are one's own"]]},{"n":377,"l":["வகுத்தான் வகுத்த வகையல்லால் கோடி","தொகுத்தார்க்கும் துய்த்தல் அரிது."],"w":[["வகுத்தான்",1,"Vakuththaan","the Dispenser (he who ordained)"],["வகுத்த",1,"Vakuththa","ordained (which)"],["வகையல்லால்",1,"Vakaiyallaal","manner/portion; except/other than"],["கோடி",1,"Koti","crore (millions)"],["தொகுத்தார்க்கும்",2,"Thokuththaarkkum","to those who amassed"],["துய்த்தல்",2,"Thuyththal","enjoying/consuming"],["அரிது",2,"Aridhu","is difficult"]]},{"n":378,"l":["துறப்பார்மன் துப்புர வில்லார் உறற்பால","ஊட்டா கழியு மெனின்."],"w":[["துறப்பார்மன்",1,"Thurappaarman","would renounce; (expletive, regret/unreal)"],["துப்புர",1,"Thuppura","enjoyment/means"],["வில்லார்",1,"Villaar","those without (the poor)"],["உறற்பால",1,"Urarpaala","things destined to befall"],["ஊட்டா",2,"Oottaa","without making (one) suffer"],["கழியு",2,"Kazhiyu","pass away/depart (which)"],["மெனின்",2,"Menin","if (it be that)"]]},{"n":379,"l":["நன்றாங்கால் நல்லவாக் காண்பவர் அன்றாங்கால்","அல்லற் படுவ தெவன்?"],"w":[["நன்றாங்கால்",1,"Nandraangaal","good; at the time when (it is)"],["நல்லவாக்",1,"Nallavaak","as good things"],["காண்பவர்",1,"Kaanpavar","those who see/regard"],["அன்றாங்கால்",1,"Andraangaal","(when it is) not so; at the time when"],["அல்லற்",2,"Allar","distress/sorrow"],["படுவ",2,"Patuva","the suffering (of)"],["தெவன்",2,"Thevan","why?/what?"]]},{"n":380,"l":["ஊழிற் பெருவலி யாவுள மற்றொன்று","சூழினுந் தான்முந் துறும்."],"w":[["ஊழிற்",1,"Oozhir","than fate"],["பெருவலி",1,"Peruvali","great; strength"],["யாவுள",1,"Yaavula","what (things); are there"],["மற்றொன்று",1,"Matrondru","another/besides; one (means)"],["சூழினுந்",2,"Soozhinun","even if (one) devises; even (concessive)"],["தான்முந்",2,"Thaanmun","it (fate) itself; coming foremost (part of முந்துறும்)"],["துறும்",2,"Thurum","will press/come forth"]]}]}