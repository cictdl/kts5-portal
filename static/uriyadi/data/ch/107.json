{"n":107,"kurals":[{"n":1061,"l":["கரவாது உவந்தீயும் கண்ணன்னார் கண்ணும்","இரவாமை கோடி உறும்."],"w":[["கரவாது",1,"Karavaadhu","without concealing"],["உவந்தீயும்",1,"Uvandheeyum","rejoicing; who give"],["கண்ணன்னார்",1,"Kannannaar","eye; those who are like"],["கண்ணும்",1,"Kannum","at/in (locative உருபு); even"],["இரவாமை",2,"Iravaamai","not begging"],["கோடி",2,"Koti","crore (ten million)"],["உறும்",2,"Urum","will be (worth)"]]},{"n":1062,"l":["இரந்தும் உயிர்வாழ்தல் வேண்டின் பரந்து","கெடுக உலகியற்றி யான்."],"w":[["இரந்தும்",1,"Irandhum","having begged; even"],["உயிர்வாழ்தல்",1,"Uyirvaazhdhal","life; living"],["வேண்டின்",1,"Ventin","if (it) be required"],["பரந்து",1,"Parandhu","wandering/spreading"],["கெடுக",2,"Ketuka","let (him) perish"],["உலகியற்றி",2,"Ulakiyatri","the world; having created"],["யான்",2,"Yaan","he who (made)"]]},{"n":1063,"l":["இன்மை இடும்பை இரந்துதீர் வாமென்னும்","வன்மையின் வன்பாட்ட தில்."],"w":[["இன்மை",1,"Inmai","poverty/want"],["இடும்பை",1,"Itumpai","misery"],["இரந்துதீர்",1,"Irandhudheer","by begging; we will remove"],["வாமென்னும்",1,"Vaamennum","saying that"],["வன்மையின்",2,"Vanmaiyin","than the cruelty"],["வன்பாட்ட",2,"Vanpaatta","harsh thing"],["தில்",2,"Thil","(there) is none"]]},{"n":1064,"l":["இடமெல்லாம் கொள்ளாத் தகைத்தே இடமில்லாக்","காலும் இரவொல்லாச் சால்பு."],"w":[["இடமெல்லாம்",1,"Itamellaam","space/place; all"],["கொள்ளாத்",1,"Kollaath","that cannot contain"],["தகைத்தே",1,"Thakaiththe","is of (such) greatness; (emphatic தேற்றம்)"],["இடமில்லாக்",1,"Itamillaak","place/refuge; having no"],["காலும்",2,"Kaalum","at the time; even"],["இரவொல்லாச்",2,"Iravollaach","begging; not consenting to"],["சால்பு",2,"Chaalpu","nobility/perfection"]]},{"n":1065,"l":["தெண்ணீர் அடுபுற்கை ஆயினும் தாள்தந்தது","உண்ணலின் ஊங்கினிய தில்."],"w":[["தெண்ணீர்",1,"Thenneer","clear; water"],["அடுபுற்கை",1,"Atupurkai","cooked; gruel/porridge"],["ஆயினும்",1,"Aayinum","even though it be"],["தாள்தந்தது",1,"Thaaldhandhadhu","effort/exertion; that which (effort) gave"],["உண்ணலின்",2,"Unnalin","than eating"],["ஊங்கினிய",2,"Oonginiya","beyond/more; sweet (thing)"],["தில்",2,"Thil","(there) is none"]]},{"n":1066,"l":["ஆவிற்கு நீரென்று இரப்பினும் நாவிற்கு","இரவின் இளிவந்த தில்."],"w":[["ஆவிற்கு",1,"Aavirku","for the cow"],["நீரென்று",1,"Neerendru","water; saying (that)"],["இரப்பினும்",1,"Irappinum","even if one begs"],["நாவிற்கு",1,"Naavirku","for the tongue"],["இரவின்",2,"Iravin","than begging"],["இளிவந்த",2,"Ilivandha","(that which) became demeaning"],["தில்",2,"Thil","(there) is none"]]},{"n":1067,"l":["இரப்பன் இரப்பாரை எல்லாம் இரப்பின்","கரப்பார் இரவன்மின் என்று."],"w":[["இரப்பன்",1,"Irappan","I beg/entreat"],["இரப்பாரை",1,"Irappaarai","those who beg (acc.)"],["எல்லாம்",1,"Ellaam","all"],["இரப்பின்",1,"Irappin","if (one) begs"],["கரப்பார்",2,"Karappaar","(from) those who conceal"],["இரவன்மின்",2,"Iravanmin","do not beg (ye)"],["என்று",2,"Endru","saying thus"]]},{"n":1068,"l":["இரவென்னும் ஏமாப்பில் தோணி கரவென்னும்","பார்தாக்கப் பக்கு விடும்."],"w":[["இரவென்னும்",1,"Iravennum","begging; called/named"],["ஏமாப்பில்",1,"Emaappil","safety/protection; without"],["தோணி",1,"Thoni","boat"],["கரவென்னும்",1,"Karavennum","concealing; called/named"],["பார்தாக்கப்",2,"Paardhaakkap","rock; when (it) strikes"],["பக்கு",2,"Pakku","splitting"],["விடும்",2,"Vitum","will (split) away"]]},{"n":1069,"l":["இரவுள்ள உள்ளம் உருகும் கரவுள்ள","உள்ளதூஉம் இன்றிக் கெடும்."],"w":[["இரவுள்ள",1,"Iravulla","begging; (that) thinks of"],["உள்ளம்",1,"Ullam","the heart/mind"],["உருகும்",1,"Urukum","melts"],["கரவுள்ள",1,"Karavulla","concealing; (that) thinks of"],["உள்ளதூஉம்",2,"Ulladhooum","even that which is (the melting); even"],["இன்றிக்",2,"Indrik","being without"],["கெடும்",2,"Ketum","perishes"]]},{"n":1070,"l":["கரப்பவர்க்கு யாங்கொளிக்கும் கொல்லோ இரப்பவர்","சொல்லாடப் போஒம் உயிர்."],"w":[["கரப்பவர்க்கு",1,"Karappavarkku","for those who conceal"],["யாங்கொளிக்கும்",1,"Yaangolikkum","where/how; (where) does it hide"],["கொல்லோ",1,"Kollo","(interrogative doubt); (question/wonder)"],["இரப்பவர்",1,"Irappavar","of the beggars"],["சொல்லாடப்",2,"Sollaatap","when (the 'no') is uttered"],["போஒம்",2,"Poom","(that) departs"],["உயிர்",2,"Uyir","the life"]]}]}