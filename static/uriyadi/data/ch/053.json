{"n":53,"kurals":[{"n":521,"l":["பற்றற்ற கண்ணும் பழைமைபா ராட்டுதல்","சுற்றத்தார் கண்ணே உள."],"w":[["பற்றற்ற",1,"Patratra","attachment/wealth; (that) ceased/was lost"],["கண்ணும்",1,"Kannum","at the time/occasion; even (concessive)"],["பழைமைபா",1,"Pazhaimaipaa","old (relationship)"],["ராட்டுதல்",1,"Raattudhal","the praising/cherishing"],["சுற்றத்தார்",2,"Sutraththaar","kinsmen"],["கண்ணே",2,"Kanne","in/at; only (emphatic)"],["உள",2,"Ula","exist/are present"]]},{"n":522,"l":["விருப்பறாச் சுற்றம் இயையின் அருப்பறா","ஆக்கம் பலவும் தரும்."],"w":[["விருப்பறாச்",1,"Virupparaach","love/desire; unceasing (that does not cease)"],["சுற்றம்",1,"Chutram","kinship/kinsmen"],["இயையின்",1,"Iyaiyin","if it is obtained/joins"],["அருப்பறா",1,"Arupparaa","bud/budding; unfading (that does not cease)"],["ஆக்கம்",2,"Aakkam","prosperity/gain"],["பலவும்",2,"Palavum","many; all (inclusive)"],["தரும்",2,"Tharum","will give"]]},{"n":523,"l":["அளவளா வில்லாதான் வாழ்க்கை குளவளாக்","கோடின்றி நீர்நிறைந் தற்று."],"w":[["அளவளா",1,"Alavalaa","intimate mingling"],["வில்லாதான்",1,"Villaadhaan","he who has not (such mingling)"],["வாழ்க்கை",1,"Vaazhkkai","life"],["குளவளாக்",1,"Kulavalaak","tank/pond; expanse"],["கோடின்றி",2,"Kotindri","bank/edge; without"],["நீர்நிறைந்",2,"Neernirain","water; being full"],["தற்று",2,"Thatru","like (comparison particle '...போன்று')"]]},{"n":524,"l":["சுற்றத்தால் சுற்றப் படஒழுகல் செல்வந்தான்","பெற்றத்தால் பெற்ற பயன்."],"w":[["சுற்றத்தால்",1,"Sutraththaal","by kinsmen"],["சுற்றப்",1,"Sutrap","so as to be surrounded"],["படஒழுகல்",1,"Pataozhukal","so as to happen (passive); living/conducting oneself"],["செல்வந்தான்",1,"Selvandhaan","wealth; (emphatic/expletive)"],["பெற்றத்தால்",2,"Petraththaal","by the gaining/possessions"],["பெற்ற",2,"Petra","(that was) obtained"],["பயன்",2,"Payan","benefit/fruit"]]},{"n":525,"l":["கொடுத்தலும் இன்சொலும் ஆற்றின் அடுக்கிய","சுற்றத்தால் சுற்றப் படும்."],"w":[["கொடுத்தலும்",1,"Kotuththalum","giving (liberality); and (enumerative)"],["இன்சொலும்",1,"I