{"n":48,"kurals":[{"n":471,"l":["வினைவலியும் தன்வலியும் மாற்றான் வலியும்","துணைவலியும் தூக்கிச் செயல்."],"w":[["வினைவலியும்",1,"Vinaivaliyum","strength of the act; and (enumerative)"],["தன்வலியும்",1,"Thanvaliyum","one's own strength; and"],["மாற்றான்",1,"Maatraan","enemy/adversary (whose strength)"],["வலியும்",1,"Valiyum","strength (of the enemy); and"],["துணைவலியும்",2,"Thunaivaliyum","strength of the allies; and"],["தூக்கிச்",2,"Thookkich","having weighed/considered"],["செயல்",2,"Cheyal","let (one) act/do"]]},{"n":472,"l":["ஒல்வ தறிவது அறிந்ததன் கண்தங்கிச்","செல்வார்க்குச் செல்லாதது இல்."],"w":[["ஒல்வ",1,"Olva","that which is possible/feasible"],["தறிவது",1,"Tharivadhu","that which is to be known"],["அறிந்ததன்",1,"Arindhadhan","of/in that which is known"],["கண்தங்கிச்",1,"Kandhangich","in/at (locative case-sign); having settled/abided"],["செல்வார்க்குச்",2,"Chelvaarkkuch","to those who proceed"],["செல்லாதது",2,"Chellaadhadhu","that which is unattainable"],["இல்",2,"Il","there is none"]]},{"n":473,"l":["உடைத்தம் வலியறியார் ஊக்கத்தின் ஊக்கி","இடைக்கண் முரிந்தார் பலர்."],"w":[["உடைத்தம்",1,"Utaiththam","possessed (strength); their own"],["வலியறியார்",1,"Valiyariyaar","strength (object); (they) do not know"],["ஊக்கத்தின்",1,"Ookkaththin","by/with zeal"],["ஊக்கி",1,"Ookki","having striven/exerted"],["இடைக்கண்",2,"Itaikkan","midway; in/at (locative)"],["முரிந்தார்",2,"Murindhaar","broke down/were ruined"],["பலர்",2,"Palar","many (people)"]]},{"n":474,"l":["அமைந்தாங் கொழுகான் அளவறியான் தன்னை","வியந்தான் விரைந்து கெடும்."],"w":[["அமைந்தாங்",1,"Amaindhaang","fitting in / being suited; thus/there (expletive)"],["கொழுகான்",1,"Kozhukaan","he does not conduct himself (in concord)"],["அளவறியான்",1,"Alavariyaan","measure/extent (object); he does not know"],["தன்னை",1,"Thannai","himself (object)"],["வியந்தான்",2,"Viyandhaan","he who exalts (himself)"],["விரைந்து",2,"Viraindhu","quickly / hastening"],["கெடும்",2,"Ketum","(he) will perish"]]},{"n":475,"l":["பீலிபெய் சாகாடும் அச்சிறும் அப்பண்டஞ்","சால மிகுத்துப் பெயின்."],"w":[["பீலிபெய்",1,"Peelipey","peacock feather (object); loaded (with) — qualifying the cart"],["சாகாடும்",1,"Saakaatum","bullock cart; even (concessive)"],["அச்சிறும்",1,"Achchirum","axle; will break/snap"],["அப்பண்டஞ்",1,"Appantanjjch","that load/goods"],["சால",2,"Aala","very much / greatly"],["மிகுத்துப்",2,"Mikuththup","having increased/overloaded"],["பெயின்",2,"Peyin","if (one) loads"]]},{"n":476,"l":["நுனிக்கொம்பர் ஏறினார் அஃதிறந் தூக்கின்","உயிர்க்கிறுதி ஆகி விடும்."],"w":[["நுனிக்கொம்பர்",1,"Nunikkompar","(on) the tip-branch"],["ஏறினார்",1,"Erinaar","those who have climbed"],["அஃதிறந்",1,"Aqdhiran","that (limit); having exceeded"],["தூக்கின்",1,"Thookkin","if (one) ventures/lifts up"],["உயிர்க்கிறுதி",2,"Uyirkkirudhi","to the life; the end/death"],["ஆகி",2,"Aaki","becoming"],["விடும்",2,"Vitum","will (it) end up"]]},{"n":477,"l":["ஆற்றின் அளவறிந்து ஈக அதுபொருள்","போற்றி வழங்கு நெறி."],"w":[["ஆற்றின்",1,"Aatrin","by/in the (proper) way"],["அளவறிந்து",1,"Alavarindhu","limit/extent (object); having known"],["ஈக",1,"Eeka","let (one) give"],["அதுபொருள்",1,"Adhuporul","that; wealth/property"],["போற்றி",2,"Potri","guarding/cherishing"],["வழங்கு",2,"Vazhangu","of giving/distributing (qualifying நெறி)"],["நெறி",2,"Neri","way/method"]]},{"n":478,"l":["ஆகாறு அளவிட்டி தாயினுங் கேடில்லை","போகாறு அகலாக் கடை."],"w":[["ஆகாறு",1,"Aakaaru","the way of income/inflow"],["அளவிட்டி",1,"Alavitti","measure (of income); (being) small/little"],["தாயினுங்",1,"Thaayinung","even though it be; even (concessive)"],["கேடில்லை",1,"Ketillai","harm/ruin; there is not"],["போகாறு",2,"Pokaaru","the way of expense/outflow"],["அகலாக்",2,"Akalaak","not widening (qualifying கடை)"],["கடை",2,"Katai","when/in the case that"]]},{"n":479,"l":["அளவறிந்து வாழாதான் வாழ்க்கை உளபோல","இல்லாகித் தோன்றாக் கெடும்."],"w":[["அளவறிந்து",1,"Alavarindhu","measure/limit (object); having known"],["வாழாதான்",1,"Vaazhaadhaan","he who does not live (within limits)"],["வாழ்க்கை",1,"Vaazhkkai","life/livelihood"],["உளபோல",1,"Ulapola","(things that) exist; as if/like"],["இல்லாகித்",2,"Illaakith","becoming non-existent"],["தோன்றாக்",2,"Thondraak","without appearing/visibly"],["கெடும்",2,"Ketum","(life) will perish"]]},{"n":480,"l":["உளவரை தூக்காத ஒப்புர வாண்மை","வளவரை வல்லைக் கெடும்."],"w":[["உளவரை",1,"Ulavarai","(of what) exists; the extent/limit (of one's means)"],["தூக்காத",1,"Thookkaadha","not weighing/considering (qualifying ஒப்புரவாண்மை)"],["ஒப்புர",1,"Oppura","benevolence/social good"],["வாண்மை",1,"Vaanmai","the practice/exercise (of benevolence)"],["வளவரை",2,"Valavarai","the measure of (one's) wealth"],["வல்லைக்",2,"Vallaik","quickly/swiftly"],["கெடும்",2,"Ketum","will perish/diminish"]]}]}