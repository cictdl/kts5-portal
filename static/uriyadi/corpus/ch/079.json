{"n":79,"kurals":[{"n":781,"l":["செயற்கரிய யாவுள நட்பின் அதுபோல்","வினைக்கரிய யாவுள காப்பு."],"w":[["செயற்கரிய",1,"Seyarkariya","hard to do/make (qualifying யாவுள)"],["யாவுள",1,"Yaavula","what are there"],["நட்பின்",1,"Natpin","than/like friendship"],["அதுபோல்",1,"Adhupol","that; like (comparison particle)"],["வினைக்கரிய",2,"Vinaikkariya","hard for/against action (qualifying யாவுள)"],["யாவுள",2,"Yaavula","what are there"],["காப்பு",2,"Kaappu","guard, protection"]]},{"n":782,"l":["நிறைநீர நீரவர் கேண்மை பிறைமதிப்","பின்னீர பேதையார் நட்பு."],"w":[["நிறைநீர",1,"Niraineera","of waxing/filling nature"],["நீரவர்",1,"Neeravar","those of (such) nature"],["கேண்மை",1,"Kenmai","friendship, intimacy"],["பிறைமதிப்",1,"Piraimadhip","crescent moon"],["பின்னீர",2,"Pinneera","of later (waning) nature"],["பேதையார்",2,"Pedhaiyaar","the foolish/ignorant ones"],["நட்பு",2,"Natpu","friendship"]]},{"n":783,"l":["நவில்தொறும் நூல்நயம் போலும் பயில்தொறும்","பண்புடை யாளர் தொடர்பு."],"w":[["நவில்தொறும்",1,"Navildhorum","(each time) one recites/studies; distributive 'each time'"],["நூல்நயம்",1,"Noolnayam","the excellence/delight of a book"],["போலும்",1,"Polum","is like, resembles"],["பயில்தொறும்",1,"Payildhorum","(each time) one associates/practises; distributive 'each time'"],["பண்புடை",2,"Panputai","having (good) qualities"],["யாளர்",2,"Yaalar","those who possess (the qualities)"],["தொடர்பு",2,"Thotarpu","association, friendship"]]},{"n":784,"l":["நகுதற் பொருட்டன்று நட்டல் மிகுதிக்கண்","மேற்சென்று இடித்தற் பொருட்டு."],"w":[["நகுதற்",1,"Nakudhar","laughing/rejoicing"],["பொருட்டன்று",1,"Poruttandru","for the sake of; is not"],["நட்டல்",1,"Nattal","befriending, forming friendship"],["மிகுதிக்கண்",1,"Mikudhikkan","at the point of excess (of fault)"],["மேற்சென்று",2,"Mersendru","going forth/forward"],["இடித்தற்",2,"Itiththar","admonishing, rebuking"],["பொருட்டு",2,"Poruttu","for the sake of"]]},{"n":785,"l":["புணர்ச்சி பழகுதல் வேண்டா உணர்ச்சிதான்","நட்பாங் கிழமை தரும்."],"w":[["புணர்ச்சி",1,"Punarch