{"n":37,"kurals":[{"n":361,"l":["அவாஎன்ப எல்லா உயிர்க்கும் எஞ்ஞான்றும்","தவாஅப் பிறப்பீனும் வித்து."],"w":[["அவாஎன்ப",1,"","desire; they say"],["எல்லா",1,"","all"],["உயிர்க்கும்",1,"","to lives; all (inclusive)"],["எஞ்ஞான்றும்",1,"","(every) time; always (inclusive)"],["தவாஅப்",2,"","unceasing (that does not perish)"],["பிறப்பீனும்",2,"","birth; that yields"],["வித்து",2,"","seed"]]},{"n":362,"l":["வேண்டுங்கால் வேண்டும் பிறவாமை மற்றது","வேண்டாமை வேண்ட வரும்."],"w":[["வேண்டுங்கால்",1,"Ventungaal","when one desires"],["வேண்டும்",1,"Ventum","is needed / one must"],["பிறவாமை",1,"Piravaamai","non-birth"],["மற்றது",1,"Matradhu","that"],["வேண்டாமை",2,"Ventaamai","desirelessness"],["வேண்ட",2,"Venta","on desiring"],["வரும்",2,"Varum","will come"]]},{"n":363,"l":["வேண்டாமை அன்ன விழுச்செல்வம் ஈண்டில்லை","ஆண்டும் அஃதொப்பது இல்."],"w":[["வேண்டாமை",1,"Ventaamai","desirelessness"],["அன்ன",1,"Anna","like / such as"],["விழுச்செல்வம்",1,"Vizhuchchelvam","excellent; wealth"],["ஈண்டில்லை",1,"Eentillai","here; is not / does not exist"],["ஆண்டும்",2,"Aantum","there; too / even"],["அஃதொப்பது",2,"Aqdhoppadhu","that; the equal"],["இல்",2,"Il","is not"]]},{"n":364,"l":["தூஉய்மை என்பது அவாவின்மை மற்றது","வாஅய்மை வேண்ட வரும்."],"w":[["தூஉய்மை",1,"Thoouymai","purity"],["என்பது",1,"Enpadhu","what is called"],["அவாவின்மை",1,"Avaavinmai","desirelessness"],["மற்றது",1,"Matradhu","that"],["வாஅய்மை",2,"Vaaaimai","truth"],["வேண்ட",2,"Venta","on desiring"],["வரும்",2,"Varum","will come"]]},{"n":365,"l":["அற்றவர் என்பார் அவாஅற்றார் மற்றையார்","அற்றாக அற்றது இலர்."],"w":[["அற்றவர்",1,"Atravar","the renounced (those who have given up)"],["என்பார்",1,"Enpaar","they call"],["அவாஅற்றார்",1,"Avaaatraar","desire; those rid of"],["மற்றையார்",1,"Matraiyaar","the others"],["அற்றாக",2,"Atraaka","to that degree / so as to be rid"],["அற்றது",2,"Atradhu","rid of (that much)"],["இலர்",2,"Ilar","are not"]]},{"n":366,"l":["அஞ்சுவ தோரும் அறனே ஒருவனை","வஞ்சிப்ப தோரும் அவா."],"w":[["அஞ்சுவ",1,"Anjuva","the (act of) fearing"],["தோரும்",1,"Thorum","(expletive particle)"],["அறனே",1,"Arane","virtue; indeed (emphatic)"],["ஒருவனை",1,"Oruvanai","a person (acc.)"],["வஞ்சிப்ப",2,"Vanjippa","that which deceives"],["தோரும்",2,"Thorum","(expletive particle)"],["அவா",2,"Avaa","desire"]]},{"n":367,"l":["அவாவினை ஆற்ற அறுப்பின் தவாவினை","தான்வேண்டு மாற்றான் வரும்."],"w":[["அவாவினை",1,"Avaavinai","desire (acc.)"],["ஆற்ற",1,"Aatra","thoroughly / much"],["அறுப்பின்",1,"Aruppin","if one cuts off"],["தவாவினை",1,"Thavaavinai","imperishable; deed"],["தான்வேண்டு",2,"Thaanventu","self (expletive); that one desires"],["மாற்றான்",2,"Maatraan","in the way/manner"],["வரும்",2,"Varum","will come"]]},{"n":368,"l":["அவாஇல்லார்க் கில்லாகுந் துன்பம் அஃதுண்டேல்","தவாஅது மேன்மேல் வரும்."],"w":[["அவாஇல்லார்க்",1,"Avaaillaark","desire; to those without"],["கில்லாகுந்",1,"Killaakun","will not be (there is none)"],["துன்பம்",1,"Thunpam","sorrow"],["அஃதுண்டேல்",1,"Aqdhuntel","that; if it exists"],["தவாஅது",2,"Thavaaadhu","unceasingly (not perishing)"],["மேன்மேல்",2,"Menmel","more and more"],["வரும்",2,"Varum","will come"]]},{"n":369,"l":["இன்பம் இடையறா தீண்டும் அவாவென்னும்","துன்பத்துள் துன்பங் கெடின்."],"w":[["இன்பம்",1,"Inpam","joy"],["இடையறா",1,"Itaiyaraa","without ceasing"],["தீண்டும்",1,"Theentum","will touch/reach"],["அவாவென்னும்",1,"Avaavennum","desire; called"],["துன்பத்துள்",2,"Thunpaththul","of sorrow; among / within"],["துன்பங்",2,"Thunpang","sorrow"],["கெடின்",2,"Ketin","if it perishes"]]},{"n":370,"l":["ஆரா இயற்கை அவாநீப்பின் அந்நிலையே","பேரா இயற்கை தரும்."],"w":[["ஆரா",1,"Aaraa","insatiable"],["இயற்கை",1,"Iyarkai","nature"],["அவாநீப்பின்",1,"Avaaneeppin","desire; if one removes"],["அந்நிலையே",1,"Annilaiye","that very state; itself (emphatic)"],["பேரா",2,"Peraa","unchanging (that does not shift)"],["இயற்கை",2,"Iyarkai","state/nature"],["தரும்",2,"Tharum","will give"]]}]}