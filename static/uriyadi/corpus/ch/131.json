{"n":131,"kurals":[{"n":1301,"l":["புல்லா திராஅப் புலத்தை அவர்உறும்","அல்லல்நோய் காண்கம் சிறிது."],"w":[["புல்லா",1,"","embracing not (negative verbal participle)"],["திராஅப்",1,"","stay apart / be (imperative, alagedai elongation)"],["புலத்தை",1,"","sulk / pout (imperative, 2nd person)"],["அவர்உறும்",1,"","he (honorific plural); that he will suffer/attain (rel. participle qualifying அல்லல்நோய்)"],["அல்லல்நோய்",2,"","distress, affliction; ailing pain (object of காண்கம்)"],["காண்கம்",2,"","let us see (optative, 1st person plural)"],["சிறிது",2,"","a little (here adverbial)"]]},{"n":1302,"l":["உப்பமைந் தற்றால் புலவி அதுசிறிது","மிக்கற்றால் நீள விடல்."],"w":[["உப்பமைந்",1,"Uppamain","salt; being fitting / in measure (verbal participle)"],["தற்றால்",1,"Thatraal","is like that which is fitting; expletive particle (aal)"],["புலவி",1,"Pulavi","sulking, pouting (love-quarrel)"],["அதுசிறிது",1,"Adhusiridhu","that (the sulking); a little (adverbial)"],["மிக்கற்றால்",2,"Mikkatraal","having exceeded / in excess; is like that (which exceeds); expletive particle (aal)"],["நீள",2,"Neela","so as to be prolonged (செயவெனெச்சம்)"],["விடல்",2,"Vital","letting (it) extend (verbal noun)"]]},{"n":1303,"l":["அலந்தாரை அல்லல்நோய் செய்தற்றால் தம்மைப்","புலந்தாரைப் புல்லா விடல்."],"w":[["அலந்தாரை",1,"Alandhaarai","those who were distressed (object)"],["அல்லல்நோய்",1,"Allalnoi","distress; ailing pain (object of செய்தல்)"],["செய்தற்றால்",1,"Seydhatraal","having done; is like the doing (of); expletive particle (aal)"],["தம்மைப்",1,"Thammaip","themselves (object of புலந்தார்)"],["புலந்தாரைப்",2,"Pulandhaaraip","those who sulked / pouted (object)"],["புல்லா",2,"Pullaa","without embracing (negative verbal participle)"],["விடல்",2,"Vital","leaving / abandoning (verbal noun, subject)"]]},{"n":1304,"l":["ஊடி யவரை உணராமை வாடிய","வள்ளி முதலரிந் தற்று."],"w":[["ஊடி",1,"Ooti","having sulked (feeds the verbal noun ஊடியவர்)"],["யவரை",1,"Yavarai","them (those who sulked), object"],["உணராமை",1,"Unaraamai","not reconciling / not appeasing (negative verbal noun, subject)"],["வாடிய",1,"Vaatiya","that has withered (rel. participle)"],["வள்ளி",2,"Valli","creeper, vine"],["முதலரிந்",2,"Mudhalarin","at the root / base; having cut (feeds அற்று)"],["தற்று",2,"Thatru","is like the cutting (of)"]]},{"n":1305,"l":["நலத்தகை நல்லவர்க்கு ஏஎர் புலத்தகை","பூஅன்ன கண்ணார் அகத்து."],"w":[["நலத்தகை",1,"Nalaththakai","goodness of quality / excellence (qualifies நல்லவர்)"],["நல்லவர்க்கு",1,"Nallavarkku","to the good ones"],["ஏஎர்",1,"Eer","beauty, grace (with alagedai)"],["புலத்தகை",1,"Pulaththakai","the excellence/abundance of sulking"],["பூஅன்ன",2,"Pooanna","flower; like, resembling (உவம உருபு)"],["கண்ணார்",2,"Kannaar","the (women) having (flower-like) eyes"],["அகத்து",2,"Akaththu","within / in the heart of"]]},{"n":1306,"l":["துனியும் புலவியும் இல்லாயின் காமம்","கனியும் கருக்காயும் அற்று."],"w":[["துனியும்",1,"Thuniyum","major estrangement / great sulk; and (conjunctive um)"],["புலவியும்",1,"Pulaviyum","minor sulk / pouting; and (conjunctive um)"],["இல்லாயின்",1,"Illaayin","if (they) are absent (conditional)"],["காமம்",1,"Kaamam","love, passion"],["கனியும்",2,"Kaniyum","ripe (over-ripe) fruit; and (conjunctive um)"],["கருக்காயும்",2,"Karukkaayum","unripe / tender raw fruit; and (conjunctive um)"],["அற்று",2,"Atru","is like that (the fruits)"]]},{"n":1307,"l":["ஊடலின் உண்டாங்கோர் துன்பம் புணர்வது","நீடுவ தன்றுகொல் என்று."],"w":[["ஊடலின்",1,"","than/in sulking (5th case, comparative)"],["உண்டாங்கோர்",1,"","there exists / there is; there / thus (expletive); a, one (qualifies துன்பம்)"],["துன்பம்",1,"","sorrow, suffering (subject of உண்டு)"],["புணர்வது",1,"","the union / that which unites"],["நீடுவ",2,"","that which will last/prolong"],["தன்றுகொல்",2,"",""],["என்று",2,"","thus thinking (quotative)"]]},{"n":1308,"l":["நோதல் எவன்மற்று நொந்தாரென்று அஃதறியும்","காதலர் இல்லா வழி."],"w":[["நோதல்",1,"Nodhal","grieving, suffering (verbal noun, subject)"],["எவன்மற்று",1,"Evanmatru","what (use) / why (interrogative); moreover / expletive (matru)"],["நொந்தாரென்று",1,"Nondhaarendru","(they) grieved / suffered; that (quotative)"],["அஃதறியும்",1,"Aqdhariyum","that (the grief), object; that knows (rel. participle, qualifies காதலர்)"],["காதலர்",2,"Kaadhalar","the loving one / beloved"],["இல்லா",2,"Illaa","non-existent (qualifies வழி)"],["வழி",2,"Vazhi","when / in the case (locative of time)"]]},{"n":1309,"l":["நீரும் நிழலது இனிதே புலவியும்","வீழுநர் கண்ணே இனிது."],"w":[["நீரும்",1,"Neerum","water; even/also (siappu um)"],["நிழலது",1,"Nizhaladhu","of/at the shade (6th case)"],["இனிதே",1,"Inidhe","is sweet/pleasant; indeed (assertive ee)"],["புலவியும்",1,"Pulaviyum","sulking, pouting; also (siappu um)"],["வீழுநர்",2,"Veezhunar","those who love / desire"],["கண்ணே",2,"Kanne","in / at (7th case suffix); only/exclusively (pirinilai ee)"],["இனிது",2,"Inidhu","is sweet/pleasant"]]},{"n":1310,"l":["ஊடல் உணங்க விடுவாரோடு என்நெஞ்சம்","கூடுவேம் என்பது அவா."],"w":[["ஊடல்",1,"Ootal","the sulking (object of உணங்க)"],["உணங்க",1,"Unanga","so as to wither / pine (செயவெனெச்சம்)"],["விடுவாரோடு",1,"Vituvaarotu","with the one who leaves (me to pine); with (comitative case suffix)"],["என்நெஞ்சம்",1,"Ennenjam","my (1st person possessive); heart, mind"],["கூடுவேம்",2,"Kootuvem","we shall unite (1st person plural future)"],["என்பது",2,"Enpadhu","the saying / that which says (subject)"],["அவா",2,"Avaa","desire, craving (the cause)"]]}]}