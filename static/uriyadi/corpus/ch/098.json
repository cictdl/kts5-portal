{"n":98,"kurals":[{"n":971,"l":["ஒளிஒருவற்கு உள்ள வெறுக்கை இளிஒருவற்கு","அஃதிறந்து வாழ்தும் எனல்."],"w":[["ஒளிஒருவற்கு",1,"Olioruvarku","light/lustre; here = courage, drive; to a man"],["உள்ள",1,"Ulla","that exists / which is (modifies வெறுக்கை)"],["வெறுக்கை",1,"Verukkai","abundance; mental drive/zeal"],["இளிஒருவற்கு",1,"Ilioruvarku","lowness, disgrace; to a man"],["அஃதிறந்து",2,"Aqdhirandhu","that (the drive); lacking, being devoid of (idiom)"],["வாழ்தும்",2,"Vaazhdhum","we shall live"],["எனல்",2,"Enal","(the) thinking/saying"]]},{"n":972,"l":["பிறப்பொக்கும் எல்லா உயிர்க்கும் சிறப்பொவ்வா","செய்தொழில் வேற்றுமை யான்."],"w":[["பிறப்பொக்கும்",1,"Pirappokkum","birth; is alike/equal"],["எல்லா",1,"Ellaa","all (modifies உயிர்)"],["உயிர்க்கும்",1,"Uyirkkum","for (all) lives too"],["சிறப்பொவ்வா",1,"Sirappovvaa","distinction, greatness; do not match/equal (negative finite)"],["செய்தொழில்",2,"Seydhozhil","done/doing (tense-hidden rel. participle of வினைத்தொகை); work, deed"],["வேற்றுமை",2,"Vetrumai","difference"],["யான்",2,"Yaan","by/through (instrumental உருபு of வேற்றுமை = வேற்றுமையான்)"]]},{"n":973,"l":["மேலிருந்தும் மேலல்லார் மேலல்லர் கீழிருந்தும்","கீழல்லார் கீழல் லவர்."],"w":[["மேலிருந்தும்",1,"Melirundhum","high place/position; even though being"],["மேலல்லார்",1,"Melallaar","superior (in quality); those who are not (negative copula)"],["மேலல்லர்",1,"Melallar","superior ones (in quality); are not (negative copula)"],["கீழிருந்தும்",1,"Keezhirundhum","low place/position; even though being"],["கீழல்லார்",2,"Keezhallaar","base (in quality); those who are not (negative copula)"],["கீழல்",2,"Keezhal","base ones (in quality)"],["லவர்",2,"Lavar","are not (low) (negative copula)"]]},{"n":974,"l":["ஒருமை மகளிரே போலப் பெருமையும்","தன்னைத்தான் கொண்டொழுகின் உண்டு."],"w":[["ஒருமை",1,"Orumai","single-minded chastity"],["மகளிரே",1,"Makalire","women; (emphatic ஏ)"],["போலப்",1,"Polap","like (simile particle)"],["பெருமையும்",1,"Perumaiyum","greatness; too, also"],["தன்னைத்தான்",2,"Thannaiththaan","oneself (acc.); oneself (nom., reflexive)"],["கொண்டொழுகின்",2,"Kontozhukin","having held/guarded; if one conducts/lives (conditional)"],["உண்டு",2,"Untu","(it) exists / is there"]]},{"n":975,"l":["பெருமை யுடையவர் ஆற்றுவார் ஆற்றின்","அருமை உடைய செயல்."],"w":[["பெருமை",1,"Perumai","greatness"],["யுடையவர்",1,"Yutaiyavar","those who possess"],["ஆற்றுவார்",1,"Aatruvaar","will accomplish"],["ஆற்றின்",1,"Aatrin","by the (proper) way/method"],["அருமை",2,"Arumai","difficulty, rarity"],["உடைய",2,"Utaiya","which possess (rare)"],["செயல்",2,"Seyal","deed, act"]]},{"n":976,"l":["சிறியார் உணர்ச்சியுள் இல்லை பெரியாரைப்","பேணிக்கொள் வேமென்னும் நோக்கு."],"w":[["சிறியார்",1,"Siriyaar","petty/small ones"],["உணர்ச்சியுள்",1,"Unarchchiyul","feeling, awareness; within"],["இல்லை",1,"Illai","is not, absent (negative finite)"],["பெரியாரைப்",1,"Periyaaraip","the great ones (acc.)"],["பேணிக்கொள்",2,"Penikkol",""],["வேமென்னும்",2,"Vemennum",""],["நோக்கு",2,"Nokku","aim, outlook"]]},{"n":977,"l":["இறப்பே புரிந்த தொழிற்றாம் சிறப்புந்தான்","சீரல் லவர்கண் படின்."],"w":[["இறப்பே",1,"Irappe","excess, transgression; (emphatic ஏ)"],["புரிந்த",1,"Purindha","which is engaged in/done"],["தொழிற்றாம்",1,"Thozhitraam","of the nature of deed; will become/is"],["சிறப்புந்தான்",1,"Sirappundhaan","distinction, eminence; even, too; (expletive தான்)"],["சீரல்",2,"Seeral","worth, dignity; not (negation)"],["லவர்கண்",2,"Lavarkan","those without (worth); at, in (locative)"],["படின்",2,"Patin","if it falls/befalls (conditional)"]]},{"n":978,"l":["பணியுமாம் என்றும் பெருமை சிறுமை","அணியுமாம் தன்னை வியந்து."],"w":[["பணியுமாம்",1,"Paniyumaam","will bow/humble (predicate); (assertive/expletive ஆம்)"],["என்றும்",1,"Endrum","always, at all times"],["பெருமை",1,"Perumai","greatness"],["சிறுமை",1,"Sirumai","meanness, littleness"],["அணியுமாம்",2,"Aniyumaam","will adorn/extol (predicate); (assertive/expletive ஆம்)"],["தன்னை",2,"Thannai","itself (acc.)"],["வியந்து",2,"Viyandhu","marveling, extolling"]]},{"n":979,"l":["பெருமை பெருமிதம் இன்மை சிறுமை","பெருமிதம் ஊர்ந்து விடல்."],"w":[["பெருமை",1,"Perumai","greatness"],["பெருமிதம்",1,"Perumidham","pride, arrogance"],["இன்மை",1,"Inmai","absence, not-having"],["சிறுமை",1,"Sirumai","meanness"],["பெருமிதம்",2,"Perumidham","pride, arrogance"],["ஊர்ந்து",2,"Oorndhu","riding upon, mounting"],["விடல்",2,"Vital","the letting (= being driven by)"]]},{"n":980,"l":["அற்றம் மறைக்கும் பெருமை சிறுமைதான்","குற்றமே கூறி விடும்."],"w":[["அற்றம்",1,"Atram","weakness, defect (acc., உருபு மறை)"],["மறைக்கும்",1,"Maraikkum","(which) conceals (modifies பெருமை)"],["பெருமை",1,"Perumai","greatness"],["சிறுமைதான்",1,"Sirumaidhaan","meanness; (expletive தான்)"],["குற்றமே",2,"Kutrame","fault, defect (acc.); only (restrictive/பிரிநிலை ஏ)"],["கூறி",2,"Koori","telling, proclaiming"],["விடும்",2,"Vitum","(will) utter / aux. completes action"]]}]}