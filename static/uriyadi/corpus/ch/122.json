{"n":122,"kurals":[{"n":1211,"l":["காதலர் தூதொடு வந்த கனவினுக்கு","யாதுசெய் வேன்கொல் விருந்து."],"w":[["காதலர்",1,"Kaadhalar","the beloved (honorific plural)"],["தூதொடு",1,"Thoodhotu","message, envoy; with (3rd-case comitative suffix)"],["வந்த",1,"Vandha","that came (rel. participle qualifying கனவு)"],["கனவினுக்கு",1,"Kanavinukku","to/for the dream"],["யாதுசெய்",2,"Yaadhusey","what (interrogative, object of செய்); do/make (stem feeding வேன்)"],["வேன்கொல்",2,"Venkol","shall I do — 1st person sing. future; doubt particle (kol)"],["விருந்து",2,"Virundhu","feast, hospitality (object of செய்வேன்)"]]},{"n":1212,"l":["கயலுண்கண் யானிரப்பத் துஞ்சிற் கலந்தார்க்கு","உயலுண்மை சாற்றுவேன் மன்."],"w":[["கயலுண்கண்",1,"Kayalunkan","carp fish (simile for the eye); collyrium-tinted (qualifier of கண்); eye(s)"],["யானிரப்பத்",1,"Yaanirappath","I (1st person pronoun); as I beg/entreat"],["துஞ்சிற்",1,"Thunjir","if (the eyes) sleep — conditional எச்சம்"],["கலந்தார்க்கு",1,"Kalandhaarkku","to him/them who united (with me)"],["உயலுண்மை",2,"Uyalunmai","surviving, escaping (death); the fact/truth (of surviving)"],["சாற்றுவேன்",2,"Saatruven","I shall declare/tell"],["மன்",2,"Man","particle (regret/contrast 'man')"]]},{"n":1213,"l":["நனவினால் நல்கா தவரைக் கனவினால்","காண்டலின் உண்டென் உயிர்."],"w":[["நனவினால்",1,"Nanavinaal","by/in the waking state"],["நல்கா",1,"Nalkaa","who does not show love (neg. rel. participle)"],["தவரைக்",1,"Thavaraik","him/them (the beloved) — object"],["கனவினால்",1,"Kanavinaal","by/in the dream"],["காண்டலின்",2,"Kaantalin","because of/through seeing"],["உண்டென்",2,"Unten","exists / there is; my (1st-person possessive)"],["உயிர்",2,"Uyir","life, soul"]]},{"n":1214,"l":["கனவினான் உண்டாகும் காமம் நனவினான்","நல்காரை நாடித் தரற்கு."],"w":[["கனவினான்",1,"Kanavinaan","by/in the dream"],["உண்டாகும்",1,"Untaakum","that arises / comes into being (qualifying காமம்)"],["காமம்",1,"Kaamam","love-passion, desire"],["நனவினான்",1,"Nanavinaan","by/in the waking state"],["நல்காரை",2,"Nalkaarai","those who do not show love (object)"],["நாடித்",2,"Naatith","having sought"],["தரற்கு",2,"Thararku","for bringing/giving"]]},{"n":1215,"l":["நனவினால் கண்டதூஉம் ஆங்கே கனவுந்தான்","கண்ட பொழுதே இனிது."],"w":[["நனவினால்",1,"Nanavinaal","by/in the waking state"],["கண்டதூஉம்",1,"Kantadhooum","that which was seen; also/even (um)"],["ஆங்கே",1,"Aange","there / at that (time); emphatic ē"],["கனவுந்தான்",1,"Kanavundhaan","the dream; also/too (um); expletive/emphatic 'taan'"],["கண்ட",2,"Kanta","that (one) saw (rel. participle qualifying பொழுது)"],["பொழுதே",2,"Pozhudhe","(the very) time/moment; emphatic/restrictive ē"],["இனிது",2,"Inidhu","(is) sweet/pleasant — predicate"]]},{"n":1216,"l":["நனவென ஒன்றில்லை ஆயின் கனவினால்","காதலர் நீங்கலர் மன்."],"w":[["நனவென",1,"Nanavena","waking state; (that which is) called 'as' — quotative எச்சம்"],["ஒன்றில்லை",1,"Ondrillai","one (thing); is not / does not exist"],["ஆயின்",1,"Aayin","if it be (so) — conditional எச்சம்"],["கனவினால்",1,"Kanavinaal","by/in the dream"],["காதலர்",2,"Kaadhalar","the beloved (honorific)"],["நீங்கலர்",2,"Neengalar","(they) would not depart — neg. finite"],["மன்",2,"Man","particle of contrast/unrealised wish (man)"]]},{"n":1217,"l":["நனவினால் நல்காக் கொடியார் கனவினால்","என்எம்மைப் பீழிப் பது."],"w":[["நனவினால்",1,"Nanavinaal","by/in the waking state"],["நல்காக்",1,"Nalkaak","who does not show love (neg. rel. participle)"],["கொடியார்",1,"Kotiyaar","the cruel one(s)"],["கனவினால்",1,"Kanavinaal","by/in the dream"],["என்எம்மைப்",2,"Enemmaip","why / for what reason (என் = எவன்); us / me (1st pers. object)"],["பீழிப்",2,"Peezhip","torment/squeeze (verbal base of பீழிப்பது)"],["பது",2,"Padhu","the act/fact of tormenting (-pathu nominaliser)"]]},{"n":1218,"l":["துஞ்சுங்கால் தோள்மேலர் ஆகி விழிக்குங்கால்","நெஞ்சத்தர் ஆவர் விரைந்து."],"w":[["துஞ்சுங்கால்",1,"Thunjungaal","that sleeps — rel. participle qualifying கால்; time/occasion ('when one sleeps')"],["தோள்மேலர்",1,"Tholmelar","shoulder (on the shoulder); is/are upon — predicate (he-is-on-the-shoulder)"],["ஆகி",1,"Aaki","having become"],["விழிக்குங்கால்",1,"Vizhikkungaal","that awakes — rel. participle qualifying கால்; time/occasion ('when one awakes')"],["நெஞ்சத்தர்",2,"Nenjaththar","is/are in (my) heart — predicate"],["ஆவர்",2,"Aavar","(they) become"],["விரைந்து",2,"Viraindhu","hastily, having hastened"]]},{"n":1219,"l":["நனவினால் நல்காரை நோவர் கனவினால்","காதலர்க் காணா தவர்."],"w":[["நனவினால்",1,"Nanavinaal","by/in the waking state"],["நல்காரை",1,"Nalkaarai","those who do not show love (object)"],["நோவர்",1,"Novar","(they) grieve/rue"],["கனவினால்",1,"Kanavinaal","by/in the dream"],["காதலர்க்",2,"Kaadhalark","the beloved (object of காணா)"],["காணா",2,"Kaanaa","who do not see (neg. rel. participle)"],["தவர்",2,"Thavar","those (women) — subject"]]},{"n":1220,"l":["நனவினால் நம்நீத்தார் என்பர் கனவினால்","காணார்கொல் இவ்வூ ரவர்."],"w":[["நனவினால்",1,"Nanavinaal","by/in the waking state"],["நம்நீத்தார்",1,"Namneeththaar","us (1st pers. object); those who abandoned/left"],["என்பர்",1,"Enpar","(they) say"],["கனவினால்",1,"Kanavinaal","by/in the dream"],["காணார்கொல்",2,"Kaanaarkol","do they not see? — neg. finite; interrogative/doubt particle (kol)"],["இவ்வூ",2,"Ivvoo","this (proximal deictic); town/village"],["ரவர்",2,"Ravar","the townsfolk (subject)"]]}]}