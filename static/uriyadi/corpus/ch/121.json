{"n":121,"kurals":[{"n":1201,"l":["உள்ளினும் தீராப் பெருமகிழ் செய்தலால்","கள்ளினும் காமம் இனிது."],"w":[["உள்ளினும்",1,"Ullinum","even if (one) thinks of"],["தீராப்",1,"Theeraap","unceasing, that does not end"],["பெருமகிழ்",1,"Perumakizh","great; joy"],["செய்தலால்",1,"Seydhalaal","because of doing/making"],["கள்ளினும்",2,"Kallinum","than toddy/wine"],["காமம்",2,"Kaamam","love, desire"],["இனிது",2,"Inidhu","(is) sweet"]]},{"n":1202,"l":["எனைத்தொன்று இனிதேகாண் காமம்தாம் வீழ்வார்","நினைப்ப வருவதொன்று இல்."],"w":[["எனைத்தொன்று",1,"Enaiththondru","how much, in any measure; one, a thing"],["இனிதேகாண்",1,"Inidhekaan","(is) sweet; emphatic ē; expletive 'see/lo'"],["காமம்தாம்",1,"Kaamamdhaam","love; expletive 'taam'"],["வீழ்வார்",1,"Veezhvaar","those who love/desire"],["நினைப்ப",2,"Ninaippa","when (one) thinks of"],["வருவதொன்று",2,"Varuvadhondru","that which comes (pain); a thing, anything"],["இல்",2,"Il","negative particle 'not' (= இல்லை)"]]},{"n":1203,"l":["நினைப்பவர் போன்று நினையார்கொல் தும்மல்","சினைப்பது போன்று கெடும்."],"w":[["நினைப்பவர்",1,"Ninaippavar","those who think (of me)"],["போன்று",1,"Pondru","being like, as if"],["நினையார்கொல்",1,"Ninaiyaarkol","do they not think?; doubt/interrogative particle"],["தும்மல்",1,"Thummal","sneeze"],["சினைப்பது",2,"Sinaippadhu","that which swells/buds up"],["போன்று",2,"Pondru","being like, as if"],["கெடும்",2,"Ketum","vanishes, ceases"]]},{"n":1204,"l":["யாமும் உளேங்கொல் அவர்நெஞ்சத்து எந்நெஞ்சத்து","ஓஒ உளரே அவர்."],"w":[["யாமும்",1,"Yaamum","we/I; too, also"],["உளேங்கொல்",1,"Ulengol","are we present?; doubt/interrogative particle"],["அவர்நெஞ்சத்து",1,"Avarnenjaththu","his (lit. their); in (the) heart"],["எந்நெஞ்சத்து",1,"Ennenjaththu","my (lit. our); in (the) heart"],["ஓஒ",2,"Oo","alas! (exclamation of wonder/pity)"],["உளரே",2,"Ulare","(he) is present; emphatic/assertive ē"],["அவர்",2,"Avar","he (lit. they)"]]},{"n":1205,"l":["தம்நெஞ்சத்து எம்மைக் கடிகொண்டார் நாணார்கொல்","எம்நெஞ்சத்து ஓவா வரல்."],"w":[["தம்நெஞ்சத்து",1,"Thamnenjaththu","their/his own; in (the) heart"],["எம்மைக்",1,"Emmaik","us/me (acc.)"],["கடிகொண்டார்",1,"Katikontaar","ban, guarding-off; (they) held, kept"],["நாணார்கொல்",1,"Naanaarkol","will (they) not feel shame?; doubt/interrogative particle"],["எம்நெஞ்சத்து",2,"Emnenjaththu","our/my; in (the) heart"],["ஓவா",2,"Ovaa","unceasing, that does not stop"],["வரல்",2,"Varal","(the) coming"]]},{"n":1206,"l":["மற்றியான் என்னுளேன் மன்னோ அவரொடியான்","உற்றநாள் உள்ள உளேன்."],"w":[["மற்றியான்",1,"","moreover, else (expletive); I"],["என்னுளேன்",1,"","what, by what; by what am I alive?"],["மன்னோ",1,"","particle of regret/emphasis; interrogative/wonder ō"],["அவரொடியான்",1,"","with him; I"],["உற்றநாள்",2,"","that (we) joined/were together; days"],["உள்ள",2,"","by recalling, to remember"],["உளேன்",2,"","I am (alive)"]]},{"n":1207,"l":["மறப்பின் எவனாவன் மற்கொல் மறப்பறியேன்","உள்ளினும் உள்ளம் சுடும்."],"w":[["மறப்பின்",1,"Marappin","if (I) forget"],["எவனாவன்",1,"Evanaavan","what; what will I become?"],["மற்கொல்",1,"Markol","particle (here 'mar'); doubt/interrogative particle"],["மறப்பறியேன்",1,"Marappariyen","forgetting; I know not (forgetting)"],["உள்ளினும்",2,"Ullinum","even if (I) think/recall"],["உள்ளம்",2,"Ullam","(the) heart/mind"],["சுடும்",2,"Sutum","(it) burns"]]},{"n":1208,"l":["எனைத்து நினைப்பினும் காயார் அனைத்தன்றோ","காதலர் செய்யும் சிறப்பு."],"w":[["எனைத்து",1,"Enaiththu","how much, however much"],["நினைப்பினும்",1,"Ninaippinum","even if (I) think (of him)"],["காயார்",1,"Kaayaar","(he) is not angry"],["அனைத்தன்றோ",1,"Anaiththandro","that much, of that nature; is it not (so); interrogative ō"],["காதலர்",2,"Kaadhalar","(the) beloved"],["செய்யும்",2,"Seyyum","that (he) does"],["சிறப்பு",2,"Sirappu","honour, special favour"]]},{"n":1209,"l":["விளியுமென் இன்னுயிர் வேறல்லம் என்பார்","அளியின்மை ஆற்ற நினைந்து."],"w":[["விளியுமென்",1,"Viliyumen","(it) perishes/dies; my"],["இன்னுயிர்",1,"Innuyir","sweet, dear; dear life"],["வேறல்லம்",1,"Verallam","separate, other; we are not (separate)"],["என்பார்",1,"Enpaar","those who say (so)"],["அளியின்மை",2,"Aliyinmai","grace, compassion; lack (of grace)"],["ஆற்ற",2,"Aatra","greatly, much"],["நினைந்து",2,"Ninaindhu","having thought of"]]},{"n":1210,"l":["விடாஅது சென்றாரைக் கண்ணினால் காணப்","படாஅதி வாழி மதி."],"w":[["விடாஅது",1,"Vitaaadhu","without leaving/ceasing"],["சென்றாரைக்",1,"Sendraaraik","him who went (acc.)"],["கண்ணினால்",1,"Kanninaal","with (the) eye"],["காணப்",1,"Kaanap","so as to see"],["படாஅதி",2,"Pataaadhi","do not set/hide (you)"],["வாழி",2,"Vaazhi","long may (you) live!"],["மதி",2,"Madhi","O moon!"]]}]}