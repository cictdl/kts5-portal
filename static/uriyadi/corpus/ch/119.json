{"n":119,"kurals":[{"n":1181,"l":["நயந்தவர்க்கு நல்காமை நேர்ந்தேன் பசந்தவென்","பண்பியார்க்கு உரைக்கோ பிற."],"w":[["நயந்தவர்க்கு",1,"Nayandhavarkku","to those (the lover) who desired (me); to/for (4th case)"],["நல்காமை",1,"Nalkaamai","(the lover's) not-granting / withholding of grace (i.e. parting) — obj of நேர்ந்தேன்"],["நேர்ந்தேன்",1,"Nerndhen","I consented/agreed"],["பசந்தவென்",1,"Pasandhaven","(that) turned pallid; my"],["பண்பியார்க்கு",2,"Panpiyaarkku","(my) nature/condition (obj); to whom; to (4th case)"],["உரைக்கோ",2,"Uraikko","shall I tell/say; interrogative/lament particle"],["பிற",2,"Pira","(line-end expletive) 'else/indeed'"]]},{"n":1182,"l":["அவர்தந்தார் என்னும் தகையால் இவர்தந்தென்","மேனிமேல் ஊரும் பசப்பு."],"w":[["அவர்தந்தார்",1,"Avardhandhaar","he/they (lover, honorific); (he) gave/begot"],["என்னும்",1,"Ennum","saying / so-called (that...)"],["தகையால்",1,"Thakaiyaal","by the pride/dignity; by/with (3rd case)"],["இவர்தந்தென்",1,"Ivardhandhen","this (pallor, here personified); having given/come; my"],["மேனிமேல்",2,"Menimel","body/complexion; upon/over (7th case)"],["ஊரும்",2,"Oorum","(pallor) creeps/rides"],["பசப்பு",2,"Pasappu","pallor / pallid hue (subject)"]]},{"n":1183,"l":["சாயலும் நாணும் அவர்கொண்டார் கைம்மாறா","நோயும் பசலையும் தந்து."],"w":[["சாயலும்",1,"Saayalum","(my) beauty/grace (obj); and (conjunctive)"],["நாணும்",1,"Naanum","(my) modesty/shyness (obj); and (conjunctive)"],["அவர்கொண்டார்",1,"Avarkontaar","he/they (lover); (he) took/seized"],["கைம்மாறா",1,"Kaimmaaraa","as recompense / in return"],["நோயும்",2,"Noyum","(love-)sickness/pang (obj); and (conjunctive)"],["பசலையும்",2,"Pasalaiyum","pallor (obj); and (conjunctive)"],["தந்து",2,"Thandhu","having given"]]},{"n":1184,"l":["உள்ளுவன் மன்யான் உரைப்பது அவர்திறமால்","கள்ளம் பிறவோ பசப்பு."],"w":[["உள்ளுவன்",1,"Ulluvan","I think/recall (of him)"],["மன்யான்",1,"Manyaan","expletive (here regret/emphasis); I"],["உரைப்பது",1,"Uraippadhu","what (I) speak"],["அவர்திறமால்",1,"Avardhiramaal","his; (good) quality/virtue; expletive/emphatic ஆல்"],["கள்ளம்",2,"Kallam","deceit/treachery"],["பிறவோ",2,"Piravo","(some) other (thing); interrogative particle (or?)"],["பசப்பு",2,"Pasappu","pallor"]]},{"n":1185,"l":["உவக்காண்எம் காதலர் செல்வார் இவக்காண்என்","மேனி பசப்பூர் வது."],"w":[["உவக்காண்எம்",1,"Uvakkaanem","behold there! (yonder, look); our"],["காதலர்",1,"Kaadhalar","(my) lover (honorific)"],["செல்வார்",1,"Selvaar","(he) departs/will go"],["இவக்காண்என்",1,"Ivakkaanen","behold here! (this side, look); my"],["மேனி",2,"Meni","(my) body/complexion"],["பசப்பூர்",2,"Pasappoor","pallor (subject of ஊர்வது); (pallor) that creeps/spreads — சொல் 'ஊர்வது' அடுத்த சீர் 'வது' வரை நீள்கிறது"],["வது",2,"Vadhu","(ஊர்வது-வின் எஞ்சிய சீர்) — that which spreads"]]},{"n":1186,"l":["விளக்கற்றம் பார்க்கும் இருளேபோல் கொண்கன்","முயக்கற்றம் பார்க்கும் பசப்பு."],"w":[["விளக்கற்றம்",1,"Vilakkatram","lamp('s); weakening/dimming/lapse (obj)"],["பார்க்கும்",1,"Paarkkum","(that) watches for"],["இருளேபோல்",1,"Irulepol","darkness; emphatic ஏ (just-like); like (உவம உருபு)"],["கொண்கன்",1,"Konkan","the lord (of seashore tract) / husband"],["முயக்கற்றம்",2,"Muyakkatram","embrace('s); slackening/loosening (obj)"],["பார்க்கும்",2,"Paarkkum","(pallor) watches for"],["பசப்பு",2,"Pasappu","pallor (subject)"]]},{"n":1187,"l":["புல்லிக் கிடந்தேன் புடைபெயர்ந்தேன் அவ்வளவில்","அள்ளிக்கொள் வற்றே பசப்பு."],"w":[["புல்லிக்",1,"Pullik","having embraced"],["கிடந்தேன்",1,"Kitandhen","I lay"],["புடைபெயர்ந்தேன்",1,"Putaipeyarndhen","side / aside; I moved/turned (aside)"],["அவ்வளவில்",1,"Avvalavil","in that (brief) span/moment; in (7th case)"],["அள்ளிக்கொள்",2,"Allikkol","scooping up / having grabbed; such-as-grabs (it grabs me up) — சொல் 'வற்றே' சீர் வரை நீள்கிறது"],["வற்றே",2,"Vatre","(கொள்வற்று-வின் எஞ்சிய சீர்) — that which grabs; emphatic/wonder ஏ"],["பசப்பு",2,"Pasappu","pallor (subject)"]]},{"n":1188,"l":["பசந்தாள் இவள்என்பது அல்லால் இவளைத்","துறந்தார் அவர்என்பார் இல்."],"w":[["பசந்தாள்",1,"Pasandhaal","(she) turned pallid"],["இவள்என்பது",1,"Ivalenpadhu","this woman / she; the saying that / what (people) say"],["அல்லால்",1,"Allaal","except / other than"],["இவளைத்",1,"Ivalaith","her (obj); accusative (2nd case)"],["துறந்தார்",2,"Thurandhaar","(he) forsook/abandoned"],["அவர்என்பார்",2,"Avarenpaar","he/they (lover); those who would say"],["இல்",2,"Il","there are none / not (exist)"]]},{"n":1189,"l":["பசக்கமன் பட்டாங்கென் மேனி நயப்பித்தார்","நன்னிலையர் ஆவர் எனின்."],"w":[["பசக்கமன்",1,"Pasakkaman","let (my body) turn pale; expletive particle (concessive)"],["பட்டாங்கென்",1,"Pattaangen","truly / as it really is; my"],["மேனி",1,"Meni","(my) body/complexion"],["நயப்பித்தார்",1,"Nayappiththaar","he who made (me) consent (to parting)"],["நன்னிலையர்",2,"Nannilaiyar","good; (those who) are of good estate"],["ஆவர்",2,"Aavar","(they) will be"],["எனின்",2,"Enin","if (it be) said / if so"]]},{"n":1190,"l":["பசப்பெனப் பேர்பெறுதல் நன்றே நயப்பித்தார்","நல்காமை தூற்றார் எனின்."],"w":[["பசப்பெனப்",1,"Pasappenap","pallor / 'the pallid one'; as / so saying (quotative)"],["பேர்பெறுதல்",1,"Perperudhal","name/repute (obj); the getting / to get"],["நன்றே",1,"Nandre","(is) good; emphatic/affirmative ஏ"],["நயப்பித்தார்",1,"Nayappiththaar","he who made (me) consent (to parting)"],["நல்காமை",2,"Nalkaamai","(his) not-being-gracious / withholding love (obj of தூற்று)"],["தூற்றார்",2,"Thootraar","(if people) do not decry/slander"],["எனின்",2,"Enin","if (it be so)"]]}]}