{"n":42,"kurals":[{"n":411,"l":["செல்வத்துட் செல்வஞ் செவிச்செல்வம் அச்செல்வம்","செல்வத்து ளெல்லாந் தலை."],"w":[["செல்வத்துட்",1,"Selvaththut","among wealths"],["செல்வஞ்",1,"Selvanj","wealth"],["செவிச்செல்வம்",1,"Chevichchelvam","ear; wealth (of the ear)"],["அச்செல்வம்",1,"Achchelvam","that; wealth"],["செல்வத்து",2,"Selvaththu","among (all) wealths"],["ளெல்லாந்",2,"Lellaan","all"],["தலை",2,"Thalai","foremost"]]},{"n":412,"l":["செவிக்குண வில்லாத போழ்து சிறிது","வயிற்றுக்கும் ஈயப் படும்."],"w":[["செவிக்குண",1,"Sevikkuna","for the ear; food"],["வில்லாத",1,"Villaadha","not having"],["போழ்து",1,"Pozhdhu","time/when"],["சிறிது",1,"Siridhu","a little"],["வயிற்றுக்கும்",2,"Vayitrukkum","to the stomach; also/even"],["ஈயப்",2,"Eeyap","to be given"],["படும்",2,"Patum","will be (done)"]]},{"n":413,"l":["செவியுணவிற் கேள்வி யுடையார் அவியுணவின்","ஆன்றாரோ டொப்பர் நிலத்து."],"w":[["செவியுணவிற்",1,"Seviyunavir","by way of ear-food"],["கேள்வி",1,"Kelvi","hearing/learning"],["யுடையார்",1,"Yutaiyaar","those who possess"],["அவியுணவின்",1,"Aviyunavin","by oblation-food"],["ஆன்றாரோ",2,"Aandraaro","the noble/full ones (gods); with"],["டொப்பர்",2,"Toppar","are equal"],["நிலத்து",2,"Nilaththu","on earth"]]},{"n":414,"l":["கற்றில னாயினுங் கேட்க அஃதொருவற்கு","ஒற்கத்தின் ஊற்றாந் துணை."],"w":[["கற்றில",1,"Katrila","he has not learned"],["னாயினுங்",1,"Naayinung","even though (it be); even/concessive"],["கேட்க",1,"Ketka","let (one) hear"],["அஃதொருவற்கு",1,"Aqdhoruvarku","that; for one (person)"],["ஒற்கத்தின்",2,"Orkaththin","in/at weakness"],["ஊற்றாந்",2,"Ootraan","that becomes a prop"],["துணை",2,"Thunai","support"]]},{"n":415,"l":["இழுக்கல் உடையுழி ஊற்றுக்கோல் அற்றே","ஒழுக்க முடையார்வாய்ச் சொல்."],"w":[["இழுக்கல்",1,"Izhukkal","slipping"],["உடையுழி",1,"Utaiyuzhi","at the place that has (slipping)"],["ஊற்றுக்கோல்",1,"Ootrukkol","supporting staff"],["அற்றே",1,"Atre","like that (simile particle); (emphatic)"],["ஒழுக்க",2,"Ozhukka","virtue/conduct"],["முடையார்வாய்ச்",2,"Mutaiyaarvaaich","those who possess; mouth"],["சொல்",2,"Chol","word"]]},{"n":416,"l":["எனைத்தானும் நல்லவை கேட்க அனைத்தானும்","ஆன்ற பெருமை தரும்."],"w":[["எனைத்தானும்",1,"Enaiththaanum","however much; even/whatsoever"],["நல்லவை",1,"Nallavai","good things"],["கேட்க",1,"Ketka","let (one) hear"],["அனைத்தானும்",1,"Anaiththaanum","that much; even/to that extent"],["ஆன்ற",2,"Aandra","full/abundant"],["பெருமை",2,"Perumai","greatness"],["தரும்",2,"Tharum","will give"]]},{"n":417,"l":["பிழைத்துணர்ந்தும் பேதைமை சொல்லா ரிழைத்துணர்ந்","தீண்டிய கேள்வி யவர்."],"w":[["பிழைத்துணர்ந்தும்",1,"","having erred; having understood; even (concessive)"],["பேதைமை",1,"","folly"],["சொல்லா",1,"","will not speak"],["ரிழைத்துணர்ந்",1,"","having examined finely; having understood"],["தீண்டிய",2,"","that touched/attained"],["கேள்வி",2,"","hearing/learning"],["யவர்",2,"","those (people)"]]},{"n":418,"l":["கேட்பினுங் கேளாத் தகையவே கேள்வியால்","தோட்கப் படாத செவி."],"w":[["கேட்பினுங்",1,"Ketpinung","even if (they) hear; even (concessive)"],["கேளாத்",1,"Kelaath","that does not hear"],["தகையவே",1,"Thakaiyave","of (such) nature; (emphatic)"],["கேள்வியால்",1,"Kelviyaal","by hearing/learning"],["தோட்கப்",2,"Thotkap","to be bored/pierced"],["படாத",2,"Pataadha","that is not (done)"],["செவி",2,"Sevi","ear"]]},{"n":419,"l":["நுணங்கிய கேள்விய ரல்லார் வணங்கிய","வாயின ராதல் அரிது."],"w":[["நுணங்கிய",1,"Nunangiya","subtle/refined"],["கேள்விய",1,"Kelviya","of hearing/learning"],["ரல்லார்",1,"Rallaar","those who are not"],["வணங்கிய",1,"Vanangiya","humble/bowed"],["வாயின",2,"Vaayina","of (such) mouth"],["ராதல்",2,"Raadhal","becoming"],["அரிது",2,"Aridhu","is difficult"]]},{"n":420,"l":["செவியிற் சுவையுணரா வாயுணர்வின் மாக்கள்","அவியினும் வாழினும் என்?"],"w":[["செவியிற்",1,"Seviyir","by/in the ear"],["சுவையுணரா",1,"Suvaiyunaraa","taste/relish; not perceiving"],["வாயுணர்வின்",1,"Vaayunarvin","mouth; with mouth-perception"],["மாக்கள்",1,"Maakkal","(base) people"],["அவியினும்",2,"Aviyinum","even if they perish; even"],["வாழினும்",2,"Vaazhinum","even if they live; even"],["என்",2,"En","what (does it matter)?"]]}]}