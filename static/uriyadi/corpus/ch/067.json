{"n":67,"kurals":[{"n":661,"l":["வினைத்திட்பம் என்பது ஒருவன் மனத்திட்பம்","மற்றைய எல்லாம் பிற."],"w":[["வினைத்திட்பம்",1,"Vinaiththitpam","firmness in action"],["என்பது",1,"Enpadhu","that which is called"],["ஒருவன்",1,"Oruvan","a man's"],["மனத்திட்பம்",1,"Manaththitpam","firmness of mind"],["மற்றைய",2,"Matraiya","the rest (others)"],["எல்லாம்",2,"Ellaam","all"],["பிற",2,"Pira","other things"]]},{"n":662,"l":["ஊறொரால் உற்றபின் ஒல்காமை இவ்விரண்டின்","ஆறென்பர் ஆய்ந்தவர் கோள்."],"w":[["ஊறொரால்",1,"Oororaal","removing harm (beforehand)"],["உற்றபின்",1,"Utrapin","having befallen; after"],["ஒல்காமை",1,"Olkaamai","not flinching"],["இவ்விரண்டின்",1,"Ivvirantin","these; of the two"],["ஆறென்பர்",2,"Aarenpar","way, method; they say"],["ஆய்ந்தவர்",2,"Aaindhavar","those who have examined"],["கோள்",2,"Kol","tenet, principle"]]},{"n":663,"l":["கடைக்கொட்கச் செய்தக்க தாண்மை இடைக்கொட்கின்","எற்றா விழுமந் தரும்."],"w":[["கடைக்கொட்கச்",1,"Kataikkotkach","at the end; so as to be revealed"],["செய்தக்க",1,"Cheydhakka","fit to be done"],["தாண்மை",1,"Thaanmai","manliness, ability"],["இடைக்கொட்கின்",1,"Itaikkotkin","in the middle; if revealed"],["எற்றா",2,"Etraa","unremovable, that cannot be wiped"],["விழுமந்",2,"Vizhuman","grief, distress"],["தரும்",2,"Tharum","will give"]]},{"n":664,"l":["சொல்லுதல் யார்க்கும் எளிய அரியவாம்","சொல்லிய வண்ணம் செயல்."],"w":[["சொல்லுதல்",1,"Solludhal","saying, telling"],["யார்க்கும்",1,"Yaarkkum","for anyone; even, all-inclusive um"],["எளிய",1,"Eliya","are easy"],["அரியவாம்",1,"Ariyavaam","difficult things; become / are"],["சொல்லிய",2,"Solliya","(as) said"],["வண்ணம்",2,"Vannam","manner, way"],["செயல்",2,"Seyal","doing, action"]]},{"n":665,"l":["வீறெய்தி மாண்டார் வினைத்திட்பம் வேந்தன்கண்","ஊறெய்தி உள்ளப் படும்."],"w":[["வீறெய்தி",1,"Veereydhi","greatness; having attained"],["மாண்டார்",1,"Maantaar","those who became great"],["வினைத்திட்பம்",1,"Vinaiththitpam","firmness in action"],["வேந்தன்கண்",1,"Vendhankan","king; in/at (locative)"],["ஊறெய்தி",2,"Ooreydhi","value, esteem (reach); having reached"],["உள்ளப்",2,"Ullap","so as to be esteemed"],["படும்",2,"Patum","will be (passive aux)"]]},{"n":666,"l":["எண்ணிய எண்ணியாங்கு எய்துப எண்ணியார்","திண்ணியர் ஆகப் பெறின்."],"w":[["எண்ணிய",1,"Enniya","the things thought"],["எண்ணியாங்கு",1,"Enniyaangu","(as) thought; in that manner / as"],["எய்துப",1,"Eydhupa","they will attain"],["எண்ணியார்",1,"Enniyaar","those who thought/planned"],["திண்ணியர்",2,"Thinniyar","they are firm/resolute"],["ஆகப்",2,"Aakap","being / so as to be"],["பெறின்",2,"Perin","if (they) obtain/are"]]},{"n":667,"l":["உருவுகண்டு எள்ளாமை வேண்டும் உருள்பெருந்தேர்க்கு","அச்சாணி அன்னார் உடைத்து."],"w":[["உருவுகண்டு",1,"Uruvukantu","form, body; having seen"],["எள்ளாமை",1,"Ellaamai","not despising"],["வேண்டும்",1,"Ventum","is needed / one must"],["உருள்பெருந்தேர்க்கு",1,"Urulperundherkku","rolling; big; for the chariot"],["அச்சாணி",2,"Achchaani","linchpin (of axle)"],["அன்னார்",2,"Annaar","those who are like (that)"],["உடைத்து",2,"Utaiththu","(the world) possesses"]]},{"n":668,"l":["கலங்காது கண்ட வினைக்கண் துளங்காது","தூக்கங் கடிந்து செயல்."],"w":[["கலங்காது",1,"Kalangaadhu","without wavering"],["கண்ட",1,"Kanta","(that was) discerned"],["வினைக்கண்",1,"Vinaikkan","deed; in (locative)"],["துளங்காது",1,"Thulangaadhu","without faltering"],["தூக்கங்",2,"Thookkang","delay, hesitation"],["கடிந்து",2,"Katindhu","having removed"],["செயல்",2,"Seyal","do! (verbal noun in imperative sense)"]]},{"n":669,"l":["துன்பம் உறவரினும் செய்க துணிவாற்றி","இன்பம் பயக்கும் வினை."],"w":[["துன்பம்",1,"Thunpam","suffering"],["உறவரினும்",1,"Uravarinum","abundantly, much; even if it comes"],["செய்க",1,"Seyka","let (one) do / do!"],["துணிவாற்றி",1,"Thunivaatri","resolve; having mustered"],["இன்பம்",2,"Inpam","joy"],["பயக்கும்",2,"Payakkum","(that) yields"],["வினை",2,"Vinai","the deed"]]},{"n":670,"l":["எனைத்திட்பம் எய்தியக் கண்ணும் வினைத்திட்பம்","வேண்டாரை வேண்டாது உலகு."],"w":[["எனைத்திட்பம்",1,"","however much; firmness"],["எய்தியக்",1,"","having attained"],["கண்ணும்",1,"","in the case of; even"],["வினைத்திட்பம்",1,"","firmness in action"],["வேண்டாரை",2,"","those who do not desire (it)"],["வேண்டாது",2,"","does not desire"],["உலகு",2,"","the world (people)"]]}]}