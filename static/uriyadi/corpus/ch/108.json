{"n":108,"kurals":[{"n":1071,"l":["மக்களே போல்வர் கயவர் அவரன்ன","ஒப்பாரி யாங்கண்ட தில்."],"w":[["மக்களே",1,"Makkale","humans/men; emphatic/restrictive particle"],["போல்வர்",1,"Polvar","are like / resemble"],["கயவர்",1,"Kayavar","the base/mean ones"],["அவரன்ன",1,"Avaranna","them/those; like/resembling (simile particle)"],["ஒப்பாரி",2,"Oppaari","comparison/likeness"],["யாங்கண்ட",2,"Yaanganta","we; (that we) saw"],["தில்",2,"Thil","particle (with இல்: 'have not seen')"]]},{"n":1072,"l":["நன்றறி வாரிற் கயவர் திருவுடையர்","நெஞ்சத்து அவலம் இலர்."],"w":[["நன்றறி",1,"Nandrari","good/goodness (obj); knowing (verbal root in compound)"],["வாரிற்",1,"Vaarir","those who know (than them); than (comparative case)"],["கயவர்",1,"Kayavar","the base ones"],["திருவுடையர்",1,"Thiruvutaiyar","wealth/fortune; (they) possess"],["நெஞ்சத்து",2,"Nenjaththu","in the heart; euphonic increment (saariyai)"],["அவலம்",2,"Avalam","sorrow/anxiety"],["இலர்",2,"Ilar","(they) are without"]]},{"n":1073,"l":["தேவர் அனையர் கயவர் அவருந்தாம்","மேவன செய்தொழுக லான்."],"w":[["தேவர்",1,"Thevar","gods/celestials"],["அனையர்",1,"Anaiyar","(they) are like"],["கயவர்",1,"Kayavar","the base ones"],["அவருந்தாம்",1,"Avarundhaam","they/those; also/too; themselves"],["மேவன",2,"Mevana","the things (they) desire"],["செய்தொழுக",2,"Seydhozhuka","having done; to conduct/live (infinitive)"],["லான்",2,"Laan","because of / by (causal-instrumental)"]]},{"n":1074,"l":["அகப்பட்டி ஆவாரைக் காணின் அவரின்","மிகப்பட்டுச் செம்மாக்கும் கீழ்."],"w":[["அகப்பட்டி",1,"Akappatti","low/abject (one)"],["ஆவாரைக்",1,"Aavaaraik","those who become (obj); accusative marker"],["காணின்",1,"Kaanin","if (one) sees"],["அவரின்",1,"Avarin","than them; than (comparative)"],["மிகப்பட்டுச்",2,"Mikappattuch","exceedingly; having become/undergone"],["செம்மாக்கும்",2,"Chemmaakkum","will exult/swell with pride"],["கீழ்",2,"Keezh","the base/low one"]]},{"n":1075,"l":["அச்சமே கீழ்களது ஆசாரம் எச்சம்","அவாவுண்டேல் உண்டாம் சிறிது."],"w":[["அச்சமே",1,"Achchame","fear; emphatic (it is fear alone)"],["கீழ்களது",1,"Keezhkaladhu","of the base ones; genitive (of)"],["ஆசாரம்",1,"Aasaaram","good conduct/decorum"],["எச்சம்",1,"Echcham","the remainder/besides that"],["அவாவுண்டேல்",2,"Avaavuntel","desire/craving; if there be"],["உண்டாம்",2,"Untaam","there will be"],["சிறிது",2,"Siridhu","a little"]]},{"n":1076,"l":["அறைபறை அன்னர் கயவர்தாம் கேட்ட","மறைபிறர்க்கு உய்த்துரைக்க லான்."],"w":[["அறைபறை",1,"Araiparai","(that is) beaten — qualifying; drum"],["அன்னர்",1,"Annar","(they) are like"],["கயவர்தாம்",1,"Kayavardhaam","the base ones; themselves"],["கேட்ட",1,"Ketta","(secret) that (they) heard"],["மறைபிறர்க்கு",2,"Maraipirarkku","secret (obj); to others; dative (to)"],["உய்த்துரைக்க",2,"Uyththuraikka","carrying/conveying; to tell (infinitive)"],["லான்",2,"Laan","because of / by"]]},{"n":1077,"l":["ஈர்ங்கை விதிரார் கயவர் கொடிறுடைக்கும்","கூன்கையர் அல்லா தவர்க்கு."],"w":[["ஈர்ங்கை",1,"Eerngai","wet/moist; hand"],["விதிரார்",1,"Vidhiraar","(they) will not shake off"],["கயவர்",1,"Kayavar","the base ones"],["கொடிறுடைக்கும்",1,"Kotirutaikkum","jaw/cheek (obj); that breaks"],["கூன்கையர்",2,"Koonkaiyar","bent/clenched; those with (clenched) hands"],["அல்லா",2,"Allaa","who are not"],["தவர்க்கு",2,"Thavarkku","to those who are not; dative (to)"]]},{"n":1078,"l":["சொல்லப் பயன்படுவர் சான்றோர் கரும்புபோல்","கொல்லப் பயன்படும் கீழ்."],"w":[["சொல்லப்",1,"Sollap","on being told/asked (infinitive)"],["பயன்படுவர்",1,"Payanpatuvar","benefit/use; (they) become useful"],["சான்றோர்",1,"Saandror","the noble/worthy"],["கரும்புபோல்",1,"Karumpupol","sugarcane; like (simile particle)"],["கொல்லப்",2,"Kollap","on being crushed/killed (infinitive)"],["பயன்படும்",2,"Payanpatum","benefit/use; becomes useful"],["கீழ்",2,"Keezh","the base one"]]},{"n":1079,"l":["உடுப்பதூஉம் உண்பதூஉம் காணின் பிறர்மேல்","வடுக்காண வற்றாகும் கீழ்."],"w":[["உடுப்பதூஉம்",1,"Utuppadhooum","that which is worn; and/also"],["உண்பதூஉம்",1,"Unpadhooum","that which is eaten; and/also"],["காணின்",1,"Kaanin","if (he) sees"],["பிறர்மேல்",1,"Pirarmel","on others; upon/on (locative)"],["வடுக்காண",2,"Vatukkaana","fault/blemish (obj); to see/find (infinitive)"],["வற்றாகும்",2,"Vatraakum","becomes capable/skilled"],["கீழ்",2,"Keezh","the base one"]]},{"n":1080,"l":["எற்றிற் குரியர் கயவரொன்று உற்றக்கால்","விற்றற்கு உரியர் விரைந்து."],"w":[["எற்றிற்",1,"Etrir","for what (thing)?; dative (for)"],["குரியர்",1,"Kuriyar","(they) are fit/suited"],["கயவரொன்று",1,"Kayavarondru","the base ones; one (thing/trouble)"],["உற்றக்கால்",1,"Utrakkaal","when (it) befalls"],["விற்றற்கு",2,"Vitrarku","selling (themselves); dative (for)"],["உரியர்",2,"Uriyar","(they) are fit/ready"],["விரைந்து",2,"Viraindhu","hastily/quickly"]]}]}