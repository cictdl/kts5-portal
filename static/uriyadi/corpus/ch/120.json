{"n":120,"kurals":[{"n":1191,"l":["தாம்வீழ்வார் தம்வீழப் பெற்றவர் பெற்றாரே","காமத்துக் காழில் கனி."],"w":[["தாம்வீழ்வார்",1,"Thaamveezhvaar","they themselves; those whom (they) love"],["தம்வீழப்",1,"Thamveezhap","them (as object of loving); so as to love/desire"],["பெற்றவர்",1,"Petravar","those who obtained"],["பெற்றாரே",1,"Petraare","they have obtained; emphatic (தேற்றம்)"],["காமத்துக்",2,"Kaamaththuk","of love (genitive)"],["காழில்",2,"Kaazhil","seed/stone; without / -less (privative)"],["கனி",2,"Kani","ripe fruit"]]},{"n":1192,"l":["வாழ்வார்க்கு வானம் பயந்தற்றால் வீழ்வார்க்கு","வீழ்வார் அளிக்கும் அளி."],"w":[["வாழ்வார்க்கு",1,"Vaazhvaarkku","for those who live"],["வானம்",1,"Vaanam","sky/rain-cloud"],["பயந்தற்றால்",1,"Payandhatraal","having yielded/given; like / of that nature (உவம உருபு); expletive ஈற்றசை"],["வீழ்வார்க்கு",1,"Veezhvaarkku","for those who love"],["வீழ்வார்",2,"Veezhvaar","the ones who love (subject)"],["அளிக்கும்",2,"Alikkum","(that they) bestow"],["அளி",2,"Ali","loving-kindness/grace"]]},{"n":1193,"l":["வீழுநர் வீழப் படுவார்க்கு அமையுமே","வாழுநம் என்னும் செருக்கு."],"w":[["வீழுநர்",1,"Veezhunar","those who love"],["வீழப்",1,"Veezhap","so as to be loved"],["படுவார்க்கு",1,"Patuvaarkku","for those who are loved"],["அமையுமே",1,"Amaiyume","is fitting/suffices; emphatic (தேற்றம்)"],["வாழுநம்",2,"Vaazhunam","we shall live"],["என்னும்",2,"Ennum","that says / named"],["செருக்கு",2,"Serukku","pride/elation"]]},{"n":1194,"l":["வீழப் படுவார் கெழீஇயிலர் தாம்வீழ்வார்","வீழப் படாஅர் எனின்."],"w":[["வீழப்",1,"Veezhap","so as to be loved"],["படுவார்",1,"Patuvaar","those who are loved"],["கெழீஇயிலர்",1,"Kezheeiyilar","affinity/good-fortune; they are without"],["தாம்வீழ்வார்",1,"Thaamveezhvaar","they themselves; those whom they love"],["வீழப்",2,"Veezhap","so as to love"],["படாஅர்",2,"Pataaar","(if) they are not loved (in return)"],["எனின்",2,"Enin","if (it be) so"]]},{"n":1195,"l":["நாம்காதல் கொண்டார் நமக்கெவன் செய்பவோ","தாம்காதல் கொள்ளாக் கடை."],"w":[["நாம்காதல்",1,"Naamkaadhal","we; love (object)"],["கொண்டார்",1,"Kontaar","the one who held (love) = lover"],["நமக்கெவன்",1,"Namakkevan","to/for us; what (interrogative)"],["செய்பவோ",1,"Seypavo","will (they) do; interrogative ஓ"],["தாம்காதல்",2,"Thaamkaadhal","they themselves; love (object)"],["கொள்ளாக்",2,"Kollaak","not holding (love)"],["கடை",2,"Katai","at the time/state when"]]},{"n":1196,"l":["ஒருதலையான் இன்னாது காமம்காப் போல","இருதலை யானும் இனிது."],"w":[["ஒருதலையான்",1,"Orudhalaiyaan","one; by/on one side"],["இன்னாது",1,"Innaadhu","is painful/not sweet"],["காமம்காப்",1,"Kaamamkaap","love/passion; carrying-pole (காவடி)"],["போல",1,"Pola","like (உவம உருபு)"],["இருதலை",2,"Irudhalai","two; side(s)"],["யானும்",2,"Yaanum","on (both) sides — 3rd வேற்றுமை உருபு (சந்தி யான்); also/even (சிறப்பு உம்மை)"],["இனிது",2,"Inidhu","is sweet/pleasant"]]},{"n":1197,"l":["பருவரலும் பைதலும் காணான்கொல் காமன்","ஒருவர்கண் நின்றொழுகு வான்."],"w":[["பருவரலும்",1,"Paruvaralum","grief/suffering; and (எண் உம்மை)"],["பைதலும்",1,"Paidhalum","pallor/sorrow (பசலை); and (எண் உம்மை)"],["காணான்கொல்",1,"Kaanaankol","he sees not; doubt/wonder particle (ஐயம்)"],["காமன்",1,"Kaaman","Kaman (god of love)"],["ஒருவர்கண்",2,"Oruvarkan","in one person; locative உருபு (கண், 7th வேற்றுமை)"],["நின்றொழுகு",2,"Nindrozhuku","standing; (who) conducts/operates"],["வான்",2,"Vaan","he who operates (= Kaman)"]]},{"n":1198,"l":["வீழ்வாரின் இன்சொல் பெறாஅது உலகத்து","வாழ்வாரின் வன்கணார் இல்."],"w":[["வீழ்வாரின்",1,"Veezhvaarin","from the one (she) loves"],["இன்சொல்",1,"Insol","sweet; word"],["பெறாஅது",1,"Peraaadhu","without obtaining"],["உலகத்து",1,"Ulakaththu","in the world"],["வாழ்வாரின்",2,"Vaazhvaarin","than those who (merely) live"],["வன்கணார்",2,"Vankanaar","the hard-hearted/cruel ones"],["இல்",2,"Il","there is none"]]},{"n":1199,"l":["நசைஇயார் நல்கார் எனினும் அவர்மாட்டு","இசையும் இனிய செவிக்கு."],"w":[["நசைஇயார்",1,"Nasaiiyaar","the one (I) desired/loved"],["நல்கார்",1,"Nalkaar","they show no grace/love"],["எனினும்",1,"Eninum","even if (it be) so; even (இழிவுசிறப்பு உம்மை)"],["அவர்மாட்டு",1,"Avarmaattu","from/about them; locative உருபு (மாட்டு, 7th வேற்றுமை)"],["இசையும்",2,"Isaiyum","fame/word; even/also (சிறப்பு உம்மை)"],["இனிய",2,"Iniya","(that are) sweet"],["செவிக்கு",2,"Sevikku","to the ear"]]},{"n":1200,"l":["உறாஅர்க்கு உறுநோய் உரைப்பாய் கடலைச்","செறாஅஅய் வாழிய நெஞ்சு."],"w":[["உறாஅர்க்கு",1,"Uraaarkku","to those unrelated/loveless"],["உறுநோய்",1,"Urunoi","great/abundant; great affliction"],["உரைப்பாய்",1,"Uraippaai","you tell"],["கடலைச்",1,"Katalaich","the sea (object)"],["செறாஅஅய்",2,"Cheraaaai","fill up / pack up (you!)"],["வாழிய",2,"Vaazhiya","may you live!"],["நெஞ்சு",2,"Nenju","O heart! (vocative)"]]}]}