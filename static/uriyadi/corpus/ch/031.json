{"n":31,"kurals":[{"n":301,"l":["செல்லிடத்துக் காப்பான் சினங்காப்பான் அல்லிடத்துக்","காக்கின்என் காவாக்கால் என்?"],"w":[["செல்லிடத்துக்",1,"Sellitaththuk","where (anger) will prevail; in the place"],["காப்பான்",1,"Kaappaan","he who guards"],["சினங்காப்பான்",1,"Sinangaappaan","anger; he who guards (anger)"],["அல்லிடத்துக்",1,"Allitaththuk","where it does not (prevail); in the place"],["காக்கின்என்",2,"Kaakkinen","if (one) guards; what (use)?"],["காவாக்கால்",2,"Kaavaakkaal","if (one) does not guard"],["என்",2,"En","what (use)?"]]},{"n":302,"l":["செல்லா இடத்துச் சினந்தீது செல்லிடத்தும்","இல்அதனின் தீய பிற."],"w":[["செல்லா",1,"Sellaa","(where it) does not prevail"],["இடத்துச்",1,"Itaththuch","in the place"],["சினந்தீது",1,"Chinandheedhu","anger; is evil"],["செல்லிடத்தும்",1,"Sellitaththum","where (it) prevails; in the place; even"],["இல்அதனின்",2,"Iladhanin","there is not; than that"],["தீய",2,"Theeya","evil things"],["பிற",2,"Pira","other (things)"]]},{"n":303,"l":["மறத்தல் வெகுளியை யார்மாட்டும் தீய","பிறத்தல் அதனான் வரும்."],"w":[["மறத்தல்",1,"Maraththal","to forget / forgetting"],["வெகுளியை",1,"Vekuliyai","anger (acc.)"],["யார்மாட்டும்",1,"Yaarmaattum","whoever; towards/at; even (any)"],["தீய",1,"Theeya","evil (things)"],["பிறத்தல்",2,"Piraththal","arising / being born"],["அதனான்",2,"Adhanaan","by/from that"],["வரும்",2,"Varum","will come/arise"]]},{"n":304,"l":["நகையும் உவகையும் கொல்லும் சினத்தின்","பகையும் உளவோ பிற."],"w":[["நகையும்",1,"Nakaiyum","smile/laughter; and"],["உவகையும்",1,"Uvakaiyum","joy; and"],["கொல்லும்",1,"Kollum","(which) kills"],["சினத்தின்",1,"Sinaththin","than anger"],["பகையும்",2,"Pakaiyum","enmity/foe; (any) too"],["உளவோ",2,"Ulavo","are there; ? (interrogative)"],["பிற",2,"Pira","other"]]},{"n":305,"l":["தன்னைத்தான் காக்கின் சினங்காக்க காவாக்கால்","தன்னையே கொல்லுஞ் சினம்."],"w":[["தன்னைத்தான்",1,"Thannaiththaan","himself (acc.); (one) himself"],["காக்கின்",1,"Kaakkin","if (one) guards"],["சினங்காக்க",1,"Sinangaakka","anger; let (one) guard"],["