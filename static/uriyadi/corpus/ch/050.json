{"n":50,"kurals":[{"n":491,"l":["தொடங்கற்க எவ்வினையும் எள்ளற்க முற்றும்","இடங்கண்ட பின்அல் லது."],"w":[["தொடங்கற்க",1,"Thotangarka","do not begin"],["எவ்வினையும்",1,"Evvinaiyum","what/which deed; even/any (inclusive)"],["எள்ளற்க",1,"Ellarka","do not despise"],["முற்றும்",1,"Mutrum","the besieging (object of எள்ளற்க)"],["இடங்கண்ட",2,"Itanganta","place; having seen (rel. participle)"],["பின்அல்",2,"Pinal","after/afterward"],["லது",2,"Ladhu","other than / unless (பின்அல்+லது சீர் எல்லையில் பிரிந்தது)"]]},{"n":492,"l":["முரண்சேர்ந்த மொய்ம்பி னவர்க்கும் அரண்சேர்ந்தாம்","ஆக்கம் பலவுந் தரும்."],"w":[["முரண்சேர்ந்த",1,"Muranserndha","enmity/opposition; joined-with (rel. participle)"],["மொய்ம்பி",1,"Moimpi","strength/might (of)"],["னவர்க்கும்",1,"Navarkkum","to those persons; even (concessive)"],["அரண்சேர்ந்தாம்",1,"Aranserndhaam","fortress/defence; that comes of relying on (the fort)"],["ஆக்கம்",2,"Aakkam","gain/prosperity"],["பலவுந்",2,"Palavun","many; all/even (inclusive)"],["தரும்",2,"Tharum","will give"]]},{"n":493,"l":["ஆற்றாரும் ஆற்றி அடுப இடனறிந்து","போற்றார்கண் போற்றிச் செயின்."],"w":[["ஆற்றாரும்",1,"Aatraarum","the powerless ones; even (concessive)"],["ஆற்றி",1,"Aatri","having mustered strength"],["அடுப",1,"Atupa","will destroy/conquer"],["இடனறிந்து",1,"Itanarindhu","the place; having known"],["போற்றார்கண்",2,"Potraarkan","enemies (those who do not cherish); at/in (locative)"],["போற்றிச்",2,"Potrich","having guarded (oneself)"],["செயின்",2,"Cheyin","if (one) acts/does"]]},{"n":494,"l":["எண்ணியார் எண்ணம் இழப்பர் இடனறிந்து","துன்னியார் துன்னிச் செயின்."],"w":[["எண்ணியார்",1,"Enniyaar","those who planned/intended"],["எண்ணம்",1,"Ennam","their plan/intention"],["இழப்பர்",1,"Izhappar","will lose"],["இடனறிந்து",1,"Itanarindhu","the place; having known"],["துன்னியார்",2,"Thunniyaar","those who closed in / drew near"],["துன்னிச்",2,"Thunnich","having approached/surrounded"],["செயின்",2,"Cheyin","if (one) acts"]]},{"n":495,"l":["நெடும்புனலுள் வெல்லும் முதலை அடும்புனலின்","நீங்கின் அதனைப் பிற."],"w":[["நெடும்புனலுள்",1,"Netumpunalul","deep water (locative); in/within (locative)"],["வெல்லும்",1,"Vellum","that conquers (rel. participle)"],["முதலை",1,"Mudhalai","crocodile"],["அடும்புனலின்",1,"Atumpunalin","that kills/destroys; from the (killing) water"],["நீங்கின்",2,"Neengin","if (it) departs/leaves"],["அதனைப்",2,"Adhanaip","it (acc.)"],["பிற",2,"Pira","other (creatures) — (will conquer) it"]]},{"n":496,"l":["கடலோடா கால்வல் நெடுந்தேர் கடலோடும்","நாவாயும் ஓடா நிலத்து."],"w":[["கடலோடா",1,"Katalotaa","in the sea; that does not run (in sea)"],["கால்வல்",1,"Kaalval","wheel; strong"],["நெடுந்தேர்",1,"Netundher","tall/long chariot"],["கடலோடும்",1,"Katalotum","in the sea; that runs (in sea)"],["நாவாயும்",2,"Naavaayum","ship; also (inclusive)"],["ஓடா",2,"Otaa","will not run (neg. finite)"],["நிலத்து",2,"Nilaththu","on the land (locative)"]]},{"n":497,"l":["அஞ்சாமை அல்லால் துணைவேண்டா எஞ்சாமை","எண்ணி இடத்தால் செயின்."],"w":[["அஞ்சாமை",1,"Anjaamai","fearlessness"],["அல்லால்",1,"Allaal","other than / except"],["துணைவேண்டா",1,"Thunaiventaa","(other) aid/help; is not needed"],["எஞ்சாமை",1,"Enjaamai","without falling short / completely"],["எண்ணி",2,"Enni","having planned/considered"],["இடத்தால்",2,"Itaththaal","by/with the (right) place"],["செயின்",2,"Seyin","if (one) acts"]]},{"n":498,"l":["சிறுபடையான் செல்லிடம் சேரின் உறுபடையான்","ஊக்கம் அழிந்து விடும்."],"w":[["சிறுபடையான்",1,"Sirupataiyaan","he of the small army"],["செல்லிடம்",1,"Sellitam","(that one) goes to; place (he goes to / occupies)"],["சேரின்",1,"Serin","if (he) reaches/occupies"],["உறுபடையான்",1,"Urupataiyaan","he of the large army"],["ஊக்கம்",2,"Ookkam","enthusiasm/morale"],["அழிந்து",2,"Azhindhu","having perished"],["விடும்",2,"Vitum","will (completely) — aux. of completion"]]},{"n":499,"l":["சிறைநலனும் சீரும் இலரெனினும் மாந்தர்","உறைநிலத்தோடு ஒட்டல் அரிது."],"w":[["சிறைநலனும்",1,"Sirainalanum","goodness/strength of fortress; and (conjunctive)"],["சீரும்",1,"Seerum","distinction/excellence; and (conjunctive)"],["இலரெனினும்",1,"Ilareninum","they do not have; even though (concessive)"],["மாந்தர்",1,"Maandhar","people/men"],["உறைநிலத்தோடு",2,"Urainilaththotu","with the dwelling-place; with (sociative)"],["ஒட்டல்",2,"Ottal","engaging/attacking"],["அரிது",2,"Aridhu","is difficult"]]},{"n":500,"l":["காலாழ் களரில் நரியடும் கண்ணஞ்சா","வேலாள் முகத்த களிறு."],"w":[["காலாழ்",1,"Kaalaazh","foot/leg; (where) the foot sinks"],["களரில்",1,"Kalaril","in the marsh/quagmire"],["நரியடும்",1,"Nariyatum","foxes; will kill"],["கண்ணஞ்சா",1,"Kannanjaa","eye; that fears not (in the eye)"],["வேலாள்",2,"Velaal","spear; warriors (spear-men)"],["முகத்த",2,"Mukaththa","having (warriors) on its face/tusks"],["களிறு",2,"Kaliru","bull elephant"]]}]}