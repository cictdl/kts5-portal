{"n":92,"kurals":[{"n":911,"l":["அன்பின் விழையார் பொருள்விழையும் ஆய்தொடியார்","இன்சொல் இழுக்குத் தரும்."],"w":[["அன்பின்",1,"Anpin","by/through love"],["விழையார்",1,"Vizhaiyaar","(they) do not desire"],["பொருள்விழையும்",1,"Porulvizhaiyum","wealth; who desire"],["ஆய்தொடியார்",1,"Aaidhotiyaar","women of choice bangles (= courtesans)"],["இன்சொல்",2,"Insol","sweet word"],["இழுக்குத்",2,"Izhukkuth","harm/disgrace"],["தரும்",2,"Tharum","(it) will give"]]},{"n":912,"l":["பயன்தூக்கிப் பண்புரைக்கும் பண்பின் மகளிர்","நயன்தூக்கி நள்ளா விடல்."],"w":[["பயன்தூக்கிப்",1,"Payandhookkip","benefit/gain; having weighed/assessed"],["பண்புரைக்கும்",1,"Panpuraikkum","good quality (words); who speak"],["பண்பின்",1,"Panpin","without (good) quality"],["மகளிர்",1,"Makalir","women"],["நயன்தூக்கி",2,"Nayandhookki","pleasure/worth; having weighed"],["நள்ளா",2,"Nallaa","not befriending/joining"],["விடல்",2,"Vital","let (one) abandon"]]},{"n":913,"l":["பொருட்பெண்டிர் பொய்ம்மை முயக்கம் இருட்டறையில்","ஏதில் பிணந்தழீஇ அற்று."],"w":[["பொருட்பெண்டிர்",1,"Porutpentir","for wealth; women"],["பொய்ம்மை",1,"Poimmai","falsehood (attrib.)"],["முயக்கம்",1,"Muyakkam","embrace"],["இருட்டறையில்",1,"Iruttaraiyil","in a dark room"],["ஏதில்",2,"Edhil","alien/unrelated (attrib.)"],["பிணந்தழீஇ",2,"Pinandhazheei","corpse; having embraced (alapedai)"],["அற்று",2,"Atru","like that / so (comparative)"]]},{"n":914,"l":["பொருட்பொருளார் புன்னலந் தோயார் அருட்பொருள்","ஆயும் அறிவி னவர்."],"w":[["பொருட்பொருளார்",1,"Porutporulaar","wealth (as object/aim); those who hold wealth as (their) aim (= courtesans)"],["புன்னலந்",1,"Punnalan","base/lowly pleasure"],["தோயார்",1,"Thoyaar","(they) will not touch/unite"],["அருட்பொருள்",1,"Arutporul","grace; the (true) wealth"],["ஆயும்",2,"Aayum","who examine"],["அறிவி",2,"Arivi","those of wisdom (யாப்பின் பொருட்டு சீர் பிரிந்தது)"],["னவர்",2,"Navar","they (the wise) — யாப்புப் பிரிவின் எஞ்சிய பகுதி"]]},{"n":915,"l":["பொதுநலத்தார் புன்னலம் தோயார் மதிநலத்தின்","மாண்ட அறிவி னவர்."],"w":[["பொதுநலத்தார்",1,"Podhunalaththaar","women of common/public charm (= courtesans)"],["புன்னலம்",1,"Punnalam","base pleasure"],["தோயார்",1,"Thoyaar","(they) will not touch"],["மதிநலத்தின்",1,"Madhinalaththin","by goodness of intellect"],["மாண்ட",2,"Maanta","(that) became exalted"],["அறிவி",2,"Arivi","those of wisdom (யாப்பின் பொருட்டு சீர் பிரிந்தது)"],["னவர்",2,"Navar","they (the wise) — யாப்புப் பிரிவின் எஞ்சிய பகுதி"]]},{"n":916,"l":["தந்நலம் பாரிப்பார் தோயார் தகைசெருக்கிப்","புன்னலம் பாரிப்பார் தோள்."],"w":[["தந்நலம்",1,"Thannalam","their own; (their own) good/fame"],["பாரிப்பார்",1,"Paarippaar","those who cherish/spread"],["தோயார்",1,"Thoyaar","(they) will not touch"],["தகைசெருக்கிப்",1,"Thakaiserukkip","by (their) beauty/rank; being conceited"],["புன்னலம்",2,"Punnalam","base charm"],["பாரிப்பார்",2,"Paarippaar","those who spread/sell"],["தோள்",2,"Thol","shoulder(s)"]]},{"n":917,"l":["நிறைநெஞ்சம் இல்லவர் தோய்வார் பிறநெஞ்சிற்","பேணிப் புணர்பவர் தோள்."],"w":[["நிறைநெஞ்சம்",1,"Nirainenjam","self-controlled mind"],["இல்லவர்",1,"Illavar","those who lack"],["தோய்வார்",1,"Thoivaar","(they) will unite/touch"],["பிறநெஞ்சிற்",1,"Piranenjir","in (their) mind set on other things"],["பேணிப்",2,"Penip","cherishing/desiring"],["புணர்பவர்",2,"Punarpavar","those who unite (the women)"],["தோள்",2,"Thol","shoulder(s)"]]},{"n":918,"l":["ஆயும் அறிவினர் அல்லார்க்கு அணங்கென்ப","மாய மகளிர் முயக்கு."],"w":[["ஆயும்",1,"Aayum","that examines"],["அறிவினர்",1,"Arivinar","those of wisdom"],["அல்லார்க்கு",1,"Allaarkku","to those who are not (wise)"],["அணங்கென்ப",1,"Anangenpa","demoness/affliction (Mohini); (they) say (it is)"],["மாய",2,"Maaya","deceitful (attrib.)"],["மகளிர்",2,"Makalir","women('s)"],["முயக்கு",2,"Muyakku","embrace/union"]]},{"n":919,"l":["வரைவிலா மாணிழையார் மென்தோள் புரையிலாப்","பூரியர்கள் ஆழும் அளறு."],"w":[["வரைவிலா",1,"Varaivilaa","without (moral) limit"],["மாணிழையார்",1,"Maanizhaiyaar","women of fine jewels (= courtesans)"],["மென்தோள்",1,"Mendhol","soft shoulder(s)"],["புரையிலாப்",1,"Puraiyilaap","without worth/nobility"],["பூரியர்கள்",2,"Pooriyarkal","base/vile men"],["ஆழும்",2,"Aazhum","(in which they) sink"],["அளறு",2,"Alaru","mire/hell"]]},{"n":920,"l":["இருமனப் பெண்டிரும் கள்ளும் கவறும்","திருநீக்கப் பட்டார் தொடர்பு."],"w":[["இருமனப்",1,"Irumanap","double-minded"],["பெண்டிரும்",1,"Pentirum","women; and (enumerative)"],["கள்ளும்",1,"Kallum","toddy/wine; and"],["கவறும்",1,"Kavarum","dice/gambling; and"],["திருநீக்கப்",2,"Thiruneekkap","by Lakshmi/fortune; being removed/cast off"],["பட்டார்",2,"Pattaar","those who were (cast off)"],["தொடர்பு",2,"Thotarpu","association/friendship"]]}]}