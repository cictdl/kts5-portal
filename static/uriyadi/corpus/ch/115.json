{"n":115,"kurals":[{"n":1141,"l":["அலரெழ ஆருயிர் நிற்கும் அதனைப்","பலரறியார் பாக்கியத் தால்."],"w":[["அலரெழ",1,"Alarezha","rumour, scandal; (so that rumour) arises"],["ஆருயிர்",1,"Aaruyir","rare, precious; (precious) life"],["நிற்கும்",1,"Nirkum","(life) stays/persists"],["அதனைப்",1,"Adhanaip","that (thing); accusative marker"],["பலரறியார்",2,"Palarariyaar","many people; (many) do not know"],["பாக்கியத்",2,"Paakkiyath","good fortune (by)"],["தால்",2,"Thaal","instrumental marker (by reason of)"]]},{"n":1142,"l":["மலரன்ன கண்ணாள் அருமை அறியாது","அலரெமக்கு ஈந்ததிவ் வூர்."],"w":[["மலரன்ன",1,"Malaranna","flower; like, resembling"],["கண்ணாள்",1,"Kannaal","she of (flower-like) eyes"],["அருமை",1,"Arumai","rareness, preciousness"],["அறியாது",1,"Ariyaadhu","without knowing"],["அலரெமக்கு",2,"Alaremakku","rumour; to us; dative marker"],["ஈந்ததிவ்",2,"Eendhadhiv","that which gave; this"],["வூர்",2,"Voor","this town (people)"]]},{"n":1143,"l":["உறாஅதோ ஊரறிந்த கௌவை அதனைப்","பெறாஅது பெற்றன்ன நீர்த்து."],"w":[["உறாஅதோ",1,"Uraaadho","will it not come/befit; interrogative particle"],["ஊரறிந்த",1,"Oorarindha","town (people); (that) the town knew"],["கௌவை",1,"Kauvai","rumour, clamour"],["அதனைப்",1,"Adhanaip","that; accusative marker"],["பெறாஅது",2,"Peraaadhu","without obtaining"],["பெற்றன்ன",2,"Petranna","having obtained; like, as if"],["நீர்த்து",2,"Neerththu","is of such nature"]]},{"n":1144,"l":["கவ்வையால் கவ்விது காமம் அதுவின்றேல்","தவ்வென்னும் தன்மை இழந்து."],"w":[["கவ்வையால்",1,"Kavvaiyaal","rumour (by); instrumental marker"],["கவ்விது",1,"Kavvidhu","is intensified/grips"],["காமம்",1,"Kaamam","love, passion"],["அதுவின்றேல்",1,"Adhuvindrel","that (rumour); is not / absence; if (conditional)"],["தவ்வென்னும்",2,"Thavvennum","(that) goes 'tav' / shrinks"],["தன்மை",2,"Thanmai","nature, quality"],["இழந்து",2,"Izhandhu","having lost"]]},{"n":1145,"l":["களித்தொறும் கள்ளுண்டல் வேட்டற்றால் காமம்","வெளிப்படுந் தோறும் இனிது."],"w":[["களித்தொறும்",1,"Kaliththorum","getting intoxicated/merry; ea