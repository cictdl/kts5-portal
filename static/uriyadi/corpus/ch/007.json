{"n":7,"kurals":[{"n":61,"l":["பெறுமவற்றுள் யாமறிவது இல்லை அறிவறிந்த","மக்கட்பேறு அல்ல பிற."],"w":[["பெறுமவற்றுள்",1,"Perumavatrul","that may be obtained; among those"],["யாமறிவது",1,"Yaamarivadhu","we; that which (we) know/value"],["இல்லை",1,"Illai","there is not"],["அறிவறிந்த",1,"Arivarindha","knowledge (what should be known); having known"],["மக்கட்பேறு",2,"Makkatperu","children; attainment/blessing"],["அல்ல",2,"Alla","are not"],["பிற",2,"Pira","other (gains)"]]},{"n":62,"l":["எழுபிறப்பும் தீயவை தீண்டா பழிபிறங்காப்","பண்புடை மக்கட் பெறின்."],"w":[["எழுபிறப்பும்",1,"Ezhupirappum","seven; birth(s); (inclusive) even/all"],["தீயவை",1,"Theeyavai","evil things"],["தீண்டா",1,"Theentaa","do not touch/afflict"],["பழிபிறங்காப்",1,"Pazhipirangaap","blame; in whom (blame) does not arise"],["பண்புடை",2,"Panputai","good quality; possessing"],["மக்கட்",2,"Makkat","children"],["பெறின்",2,"Perin","if (one) begets"]]},{"n":63,"l":["தம்பொருள் என்பதம் மக்கள் அவர்பொருள்","தம்தம் வினையான் வரும்."],"w":[["தம்பொருள்",1,"Thamporul","their own; wealth"],["என்பதம்",1,"Enpadham","(the wise) say; one's own"],["மக்கள்",1,"Makkal","children"],["அவர்பொருள்",1,"Avarporul","their; wealth"],["தம்தம்",2,"Thamdham","each one's own"],["வினையான்",2,"Vinaiyaan","by (their) deeds"],["வரும்",2,"Varum","will come/accrue"]]},{"n":64,"l":["அமிழ்தினும் ஆற்ற இனிதேதம் மக்கள்","சிறுகை அளாவிய கூழ்."],"w":[["அமிழ்தினும்",1,"Amizhdhinum","than even nectar"],["ஆற்ற",1,"Aatra","very much, greatly"],["இனிதேதம்",1,"Inidhedham","(is) sweet/pleasant; (emphatic) indeed; their own"],["மக்கள்",1,"Makkal","children"],["சிறுகை",2,"Sirukai","small; hand"],["அளாவிய",2,"Alaaviya","stirred/mixed (by)"],["கூழ்",2,"Koozh","gruel/porridge"]]},{"n":65,"l":["மக்கள்மெய் தீண்டல் உடற்கின்பம் மற்றுஅவர்","சொற்கேட்டல் இன்பம் செவிக்கு."],"w":[["மக்கள்மெய்",1,"","children's; body"],["தீண்டல்",1,"","touching"],["உடற்கின்பம்",1,"","to the body; pleasure"],["மற்றுஅவர்",1,"","moreover; their"],["சொற்கேட்டல்",2,"","words; hearing"],["இன்பம்",2,"","pleasure"],["செவிக்கு",2,"","to the ear"]]},{"n":66,"l":["குழல்இனிது யாழ்இனிது என்பதம் மக்கள்","மழலைச்சொல் கேளா தவர்."],"w":[["குழல்இனிது",1,"","flute; is sweet"],["யாழ்இனிது",1,"","lute (yaazh); is sweet"],["என்பதம்",1,"","(they) say; their own"],["மக்கள்",1,"","children's"],["மழலைச்சொல்",2,"","babble/lisping; words"],["கேளா",2,"","who do not hear"],["தவர்",2,"","those who (do not hear)"]]},{"n":67,"l":["தந்தை மகற்காற்றும் நன்றி அவையத்து","முந்தி இருப்பச் செயல்."],"w":[["தந்தை",1,"Thandhai","father"],["மகற்காற்றும்",1,"Makarkaatrum","for the son; renders/does"],["நன்றி",1,"Nandri","good (benefit)"],["அவையத்து",1,"Avaiyaththu","in the assembly"],["முந்தி",2,"Mundhi","being foremost"],["இருப்பச்",2,"Iruppach","so that (he) be"],["செயல்",2,"Cheyal","(one) should do"]]},{"n":68,"l":["தம்மின்தம் மக்கள் அறிவுடைமை மாநிலத்து","மன்னுயிர்க் கெல்லாம் இனிது."],"w":[["தம்மின்தம்",1,"Thammindham","than themselves; their own"],["மக்கள்",1,"Makkal","children's"],["அறிவுடைமை",1,"Arivutaimai","wisdom; possession (of)"],["மாநிலத்து",1,"Maanilaththu","great/vast; in the (great) earth"],["மன்னுயிர்க்",2,"Mannuyirk","enduring/abiding; to (all) life"],["கெல்லாம்",2,"Kellaam","all"],["இனிது",2,"Inidhu","is pleasant"]]},{"n":69,"l":["ஈன்ற பொழுதின் பெரிதுவக்கும் தன்மகனைச்","சான்றோன் எனக்கேட்ட தாய்."],"w":[["ஈன்ற",1,"Eendra","(when she) bore"],["பொழுதின்",1,"Pozhudhin","than the time (of bearing)"],["பெரிதுவக்கும்",1,"Peridhuvakkum","greatly (more); will rejoice"],["தன்மகனைச்",1,"Thanmakanaich","her own; son (acc.)"],["சான்றோன்",2,"Chaandron","a noble/learned man"],["எனக்கேட்ட",2,"Enakketta","(saying) that; (who) heard"],["தாய்",2,"Thaai","the mother"]]},{"n":70,"l":["மகன்தந்தைக்கு ஆற்றும் உதவி இவன்தந்தை","என்நோற்றான் கொல்லெனும் சொல்."],"w":[["மகன்தந்தைக்கு",1,"","the son; to the father"],["ஆற்றும்",1,"","(that he) renders"],["உதவி",1,"","the help/requital"],["இவன்தந்தை",1,"","this (boy's); father"],["என்நோற்றான்",2,"","what; performed (penance)"],["கொல்லெனும்",2,"",""],["சொல்",2,"","the word/praise"]]}]}