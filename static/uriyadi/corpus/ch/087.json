{"n":87,"kurals":[{"n":861,"l":["வலியார்க்கு மாறேற்றல் ஓம்புக ஓம்பா","மெலியார்மேல் மேக பகை."],"w":[["வலியார்க்கு",1,"Valiyaarkku","to the strong"],["மாறேற்றல்",1,"Maaretral","opposing/confronting"],["ஓம்புக",1,"Ompuka","let one refrain"],["ஓம்பா",1,"Ompaa","not refraining (without sparing)"],["மெலியார்மேல்",2,"Meliyaarmel","the weak; upon/against"],["மேக",2,"Meka","let one undertake"],["பகை",2,"Pakai","enmity/hostility"]]},{"n":862,"l":["அன்பிலன் ஆன்ற துணையிலன் தான்துவ்வான்","என்பரியும் ஏதிலான் துப்பு."],"w":[["அன்பிலன்",1,"Anpilan","he is loveless"],["ஆன்ற",1,"Aandra","ample/befitting"],["துணையிலன்",1,"Thunaiyilan","he is without support"],["தான்துவ்வான்",1,"Thaandhuvvaan","himself; he is not able/strong"],["என்பரியும்",2,"Enpariyum","how/by what means; will destroy/sever"],["ஏதிலான்",2,"Edhilaan","the stranger/enemy"],["துப்பு",2,"Thuppu","strength/might"]]},{"n":863,"l":["அஞ்சும் அறியான் அமைவிலன் ஈகலான்","தஞ்சம் எளியன் பகைக்கு."],"w":[["அஞ்சும்",1,"Anjum","(one who) fears"],["அறியான்",1,"Ariyaan","he does not know"],["அமைவிலன்",1,"Amaivilan","he is without concord"],["ஈகலான்",1,"Eekalaan","he does not give"],["தஞ்சம்",2,"Thanjam","very/easily"],["எளியன்",2,"Eliyan","he is easy to overcome"],["பகைக்கு",2,"Pakaikku","to/for the enemy"]]},{"n":864,"l":["நீங்கான் வெகுளி நிறையிலன் எஞ்ஞான்றும்","யாங்கணும் யார்க்கும் எளிது."],"w":[["நீங்கான்",1,"Neengaan","he does not depart from"],["வெகுளி",1,"Vekuli","anger/wrath"],["நிறையிலன்",1,"Niraiyilan","he is without self-restraint"],["எஞ்ஞான்றும்",1,"Egngnaandrum","at all times"],["யாங்கணும்",2,"Yaanganum","everywhere"],["யார்க்கும்",2,"Yaarkkum","to anyone; even/all (inclusive)"],["எளிது",2,"Elidhu","(it) is easy"]]},{"n":865,"l":["வழிநோக்கான் வாய்ப்பன செய்யான் பழிநோக்கான்","பண்பிலன் பற்றார்க்கு இனிது."],"w":[["வழிநோக்கான்",1,"Vazhinokkaan","the right way; he does not look to"],["வாய்ப்பன",1,"Vaaippana","things that are fitting"],["செய்யான்",1,"Seyyaan","he does not do"],["பழிநோக்கான்",1,"Pazhinokkaan","blame/disgrace; he does not heed"],["பண்பிலன்",2,"Panpilan","he is without good qualities"],["பற்றார்க்கு",2,"Patraarkku","to his enemies"],["இனிது",2,"Inidhu","(it) is pleasant/easy"]]},{"n":866,"l":["காணாச் சினத்தான் கழிபெருங் காமத்தான்","பேணாமை பேணப் படும்."],"w":[["காணாச்",1,"Kaanaach","that does not consider/see"],["சினத்தான்",1,"Chinaththaan","one with anger"],["கழிபெருங்",1,"Kazhiperung","excessive/very; great"],["காமத்தான்",1,"Kaamaththaan","one with great desire"],["பேணாமை",2,"Penaamai","non-cherishing / hostility"],["பேணப்",2,"Penap","so as to be cherished/desired"],["படும்",2,"Patum","will be (passive aux)"]]},{"n":867,"l":["கொடுத்தும் கொளல்வேண்டும் மன்ற அடுத்திருந்து","மாணாத செய்வான் பகை."],"w":[["கொடுத்தும்",1,"Kotuththum","even by giving"],["கொளல்வேண்டும்",1,"Kolalventum","the taking/obtaining; is needed/must"],["மன்ற",1,"Mandra","certainly (emphatic)"],["அடுத்திருந்து",1,"Atuththirundhu","having joined/come near; being/staying"],["மாணாத",2,"Maanaadha","things that are not excellent"],["செய்வான்",2,"Seyvaan","one who does"],["பகை",2,"Pakai","enmity (of him)"]]},{"n":868,"l":["குணனிலனாய்க் குற்றம் பலவாயின் மாற்றார்க்கு","இனனிலனாம் ஏமாப் புடைத்து."],"w":[["குணனிலனாய்க்",1,"Kunanilanaaik","being without virtue"],["குற்றம்",1,"Kutram","fault/vice"],["பலவாயின்",1,"Palavaayin","many; if (they) become"],["மாற்றார்க்கு",1,"Maatraarkku","to his enemies"],["இனனிலனாம்",2,"Inanilanaam","he is without kin/allies; becomes/will be"],["ஏமாப்",2,"Emaap","safety/advantage"],["புடைத்து",2,"Putaiththu","(it) possesses the nature of"]]},{"n":869,"l":["செறுவார்க்குச் சேணிகவா இன்பம் அறிவிலா","அஞ்சும் பகைவர்ப் பெறின்."],"w":[["செறுவார்க்குச்",1,"Seruvaarkkuch","for those who fight/oppose"],["சேணிகவா",1,"Chenikavaa","far/distance; (they) do not depart far"],["இன்பம்",1,"Inpam","joys/pleasures"],["அறிவிலா",1,"Arivilaa","that has no knowledge"],["அஞ்சும்",2,"Anjum","(who) fear / fearful"],["பகைவர்ப்",2,"Pakaivarp","enemies (object)"],["பெறின்",2,"Perin","if one gets/obtains"]]},{"n":870,"l":["கல்லான் வெகுளும் சிறுபொருள் எஞ்ஞான்றும்","ஒல்லானை ஒல்லா தொளி."],"w":[["கல்லான்",1,"Kallaan","the unlearned one"],["வெகுளும்",1,"Vekulum","(that one gets by) hating"],["சிறுபொருள்",1,"Siruporul","small; gain/wealth"],["எஞ்ஞான்றும்",1,"Egngnaandrum","ever / at any time"],["ஒல்லானை",2,"Ollaanai","him who is unable"],["ஒல்லா",2,"Ollaa","(it) does not accrue/come"],["தொளி",2,"Tholi","glory/lustre (fame)"]]}]}