{"n":11,"kurals":[{"n":101,"l":["செய்யாமல் செய்த உதவிக்கு வையகமும்","வானகமும் ஆற்றல் அரிது."],"w":[["செய்யாமல்",1,"Seyyaamal","without doing"],["செய்த",1,"Seydha","that (one) did"],["உதவிக்கு",1,"Udhavikku","for the help"],["வையகமும்",1,"Vaiyakamum","the earth-world; even/and (inclusive)"],["வானகமும்",2,"Vaanakamum","the heaven-world; even/and (inclusive)"],["ஆற்றல்",2,"Aatral","being able (to repay)"],["அரிது",2,"Aridhu","is difficult"]]},{"n":102,"l":["காலத்தி னாற்செய்த நன்றி சிறிதெனினும்","ஞாலத்தின் மாணப் பெரிது."],"w":[["காலத்தி",1,"Kaalaththi","by/in (right) time"],["னாற்செய்த",1,"Naarseydha","by/through (case-suffix); (that) was done"],["நன்றி",1,"Nandri","good help / benefit"],["சிறிதெனினும்",1,"Siridheninum","a small thing; even if (one) says/though"],["ஞாலத்தின்",2,"Gnaalaththin","than the world"],["மாணப்",2,"Maanap","greatly / so as to be eminent"],["பெரிது",2,"Peridhu","is great"]]},{"n":103,"l":["பயன்தூக்கார் செய்த உதவி நயன்தூக்கின்","நன்மை கடலின் பெரிது."],"w":[["பயன்தூக்கார்",1,"Payandhookkaar","benefit/result (obj.); those who do not weigh"],["செய்த",1,"Seydha","(that they) did"],["உதவி",1,"Udhavi","help"],["நயன்தூக்கின்",1,"Nayandhookkin","the love/grace (obj.); if (one) weighs"],["நன்மை",2,"Nanmai","goodness"],["கடலின்",2,"Katalin","than the sea"],["பெரிது",2,"Peridhu","is great"]]},{"n":104,"l":["தினைத்துணை நன்றி செயினும் பனைத்துணையாக்","கொள்வர் பயன்தெரி வார்."],"w":[["தினைத்துணை",1,"Thinaiththunai","millet-sized (tiny)"],["நன்றி",1,"Nandri","good/benefit"],["செயினும்",1,"Seyinum","even if (one) does"],["பனைத்துணையாக்",1,"Panaiththunaiyaak","palmyra-sized (huge); as / so as to be"],["கொள்வர்",2,"Kolvar","(they) will take/regard"],["பயன்தெரி",2,"Payandheri","benefit (obj.); knowing/discerning"],["வார்",2,"Vaar","those (who discern)"]]},{"n":105,"l":["உதவி வரைத்தன்று உதவி உதவி","செயப்பட்டார் சால்பின் வரைத்து."],"w":[["உதவி",1,"Udhavi","help (the return-help)"],["வரைத்தன்று",1,"Varaiththandru","of the measure/limit (of); is not"],["உதவி",1,"Udhavi","help (orig.)"],["உதவி",1,"Udhavi","help (that was given)"],["செயப்பட்டார்",2,"Seyappattaar","those to whom (it) was done"],["சால்பின்",2,"Saalpin","of the worth/dignity"],["வரைத்து",2,"Varaiththu","is of the measure (of)"]]},{"n":106,"l":["மறவற்க மாசற்றார் கேண்மை துறவற்க","துன்பத்துள் துப்பாயார் நட்பு."],"w":[["மறவற்க",1,"Maravarka","do not forget"],["மாசற்றார்",1,"Maasatraar","flaw/blemish; those without (it) — the flawless"],["கேண்மை",1,"Kenmai","friendship/kinship (obj.)"],["துறவற்க",1,"Thuravarka","do not forsake"],["துன்பத்துள்",2,"Thunpaththul","in (time of) sorrow"],["துப்பாயார்",2,"Thuppaayaar","those who were strength/support"],["நட்பு",2,"Natpu","friendship (obj.)"]]},{"n":107,"l":["எழுமை எழுபிறப்பும் உள்ளுவர் தங்கண்","விழுமந் துடைத்தவர் நட்பு."],"w":[["எழுமை",1,"Ezhumai","seven (lives) / sevenfold span"],["எழுபிறப்பும்",1,"Ezhupirappum","the seven births; all/even (inclusive)"],["உள்ளுவர்",1,"Ulluvar","(they) will remember"],["தங்கண்",1,"Thangan","their own; in/at (locative)"],["விழுமந்",2,"Vizhuman","sorrow/affliction (obj.)"],["துடைத்தவர்",2,"Thutaiththavar","those who wiped (it) away"],["நட்பு",2,"Natpu","friendship (obj.)"]]},{"n":108,"l":["நன்றி மறப்பது நன்றன்று நன்றல்லது","அன்றே மறப்பது நன்று."],"w":[["நன்றி",1,"Nandri","the good/benefit (obj.)"],["மறப்பது",1,"Marappadhu","the forgetting"],["நன்றன்று",1,"Nandrandru","(a) good thing; is not"],["நன்றல்லது",1,"Nandralladhu","good (thing); that which is not (good) — the evil"],["அன்றே",2,"Andre","that very day/then; indeed (emphatic)"],["மறப்பது",2,"Marappadhu","the forgetting"],["நன்று",2,"Nandru","is good"]]},{"n":109,"l":["கொன்றன்ன இன்னா செயினும் அவர்செய்த","ஒன்றுநன்று உள்ளக் கெடும்."],"w":[["கொன்றன்ன",1,"Kondranna","having killed; such as / (that is) like"],["இன்னா",1,"Innaa","harmful things / evils"],["செயினும்",1,"Seyinum","even if (one) does"],["அவர்செய்த",1,"Avarseydha","they / that one (hon.); (that) they did"],["ஒன்றுநன்று",2,"Ondrunandru","one; good deed (obj.)"],["உள்ளக்",2,"Ullak","on remembering / as (one) recalls"],["கெடும்",2,"Ketum","(it) will perish/vanish"]]},{"n":110,"l":["எந்நன்றி கொன்றார்க்கும் உய்வுண்டாம் உய்வில்லை","செய்ந்நன்றி கொன்ற மகற்கு."],"w":[["எந்நன்றி",1,"Ennandri","which/any; virtue/good (obj.)"],["கொன்றார்க்கும்",1,"Kondraarkkum","even for those who destroyed; even (concessive)"],["உய்வுண்டாம்",1,"Uyvuntaam","escape/deliverance; there is/will be"],["உய்வில்லை",1,"Uyvillai","escape/deliverance; there is none"],["செய்ந்நன்றி",2,"Seynnandri","(that was) done; the help done (obj.)"],["கொன்ற",2,"Kondra","(who) destroyed"],["மகற்கு",2,"Makarku","for the man (who)"]]}]}