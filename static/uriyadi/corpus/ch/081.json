{"n":81,"kurals":[{"n":801,"l":["பழைமை எனப்படுவது யாதெனின் யாதும்","கிழமையைக் கீழ்ந்திடா நட்பு."],"w":[["பழைமை",1,"Pazhaimai","old-friendship/familiarity"],["எனப்படுவது",1,"Enappatuvadhu","that which is called"],["யாதெனின்",1,"Yaadhenin","what; if (one) says/asks"],["யாதும்",1,"Yaadhum","any/whatever; even/in any way (emphatic)"],["கிழமையைக்",2,"Kizhamaiyaik","right/privilege (acc.); accusative case-marker"],["கீழ்ந்திடா",2,"Keezhndhitaa","that does not lower/belittle (qualifies நட்பு)"],["நட்பு",2,"Natpu","friendship"]]},{"n":802,"l":["நட்பிற் குறுப்புக் கெழுதகைமை மற்றதற்கு","உப்பாதல் சான்றோர் கடன்."],"w":[["நட்பிற்",1,"Natpir","to/for friendship (dat.)"],["குறுப்புக்",1,"Kuruppuk","limb/part/constituent"],["கெழுதகைமை",1,"Kezhudhakaimai","intimacy/familiar privilege"],["மற்றதற்கு",1,"Matradharku","moreover/and (expletive); to that (dat.)"],["உப்பாதல்",2,"Uppaadhal","being agreeable / savouring (= உடன்படுதல்)"],["சான்றோர்",2,"Saandror","the wise/noble ones"],["கடன்",2,"Katan","duty/obligation"]]},{"n":803,"l":["பழகிய நட்பெவன் செய்யுங் கெழுதகைமை","செய்தாங்கு அமையாக் கடை."],"w":[["பழகிய",1,"Pazhakiya","(that became) familiar/long-acquainted"],["நட்பெவன்",1,"Natpevan","friendship; what (use)? (interrogative)"],["செய்யுங்",1,"Seyyung","(what) will (it) do / achieve"],["கெழுதகைமை",1,"Kezhudhakaimai","intimacy/familiar privilege"],["செய்தாங்கு",2,"Seydhaangu","as (one) himself did it"],["அமையாக்",2,"Amaiyaak","(if one) does not consent/accord (qualifies கடை)"],["கடை",2,"Katai","in the case/when (condition)"]]},{"n":804,"l":["விழைதகையான் வேண்டி இருப்பர் கெழுதகையாற்","கேளாது நட்டார் செயின்."],"w":[["விழைதகையான்",1,"Vizhaidhakaiyaan","by/with the desirable quality; instrumental case-marker"],["வேண்டி",1,"Venti","desiring/wishing"],["இருப்பர்",1,"Iruppar","they will remain/abide (accept)"],["கெழுதகையாற்",1,"Kezhudhakaiyaar","by/through intimacy; instrumental case-marker"],["கேளாது",2,"Kelaadhu","without asking"],["நட்டார்",2,"Nattaar","friends (those who befriended)"],["செயின்",2,"Seyin","if (they) do"]]},{"n":805,"l":["பேதைமை ஒன்றோ பெருங்கிழமை என்றுணர்க","நோதக்க நட்டார் செயின்."],"w":[["பேதைமை",1,"Pedhaimai","ignorance/folly"],["ஒன்றோ",1,"Ondro","one (thing) / only; interrogative/doubt ō"],["பெருங்கிழமை",1,"Perungizhamai","great/large; right/intimacy/privilege"],["என்றுணர்க",1,"Endrunarka","saying/thus (quotative); let (one) understand/realise"],["நோதக்க",2,"Nodhakka","(things) worthy of grieving/painful"],["நட்டார்",2,"Nattaar","friends"],["செயின்",2,"Seyin","if (they) do"]]},{"n":806,"l":["எல்லைக்கண் நின்றார் துறவார் தொலைவிடத்தும்","தொல்லைக்கண் நின்றார் தொடர்பு."],"w":[["எல்லைக்கண்",1,"Ellaikkan","within the boundary/limit; locative case-marker (in/at)"],["நின்றார்",1,"Nindraar","those who stood/abided"],["துறவார்",1,"Thuravaar","they will not forsake"],["தொலைவிடத்தும்",1,"Tholaivitaththum","even at the place/time of loss/ruin; even (concessive)"],["தொல்லைக்கண்",2,"Thollaikkan","in olden/long-standing (time); locative case-marker"],["நின்றார்",2,"Nindraar","those who stood/abided"],["தொடர்பு",2,"Thotarpu","connection/bond"]]},{"n":807,"l":["அழிவந்த செய்யினும் அன்பறார் அன்பின்","வழிவந்த கேண்மை யவர்."],"w":[["அழிவந்த",1,"Azhivandha","(things) that bring ruin"],["செய்யினும்",1,"Seyyinum","even if (they) do; even (concessive)"],["அன்பறார்",1,"Anparaar","love; (they) will not sever (love)"],["அன்பின்",1,"Anpin","of/in (the path of) love; case-marker (in the path of love)"],["வழிவந்த",2,"Vazhivandha","that came down in the way (of love)"],["கேண்மை",2,"Kenmai","friendship/kinship"],["யவர்",2,"Yavar","those who possess (kinship)"]]},{"n":808,"l":["கேளிழுக்கம் கேளாக் கெழுதகைமை வல்லார்க்கு","நாளிழுக்கம் நட்டார் செயின்."],"w":[["கேளிழுக்கம்",1,"Kelizhukkam","kinsman/friend('s); fault/lapse (of friend)"],["கேளாக்",1,"Kelaak","(who) does not heed/listen (qualifies கெழுதகைமை)"],["கெழுதகைமை",1,"Kezhudhakaimai","intimacy/familiar privilege"],["வல்லார்க்கு",1,"Vallaarkku","for those capable (of); dative case-marker"],["நாளிழுக்கம்",2,"Naalizhukkam","day; lapse/loss (here ironically = profitable day)"],["நட்டார்",2,"Nattaar","friends"],["செயின்",2,"Seyin","if (they) do"]]},{"n":809,"l":["கெடாஅ வழிவந்த கேண்மையார் கேண்மை","விடாஅர் விழையும் உலகு."],"w":[["கெடாஅ",1,"Ketaaa","that does not perish/spoil (qualifies வழிவந்த கேண்மை)"],["வழிவந்த",1,"Vazhivandha","that came down (in unbroken) way"],["கேண்மையார்",1,"Kenmaiyaar","those of friendship/kinship"],["கேண்மை",1,"Kenmai","friendship (acc., object of விடாஅர்)"],["விடாஅர்",2,"Vitaaar","those who do not give up (it)"],["விழையும்",2,"Vizhaiyum","(the world) desires/loves"],["உலகு",2,"Ulaku","the world (= people, subject of விழையும்)"]]},{"n":810,"l":["விழையார் விழையப் படுப பழையார்கண்","பண்பின் தலைப்பிரியா தார்."],"w":[["விழையார்",1,"Vizhaiyaar","those who do not desire (foes)"],["விழையப்",1,"Vizhaiyap","so as to be desired"],["படுப",1,"Patupa","(they) become/are made desired"],["பழையார்கண்",1,"Pazhaiyaarkan","in/towards old friends; locative case-marker (in/towards)"],["பண்பின்",2,"Panpin","from (good) quality/character; ablative case-marker (from)"],["தலைப்பிரியா",2,"Thalaippiriyaa","(who) do not depart/swerve (from) — qualifies தார்"],["தார்",2,"Thaar","those who (do not swerve)"]]}]}