{"n":45,"kurals":[{"n":441,"l":["அறனறிந்து மூத்த அறிவுடையார் கேண்மை","திறனறிந்து தேர்ந்து கொளல்."],"w":[["அறனறிந்து",1,"Aranarindhu","virtue; having known"],["மூத்த",1,"Mooththa","matured/aged"],["அறிவுடையார்",1,"Arivutaiyaar","the wise (who possess knowledge)"],["கேண்மை",1,"Kenmai","friendship"],["திறனறிந்து",2,"Thiranarindhu","the way/means; having known"],["தேர்ந்து",2,"Therndhu","having examined/chosen"],["கொளல்",2,"Kolal","should obtain/take"]]},{"n":442,"l":["உற்றநோய் நீக்கி உறாஅமை முற்காக்கும்","பெற்றியார்ப் பேணிக் கொளல்."],"w":[["உற்றநோய்",1,"Utranoi","that has come/befallen; affliction/trouble"],["நீக்கி",1,"Neekki","having removed"],["உறாஅமை",1,"Uraaamai","so that it does not recur"],["முற்காக்கும்",1,"Murkaakkum","beforehand; that guards"],["பெற்றியார்ப்",2,"Petriyaarp","those of (such) capability"],["பேணிக்",2,"Penik","cherishing/honouring"],["கொளல்",2,"Kolal","should obtain/take"]]},{"n":443,"l":["அரியவற்று ளெல்லாம் அரிதே பெரியாரைப்","பேணித் தமராக் கொளல்."],"w":[["அரியவற்று",1,"Ariyavatru","rare; among those"],["ளெல்லாம்",1,"Lellaam","all"],["அரிதே",1,"Aridhe","is rare; (emphatic)"],["பெரியாரைப்",1,"Periyaaraip","the great ones; (accusative)"],["பேணித்",2,"Penith","honouring"],["தமராக்",2,"Thamaraak","one's own kin; so as to become"],["கொளல்",2,"Kolal","should make/take"]]},{"n":444,"l":["தம்மிற் பெரியார் தமரா ஒழுகுதல்","வன்மையு ளெல்லாந் தலை."],"w":[["தம்மிற்",1,"Thammir","than oneself; (comparative -in)"],["பெரியார்",1,"Periyaar","the great/superior ones"],["தமரா",1,"Thamaraa","one's own kin; so as to become"],["ஒழுகுதல்",1,"Ozhukudhal","conducting oneself"],["வன்மையு",2,"Vanmaiyu","among strengths"],["ளெல்லாந்",2,"Lellaan","all"],["தலை",2,"Thalai","is the foremost"]]},{"n":445,"l":["சூழ்வார்கண் ணாக ஒழுகலான் மன்னவன்","சூழ்வாரைச் சூழ்ந்து கொளல்."],"w":[["சூழ்வார்கண்",1,"Soozhvaarkan","those who deliberate/counsel; eye"],["ணாக",1,"Naaka","being as"],["ஒழுகலான்",1,"Ozhukalaan","because (the world) conducts itself; (instrumental/causal -aan)"],["மன்னவன்",1,"Mannavan","the king"],["சூழ்வாரைச்",2,"Soozhvaaraich","those who counsel/deliberate; (accusative)"],["சூழ்ந்து",2,"Soozhndhu","having deliberated/examined"],["கொளல்",2,"Kolal","should obtain/take"]]},{"n":446,"l":["தக்கா ரினத்தனாய்த் தானொழுக வல்லானைச்","செற்றார் செயக்கிடந்த தில்."],"w":[["தக்கா",1,"Thakkaa","the worthy ones"],["ரினத்தனாய்த்",1,"Rinaththanaaith","being one of (their) group"],["தானொழுக",1,"Thaanozhuka","himself; so as to conduct (himself)"],["வல்லானைச்",1,"Vallaanaich","the one able; (accusative)"],["செற்றார்",2,"Chetraar","the enemies"],["செயக்கிடந்த",2,"Seyakkitandha","to do (harm); that which lies (to be done)"],["தில்",2,"Thil","there is none"]]},{"n":447,"l":["இடிக்குந் துணையாரை யாள்வாரை யாரே","கெடுக்குந் தகைமை யவர்."],"w":[["இடிக்குந்",1,"Itikkun","that admonish/reprove"],["துணையாரை",1,"Thunaiyaarai","those who are a help/support; (accusative)"],["யாள்வாரை",1,"Yaalvaarai","those who employ/avail (them); (accusative)"],["யாரே",1,"Yaare","who; (வினா ஏகாரம் — வினாப்பொருளை வலியுறுத்தும்)"],["கெடுக்குந்",2,"Ketukkun","that can ruin"],["தகைமை",2,"Thakaimai","the capacity/ability"],["யவர்",2,"Yavar","those (who have)"]]},{"n":448,"l":["இடிப்பாரை இல்லாத ஏமரா மன்னன்","கெடுப்பா ரிலானுங் கெடும்."],"w":[["இடிப்பாரை",1,"Itippaarai","those who reprove; (accusative)"],["இல்லாத",1,"Illaadha","who does not have"],["ஏமரா",1,"Emaraa","unguarded/without protection"],["மன்னன்",1,"Mannan","the king"],["கெடுப்பா",2,"Ketuppaa","those who would ruin (him)"],["ரிலானுங்",2,"Rilaanung","even though (he) has none; even (concessive)"],["கெடும்",2,"Ketum","will perish"]]},{"n":449,"l":["முதலிலார்க் கூதிய மில்லை மதலையாஞ்","சார்பிலார்க் கில்லை நிலை."],"w":[["முதலிலார்க்",1,"Mudhalilaarkku","for those without capital; (dative -ku)"],["கூதிய",1,"Oodhiya","profit/gain"],["மில்லை",1,"Millai","is not/there is none"],["மதலையாஞ்",1,"Madhalaiyaanj","prop/pillar (support); that is/serves as"],["சார்பிலார்க்",2,"Chaarpilaark","for those without support; (dative -ku)"],["கில்லை",2,"Killai","is not/there is none"],["நிலை",2,"Nilai","stability/permanence"]]},{"n":450,"l":["பல்லார் பகைகொளலிற் பத்தடுத்த தீமைத்தே","நல்லார் தொடர்கை விடல்."],"w":[["பல்லார்",1,"","many people"],["பகைகொளலிற்",1,"","enmity; than the taking-on of; (comparative -in)"],["பத்தடுத்த",1,"","ten; added/multiplied"],["தீமைத்தே",1,"","is of (such) evil; (emphatic)"],["நல்லார்",2,"","the good/great ones"],["தொடர்கை",2,"","the connection/association"],["விடல்",2,"","abandoning"]]}]}