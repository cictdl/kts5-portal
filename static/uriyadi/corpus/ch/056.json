{"n":56,"kurals":[{"n":551,"l":["கொலைமேற்கொண் டாரிற் கொடிதே அலைமேற்கொண்டு","அல்லவை செய்தொழுகும் வேந்து."],"w":[["கொலைமேற்கொண்",1,"Kolaimerkon","killing/murder (obj.); having undertaken (part of கொண்டாரின்)"],["டாரிற்",1,"Taarir","than those who took up (killing)"],["கொடிதே",1,"Kotidhe","is more cruel; emphatic/assertive ē"],["அலைமேற்கொண்டு",1,"Alaimerkontu","harassment/oppression (obj.); having undertaken"],["அல்லவை",2,"Allavai","wrong/unjust things (obj.)"],["செய்தொழுகும்",2,"Seydhozhukum","having done; who lives/conducts (rel. part.)"],["வேந்து",2,"Vendhu","king/sovereign"]]},{"n":552,"l":["வேலொடு நின்றான் இடுவென் றதுபோலும்","கோலொடு நின்றான் இரவு."],"w":[["வேலொடு",1,"Velotu","with a spear; with (3rd-case உருபு)"],["நின்றான்",1,"Nindraan","he who stood"],["இடுவென்",1,"Ituven","hand it over! (imperative); saying so"],["றதுபோலும்",1,"Radhupolum","that (act); is like/resembles"],["கோலொடு",2,"Kolotu","with the sceptre; with (3rd-case உருபு)"],["நின்றான்",2,"Nindraan","he who stood (with sceptre)"],["இரவு",2,"Iravu","begging/asking (for tax)"]]},{"n":553,"l":["நாடொறும் நாடி முறைசெய்யா மன்னவன்","நாடொறும் நாடு கெடும்."],"w":[["நாடொறும்",1,"Naatorum","day; every (distributive)"],["நாடி",1,"Naati","having investigated"],["முறைசெய்யா",1,"Muraiseyyaa","justice/due order (obj.); who does not do (justice)"],["மன்னவன்",1,"Mannavan","king"],["நாடொறும்",2,"Naatorum","day; every (distributive)"],["நாடு",2,"Naatu","country/realm"],["கெடும்",2,"Ketum","will perish/decay"]]},{"n":554,"l":["கூழுங் குடியும் ஒருங்கிழக்கும் கோல்கோடிச்","சூழாது செய்யும் அரசு."],"w":[["கூழுங்",1,"Koozhung","wealth/food-grain (obj.); and (inclusive um)"],["குடியும்",1,"Kutiyum","subjects/citizens (obj.); and (inclusive um)"],["ஒருங்கிழக்கும்",1,"Orungizhakkum","together/at once; will lose (the king)"],["கோல்கோடிச்",1,"Kolkotich","sceptre/rule (obj.); having bent/perverted"],["சூழாது",2,"Choozhaadhu","without considering"],["செய்யும்",2,"Seyyum","that acts (rel. part.)"],["அரசு",2,"Arasu","the king/government"]]},{"n":555,"l":["அல்லற்பட்டு ஆற்றாது அழுதகண் ணீரன்றே","செல்வத்தைத் தேய்க்கும் படை"],"w":[["அல்லற்பட்டு",1,"Allarpattu","suffering/distress; having undergone"],["ஆற்றாது",1,"Aatraadhu","being unable to bear"],["அழுதகண்",1,"Azhudhakan","that wept (rel. part.); eye"],["ணீரன்றே",1,"Neerandre","water/tears; is it not; interrogative/assertive ē"],["செல்வத்தைத்",2,"Selvaththaith","wealth (obj.)"],["தேய்க்கும்",2,"Theykkum","that wears away (rel. part.)"],["படை",2,"Patai","weapon/army"]]},{"n":556,"l":["மன்னர்க்கு மன்னுதல் செங்கோன்மை அஃதின்றேல்","மன்னாவாம் மன்னர்க் கொளி."],"w":[["மன்னர்க்கு",1,"Mannarkku","for kings"],["மன்னுதல்",1,"Mannudhal","enduring/permanence (of fame)"],["செங்கோன்மை",1,"Sengonmai","just rule/righteous sceptre"],["அஃதின்றேல்",1,"Aqdhindrel","that (just rule); if it is not (present)"],["மன்னாவாம்",2,"Mannaavaam","that does not endure; becomes/will be"],["மன்னர்க்",2,"Mannark","for kings"],["கொளி",2,"Koli","light/glory/fame"]]},{"n":557,"l":["துளியின்மை ஞாலத்திற்கு எற்றற்றே வேந்தன்","அளியின்மை வாழும் உயிர்க்கு."],"w":[["துளியின்மை",1,"Thuliyinmai","raindrop/rain; absence/want"],["ஞாலத்திற்கு",1,"Gnaalaththirku","to the world"],["எற்றற்றே",1,"Etratre","of what nature?; of that nature; assertive ē"],["வேந்தன்",1,"Vendhan","king's (grace)"],["அளியின்மை",2,"Aliyinmai","grace/compassion; absence/want"],["வாழும்",2,"Vaazhum","living (rel. part.)"],["உயிர்க்கு",2,"Uyirkku","for the (living) creatures"]]},{"n":558,"l":["இன்மையின் இன்னாது உடைமை முறைசெய்யா","மன்னவன் கோற்கீழ்ப் படின்."],"w":[["இன்மையின்",1,"Inmaiyin","than poverty"],["இன்னாது",1,"Innaadhu","is painful/bitter"],["உடைமை",1,"Utaimai","wealth/possession"],["முறைசெய்யா",1,"Muraiseyyaa","justice/due order (obj.); who does not do (justice)"],["மன்னவன்",2,"Mannavan","king's (sceptre)"],["கோற்கீழ்ப்",2,"Korkeezhp","sceptre/rule; under/beneath"],["படின்",2,"Patin","if one falls/comes under"]]},{"n":559,"l":["முறைகோடி மன்னவன் செய்யின் உறைகோடி","ஒல்லாது வானம் பெயல்."],"w":[["முறைகோடி",1,"Muraikoti","justice/due order (obj.); having swerved/perverted"],["மன்னவன்",1,"Mannavan","king"],["செய்யின்",1,"Seyyin","if (he) does"],["உறைகோடி",1,"Uraikoti","raindrop/season's rain; having swerved/failing"],["ஒல்லாது",2,"Ollaadhu","(rain) does not come about"],["வானம்",2,"Vaanam","sky/cloud"],["பெயல்",2,"Peyal","raining/rainfall"]]},{"n":560,"l":["ஆபயன் குன்றும் அறுதொழிலோர் நூல்மறப்பர்","காவலன் காவான் எனின்."],"w":[["ஆபயன்",1,"Aapayan","cow; yield/benefit (milk)"],["குன்றும்",1,"Kundrum","will diminish"],["அறுதொழிலோர்",1,"Arudhozhilor","six; those of the (six) functions/Brahmins"],["நூல்மறப்பர்",1,"Noolmarappar","(sacred) books/lore (obj.); will forget"],["காவலன்",2,"Kaavalan","guardian/protector (king)"],["காவான்",2,"Kaavaan","does not protect"],["எனின்",2,"Enin","if (it be) so"]]}]}