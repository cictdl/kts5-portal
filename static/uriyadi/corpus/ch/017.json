{"n":17,"kurals":[{"n":161,"l":["ஒழுக்காறாக் கொள்க ஒருவன்தன் நெஞ்சத்து","அழுக்காறு இலாத இயல்பு."],"w":[["ஒழுக்காறாக்",1,"Ozhukkaaraak","as the path/way of conduct"],["கொள்க",1,"Kolka","let (one) hold/deem"],["ஒருவன்தன்",1,"Oruvandhan","a person/one; his own"],["நெஞ்சத்து",1,"Nenjaththu","in the heart/mind"],["அழுக்காறு",2,"Azhukkaaru","envy/jealousy"],["இலாத",2,"Ilaadha","which is not (present)"],["இயல்பு",2,"Iyalpu","nature/disposition (object)"]]},{"n":162,"l":["விழுப்பேற்றின் அஃதொப்பது இல்லையார் மாட்டும்","அழுக்காற்றின் அன்மை பெறின்."],"w":[["விழுப்பேற்றின்",1,"Vizhuppetrin","among/than excellent gains"],["அஃதொப்பது",1,"Aqdhoppadhu","that; that which equals"],["இல்லையார்",1,"Illaiyaar","there is none; whoever/any"],["மாட்டும்",1,"Maattum","in (anyone's) case/regard; even (in any)"],["அழுக்காற்றின்",2,"Azhukkaatrin","of/from envy"],["அன்மை",2,"Anmai","the absence/not-being"],["பெறின்",2,"Perin","if (one) obtains"]]},{"n":163,"l":["அறன்ஆக்கம் வேண்டாதான் என்பான் பிறனாக்கம்","பேணாது அழுக்கறுப் பான்."],"w":[["அறன்ஆக்கம்",1,"Aranaakkam","virtue; prosperity/gain"],["வேண்டாதான்",1,"Ventaadhaan","he who desires not"],["என்பான்",1,"Enpaan","he who is called/deemed"],["பிறனாக்கம்",1,"Piranaakkam","another's; prosperity (object)"],["பேணாது",2,"Penaadhu","without cherishing"],["அழுக்கறுப்",2,"Azhukkarup","(front part of) அழுக்கறுப்பான் = he who envies"],["பான்",2,"Paan","(end part of) அழுக்கறுப்பான் = he who (does)"]]},{"n":164,"l":["அழுக்காற்றின் அல்லவை செய்யார் இழுக்காற்றின்","ஏதம் படுபாக்கு அறிந்து."],"w":[["அழுக்காற்றின்",1,"Azhukkaatrin","because of/by envy (causal இன்)"],["அல்லவை",1,"Allavai","things that are not (right)/wrongs"],["செய்யார்",1,"Seyyaar","(the wise) do not do"],["இழுக்காற்றின்",1,"Izhukkaatrin","from the faulty path"],["ஏதம்",2,"Edham","harm/misfortune"],["படுபாக்கு",2,"Patupaakku","the coming-to-be (of harm)"],["அறிந்து",2,"Arindhu","having known"]]},{"n":165,"l":["அழுக்காறு உடையார்க்கு அதுசாலும் ஒன்னார்","வழுக்கியும் கேடீன் பது."],"w":[["அழுக்காறு",1,"Azhukkaaru","envy (object of உடை)"],["உடையார்க்கு",1,"Utaiyaarkku","for those who possess (it)"],["அதுசாலும்",1,"Adhusaalum","that (envy); suffices/is enough"],["ஒன்னார்",1,"Onnaar","enemies/foes"],["வழுக்கியும்",2,"Vazhukkiyum","even if (they) fail/slip (do not harm); even (concessive)"],["கேடீன்",2,"Keteen","ruin (object)"],["பது",2,"Padhu","that which begets/yields"]]},{"n":166,"l":["கொடுப்பது அழுக்கறுப்பான் சுற்றம் உடுப்பதூஉம்","உண்பதூஉம் இன்றிக் கெடும்."],"w":[["கொடுப்பது",1,"Kotuppadhu","that which is given (charity)"],["அழுக்கறுப்பான்",1,"Azhukkaruppaan","he who envies"],["சுற்றம்",1,"Sutram","kinsfolk/family"],["உடுப்பதூஉம்",1,"Utuppadhooum","that which is worn (clothing); and (enumerative)"],["உண்பதூஉம்",2,"Unpadhooum","that which is eaten (food); and (enumerative)"],["இன்றிக்",2,"Indrik","being without"],["கெடும்",2,"Ketum","(kin) shall perish"]]},{"n":167,"l":["அவ்வித்து அழுக்காறு உடையானைச் செய்யவள்","தவ்வையைக் காட்டி விடும்."],"w":[["அவ்வித்து",1,"Avviththu","(she) having envied"],["அழுக்காறு",1,"Azhukkaaru","envy (object of உடை)"],["உடையானைச்",1,"Utaiyaanaich","him who possesses (it)"],["செய்யவள்",1,"Cheyyaval","the red one (Lakshmi/Fortune)"],["தவ்வையைக்",2,"Thavvaiyaik","(her) elder sister (Misfortune) — object of காட்டி"],["காட்டி",2,"Kaatti","having pointed out"],["விடும்",2,"Vitum","(she) will leave/depart"]]},{"n":168,"l":["அழுக்காறு எனஒரு பாவி திருச்செற்றுத்","தீயுழி உய்த்து விடும்."],"w":[["அழுக்காறு",1,"Azhukkaaru","envy"],["எனஒரு",1,"Enaoru","called/named as; a/one (matchless)"],["பாவி",1,"Paavi","sinner/wicked one"],["திருச்செற்றுத்",1,"Thiruchchetruth","wealth/fortune (object); having destroyed"],["தீயுழி",2,"Theeyuzhi","evil (attribute); in the (evil) place/path"],["உய்த்து",2,"Uyththu","having driven/sent"],["விடும்",2,"Vitum","(it) will let/cast"]]},{"n":169,"l":["அவ்விய நெஞ்சத்தான் ஆக்கமும் செவ்வியான்","கேடும் நினைக்கப் படும்."],"w":[["அவ்விய",1,"Avviya","envious (qualifying heart)"],["நெஞ்சத்தான்",1,"Nenjaththaan","he with (such) a heart"],["ஆக்கமும்",1,"Aakkamum","prosperity; and (enumerative)"],["செவ்வியான்",1,"Sevviyaan","the upright/good man"],["கேடும்",2,"Ketum","ruin/decline; and (enumerative)"],["நினைக்கப்",2,"Ninaikkap","to be pondered (inf)"],["படும்",2,"Patum","are (worthy of being) — passive aux"]]},{"n":170,"l":["அழுக்கற்று அகன்றாரும் இல்லை அஃதுஇல்லார்","பெருக்கத்தில் தீர்ந்தாரும் இல்."],"w":[["அழுக்கற்று",1,"Azhukkatru","having envied (envy-acting)"],["அகன்றாரும்",1,"Akandraarum","those who became great/expanded; (none) even (one)"],["இல்லை",1,"Illai","there is none"],["அஃதுஇல்லார்",1,"Aqdhuillaar","that (envy); those without (it)"],["பெருக்கத்தில்",2,"Perukkaththil","from (their) abundance"],["தீர்ந்தாரும்",2,"Theerndhaarum","those who departed/were severed; (none) even (one)"],["இல்",2,"Il","there is not"]]}]}