{"n":106,"kurals":[{"n":1051,"l":["இரக்க இரத்தக்கார்க் காணின் கரப்பின்","அவர்பழி தம்பழி அன்று."],"w":[["இரக்க",1,"Irakka","let one beg/ask (one should beg)"],["இரத்தக்கார்க்",1,"Iraththakkaark","those worthy to be begged from (object of காண்); case/sandhi consonant"],["காணின்",1,"Kaanin","if (one) sees"],["கரப்பின்",1,"Karappin","if (one) hides/conceals"],["அவர்பழி",2,"Avarpazhi","their (those persons'); blame/disgrace"],["தம்பழி",2,"Thampazhi","their own (the beggar's); blame/disgrace"],["அன்று",2,"Andru","is not"]]},{"n":1052,"l":["இன்பம் ஒருவற்கு இரத்தல் இரந்தவை","துன்பம் உறாஅ வரின்."],"w":[["இன்பம்",1,"Inpam","joy/pleasure"],["ஒருவற்கு",1,"Oruvarku","to a person; dative case marker"],["இரத்தல்",1,"Iraththal","begging/asking"],["இரந்தவை",1,"Irandhavai","the things begged for"],["துன்பம்",2,"Thunpam","sorrow/pain"],["உறாஅ",2,"Uraaa","without afflicting/befalling"],["வரின்",2,"Varin","if (it) comes/is obtained"]]},{"n":1053,"l":["கரப்பிலா நெஞ்சின் கடனறிவார் முன்நின்று","இரப்புமோ ரேஎர் உடைத்து."],"w":[["கரப்பிலா",1,"Karappilaa","with no concealment (qualifying நெஞ்சு)"],["நெஞ்சின்",1,"Nenjin","of the heart; connective/case suffix"],["கடனறிவார்",1,"Katanarivaar","duty; those who know"],["முன்நின்று",1,"Munnindru","in front (of); having stood"],["இரப்புமோ",2,"Irappumo","begging (act); interrogative/wonder particle"],["ரேஎர்",2,"Reer","(a kind of) beauty/grace"],["உடைத்து",2,"Utaiththu","possesses/has"]]},{"n":1054,"l":["இரத்தலும் ஈதலே போலும் கரத்தல்","கனவிலும் தேற்றாதார் மாட்டு."],"w":[["இரத்தலும்",1,"Iraththalum","begging; also/even (inclusive)"],["ஈதலே",1,"Eedhale","giving; indeed (emphatic)"],["போலும்",1,"Polum","resembles/is like"],["கரத்தல்",1,"Karaththal","concealing/denying"],["கனவிலும்",2,"Kanavilum","in dream; even (in dream too)"],["தேற்றாதார்",2,"Thetraadhaar","those who never conceive (of hiding)"],["மாட்டு",2,"Maattu","at/with (locative)"]]},{"n":1055,"l":["கரப்பிலார் வையகத்து உண்மையால் கண்ணின்று","இரப்பவர் மேற்கொள் வது."],"w":[["கரப்பிலார்",1,"Karappilaar","those without concealment"],["வையகத்து",1,"Vaiyakaththu","in the world; connective/locative suffix"],["உண்மையால்",1,"Unmaiyaal","because of (their) existence; by/because of"],["கண்ணின்று",1,"Kannindru","eye / in presence (before the eye); standing (before)"],["இரப்பவர்",2,"Irappavar","those who beg"],["மேற்கொள்",2,"Merkol","undertake (stem of மேற்கொள்வது)"],["வது",2,"Vadhu","that which (they) undertake"]]},{"n":1056,"l":["கரப்பிடும்பை யில்லாரைக் காணின் நிரப்பிடும்பை","எல்லாம் ஒருங்கு கெடும்."],"w":[["கரப்பிடும்பை",1,"Karappitumpai","concealing; affliction/disease"],["யில்லாரைக்",1,"Yillaaraik","those who have not (it); accusative marker"],["காணின்",1,"Kaanin","if (one) sees"],["நிரப்பிடும்பை",1,"Nirappitumpai","poverty/want; affliction"],["எல்லாம்",2,"Ellaam","all"],["ஒருங்கு",2,"Orungu","together/all at once"],["கெடும்",2,"Ketum","will perish/vanish"]]},{"n":1057,"l":["இகழ்ந்தெள்ளாது ஈவாரைக் காணின் மகிழ்ந்துள்ளம்","உள்ளுள் உவப்பது உடைத்து."],"w":[["இகழ்ந்தெள்ளாது",1,"Ikazhndhellaadhu","despising; without scorning"],["ஈவாரைக்",1,"Eevaaraik","those who give; accusative marker"],["காணின்",1,"Kaanin","if (one) sees"],["மகிழ்ந்துள்ளம்",1,"Makizhndhullam","rejoicing; heart/mind"],["உள்ளுள்",2,"Ullul","deep within"],["உவப்பது",2,"Uvappadhu","that which rejoices"],["உடைத்து",2,"Utaiththu","possesses/has (the nature of)"]]},{"n":1058,"l":["இரப்பாரை இல்லாயின் ஈர்ங்கண்மா ஞாலம்","மரப்பாவை சென்றுவந் தற்று."],"w":[["இரப்பாரை",1,"Irappaarai","those who beg (accusative); accusative marker"],["இல்லாயின்",1,"Illaayin","if there are none"],["ஈர்ங்கண்மா",1,"Eernganmaa","cool/moist; space/expanse; great/large"],["ஞாலம்",1,"Gnaalam","the world/earth"],["மரப்பாவை",2,"Marappaavai","wood; puppet/doll"],["சென்றுவந்",2,"Sendruvan","having gone; having come"],["தற்று",2,"Thatru","is like that / of that nature"]]},{"n":1059,"l":["ஈவார்கண் என்னுண்டாம் தோற்றம் இரந்துகோள்","மேவார் இலாஅக் கடை."],"w":[["ஈவார்கண்",1,"Eevaarkan","givers; in/with (locative)"],["என்னுண்டாம்",1,"Ennuntaam","what; will there be"],["தோற்றம்",1,"Thotram","fame/distinction (appearance)"],["இரந்துகோள்",1,"Irandhukol","having begged; receiving/taking"],["மேவார்",2,"Mevaar","those who desire (to beg and receive)"],["இலாஅக்",2,"Ilaaak","not being / when there are not"],["கடை",2,"Katai","occasion/when (at the point that)"]]},{"n":1060,"l":["இரப்பான் வெகுளாமை வேண்டும் நிரப்பிடும்பை","தானேயும் சாலும் கரி."],"w":[["இரப்பான்",1,"Irappaan","the beggar/one who begs"],["வெகுளாமை",1,"Vekulaamai","non-anger / not being wrathful"],["வேண்டும்",1,"Ventum","is required/must"],["நிரப்பிடும்பை",1,"Nirappitumpai","poverty/want; affliction of want"],["தானேயும்",2,"Thaaneyum","itself; even (emphatic); also/even"],["சாலும்",2,"Saalum","is sufficient/will suffice"],["கரி",2,"Kari","witness/testimony"]]}]}