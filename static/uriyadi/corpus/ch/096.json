{"n":96,"kurals":[{"n":951,"l":["இற்பிறந்தார் கண்அல்லது இல்லை இயல்பாகச்","செப்பமும் நாணும் ஒருங்கு."],"w":[["இற்பிறந்தார்",1,"Irpirandhaar","in a (noble) house/family; those born"],["கண்அல்லது",1,"Kanalladhu","at/in (locative marker); except / other than"],["இல்லை",1,"Illai","is not / there is not"],["இயல்பாகச்",1,"Iyalpaakach","naturally / by nature"],["செப்பமும்",2,"Cheppamum","rectitude / uprightness; and (enumerative)"],["நாணும்",2,"Naanum","shame / modesty; and (enumerative)"],["ஒருங்கு",2,"Orungu","together / in union"]]},{"n":952,"l":["ஒழுக்கமும் வாய்மையும் நாணும்இம் மூன்றும்","இழுக்கார் குடிப்பிறந் தார்."],"w":[["ஒழுக்கமும்",1,"","good conduct; and"],["வாய்மையும்",1,"","truthfulness; and"],["நாணும்இம்",1,"","modesty; and; this (proximal demonstrative)"],["மூன்றும்",1,"","three; all (inclusive)"],["இழுக்கார்",2,"","will not slip/lapse"],["குடிப்பிறந்",2,"","family / lineage; having been born"],["தார்",2,"","those (who are) born"]]},{"n":953,"l":["நகைஈகை இன்சொல் இகழாமை நான்கும்","வகையென்ப வாய்மைக் குடிக்கு."],"w":[["நகைஈகை",1,"Nakaieekai","smile / cheerfulness; munificence / giving"],["இன்சொல்",1,"Insol","sweet (quality); word / speech"],["இகழாமை",1,"Ikazhaamai","non-disparagement / not despising"],["நான்கும்",1,"Naankum","four; all (inclusive)"],["வகையென்ப",2,"Vakaiyenpa","kind / proper traits; they say (so) / are deemed"],["வாய்மைக்",2,"Vaaimaik","true / honest (lineage)"],["குடிக்கு",2,"Kutikku","for the family/lineage"]]},{"n":954,"l":["அடுக்கிய கோடி பெறினும் குடிப்பிறந்தார்","குன்றுவ செய்தல் இலர்."],"w":[["அடுக்கிய",1,"Atukkiya","heaped-up / accumulated"],["கோடி",1,"Koti","crore / ten million"],["பெறினும்",1,"Perinum","even if (one) obtains"],["குடிப்பிறந்தார்",1,"Kutippirandhaar","(in a) family; those born (in a noble family)"],["குன்றுவ",2,"Kundruva","things that diminish (worth)"],["செய்தல்",2,"Seydhal","doing / the act of doing"],["இலர்",2,"Ilar","they are not (given to) / they lack"]]},{"n":955,"l":["வழங்குவ துள்வீழ்ந்தக் கண்ணும் பழங்குடி","பண்பில் த