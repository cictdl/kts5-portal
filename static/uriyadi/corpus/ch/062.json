{"n":62,"kurals":[{"n":611,"l":["அருமை உடைத்தென்று அசாவாமை வேண்டும்","பெருமை முயற்சி தரும்."],"w":[["அருமை",1,"Arumai","difficulty"],["உடைத்தென்று",1,"Utaiththendru","(it) has; saying that"],["அசாவாமை",1,"Asaavaamai","not being wearied (verbal noun)"],["வேண்டும்",1,"Ventum","is needed"],["பெருமை",2,"Perumai","greatness"],["முயற்சி",2,"Muyarsi","effort"],["தரும்",2,"Tharum","will give"]]},{"n":612,"l":["வினைக்கண் வினைகெடல் ஓம்பல் வினைக்குறை","தீர்ந்தாரின் தீர்ந்தன்று உலகு."],"w":[["வினைக்கண்",1,"Vinaikkan","work; in/at"],["வினைகெடல்",1,"Vinaiketal","work; ruin/lapse"],["ஓம்பல்",1,"Ompal","guarding against"],["வினைக்குறை",1,"Vinaikkurai","work; deficiency"],["தீர்ந்தாரின்",2,"Theerndhaarin","those who quit; like/from"],["தீர்ந்தன்று",2,"Theerndhandru","has quit"],["உலகு",2,"Ulaku","the world"]]},{"n":613,"l":["தாளாண்மை என்னும் தகைமைக்கண் தங்கிற்றே","வேளாண்மை என்னுஞ் செருக்கு."],"w":[["தாளாண்மை",1,"Thaalaanmai","industry/perseverance"],["என்னும்",1,"Ennum","called/named"],["தகைமைக்கண்",1,"Thakaimaikkan","excellence; in"],["தங்கிற்றே",1,"Thangitre","has rested/abided; (emphatic/தேற்றம்)"],["வேளாண்மை",2,"Velaanmai","beneficence/bounty"],["என்னுஞ்",2,"Ennunj","called/named"],["செருக்கு",2,"Cherukku","pride/exuberance"]]},{"n":614,"l":["தாளாண்மை இல்லாதான் வேளாண்மை பேடிகை","வாளாண்மை போலக் கெடும்."],"w":[["தாளாண்மை",1,"Thaalaanmai","industry"],["இல்லாதான்",1,"Illaadhaan","he who lacks"],["வேளாண்மை",1,"Velaanmai","bounty"],["பேடிகை",1,"Petikai","eunuch/coward; hand (in the hand)"],["வாளாண்மை",2,"Vaalaanmai","wielding a sword"],["போலக்",2,"Polak","like (உவம உருபு)"],["கெடும்",2,"Ketum","will fail"]]},{"n":615,"l":["இன்பம் விழையான் வினைவிழைவான் தன்கேளிர்","துன்பம் துடைத்தூன்றும் தூண்."],"w":[["இன்பம்",1,"Inpam","pleasure"],["விழையான்",1,"Vizhaiyaan","desires not"],["வினைவிழைவான்",1,"Vinaivizhaivaan","work; he who desires"],["தன்கேளிர்",1,"Thankelir","his own; kinsfolk/friends"],["துன்பம்",2,"Thunpam","grief"],["துடைத்தூன்றும்",2,"Thutaiththoondrum","wiping away; supporting"],["தூண்",2,"Thoon","pillar"]]},{"n":616,"l":["முயற்சி திருவினை ஆக்கும் முயற்றின்மை","இன்மை புகுத்தி விடும்."],"w":[["முயற்சி",1,"Muyarsi","effort"],["திருவினை",1,"Thiruvinai","wealth/fortune; (it) into wealth"],["ஆக்கும்",1,"Aakkum","will create"],["முயற்றின்மை",1,"Muyatrinmai","lack of effort"],["இன்மை",2,"Inmai","poverty/want"],["புகுத்தி",2,"Pukuththi","having thrust into"],["விடும்",2,"Vitum","will leave/cast"]]},{"n":617,"l":["மடியுளாள் மாமுகடி என்ப மடியிலான்","தாளுளாள் தாமரையி னாள்."],"w":[["மடியுளாள்",1,"Matiyulaal","sloth; she who dwells"],["மாமுகடி",1,"Maamukati","great/black; Mudevi (goddess of misfortune)"],["என்ப",1,"Enpa","they say"],["மடியிலான்",1,"Matiyilaan","sloth; he who lacks"],["தாளுளாள்",2,"Thaalulaal","effort/toil; he in whom (it) dwells"],["தாமரையி",2,"Thaamaraiyi","the lotus-dweller = திருமகள்/Lakshmi (split across சீர்) — part 1"],["னாள்",2,"Naal","…(தாமரையி)னாள் = திருமகள்/Lakshmi — part 2 (continuation)"]]},{"n":618,"l":["பொறியின்மை யார்க்கும் பழியன்று அறிவறிந்து","ஆள்வினை இன்மை பழி."],"w":[["பொறியின்மை",1,"Poriyinmai","fortune/faculty; lack"],["யார்க்கும்",1,"Yaarkkum","to anyone; even (all-inclusive)"],["பழியன்று",1,"Pazhiyandru","blame; is not"],["அறிவறிந்து",1,"Arivarindhu","what should be known; having known"],["ஆள்வினை",2,"Aalvinai","manly effort"],["இன்மை",2,"Inmai","absence"],["பழி",2,"Pazhi","blame/disgrace"]]},{"n":619,"l":["தெய்வத்தான் ஆகா தெனினும் முயற்சிதன்","மெய்வருத்தக் கூலி தரும்."],"w":[["தெய்வத்தான்",1,"Theyvaththaan","by fate/divinity"],["ஆகா",1,"Aakaa","(it) does not become / is not achievable — part 1"],["தெனினும்",1,"Theninum","…(ஆகா)து எனினும் = even if it be (so) — concessive — part 2"],["முயற்சிதன்",1,"Muyarsidhan","effort; its own"],["மெய்வருத்தக்",2,"Meyvaruththak","body; that wearies/of toil"],["கூலி",2,"Kooli","wages/reward"],["தரும்",2,"Tharum","will give"]]},{"n":620,"l":["ஊழையும் உப்பக்கம் காண்பர் உலைவின்றித்","தாழாது உஞற்று பவர்."],"w":[["ஊழையும்",1,"Oozhaiyum","fate/destiny; even"],["உப்பக்கம்",1,"Uppakkam","the back/hind side (defeat)"],["காண்பர்",1,"Kaanpar","(they) will see/behold"],["உலைவின்றித்",1,"Ulaivindrith","wavering/distress; without"],["தாழாது",2,"Thaazhaadhu","without faltering/delay"],["உஞற்று",2,"Ugnatru","those who strive — part 1"],["பவர்",2,"Pavar","those who strive — part 2"]]}]}