{"n":133,"kurals":[{"n":1321,"l":["இல்லை தவறவர்க்கு ஆயினும் ஊடுதல்","வல்லது அவர்அளிக்கு மாறு."],"w":[["இல்லை",1,"Illai","is not / there is none"],["தவறவர்க்கு",1,"Thavaravarkku","fault; to/in him (honorific)"],["ஆயினும்",1,"Aayinum","if it be; concessive -um (even though)"],["ஊடுதல்",1,"Ootudhal","sulking, the act of pouting"],["வல்லது",2,"Valladhu","is able / that which is capable"],["அவர்அளிக்கு",2,"Avaralikku","his (honorific); to/for his loving grace"],["மாறு",2,"Maaru","so that... grows / in turn"]]},{"n":1322,"l":["ஊடலின் தோன்றும் சிறுதுனி நல்லளி","வாடினும் பாடு பெறும்."],"w":[["ஊடலின்",1,"Ootalin","from/by sulking"],["தோன்றும்",1,"Thondrum","that arises"],["சிறுதுனி",1,"Sirudhuni","small; grief, distress"],["நல்லளி",1,"Nallali","good; loving grace, affection"],["வாடினும்",2,"Vaatinum","if it withers; concessive -um (even if)"],["பாடு",2,"Paatu","greatness, dignity"],["பெறும்",2,"Perum","will obtain/gain"]]},{"n":1323,"l":["புலத்தலின் புத்தேள்நாடு உண்டோ நிலத்தொடு","நீரியைந் தன்னார் அகத்து."],"w":[["புலத்தலின்",1,"Pulaththalin","than sulking"],["புத்தேள்நாடு",1,"Puththelnaatu","deva, god; land (heaven of gods)"],["உண்டோ",1,"Unto","exists; interrogative -o"],["நிலத்தொடு",1,"Nilaththotu","with the earth"],["நீரியைந்",2,"Neeriyain","water; having joined/blended"],["தன்னார்",2,"Thannaar","those who are like (such ones)"],["அகத்து",2,"Akaththu","in (the heart/being of)"]]},{"n":1324,"l":["புல்லி விடாஅப் புலவியுள் தோன்றுமென்","உள்ளம் உடைக்கும் படை."],"w":[["புல்லி",1,"Pulli","having embraced"],["விடாஅப்",1,"Vitaaap","not letting go (that does not release)"],["புலவியுள்",1,"Pulaviyul","within the sulking"],["தோன்றுமென்",1,"Thondrumen","that appears; my"],["உள்ளம்",2,"Ullam","heart, mind (as object)"],["உடைக்கும்",2,"Utaikkum","that breaks/shatters"],["படை",2,"Patai","weapon"]]},{"n":1325,"l":["தவறிலர் ஆயினும் தாம்வீழ்வார் மென்றோள்","அகறலின் ஆங்கொன் றுடைத்து."],"w":[["தவறிலர்",1,"Thavarilar","fault; are without (faultless)"],["ஆயினும்",1,"Aayinum","if it be; concessive -um (even though)"],["தாம்வீழ்வார்",1,"Thaamveezhvaar","they themselves; those whom they love"],["மென்றோள்",1,"Mendrol","soft; shoulder(s)"],["அகறலின்",2,"Akaralin","by being separated/distant"],["ஆங்கொன்",2,"Aangon","there / then (expletive); a one (a certain something)"],["றுடைத்து",2,"Rutaiththu","possesses (there is)"]]},{"n":1326,"l":["உணலினும் உண்டது அறல்இனிது காமம்","புணர்தலின் ஊடல் இனிது."],"w":[["உணலினும்",1,"Unalinum","than eating; emphatic -um"],["உண்டது",1,"Untadhu","that which was eaten"],["அறல்இனிது",1,"Aralinidhu","digesting; is sweet/pleasant"],["காமம்",1,"Kaamam","love, passion"],["புணர்தலின்",2,"Punardhalin","than union/coupling"],["ஊடல்",2,"Ootal","sulking"],["இனிது",2,"Inidhu","is sweet/pleasant"]]},{"n":1327,"l":["ஊடலில் தோற்றவர் வென்றார் அதுமன்னும்","கூடலிற் காணப் படும்."],"w":[["ஊடலில்",1,"Ootalil","in the sulk"],["தோற்றவர்",1,"Thotravar","those who lost"],["வென்றார்",1,"Vendraar","(they) won"],["அதுமன்னும்",1,"Adhumannum","that (truth); expletive (mannum); emphatic -um"],["கூடலிற்",2,"Kootalir","in the reunion"],["காணப்",2,"Kaanap","to be seen"],["படும்",2,"Patum","will be (seen)"]]},{"n":1328,"l":["ஊடிப் பெறுகுவம் கொல்லோ நுதல்வெயர்ப்பக்","கூடலில் தோன்றிய உப்பு."],"w":[["ஊடிப்",1,"Ootip","having sulked"],["பெறுகுவம்",1,"Perukuvam","shall we obtain"],["கொல்லோ",1,"Kollo","doubt particle 'kol'; interrogative/wonder -o"],["நுதல்வெயர்ப்பக்",1,"Nudhalveyarppak","forehead; so that (it) sweats"],["கூடலில்",2,"Kootalil","in the union"],["தோன்றிய",2,"Thondriya","that arose"],["உப்பு",2,"Uppu","savour, relish (lit. salt)"]]},{"n":1329,"l":["ஊடுக மன்னோ ஒளியிழை யாமிரப்ப","நீடுக மன்னோ இரா."],"w":[["ஊடுக",1,"Ootuka","let (her) sulk"],["மன்னோ",1,"Manno","expletive (desire/regret); emotive -o"],["ஒளியிழை",1,"Oliyizhai","bright; she of bright jewels (the lady)"],["யாமிரப்ப",1,"Yaamirappa","we / I; as I entreat"],["நீடுக",2,"Neetuka","let (it) lengthen"],["மன்னோ",2,"Manno","expletive (desire/regret); emotive -o"],["இரா",2,"Iraa","night"]]},{"n":1330,"l":["ஊடுதல் காமத்திற்கு இன்பம் அதற்கின்பம்","கூடி முயங்கப் பெறின்."],"w":[["ஊடுதல்",1,"Ootudhal","sulking"],["காமத்திற்கு",1,"Kaamaththirku","for love/passion"],["இன்பம்",1,"Inpam","delight, pleasure"],["அதற்கின்பம்",1,"Adharkinpam","to that (sulking); delight"],["கூடி",2,"Kooti","having joined/united"],["முயங்கப்",2,"Muyangap","to embrace"],["பெறின்",2,"Perin","if (one) obtains"]]}]}