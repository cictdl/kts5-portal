{"n":46,"kurals":[{"n":451,"l":["சிற்றினம் அஞ்சும் பெருமை சிறுமைதான்","சுற்றமாச் சூழ்ந்து விடும்."],"w":[["சிற்றினம்",1,"Sitrinam","mean/petty company"],["அஞ்சும்",1,"Anjum","fears (adj. participle)"],["பெருமை",1,"Perumai","greatness/the noble"],["சிறுமைதான்",1,"Sirumaidhaan","meanness/the mean; expletive particle (emphatic)"],["சுற்றமாச்",2,"Sutramaach","kin/kinship; (becoming) as - aakka vinaiyecham"],["சூழ்ந்து",2,"Choozhndhu","having embraced/reckoned"],["விடும்",2,"Vitum","will (do completely)"]]},{"n":452,"l":["நிலத்தியல்பால் நீர்திரிந் தற்றாகும் மாந்தர்க்கு","இனத்தியல்ப தாகும் அறிவு."],"w":[["நிலத்தியல்பால்",1,"Nilaththiyalpaal","of land/soil; by the nature"],["நீர்திரிந்",1,"Neerdhirin","water; having changed"],["தற்றாகும்",1,"Thatraakum","that state / like that; becomes"],["மாந்தர்க்கு",1,"Maandharkku","for men"],["இனத்தியல்ப",2,"Inaththiyalpa","of the kin/group; of the nature (predicate)"],["தாகும்",2,"Thaakum","becomes"],["அறிவு",2,"Arivu","wisdom/intelligence"]]},{"n":453,"l":["மனத்தானாம் மாந்தர்க் குணர்ச்சி இனத்தானாம்","இன்னான் எனப்படுஞ் சொல்."],"w":[["மனத்தானாம்",1,"Manaththaanaam","by the mind; comes to be"],["மாந்தர்க்",1,"Maandhark","for men"],["குணர்ச்சி",1,"Kunarchchi","perception/feeling/wisdom"],["இனத்தானாம்",1,"Inaththaanaam","by the kin/group; comes to be"],["இன்னான்",2,"Innaan","such-and-such a man"],["எனப்படுஞ்",2,"Enappatunj","that is said to be"],["சொல்",2,"Chol","word/reputation"]]},{"n":454,"l":["மனத்து ளதுபோலக் காட்டி ஒருவற்கு","இனத்துள தாகும் அறிவு."],"w":[["மனத்து",1,"Manaththu","in the mind"],["ளதுபோலக்",1,"Ladhupolak","that which exists; like/as (உவம உருபு)"],["காட்டி",1,"Kaatti","having shown/appeared"],["ஒருவற்கு",1,"Oruvarku","for one/a person"],["இனத்துள",2,"Inaththula","within the kin/group"],["தாகும்",2,"Thaakum","becomes/is"],["அறிவு",2,"Arivu","wisdom"]]},{"n":455,"l":["மனந்தூய்மை செய்வினை தூய்மை இரண்டும்","இனந்தூய்மை தூவா வரும்."],"w":[["மனந்தூய்மை",1,"Manandhooimai","mind; purity"],["செய்வினை",1,"Seyvinai","deed/action done"],["தூய்மை",1,"Thooimai","purity"],["இரண்டும்",1,"Irantum","the two; both (inclusive um)"],["இனந்தூய்மை",2,"Inandhooimai","kin/group; purity"],["தூவா",2,"Thoovaa","issuing/springing from"],["வரும்",2,"Varum","will come/arise"]]},{"n":456,"l":["மனந்தூயார்க் கெச்சம்நன் றாகும் இனந்தூயார்க்கு","இல்லைநன் றாகா வினை."],"w":[["மனந்தூயார்க்",1,"Manandhooyaark","for the pure-minded"],["கெச்சம்நன்",1,"Kechchamnan","what remains/progeny/legacy; good"],["றாகும்",1,"Raakum","becomes/will be"],["இனந்தூயார்க்கு",1,"Inandhooyaarkku","for the pure in company"],["இல்லைநன்",2,"Illainan","there is not; good"],["றாகா",2,"Raakaa","that does not become"],["வினை",2,"Vinai","deed/act"]]},{"n":457,"l":["மனநலம் மன்னுயிர்க் காக்கம் இனநலம்","எல்லாப் புகழும் தரும்."],"w":[["மனநலம்",1,"Mananalam","goodness of mind"],["மன்னுயிர்க்",1,"Mannuyirk","for the enduring lives"],["காக்கம்",1,"Kaakkam","gain/prosperity"],["இனநலம்",1,"Inanalam","goodness of company"],["எல்லாப்",2,"Ellaap","all"],["புகழும்",2,"Pukazhum","fame; even/inclusive um"],["தரும்",2,"Tharum","will give"]]},{"n":458,"l":["மனநலம் நன்குடைய ராயினும் சான்றோர்க்கு","இனநலம் ஏமாப் புடைத்து."],"w":[["மனநலம்",1,"Mananalam","goodness of mind"],["நன்குடைய",1,"Nankutaiya","well/abundantly; possessing (rel. part.)"],["ராயினும்",1,"Raayinum","even though (they) be - inakka ecam"],["சான்றோர்க்கு",1,"Saandrorkku","for the wise/worthy"],["இனநலம்",2,"Inanalam","goodness of company"],["ஏமாப்",2,"Emaap","protection/security"],["புடைத்து",2,"Putaiththu","it has/possesses"]]},{"n":459,"l":["மனநலத்தின் ஆகும் மறுமைமற் றஃதும்","இனநலத்தின் ஏமாப் புடைத்து."],"w":[["மனநலத்தின்",1,"Mananalaththin","from goodness of mind"],["ஆகும்",1,"Aakum","comes about"],["மறுமைமற்",1,"Marumaimar","next world/afterlife bliss; moreover (expletive)"],["றஃதும்",1,"Raqdhum","that (one); also/too"],["இனநலத்தின்",2,"Inanalaththin","from goodness of company"],["ஏமாப்",2,"Emaap","protection/strength"],["புடைத்து",2,"Putaiththu","it has/possesses"]]},{"n":460,"l":["நல்லினத்தி னூங்குந் த