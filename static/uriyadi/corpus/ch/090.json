{"n":90,"kurals":[{"n":891,"l":["ஆற்றுவார் ஆற்றல் இகழாமை போற்றுவார்","போற்றலுள் எல்லாம் தலை."],"w":[["ஆற்றுவார்",1,"Aatruvaar","those who accomplish"],["ஆற்றல்",1,"Aatral","ability (obj.)"],["இகழாமை",1,"Ikazhaamai","not despising"],["போற்றுவார்",1,"Potruvaar","those who guard"],["போற்றலுள்",2,"Potralul","of safeguards; among"],["எல்லாம்",2,"Ellaam","all"],["தலை",2,"Thalai","foremost"]]},{"n":892,"l":["பெரியாரைப் பேணாது ஒழுகிற் பெரியாரால்","பேரா இடும்பை தரும்."],"w":[["பெரியாரைப்",1,"Periyaaraip","the great (obj.)"],["பேணாது",1,"Penaadhu","without honoring"],["ஒழுகிற்",1,"Ozhukir","if one behaves"],["பெரியாரால்",1,"Periyaaraal","by the great"],["பேரா",2,"Peraa","unremovable"],["இடும்பை",2,"Itumpai","suffering"],["தரும்",2,"Tharum","gives"]]},{"n":893,"l":["கெடல்வேண்டின் கேளாது செய்க அடல்வேண்டின்","ஆற்று பவர்கண் இழுக்கு."],"w":[["கெடல்வேண்டின்",1,"Ketalventin","ruin; if one wants"],["கேளாது",1,"Kelaadhu","without heeding"],["செய்க",1,"Seyka","let (one) do"],["அடல்வேண்டின்",1,"Atalventin","destroying; if one wants"],["ஆற்று",2,"Aatru","(who) accomplish"],["பவர்கண்",2,"Pavarkan","in those who; at/in"],["இழுக்கு",2,"Izhukku","offence/fault"]]},{"n":894,"l":["கூற்றத்தைக் கையால் விளித்தற்றால் ஆற்றுவார்க்கு","ஆற்றாதார் இன்னா செயல்."],"w":[["கூற்றத்தைக்",1,"Kootraththaik","Death/Yama (obj.)"],["கையால்",1,"Kaiyaal","with the hand"],["விளித்தற்றால்",1,"Viliththatraal","calling/beckoning; like / as (comparison)"],["ஆற்றுவார்க்கு",1,"Aatruvaarkku","to the mighty"],["ஆற்றாதார்",2,"Aatraadhaar","the weak (subj.)"],["இன்னா",2,"Innaa","harm/evil"],["செயல்",2,"Seyal","doing"]]},{"n":895,"l":["யாண்டுச்சென்று யாண்டும் உளராகார் வெந்துப்பின்","வேந்து செறப்பட் டவர்."],"w":[["யாண்டுச்சென்று",1,"","where (to); having gone"],["யாண்டும்",1,"","anywhere; even (all)"],["உளராகார்",1,"","will not survive"],["வெந்துப்பின்",1,"","of fierce strength (வெம்மையான வலிமை)"],["வேந்து",2,"","(by the) king — வேந்தால் (3-ஆம் வேற்றுமைத்தொகை)"],["செறப்பட்",2,"","being angered"],["டவர்",2,"","those who (were angered)"]]},{"n":896,"l":["எரியால் சுடப்படினும் உய்வுண்டாம் உய்யார்","பெரியார்ப் பிழைத்தொழுகு வார்."],"w":[["எரியால்",1,"Eriyaal","by fire"],["சுடப்படினும்",1,"Sutappatinum","even if burned; even"],["உய்வுண்டாம்",1,"Uyvuntaam","escape; there is"],["உய்யார்",1,"Uyyaar","will not escape"],["பெரியார்ப்",2,"Periyaarp","the great (செயப்படுபொருள், ஐ உருபு மறை)"],["பிழைத்தொழுகு",2,"Pizhaiththozhuku","having offended; those who live"],["வார்",2,"Vaar","those who (live)"]]},{"n":897,"l":["வகைமாண்ட வாழ்க்கையும் வான்பொருளும் என்னாம்","தகைமாண்ட தக்கார் செறின்."],"w":[["வகைமாண்ட",1,"Vakaimaanta","in kind/variety; excelling"],["வாழ்க்கையும்",1,"Vaazhkkaiyum","life; and"],["வான்பொருளும்",1,"Vaanporulum","great wealth; and"],["என்னாம்",1,"Ennaam","what; will be / what use"],["தகைமாண்ட",2,"Thakaimaanta","in worth; excelling"],["தக்கார்",2,"Thakkaar","the worthy ones"],["செறின்",2,"Serin","if (they) are angered"]]},{"n":898,"l":["குன்றன்னார் குன்ற மதிப்பின் குடியொடு","நின்றன்னார் மாய்வர் நிலத்து."],"w":[["குன்றன்னார்",1,"Kundrannaar","hill; those like"],["குன்ற",1,"Kundra","to be belittled"],["மதிப்பின்",1,"Madhippin","if (one) reckons"],["குடியொடு",1,"Kutiyotu","with the family"],["நின்றன்னார்",2,"Nindrannaar","standing firm; those who seem"],["மாய்வர்",2,"Maaivar","will perish"],["நிலத்து",2,"Nilaththu","on earth"]]},{"n":899,"l":["ஏந்திய கொள்கையார் சீறின் இடைமுரிந்து","வேந்தனும் வேந்து கெடும்."],"w":[["ஏந்திய",1,"Endhiya","elevated/upheld"],["கொள்கையார்",1,"Kolkaiyaar","those of (high) principle"],["சீறின்",1,"Seerin","if (they) rage"],["இடைமுரிந்து",1,"Itaimurindhu","midway; being broken"],["வேந்தனும்",2,"Vendhanum","the king; even"],["வேந்து",2,"Vendhu","kingship/throne (எழுவாய்)"],["கெடும்",2,"Ketum","will perish"]]},{"n":900,"l":["இறந்தமைந்த சார்புடையர் ஆயினும் உய்யார்","சிறந்தமைந்த சீரார் செறின்."],"w":[["இறந்தமைந்த",1,"Irandhamaindha","exceedingly; well-furnished"],["சார்புடையர்",1,"Saarputaiyar","supports; (they) possess"],["ஆயினும்",1,"Aayinum","even though"],["உய்யார்",1,"Uyyaar","will not escape"],["சிறந்தமைந்த",2,"Sirandhamaindha","excellently; well-endowed"],["சீரார்",2,"Seeraar","those of merit"],["செறின்",2,"Serin","if (they) are angered"]]}]}