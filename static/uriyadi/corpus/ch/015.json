{"n":15,"kurals":[{"n":141,"l":["பிறன்பொருளாள் பெட்டொழுகும் பேதைமை ஞாலத்து","அறம்பொருள் கண்டார்கண் இல்."],"w":[["பிறன்பொருளாள்",1,"Piranporulaal","another man (possessive); she who is (his) property = wife"],["பெட்டொழுகும்",1,"Pettozhukum","having desired; that behaves/conducts (qualifying பேதைமை)"],["பேதைமை",1,"Pedhaimai","folly/ignorance"],["ஞாலத்து",1,"Gnaalaththu","in the world"],["அறம்பொருள்",2,"Aramporul","virtue; wealth"],["கண்டார்கண்",2,"Kantaarkan","those who discerned; in/among (locative urupu)"],["இல்",2,"Il","is not (negation)"]]},{"n":142,"l":["அறன்கடை நின்றாருள் எல்லாம் பிறன்கடை","நின்றாரின் பேதையார் இல்."],"w":[["அறன்கடை",1,"Arankatai","from virtue; lowest place/end"],["நின்றாருள்",1,"Nindraarul","those who stood; among (locative)"],["எல்லாம்",1,"Ellaam","all"],["பிறன்கடை",1,"Pirankatai","another man's; doorway/threshold"],["நின்றாரின்",2,"Nindraarin","than those who stood (comparison); than (comparative urupu)"],["பேதையார்",2,"Pedhaiyaar","fools"],["இல்",2,"Il","are none (negation)"]]},{"n":143,"l":["விளிந்தாரின் வேறல்லர் மன்ற தெளிந்தாரில்","தீமை புரிந்தொழுகு வார்."],"w":[["விளிந்தாரின்",1,"","than those who died (comparison); than (comparative urupu)"],["வேறல்லர்",1,"","different/separate; are not"],["மன்ற",1,"","certainly (assertive particle)"],["தெளிந்தாரில்",1,"","of those who trusted; house/home (of)"],["தீமை",2,"","evil/wrong"],["புரிந்தொழுகு",2,"",""],["வார்",2,"","those who (live so)"]]},{"n":144,"l":["எனைத்துணையர் ஆயினும் என்னாம் தினைத்துணையும்","தேரான் பிறனில் புகல்."],"w":[["எனைத்துணையர்",1,"Enaiththunaiyar","how much/of what measure; they who are of (such) measure"],["ஆயினும்",1,"Aayinum","even though (they) be; even (concessive um)"],["என்னாம்",1,"Ennaam","what; will become/avail"],["தினைத்துணையும்",1,"Thinaiththunaiyum","even a millet's measure; even (intensive um)"],["தேரான்",2,"Theraan","without (his) examining"],["பிறனில்",2,"Piranil","another man's; house/wife (of another)"],["புகல்",2,"Pukal","entering/resorting"]]},{"n":145,"l":["எளிதென இல்லிறப்பான் எய்துமெஞ் ஞான்றும்","விளியாது நிற்கும் பழி."],"w":[["எளிதென",1,"Elidhena","(it is) easy; thinking that"],["இல்லிறப்பான்",1,"Illirappaan","(another's) house/wife; he who transgresses into"],["எய்துமெஞ்",1,"Eydhumenj","(he) attains/gets; what(ever) (in எஞ்ஞான்றும்)"],["ஞான்றும்",1,"Gnaandrum","time/day; always (எஞ்ஞான்றும் = ever)"],["விளியாது",2,"Viliyaadhu","without perishing"],["நிற்கும்",2,"Nirkum","that stands/remains (qualifying பழி)"],["பழி",2,"Pazhi","blame/disgrace"]]},{"n":146,"l":["பகைபாவம் அச்சம் பழியென நான்கும்","இகவாவாம் இல்லிறப்பான் கண்."],"w":[["பகைபாவம்",1,"Pakaipaavam","enmity; sin"],["அச்சம்",1,"Achcham","fear"],["பழியென",1,"Pazhiyena","disgrace; thus (naming)"],["நான்கும்",1,"Naankum","the four; all (the four) (எண்ணும்மை)"],["இகவாவாம்",2,"Ikavaavaam","do not depart/leave"],["இல்லிறப்பான்",2,"Illirappaan","(another's) house/wife; he who transgresses into"],["கண்",2,"Kan","in/at (locative urupu)"]]},{"n":147,"l":["அறனியலான் இல்வாழ்வான் என்பான் பிறனியலாள்","பெண்மை நயவா தவன்."],"w":[["அறனியலான்",1,"Araniyalaan","of virtue / virtue's; he who lives by (virtue's) nature"],["இல்வாழ்வான்",1,"Ilvaazhvaan","in household; he who lives (householder)"],["என்பான்",1,"Enpaan","is (so) called"],["பிறனியலாள்",1,"Piraniyalaal","another man's; she who belongs to (another) = wife"],["பெண்மை",2,"Penmai","womanhood/femininity"],["நயவா",2,"Nayavaa","who desires not (qualifying தவன்)"],["தவன்",2,"Thavan","he (that one)"]]},{"n":148,"l":["பிறன்மனை நோக்காத பேராண்மை சான்றோர்க்கு","அறனொன்றோ ஆன்ற வொழுக்கு."],"w":[["பிறன்மனை",1,"Piranmanai","another man's; house/wife"],["நோக்காத",1,"Nokkaadha","that looks not at (qualifying பேராண்மை)"],["பேராண்மை",1,"Peraanmai","great; manliness"],["சான்றோர்க்கு",1,"Saandrorkku","for the noble/wise; to/for (dative urupu)"],["அறனொன்றோ",2,"Aranondro","virtue; one (only); (is it) only? (interrogative ō)"],["ஆன்ற",2,"Aandra","abundant/full (qualifying ஒழுக்கு)"],["வொழுக்கு",2,"Vozhukku","(good) conduct"]]},{"n":149,"l":["நலக்குரியார் யாரெனின் நாமநீர் வைப்பின்","பிறர்க்குரியாள் தோள்தோயா தார்."],"w":[["நலக்குரியார்",1,"Nalakkuriyaar","for good/benefit; those who are entitled (to)"],["யாரெனின்",1,"Yaarenin","who; if (one) asks"],["நாமநீர்",1,"Naamaneer","fearful/dread; water (sea)"],["வைப்பின்",1,"Vaippin","in the (sea-girt) world/region; (euphonic connective)"],["பிறர்க்குரியாள்",2,"Pirarkkuriyaal","to others; she who belongs (to another) = wife"],["தோள்தோயா",2,"Tholdhoyaa","shoulder/embrace; who touch not (qualifying தார்)"],["தார்",2,"Thaar","those who (do not touch)"]]},{"n":150,"l":["அறன்வரையான் அல்ல செயினும் பிறன்வரையாள்","பெண்மை நயவாமை நன்று."],"w":[["அறன்வரையான்",1,"Aranvaraiyaan","virtue; (he) keeps not to (virtue)"],["அல்ல",1,"Alla","things that are not (virtuous) = evils"],["செயினும்",1,"Seyinum","even if (he) does; even (concessive um)"],["பிறன்வரையாள்",1,"Piranvaraiyaal","another man's; she within (another's) bounds = wife"],["பெண்மை",2,"Penmai","womanhood"],["நயவாமை",2,"Nayavaamai","not desiring (the act of)"],["நன்று",2,"Nandru","is good"]]}]}