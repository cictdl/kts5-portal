{"n":60,"kurals":[{"n":591,"l":["உடையர் எனப்படுவது ஊக்கம் அஃதில்லார்","உடையது உடையரோ மற்று."],"w":[["உடையர்",1,"Utaiyar","they possess"],["எனப்படுவது",1,"Enappatuvadhu","what is said to be"],["ஊக்கம்",1,"Ookkam","energy, drive"],["அஃதில்லார்",1,"Aqdhillaar","that; those without (it)"],["உடையது",2,"Utaiyadhu","what is possessed"],["உடையரோ",2,"Utaiyaro","do they possess; interrogative"],["மற்று",2,"Matru","else, moreover"]]},{"n":592,"l":["உள்ளம் உடைமை உடைமை பொருளுடைமை","நில்லாது நீங்கி விடும்."],"w":[["உள்ளம்",1,"Ullam","mind, resolve"],["உடைமை",1,"Utaimai","possession"],["உடைமை",1,"Utaimai","(true) possession"],["பொருளுடைமை",1,"Porulutaimai","wealth; possession of"],["நில்லாது",2,"Nillaadhu","not staying"],["நீங்கி",2,"Neengi","departing"],["விடும்",2,"Vitum","will (depart)"]]},{"n":593,"l":["ஆக்கம் இழந்தேமென்று அல்லாவார் ஊக்கம்","ஒருவந்தம் கைத்துடை யார்."],"w":[["ஆக்கம்",1,"Aakkam","wealth, gain"],["இழந்தேமென்று",1,"Izhandhemendru","we have lost; saying that"],["அல்லாவார்",1,"Allaavaar","will not be troubled / will not become (otherwise)"],["ஊக்கம்",1,"Ookkam","energy"],["ஒருவந்தம்",2,"Oruvandham","firmly, certainly"],["கைத்துடை",2,"Kaiththutai","possession in hand; possessing"],["யார்",2,"Yaar","are those who (possess)"]]},{"n":594,"l":["ஆக்கம் அதர்வினாய்ச் செல்லும் அசைவிலா","ஊக்க முடையா னுழை."],"w":[["ஆக்கம்",1,"Aakkam","fortune, wealth"],["அதர்வினாய்ச்",1,"Adharvinaaich","the path/way; asking, enquiring"],["செல்லும்",1,"Chellum","will go"],["அசைவிலா",1,"Asaivilaa","weariness, slackness; without"],["ஊக்க",2,"Ookka","energy (of)"],["முடையா",2,"Mutaiyaa","the one who possesses"],["னுழை",2,"Nuzhai","near, at the place of"]]},{"n":595,"l":["வெள்ளத் தனைய மலர்நீட்டம் மாந்தர்தம்","உள்ளத் தனையது உயர்வு."],"w":[["வெள்ளத்",1,"Vellath","of/in the water (to the depth of)"],["தனைய",1,"Thanaiya","are of that measure"],["மலர்நீட்டம்",1,"Malarneettam","flower; length, height (of stalk)"],["மாந்தர்தம்",1,"Maandhardham","people; their"],["உள்ளத்",2,"Ullath","of/in the mind (to the measure of)"],["தனையது",2,"Thanaiyadhu","is of that measure"],["உயர்வு",2,"Uyarvu","elevation, greatness"]]},{"n":596,"l":["உள்ளுவ தெல்லாம் உயர்வுள்ளல் மற்றது","தள்ளினுந் தள்ளாமை நீர்த்து."],"w":[["உள்ளுவ",1,"Ulluva","that which is thought"],["தெல்லாம்",1,"Thellaam","all"],["உயர்வுள்ளல்",1,"Uyarvullal","greatness; thinking of"],["மற்றது",1,"Matradhu","moreover; that (aim)"],["தள்ளினுந்",2,"Thallinun","even if (it) fails/slips; even"],["தள்ளாமை",2,"Thallaamai","not abandoning"],["நீர்த்து",2,"Neerththu","is of the nature/quality"]]},{"n":597,"l":["சிதைவிடத்து ஒல்கார் உரவோர் புதையம்பிற்","பட்டுப்பா டூன்றுங் களிறு."],"w":[["சிதைவிடத்து",1,"Sidhaivitaththu","ruin, destruction; at the time/place of"],["ஒல்கார்",1,"Olkaar","do not weaken"],["உரவோர்",1,"Uravor","the strong/firm-minded"],["புதையம்பிற்",1,"Pudhaiyampir","covering-much (mass of); by arrows"],["பட்டுப்பா",2,"Pattuppaa","having been struck; greatness, dignity"],["டூன்றுங்",2,"Toondrung","that firmly upholds"],["களிறு",2,"Kaliru","(male) elephant"]]},{"n":598,"l":["உள்ளம் இலாதவர் எய்தார் உலகத்து","வள்ளியம் என்னுஞ் செருக்கு."],"w":[["உள்ளம்",1,"Ullam","energy of mind"],["இலாதவர்",1,"Ilaadhavar","those who lack"],["எய்தார்",1,"Eydhaar","do not attain"],["உலகத்து",1,"Ulakaththu","in the world"],["வள்ளியம்",2,"Valliyam","we are liberal/generous"],["என்னுஞ்",2,"Ennunj","called, that says"],["செருக்கு",2,"Cherukku","pride, exultation"]]},{"n":599,"l":["பரியது கூர்ங்கோட்டது ஆயினும் யானை","வெரூஉம் புலிதாக் குறின்."],"w":[["பரியது",1,"Pariyadhu","is large-bodied"],["கூர்ங்கோட்டது",1,"Koorngottadhu","sharp; has tusks"],["ஆயினும்",1,"Aayinum","even though it is; even"],["யானை",1,"Yaanai","elephant"],["வெரூஉம்",2,"Veruum","(it) fears, trembles"],["புலிதாக்",2,"Pulidhaak","tiger; attacking"],["குறின்",2,"Kurin","if (it) intends/draws near"]]},{"n":600,"l":["உரமொருவற்கு உள்ள வெறுக்கைஅஃ தில்லார்","மரம்மக்க ளாதலே வேறு."],"w":[["உரமொருவற்கு",1,"Uramoruvarku","strength, firmness; for a person"],["உள்ள",1,"Ulla","that is (within), mental"],["வெறுக்கைஅஃ",1,"Verukkaiaq","abundance, wealth (of resolve); that"],["தில்லார்",1,"Thillaar","those without (it)"],["மரம்மக்க",2,"Marammakka","tree; people, humans"],["ளாதலே",2,"Laadhale","being, becoming; (emphatic)"],["வேறு",2,"Veru","difference, distinction"]]}]}