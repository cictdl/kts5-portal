{"n":1,"kurals":[{"n":1,"l":["அகர முதல எழுத்தெல்லாம் ஆதி","பகவன் முதற்றே உலகு."],"w":[["அகர",1,"Akara","the letter A"],["முதல",1,"Mudhala","being the first/basis (of)"],["எழுத்தெல்லாம்",1,"Ezhuththellaam","letters; all"],["ஆதி",1,"Aadhi","primordial (Lord)"],["பகவன்",2,"Pakavan","the Lord / God"],["முதற்றே",2,"Mudhatre","has (Him) as the first/origin; emphatic/assertive particle"],["உலகு",2,"Ulaku","the world"]]},{"n":2,"l":["கற்றதனால் ஆய பயனென்கொல் வாலறிவன்","நற்றாள் தொழாஅர் எனின்."],"w":[["கற்றதனால்",1,"Katradhanaal","that which was learned; instrumental -by"],["ஆய",1,"Aaya","that resulted/accrued"],["பயனென்கொல்",1,"Payanenkol","benefit, profit; what; interrogative/doubt particle"],["வாலறிவன்",1,"Vaalarivan","pure, clear; the wise one (God)"],["நற்றாள்",2,"Natraal","good; feet"],["தொழாஅர்",2,"Thozhaaar","those who do not worship"],["எனின்",2,"Enin","if (it be so)"]]},{"n":3,"l":["மலர்மிசை ஏகினான் மாணடி சேர்ந்தார்","நிலமிசை நீடுவாழ் வார்."],"w":[["மலர்மிசை",1,"Malarmisai","on the flower; upon, on (locative postposition)"],["ஏகினான்",1,"Ekinaan","he who went/abides"],["மாணடி",1,"Maanati","excellent, glorious; feet"],["சேர்ந்தார்",1,"Serndhaar","those who reached/clung"],["நிலமிசை",2,"Nilamisai","on the earth; upon, on (locative postposition)"],["நீடுவாழ்",2,"Neetuvaazh","long, enduring; live (long)"],["வார்",2,"Vaar","(they) will live"]]},{"n":4,"l":["வேண்டுதல் வேண்டாமை இலானடி சேர்ந்தார்க்கு","யாண்டும் இடும்பை இல."],"w":[["வேண்டுதல்",1,"Ventudhal","desiring, liking"],["வேண்டாமை",1,"Ventaamai","not-desiring, loathing"],["இலானடி",1,"Ilaanati","he who is without; feet"],["சேர்ந்தார்க்கு",1,"Serndhaarkku","for those who reached; dative -to/for"],["யாண்டும்",2,"Yaantum","(at) any time/place; even, always (inclusive/முற்றும்மை)"],["இடும்பை",2,"Itumpai","suffering, sorrow"],["இல",2,"Ila","(they) are not / none"]]},{"n":5,"l":["இருள்சேர் இருவினையும் சேரா இறைவன்","பொருள்சேர் புகழ்புரிந்தார் மாட்டு."],"w":[["இருள்சேர்",1,"Irulser","darkness (ignorance); associated/born of"],["இருவினையும்",1,"Iruvinaiyum","two; deeds (karma); both (inclusive)"],["சேரா",1,"Seraa","do not join/attach"],["இறைவன்",1,"Iraivan","the Lord (God's)"],["பொருள்சேர்",2,"Porulser","truth, real meaning; joined-with, true"],["புகழ்புரிந்தார்",2,"Pukazhpurindhaar","praise, fame; those who cherished/desired"],["மாட்டு",2,"Maattu","in, with regard to (locative)"]]},{"n":6,"l":["பொறிவாயில் ஐந்தவித்தான் பொய்தீர் ஒழுக்க","நெறிநின்றார் நீடுவாழ் வார்."],"w":[["பொறிவாயில்",1,"Porivaayil","sense-organs; gateway, channel"],["ஐந்தவித்தான்",1,"Aindhaviththaan","the five (desires); he who extinguished"],["பொய்தீர்",1,"Poidheer","falsehood; free-of, devoid-of"],["ஒழுக்க",1,"Ozhukka","conduct, virtue"],["நெறிநின்றார்",2,"Nerinindraar","in the path; those who stood/stayed"],["நீடுவாழ்",2,"Neetuvaazh","long, enduring; live (long)"],["வார்",2,"Vaar","(they) will live"]]},{"n":7,"l":["தனக்குவமை இல்லாதான் தாள்சேர்ந்தார்க் கல்லால்","மனக்கவலை மாற்றல் அரிது."],"w":[["தனக்குவமை",1,"Thanakkuvamai","to himself; comparison, equal"],["இல்லாதான்",1,"Illaadhaan","he who has none (peerless)"],["தாள்சேர்ந்தார்க்",1,"Thaalserndhaark","feet; for those who reached"],["கல்லால்",1,"Kallaal","except, other than"],["மனக்கவலை",2,"Manakkavalai","of/in the mind; anxiety, worry"],["மாற்றல்",2,"Maatral","removing, dispelling"],["அரிது",2,"Aridhu","is difficult/impossible"]]},{"n":8,"l":["அறவாழி அந்தணன் தாள்சேர்ந்தார்க் கல்லால்","பிறவாழி நீந்தல் அரிது."],"w":[["அறவாழி",1,"Aravaazhi","virtue, dharma; sea, ocean"],["அந்தணன்",1,"Andhanan","the noble/sage (God)"],["தாள்சேர்ந்தார்க்",1,"Thaalserndhaark","feet; for those who reached"],["கல்லால்",1,"Kallaal","except, other than"],["பிறவாழி",2,"Piravaazhi","birth (cycle); sea (of births)"],["நீந்தல்",2,"Neendhal","swimming, crossing"],["அரிது",2,"Aridhu","is difficult/impossible"]]},{"n":9,"l":["கோளில் பொறியின் குணமிலவே எண்குணத்தான்","தாளை வணங்காத் தலை."],"w":[["கோளில்",1,"Kolil","grasping power; without (privative)"],["பொறியின்",1,"Poriyin","like the sense-organs; comparative -in (like)"],["குணமிலவே",1,"Kunamilave","quality, use; (they) are without quality; emphatic ஏ (தேற்றம்)"],["எண்குணத்தான்",1,"Enkunaththaan","eight; the Eight-Virtued One"],["தாளை",2,"Thaalai","the feet (obj.); accusative -ai"],["வணங்காத்",2,"Vanangaath","that does not bow"],["தலை",2,"Thalai","head(s)"]]},{"n":10,"l":["பிறவிப் பெருங்கடல் நீந்துவர் நீந்தார்","இறைவன் அடிசேரா தார்."],"w":[["பிறவிப்",1,"Piravip","birth (as)"],["பெருங்கடல்",1,"Perungatal","great, vast; sea, ocean"],["நீந்துவர்",1,"Neendhuvar","(they) will swim across"],["நீந்தார்",1,"Neendhaar","(they) will not swim"],["இறைவன்",2,"Iraivan","the Lord's"],["அடிசேரா",2,"Atiseraa","feet (obj.); who do not reach"],["தார்",2,"Thaar","those who do not (reach)"]]}]}