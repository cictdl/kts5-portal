{"n":114,"kurals":[{"n":1131,"l":["காமம் உழந்து வருந்தினார்க்கு ஏமம்","மடலல்லது இல்லை வலி."],"w":[["காமம்",1,"Kaamam","passion, lust"],["உழந்து",1,"Uzhandhu","having suffered"],["வருந்தினார்க்கு",1,"Varundhinaarkku","those who grieved; to/for (dative)"],["ஏமம்",1,"Emam","protection, safeguard"],["மடலல்லது",2,"Matalalladhu","palmyra-stem horse (madal); other than, except"],["இல்லை",2,"Illai","is not, there is none"],["வலி",2,"Vali","strength, powerful aid"]]},{"n":1132,"l":["நோனா உடம்பும் உயிரும் மடலேறும்","நாணினை நீக்கி நிறுத்து."],"w":[["நோனா",1,"Nonaa","that cannot endure"],["உடம்பும்",1,"Utampum","body; and (enumerative)"],["உயிரும்",1,"Uyirum","life, soul; and (enumerative)"],["மடலேறும்",1,"Matalerum","madal (palm-horse); will mount/ride"],["நாணினை",2,"Naaninai","modesty, shame (acc.); euphonic infix (saariyai)"],["நீக்கி",2,"Neekki","having removed"],["நிறுத்து",2,"Niruththu","having set aside / stopped"]]},{"n":1133,"l":["நாணொடு நல்லாண்மை பண்டுடையேன் இன்றுடையேன்","காமுற்றார் ஏறும் மடல்."],"w":[["நாணொடு",1,"Naanotu","with modesty; with (sociative)"],["நல்லாண்மை",1,"Nallaanmai","good; manliness"],["பண்டுடையேன்",1,"Pantutaiyen","formerly, of old; I possessed"],["இன்றுடையேன்",1,"Indrutaiyen","today, now; I possess"],["காமுற்றார்",2,"Kaamutraar","those filled with passion"],["ஏறும்",2,"Erum","that (they) mount"],["மடல்",2,"Matal","madal (palm-horse)"]]},{"n":1134,"l":["காமக் கடும்புனல் உய்க்குமே நாணொடு","நல்லாண்மை என்னும் புணை."],"w":[["காமக்",1,"Kaamak","of passion (attributive)"],["கடும்புனல்",1,"Katumpunal","fierce, swift; flood, water"],["உய்க்குமே",1,"Uykkume","sweeps/carries away"],["நாணொடு",1,"Naanotu","modesty (with); and / with (sociative)"],["நல்லாண்மை",2,"Nallaanmai","good; manliness, firmness"],["என்னும்",2,"Ennum","called, named (that is)"],["புணை",2,"Punai","raft, float"]]},{"n":1135,"l":["தொடலைக் குறுந்தொடி தந்தாள் மடலொடு","மாலை உழக்கும் துயர்."],"w":[["தொடலைக்",1,"Thotalaik","garland-like string"],["குறுந்தொடி",1,"Kurundhoti","small, short; she of s