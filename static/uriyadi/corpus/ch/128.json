{"n":128,"kurals":[{"n":1271,"l":["கரப்பினுங் கையிகந் தொல்லாநின் உண்கண்","உரைக்கல் உறுவதொன் றுண்டு."],"w":[["கரப்பினுங்",1,"Karappinung","though (you) hide; even/though (concessive)"],["கையிகந்",1,"Kaiyikan","hand (i.e. restraint/limit); passing beyond, transgressing"],["தொல்லாநின்",1,"Thollaanin","not consenting (to hide); your"],["உண்கண்",1,"Unkan","collyrium-painted eyes"],["உரைக்கல்",2,"Uraikkal","telling/uttering"],["உறுவதொன்",2,"Uruvadhon","that which is fit/about to (be told); one (thing)"],["றுண்டு",2,"Runtu","there is"]]},{"n":1272,"l":["கண்ணிறைந்த காரிகைக் காம்பேர்தோட் பேதைக்குப்","பெண்நிறைந்த நீர்மை பெரிது."],"w":[["கண்ணிறைந்த",1,"Kanniraindha","eye-filling (beauty)"],["காரிகைக்",1,"Kaarikaik","beauty/grace"],["காம்பேர்தோட்",1,"Kaamperdhot","bamboo stem; like/resembling (comparison); shoulder/arm"],["பேதைக்குப்",1,"Pedhaikkup","to the simple young woman"],["பெண்நிறைந்த",2,"Penniraindha","womanliness-filled"],["நீர்மை",2,"Neermai","nature/quality"],["பெரிது",2,"Peridhu","is great/abundant"]]},{"n":1273,"l":["மணியில் திகழ்தரு நூல்போல் மடந்தை","அணியில் திகழ்வதொன்று உண்டு."],"w":[["மணியில்",1,"Maniyil","in the gem/bead"],["திகழ்தரு",1,"Thikazhdharu","that shines through"],["நூல்போல்",1,"Noolpol","thread; like"],["மடந்தை",1,"Matandhai","the young woman('s)"],["அணியில்",2,"Aniyil","in (her) beauty/adornment"],["திகழ்வதொன்று",2,"Thikazhvadhondru","that which shines; one (thing)"],["உண்டு",2,"Untu","there is"]]},{"n":1274,"l":["முகைமொக்குள் உள்ளது நாற்றம்போல் பேதை","நகைமொக்குள் உள்ளதொன் றுண்டு."],"w":[["முகைமொக்குள்",1,"Mukaimokkul","within the flower-bud"],["உள்ளது",1,"Ulladhu","that which is (within)"],["நாற்றம்போல்",1,"Naatrampol","fragrance/scent; like"],["பேதை",1,"Pedhai","the simple woman('s)"],["நகைமொக்குள்",2,"Nakaimokkul","within the bud of (her) smile"],["உள்ளதொன்",2,"Ulladhon","that which is (within); one (thing)"],["றுண்டு",2,"Runtu","there is"]]},{"n":1275,"l":["செறிதொடி செய்திறந்த கள்ளம் உறுதுயர்","தீர்க்கும் மருந்தொன்று உடைத்து."],"w":[["செறிதொடி",1,"Seridhoti","she of close-set bangles"],["செய்திறந்த",1,"Seydhirandha","having done; that passed/transgressed"],["கள்ளம்",1,"Kallam","deception/secret hint"],["உறுதுயர்",1,"Urudhuyar","great/intense; (great) sorrow"],["தீர்க்கும்",2,"Theerkkum","that cures"],["மருந்தொன்று",2,"Marundhondru","medicine/cure; one (thing)"],["உடைத்து",2,"Utaiththu","possesses/has"]]},{"n":1276,"l":["பெரிதாற்றிப் பெட்பக் கலத்தல் அரிதாற்றி","அன்பின்மை சூழ்வ துடைத்து."],"w":[["பெரிதாற்றிப்",1,"Peridhaatrip","greatly/much; having borne/endured"],["பெட்பக்",1,"Petpak","so as to desire/delight"],["கலத்தல்",1,"Kalaththal","uniting/embracing"],["அரிதாற்றி",1,"Aridhaatri","the difficult (parting); having borne/endured"],["அன்பின்மை",2,"Anpinmai","lovelessness"],["சூழ்வ",2,"Soozhva","that which intends/plans"],["துடைத்து",2,"Thutaiththu","possesses/is"]]},{"n":1277,"l":["தண்ணந் துறைவன் தணந்தமை நம்மினும்","முன்னம் உணர்ந்த வளை."],"w":[["தண்ணந்",1,"Thannan","cool (and pleasant)"],["துறைவன்",1,"Thuraivan","lord of the (cool) shore"],["தணந்தமை",1,"Thanandhamai","the (act of) parting"],["நம்மினும்",1,"Namminum","than us; even"],["முன்னம்",2,"Munnam","beforehand/earlier"],["உணர்ந்த",2,"Unarndha","that knew/perceived"],["வளை",2,"Valai","bangles"]]},{"n":1278,"l":["நெருநற்றுச் சென்றார்எம் காதலர் யாமும்","எழுநாளேம் மேனி பசந்து."],"w":[["நெருநற்றுச்",1,"Nerunatruch","yesterday"],["சென்றார்எம்",1,"Chendraarem","(they) went/departed; our"],["காதலர்",1,"Kaadhalar","(my) lover"],["யாமும்",1,"Yaamum","we (I); also"],["எழுநாளேம்",2,"Ezhunaalem","seven; we have become (of) (seven) days"],["மேனி",2,"Meni","body/complexion"],["பசந்து",2,"Pasandhu","having turned sallow/pale"]]},{"n":1279,"l":["தொடிநோக்கி மென்தோளும் நோக்கி அடிநோக்கி","அஃதாண் டவள்செய் தது."],"w":[["தொடிநோக்கி",1,"Thotinokki","bangles; having looked at"],["மென்தோளும்",1,"Mendholum","soft shoulders/arms; also"],["நோக்கி",1,"Nokki","having looked"],["அடிநோக்கி",1,"Atinokki","feet; having looked"],["அஃதாண்",2,"Aqdhaan","that (thing); there/in that (place)"],["டவள்செய்",2,"Tavalsey","she; that (she) did"],["தது",2,"Thadhu","that (is it)"]]},{"n":1280,"l":["பெண்ணினால் பெண்மை உடைத்தென்ப கண்ணினால்","காமநோய் சொல்லி இரவு."],"w":[["பெண்ணினால்",1,"Penninaal","by/with womanhood"],["பெண்மை",1,"Penmai","womanliness"],["உடைத்தென்ப",1,"Utaiththenpa","possesses/has; (they) say"],["கண்ணினால்",1,"Kanninaal","with the eyes"],["காமநோய்",2,"Kaamanoi","the malady of love"],["சொல்லி",2,"Solli","having told/expressed"],["இரவு",2,"Iravu","begging/pleading"]]}]}