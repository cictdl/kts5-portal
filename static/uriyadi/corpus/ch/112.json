{"n":112,"kurals":[{"n":1111,"l":["நன்னீரை வாழி அனிச்சமே நின்னினும்","மென்னீரள் யாம்வீழ் பவள்."],"w":[["நன்னீரை",1,"Nanneerai","good/fine; softness/nature (acc.)"],["வாழி",1,"Vaazhi","may you live / hail"],["அனிச்சமே",1,"Anichchame","O anicha flower; vocative/emphatic particle"],["நின்னினும்",1,"Ninninum","than you; than (comparative); even (emphatic)"],["மென்னீரள்",2,"Menneeral",""],["யாம்வீழ்",2,"Yaamveezh",""],["பவள்",2,"Paval",""]]},{"n":1112,"l":["மலர்காணின் மையாத்தி நெஞ்சே இவள்கண்","பலர்காணும் பூவொக்கும் என்று."],"w":[["மலர்காணின்",1,"Malarkaanin","flower (obj.); if (you) see"],["மையாத்தி",1,"Maiyaaththi","you become dazed"],["நெஞ்சே",1,"Nenje","O heart/mind; vocative particle"],["இவள்கண்",1,"Ivalkan","her / this woman's; eyes"],["பலர்காணும்",2,"Palarkaanum","many people; that (many) see"],["பூவொக்கும்",2,"Poovokkum","flower (obj.); (that) resembles"],["என்று",2,"Endru","thus / saying"]]},{"n":1113,"l":["முறிமேனி முத்தம் முறுவல் வெறிநாற்றம்","வேலுண்கண் வேய்த்தோ ளவட்கு."],"w":[["முறிமேனி",1,"Murimeni","tender shoot; body/complexion"],["முத்தம்",1,"Muththam","pearl (= her teeth)"],["முறுவல்",1,"Muruval","smile/teeth"],["வெறிநாற்றம்",1,"Verinaatram","natural fragrance; smell/scent"],["வேலுண்கண்",2,"Velunkan","spear (= eye simile); (collyrium-)smeared; eyes"],["வேய்த்தோ",2,"Veyththo","bamboo (= shoulder simile); shoulder"],["ளவட்கு",2,"Lavatku","to her; to/for (dative)"]]},{"n":1114,"l":["காணின் குவளை கவிழ்ந்து நிலன்நோக்கும்","மாணிழை கண்ணொவ்வேம் என்று."],"w":[["காணின்",1,"Kaanin","if (they) see"],["குவளை",1,"Kuvalai","blue waterlily"],["கவிழ்ந்து",1,"Kavizhndhu","drooping / having bent down"],["நிலன்நோக்கும்",1,"Nilannokkum","ground (obj.); will look at"],["மாணிழை",2,"Maanizhai","excellent; the jewelled one (= the lady)"],["கண்ணொவ்வேம்",2,"Kannovvem","(her) eyes; we are not equal"],["என்று",2,"Endru","thus / saying"]]},{"n":1115,"l":["அனிச்சப்பூக் கால்களையாள் பெய்தாள் நுகப்பிற்கு","நல்ல படாஅ பறை."],"w":[["அனிச்சப்பூக்",1,"Anichchappook","anicha; flower (obj.)"],["கால்களையாள்",1,"Kaalkalaiyaal","stalk/stem (obj.); she does not remove"],["பெய்தாள்",1,"Peydhaal","she wore/placed"],["நுகப்பிற்கு",1,"Nukappirku","for (her) waist; to/for (dative)"],["நல்ல",2,"Nalla","good (ones)"],["படாஅ",2,"Pataaa","will not sound/occur"],["பறை",2,"Parai","drums (auspicious sounds)"]]},{"n":1116,"l":["மதியும் மடந்தை முகனும் அறியா","பதியின் கலங்கிய மீன்."],"w":[["மதியும்",1,"Madhiyum","moon; and (both)"],["மடந்தை",1,"Matandhai","the young woman('s)"],["முகனும்",1,"Mukanum","face; and (both)"],["அறியா",1,"Ariyaa","not knowing / unable to tell apart"],["பதியின்",2,"Padhiyin","from (their) place; from (ablative)"],["கலங்கிய",2,"Kalangiya","that got confused"],["மீன்",2,"Meen","stars"]]},{"n":1117,"l":["அறுவாய் நிறைந்த அவிர்மதிக்குப் போல","மறுவுண்டோ மாதர் முகத்து."],"w":[["அறுவாய்",1,"Aruvaai","waning/cleft (state)"],["நிறைந்த",1,"Niraindha","that became full"],["அவிர்மதிக்குப்",1,"Avirmadhikkup","shining; to the bright moon; to/for"],["போல",1,"Pola","like / as"],["மறுவுண்டோ",2,"Maruvunto","blemish/spot; is there; (question)"],["மாதர்",2,"Maadhar","the lady('s)"],["முகத்து",2,"Mukaththu","on the face"]]},{"n":1118,"l":["மாதர் முகம்போல் ஒளிவிட வல்லையேல்","காதலை வாழி மதி."],"w":[["மாதர்",1,"Maadhar","lady('s)"],["முகம்போல்",1,"Mukampol","face; like / as"],["ஒளிவிட",1,"Olivita","light (obj.); to emit/spread"],["வல்லையேல்",1,"Vallaiyel","(if) you are able; if (conditional)"],["காதலை",2,"Kaadhalai","love (obj.) / you shall be loved"],["வாழி",2,"Vaazhi","may you live / hail"],["மதி",2,"Madhi","O moon"]]},{"n":1119,"l":["மலரன்ன கண்ணாள் முகமொத்தி யாயின்","பலர்காணத் தோன்றல் மதி."],"w":[["மலரன்ன",1,"Malaranna","flower (simile); like / resembling"],["கண்ணாள்",1,"Kannaal","she who has (such) eyes"],["முகமொத்தி",1,"Mukamoththi","face (obj.); you resemble"],["யாயின்",1,"Yaayin","if (it) be (so)"],["பலர்காணத்",2,"Palarkaanath","many people; so that (many) see"],["தோன்றல்",2,"Thondral","do not appear"],["மதி",2,"Madhi","O moon"]]},{"n":1120,"l":["அனிச்சமும் அன்னத்தின் தூவியும் மாதர்","அடிக்கு நெருஞ்சிப் பழம்."],"w":[["அனிச்சமும்",1,"Anichchamum","anicha flower; and (both)"],["அன்னத்தின்",1,"Annaththin","swan's; (euphonic increment); of (genitive)"],["தூவியும்",1,"Thooviyum","feather/down; and (both)"],["மாதர்",1,"Maadhar","the lady('s)"],["அடிக்கு",2,"Atikku","for (her) feet; to/for (dative)"],["நெருஞ்சிப்",2,"Nerunjip","caltrop"],["பழம்",2,"Pazham","fruit (= caltrop thorn-fruit)"]]}]}