{"n":126,"kurals":[{"n":1251,"l":["காமக் கணிச்சி உடைக்கும் நிறையென்னும்","நாணுத்தாழ் வீழ்த்த கதவு."],"w":[["காமக்",1,"Kaamak","passion (as)"],["கணிச்சி",1,"Kanichchi","axe / pickaxe"],["உடைக்கும்",1,"Utaikkum","(it) breaks"],["நிறையென்னும்",1,"Niraiyennum","reserve / self-control; called / so named"],["நாணுத்தாழ்",2,"Naanuththaazh","modesty / shame; bolt / latch"],["வீழ்த்த",2,"Veezhththa","fitted / made to hold (the bolt)"],["கதவு",2,"Kadhavu","door"]]},{"n":1252,"l":["காமம் எனவொன்றோ கண்ணின்றென் நெஞ்சத்தை","யாமத்தும் ஆளும் தொழில்."],"w":[["காமம்",1,"Kaamam","passion / lust"],["எனவொன்றோ",1,"Enavondro","saying / called; one (a thing); (asai / emphatic)"],["கண்ணின்றென்",1,"Kannindren","without grace (no kaNNoottam); my"],["நெஞ்சத்தை",1,"Nenjaththai","the heart (acc.)"],["யாமத்தும்",2,"Yaamaththum","at midnight (locative); even"],["ஆளும்",2,"Aalum","(that) governs / commands"],["தொழில்",2,"Thozhil","(its) work / task"]]},{"n":1253,"l":["மறைப்பேன்மன் காமத்தை யானோ குறிப்பின்றித்","தும்மல்போல் தோன்றி விடும்."],"w":[["மறைப்பேன்மன்",1,"Maraippenman","I shall hide; (asai / ozhiyisai 'மன்')"],["காமத்தை",1,"Kaamaththai","the passion (acc.)"],["யானோ",1,"Yaano","I; (as for me)"],["குறிப்பின்றித்",1,"Kurippindrith","intention / sign; without"],["தும்மல்போல்",2,"Thummalpol","a sneeze; like (simile particle)"],["தோன்றி",2,"Thondri","appearing"],["விடும்",2,"Vitum","(it) will (appear)"]]},{"n":1254,"l":["நிறையுடையேன் என்பேன்மன் யானோஎன் காமம்","மறையிறந்து மன்று படும்."],"w":[["நிறையுடையேன்",1,"Niraiyutaiyen","reserve / self-restraint; I am one who has"],["என்பேன்மன்",1,"Enpenman","I would say; (asai / ozhiyisai, past-unfulfilled)"],["யானோஎன்",1,"Yaanoen","I; (as for me); my"],["காமம்",1,"Kaamam","passion / lust"],["மறையிறந்து",2,"Maraiyirandhu","concealment; exceeding / crossing"],["மன்று",2,"Mandru","the public assembly / open court"],["படும்",2,"Patum","(it) becomes public / falls open"]]},{"n":1255,"l":["செற்றார்பின் செல்லாப் பெருந்தகைமை காமநோய்","உற்றார் அறிவதொன்று அன்று."],"w":[["செற்றார்பின்",1,"Setraarpin","those who hated/spurned; behind / after"],["செல்லாப்",1,"Sellaap","(that) does not go"],["பெருந்தகைமை",1,"Perundhakaimai","great; dignity / nobility"],["காமநோய்",1,"Kaamanoi","passion / love-; affliction / sickness"],["உற்றார்",2,"Utraar","those who have suffered (it)"],["அறிவதொன்று",2,"Arivadhondru","that which (they) know; a thing / one"],["அன்று",2,"Andru","is not"]]},{"n":1256,"l":["செற்றவர் பின்சேறல் வேண்டி அளித்தரோ","எற்றென்னை உற்ற துயர்."],"w":[["செற்றவர்",1,"Setravar","those who spurned (me)"],["பின்சேறல்",1,"Pinseral","behind / after; going / following"],["வேண்டி",1,"Venti","desiring"],["அளித்தரோ",1,"Aliththaro","is pitiable / alas; (asai of pity/wonder)"],["எற்றென்னை",2,"Etrennai","of what nature?; me (acc.)"],["உற்ற",2,"Utra","(that) befell"],["துயர்",2,"Thuyar","grief / sorrow"]]},{"n":1257,"l":["நாணென ஒன்றோ அறியலம் காமத்தால்","பேணியார் பெட்ப செயின்."],"w":[["நாணென",1,"Naanena","modesty / shame; called / as"],["ஒன்றோ",1,"Ondro","one (a thing); (emphatic)"],["அறியலம்",1,"Ariyalam","we do not know"],["காமத்தால்",1,"Kaamaththaal","by/through passion"],["பேணியார்",2,"Peniyaar","those (we) cherished / the loved one"],["பெட்ப",2,"Petpa","things desired"],["செயின்",2,"Seyin","if (they) do"]]},{"n":1258,"l":["பன்மாயக் கள்வன் பணிமொழி அன்றோநம்","பெண்மை உடைக்கும் படை."],"w":[["பன்மாயக்",1,"Panmaayak","many; wile / deceit"],["கள்வன்",1,"Kalvan","thief (the deceiver-lover)"],["பணிமொழி",1,"Panimozhi","humble; words / speech"],["அன்றோநம்",1,"Andronam","is it not; (interrogative); our"],["பெண்மை",2,"Penmai","womanhood / our reserve"],["உடைக்கும்",2,"Utaikkum","(that) breaks / destroys"],["படை",2,"Patai","weapon"]]},{"n":1259,"l":["புலப்பல் எனச்சென்றேன் புல்லினேன் நெஞ்சம்","கலத்தல் உறுவது கண்டு."],"w":[["புலப்பல்",1,"Pulappal","I shall sulk / quarrel"],["எனச்சென்றேன்",1,"Enachchendren","thinking / saying; I went"],["புல்லினேன்",1,"Pullinen","I embraced"],["நெஞ்சம்",1,"Nenjam","the heart"],["கலத்தல்",2,"Kalaththal","uniting / joining"],["உறுவது",2,"Uruvadhu","(its) tending to / attaining"],["கண்டு",2,"Kantu","having seen"]]},{"n":1260,"l":["நிணந்தீயில் இட்டன்ன நெஞ்சினார்க்கு உண்டோ","புணர்ந்தூடி நிற்பேம் எனல்."],"w":[["நிணந்தீயில்",1,"Ninandheeyil","fat / tallow; in the fire"],["இட்டன்ன",1,"Ittanna","(that which was) cast / put; like / such as"],["நெஞ்சினார்க்கு",1,"Nenjinaarkku","for those with (such) a heart"],["உண்டோ",1,"Unto","is there / exists; (interrogative)"],["புணர்ந்தூடி",2,"Punarndhooti","having united; having sulked"],["நிற்பேம்",2,"Nirpem","we shall stand firm"],["எனல்",2,"Enal","the saying / claiming (so)"]]}]}