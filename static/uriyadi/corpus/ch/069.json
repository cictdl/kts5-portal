{"n":69,"kurals":[{"n":681,"l":["அன்புடைமை ஆன்ற குடிப்பிறத்தல் வேந்தவாம்","பண்புடைமை தூதுரைப்பான் பண்பு."],"w":[["அன்புடைமை",1,"Anputaimai","having love"],["ஆன்ற",1,"Aandra","noble, full (modifying குடிப்பிறத்தல்)"],["குடிப்பிறத்தல்",1,"Kutippiraththal","being of noble birth"],["வேந்தவாம்",1,"Vendhavaam","king; (which kings) desire"],["பண்புடைமை",2,"Panputaimai","having good qualities"],["தூதுரைப்பான்",2,"Thoodhuraippaan","embassy/message; one who delivers"],["பண்பு",2,"Panpu","the qualification"]]},{"n":682,"l":["அன்பறிவு ஆராய்ந்த சொல்வன்மை தூதுரைப்பார்க்கு","இன்றி யமையாத மூன்று."],"w":[["அன்பறிவு",1,"Anparivu","love; knowledge"],["ஆராய்ந்த",1,"Aaraaindha","well-examined (modifying சொல்வன்மை)"],["சொல்வன்மை",1,"Solvanmai","in speech; strength/eloquence"],["தூதுரைப்பார்க்கு",1,"Thoodhuraippaarkku","embassy/message; for those who deliver"],["இன்றி",2,"Indri","without (being)"],["யமையாத",2,"Yamaiyaadha","that do not subsist (without)"],["மூன்று",2,"Moondru","three"]]},{"n":683,"l":["நூலாருள் நூல்வல்லன் ஆகுதல் வேலாருள்","வென்றி வினையுரைப்பான் பண்பு."],"w":[["நூலாருள்",1,"Noolaarul","the learned; among"],["நூல்வல்லன்",1,"Noolvallan","in texts; one who is skilled"],["ஆகுதல்",1,"Aakudhal","becoming"],["வேலாருள்",1,"Velaarul","the spear-bearing (kings); among"],["வென்றி",2,"Vendri","victory(-giving)"],["வினையுரைப்பான்",2,"Vinaiyuraippaan","the (victorious) deed; one who delivers"],["பண்பு",2,"Panpu","the qualification"]]},{"n":684,"l":["அறிவுரு வாராய்ந்த கல்விஇம் மூன்றன்","செறிவுடையான் செல்க வினைக்கு."],"w":[["அறிவுரு",1,"Arivuru","intelligence; form/appearance"],["வாராய்ந்த",1,"Vaaraaindha","well-examined (modifying கல்வி)"],["கல்விஇம்",1,"Kalviim","learning; this/these"],["மூன்றன்",1,"Moondran","of these three"],["செறிவுடையான்",2,"Serivutaiyaan","one who has the fitness"],["செல்க",2,"Selka","let (him) go"],["வினைக்கு",2,"Vinaikku","for the task (of envoy)"]]},{"n":685,"l":["தொகச்சொல்லித் தூவாத நீக்கி நகச்சொல்லி","நன்றி பயப்பதாந் தூது."],"w":[["தொகச்சொல்லித்",1,"","so as to be concise; having spoken"],["தூவாத",1,"","displeasing/useless (things)"],["நீக்கி",1,"","having removed"],["நகச்சொல்லி",1,"","so as to delight/smile; having spoken"],["நன்றி",2,"","good/benefit"],["பயப்பதாந்",2,"","that which yields"],["தூது",2,"","(the) envoy"]]},{"n":686,"l":["கற்றுக்கண் அஞ்சான் செலச்சொல்லிக் காலத்தால்","தக்கது அறிவதாம் தூது."],"w":[["கற்றுக்கண்",1,"Katrukkan","having learnt; eye/(hostile) gaze"],["அஞ்சான்",1,"Anjaan","he who fears not"],["செலச்சொல்லிக்",1,"Selachchollik","so as to reach (the mind); having spoken"],["காலத்தால்",1,"Kaalaththaal","by/according to time"],["தக்கது",2,"Thakkadhu","that which is fitting"],["அறிவதாம்",2,"Arivadhaam","that which knows/discerns"],["தூது",2,"Thoodhu","(the) envoy"]]},{"n":687,"l":["கடனறிந்து காலங் கருதி இடனறிந்து","எண்ணி உரைப்பான் தலை."],"w":[["கடனறிந்து",1,"Katanarindhu","duty; having known"],["காலங்",1,"Kaalang","time"],["கருதி",1,"Karudhi","having considered"],["இடனறிந்து",1,"Itanarindhu","place; having known"],["எண்ணி",2,"Enni","having thought out"],["உரைப்பான்",2,"Uraippaan","one who delivers"],["தலை",2,"Thalai","the foremost/best"]]},{"n":688,"l":["தூய்மை துணைமை துணிவுடைமை இம்மூன்றின்","வாய்மை வழியுரைப்பான் பண்பு."],"w":[["தூய்மை",1,"Thooimai","purity"],["துணைமை",1,"Thunaimai","having support"],["துணிவுடைமை",1,"Thunivutaimai","having boldness"],["இம்மூன்றின்",1,"Immoondrin","these; of the three"],["வாய்மை",2,"Vaaimai","being attained/truthfulness"],["வழியுரைப்பான்",2,"Vazhiyuraippaan","in the (right) way; one who delivers"],["பண்பு",2,"Panpu","the qualification"]]},{"n":689,"l":["விடுமாற்றம் வேந்தர்க்கு உரைப்பான் வடுமாற்றம்","வாய்சோரா வன்க ணவன்."],"w":[["விடுமாற்றம்",1,"Vitumaatram","sent (word); word/reply"],["வேந்தர்க்கு",1,"Vendharkku","to the kings"],["உரைப்பான்",1,"Uraippaan","one who delivers"],["வடுமாற்றம்",1,"Vatumaatram","fault/blemish; faulty word"],["வாய்சோரா",2,"Vaaisoraa",""],["வன்க",2,"Vanka",""],["ணவன்",2,"Navan",""]]},{"n":690,"l":["இறுதி பயப்பினும் எஞ்சாது இறைவற்கு","உறுதி பயப்பதாம் தூது."],"w":[["இறுதி",1,"Irudhi","ruin/end"],["பயப்பினும்",1,"Payappinum","even if it yields; even (concessive)"],["எஞ்சாது",1,"Enjaadhu","without flinching/falling short"],["இறைவற்கு",1,"Iraivarku","for the king/lord"],["உறுதி",2,"Urudhi","good/security"],["பயப்பதாம்",2,"Payappadhaam","that which yields"],["தூது",2,"Thoodhu","(the) envoy"]]}]}