{"n":118,"kurals":[{"n":1171,"l":["கண்தாம் கலுழ்வ தெவன்கொலோ தண்டாநோய்","தாம்காட்ட யாம்கண் டது."],"w":[["கண்தாம்",1,"Kandhaam","eyes; they (the eyes) themselves"],["கலுழ்வ",1,"Kaluzhva","the weeping (that which weeps)"],["தெவன்கொலோ",1,"Thevankolo","why / what; doubt particle; interrogative/pity ō"],["தண்டாநோய்",1,"Thantaanoi","unceasing (that does not abate); malady (of love)"],["தாம்காட்ட",2,"Thaamkaatta","they (the eyes); having shown / when (they) showed"],["யாம்கண்",2,"Yaamkan","we / I; saw (split across சீர்: கண்+டது)"],["டது",2,"Tadhu","that which (we) saw"]]},{"n":1172,"l":["தெரிந்துணரா நோக்கிய உண்கண் பரிந்துணராப்","பைதல் உழப்பது எவன்?"],"w":[["தெரிந்துணரா",1,"Therindhunaraa","having discerned; without realizing"],["நோக்கிய",1,"Nokkiya","that gazed"],["உண்கண்",1,"Unkan","collyrium-darkened (kohl); eyes"],["பரிந்துணராப்",1,"Parindhunaraap","having pitied/grieved; without realizing"],["பைதல்",2,"Paidhal","grief / sorrow"],["உழப்பது",2,"Uzhappadhu","the suffering (act)"],["எவன்",2,"Evan","why / for what"]]},{"n":1173,"l":["கதுமெனத் தாநோக்கித் தாமே கலுழும்","இதுநகத் தக்க துடைத்து."],"w":[["கதுமெனத்",1,"Kadhumenath","suddenly / swiftly"],["தாநோக்கித்",1,"Thaanokkith","they themselves (eyes); having gazed"],["தாமே",1,"Thaame","they themselves; emphatic ē (themselves alone)"],["கலுழும்",1,"Kaluzhum","that weep"],["இதுநகத்",2,"Ithunakath","this; to laugh at"],["தக்க",2,"Thakka","fit/worthy (to)"],["துடைத்து",2,"Thutaiththu","(it) has/possesses the nature of"]]},{"n":1174,"l":["பெயலாற்றா நீருலந்த உண்கண் உயலாற்றா","உய்வில்நோய் என்கண் நிறுத்து."],"w":[["பெயலாற்றா",1,"Peyalaatraa","raining (of tears); unable (to do)"],["நீருலந்த",1,"Neerulandha","water/tears; that dried up"],["உண்கண்",1,"Unkan","collyrium-darkened (kohl); eyes"],["உயலாற்றா",1,"Uyalaatraa","surviving/escaping; unable (to escape)"],["உய்வில்நோய்",2,"Uyvilnoi","deliverance/escape; without (no escape); malady (inescapable)"],["என்கண்",2,"Enkan","my / in me; in/at (locative உருபு)"],["நிறுத்து",2,"Niruththu","having established/placed"]]},{"n":1175,"l":["படலாற்றா பைதல் உழக்கும் கடலாற்றாக்","காமநோய் செய்தஎன் கண்."],"w":[["படலாற்றா",1,"Patalaatraa","sleeping/closing (of eyes); unable (to sleep)"],["பைதல்",1,"Paidhal","grief / sorrow"],["உழக்கும்",1,"Uzhakkum","that suffer/toss"],["கடலாற்றாக்",1,"Katalaatraak","sea; that (the sea) cannot bear"],["காமநோய்",2,"Kaamanoi","love/lust; malady of love"],["செய்தஎன்",2,"Seydhaen","that caused/made; my"],["கண்",2,"Kan","eyes"]]},{"n":1176,"l":["ஓஒ இனிதே எமக்கிந்நோய் செய்தகண்","தாஅம் இதற்பட் டது."],"w":[["ஓஒ",1,"Oo","Oh! (exclamation of pity; இசைநிறை அளபெடை)"],["இனிதே",1,"Inidhe","(is) sweet/good; emphatic ē"],["எமக்கிந்நோய்",1,"Emakkinnoi","to us/me; this malady"],["செய்தகண்",1,"Seydhakan","that caused; eyes"],["தாஅம்",2,"Thaaam","they themselves (இசைநிறை அளபெடை)"],["இதற்பட்",2,"Itharpat","into this (state); fell/underwent (split: பட்+டது)"],["டது",2,"Tadhu","that (it) suffered"]]},{"n":1177,"l":["உழந்துழந் துள்நீர் அறுக விழைந்திழைந்து","வேண்டி அவர்க்கண்ட கண்."],"w":[["உழந்துழந்",1,"Uzhandhuzhan","suffering (and); suffering (repeated)"],["துள்நீர்",1,"Thulneer","inner / within; (tear-)water"],["அறுக",1,"Aruka","let (it) dry up/cease"],["விழைந்திழைந்து",1,"Vizhaindhizhaindhu","desiring; melting/yielding"],["வேண்டி",2,"Venti","longing/wishing"],["அவர்க்கண்ட",2,"Avarkkanta","him; that saw"],["கண்",2,"Kan","eyes"]]},{"n":1178,"l":["பேணாது பெட்டார் உளர்மன்னோ மற்றவர்க்","காணாது அமைவில கண்."],"w":[["பேணாது",1,"Penaadhu","without cherishing"],["பெட்டார்",1,"Pettaar","one who desired/loved"],["உளர்மன்னோ",1,"Ularmanno","(he) exists/is; ozhiyisai mann (regret/contrast); ō (pity/doubt)"],["மற்றவர்க்",1,"Matravark","moreover / but; him"],["காணாது",2,"Kaanaadhu","not seeing"],["அமைவில",2,"Amaivila","rest/repose; (they) are without (have no rest)"],["கண்",2,"Kan","eyes"]]},{"n":1179,"l":["வாராக்கால் துஞ்சா வரின்துஞ்சா ஆயிடை","ஆரஞர் உற்றன கண்."],"w":[["வாராக்கால்",1,"Vaaraakkaal","not coming; when / time (if-not)"],["துஞ்சா",1,"Thunjaa","(they) do not sleep (negative finite)"],["வரின்துஞ்சா",1,"Varindhunjaa","if (he) comes; (they) do not sleep (negative finite)"],["ஆயிடை",1,"Aayitai","in between / meanwhile"],["ஆரஞர்",2,"Aaragnar","intense / hard-to-bear; great affliction/grief"],["உற்றன",2,"Utrana","(they) attained/suffered"],["கண்",2,"Kan","eyes"]]},{"n":1180,"l":["மறைபெறல் ஊரார்க்கு அரிதன்றால் எம்போல்","அறைபறை கண்ணார் அகத்து."],"w":[["மறைபெறல்",1,"Maraiperal","secret; obtaining/knowing"],["ஊரார்க்கு",1,"Ooraarkku","to the townsfolk"],["அரிதன்றால்",1,"Aridhandraal","difficult; is not (negation); āl (asai particle)"],["எம்போல்",1,"Empol","us/our; like (uvama urubu)"],["அறைபறை",2,"Araiparai","(that is) beaten; drum"],["கண்ணார்",2,"Kannaar","those who have (such) eyes"],["அகத்து",2,"Akaththu","within / in the heart of"]]}]}