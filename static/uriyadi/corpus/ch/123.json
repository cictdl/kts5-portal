{"n":123,"kurals":[{"n":1221,"l":["மாலையோ அல்லை மணந்தார் உயிருண்ணும்","வேலைநீ வாழி பொழுது."],"w":[["மாலையோ",1,"Maalaiyo","evening; interrogative/doubt particle"],["அல்லை",1,"Allai","you are not"],["மணந்தார்",1,"Manandhaar","those who wedded (women)"],["உயிருண்ணும்",1,"Uyirunnum","life (acc.); that devours"],["வேலைநீ",2,"Velainee","spear (metaphor for eventide); you"],["வாழி",2,"Vaazhi","may you live (benedictive)"],["பொழுது",2,"Pozhudhu","O time/eventide (vocative)"]]},{"n":1222,"l":["புன்கண்ணை வாழி மருள்மாலை எம்கேள்போல்","வன்கண்ண தோநின் துணை."],"w":[["புன்கண்ணை",1,"Punkannai","you are dim-eyed / in wretched state"],["வாழி",1,"Vaazhi","may you live (benedictive)"],["மருள்மாலை",1,"Marulmaalai","bewildering/dim; O dim eventide"],["எம்கேள்போல்",1,"Emkelpol","our; kin/beloved (our lover); like (comparison)"],["வன்கண்ண",2,"Vankanna","is it cruel-eyed/pitiless"],["தோநின்",2,"Thonin","interrogative particle; your"],["துணை",2,"Thunai","mate/companion"]]},{"n":1223,"l":["பனிஅரும்பிப் பைதல்கொள் மாலை துனிஅரும்பித்","துன்பம் வளர வரும்."],"w":[["பனிஅரும்பிப்",1,"Paniarumpip","dew/cold; having budded/appeared"],["பைதல்கொள்",1,"Paidhalkol","pallor/sorrow; that takes on (pallor)"],["மாலை",1,"Maalai","eventide"],["துனிஅரும்பித்",1,"Thuniarumpith","loathing/distaste; having budded"],["துன்பம்",2,"Thunpam","sorrow"],["வளர",2,"Valara","so as to grow"],["வரும்",2,"Varum","comes"]]},{"n":1224,"l":["காதலர் இல்வழி மாலை கொலைக்களத்து","ஏதிலர் போல வரும்."],"w":[["காதலர்",1,"Kaadhalar","the lover (honorific singular)"],["இல்வழி",1,"Ilvazhi","absent/not being; the time/occasion when"],["மாலை",1,"Maalai","eventide"],["கொலைக்களத்து",1,"Kolaikkalaththu","killing; in the field/place"],["ஏதிலர்",2,"Edhilar","strangers/foes"],["போல",2,"Pola","like"],["வரும்",2,"Varum","comes"]]},{"n":1225,"l":["காலைக்குச் செய்தநன்று என்கொல் எவன்கொல்யான்","மாலைக்குச் செய்த பகை?"],"w":[["காலைக்குச்",1,"Kaalaikkuch","for the morning"],["செய்தநன்று",1,"Cheydhanandru","that (I) did; good/benefit"],["என்கொல்",1,"Enkol","wh