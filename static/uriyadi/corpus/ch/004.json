{"n":4,"kurals":[{"n":31,"l":["சிறப்புஈனும் செல்வமும் ஈனும் அறத்தினூஉங்கு","ஆக்கம் எவனோ உயிர்க்கு."],"w":[["சிறப்புஈனும்",1,"","distinction, glory (object); yields, gives (habitual/future)"],["செல்வமும்",1,"","wealth (object); also, and (inclusive)"],["ஈனும்",1,"","yields, gives (habitual/future)"],["அறத்தினூஉங்கு",1,"","than virtue (comparative); more than, beyond (comparative particle)"],["ஆக்கம்",2,"","gain, prosperity, good"],["எவனோ",2,"","what (interrogative); interrogative particle"],["உயிர்க்கு",2,"","for life / for the living being"]]},{"n":32,"l":["அறத்தினூஉங்கு ஆக்கமும் இல்லை அதனை","மறத்தலின் ஊங்கில்லை கேடு."],"w":[["அறத்தினூஉங்கு",1,"Araththinooungu","than virtue (comparative); more than, beyond"],["ஆக்கமும்",1,"Aakkamum","gain, good; even, also (emphatic)"],["இல்லை",1,"Illai","is not, does not exist"],["அதனை",1,"Adhanai","it (i.e. virtue), as object"],["மறத்தலின்",2,"Maraththalin","than forgetting (it)"],["ஊங்கில்லை",2,"Oongillai","more than, beyond; is not, does not exist"],["கேடு",2,"Ketu","ruin, harm"]]},{"n":33,"l":["ஒல்லும் வகையான் அறவினை ஓவாதே","செல்லும்வாய் எல்லாஞ் செயல்."],"w":[["ஒல்லும்",1,"Ollum","that is possible / feasible (qualifying வகை)"],["வகையான்",1,"Vakaiyaan","by the manner/means"],["அறவினை",1,"Aravinai","virtuous deed (object of செயல்)"],["ஓவாதே",1,"Ovaadhe","without ceasing, ceaselessly; emphatic particle"],["செல்லும்வாய்",2,"Sellumvaai","that one goes (to), qualifying வாய்; place, occasion"],["எல்லாஞ்",2,"Ellaanj","all, every"],["செயல்",2,"Cheyal","let (one) do / one should do (வேண்டல்)"]]},{"n":34,"l":["மனத்துக்கண் மாசிலன் ஆதல் அனைத்தறன்","ஆகுல நீர பிற."],"w":[["மனத்துக்கண்",1,"","in the mind"],["மாசிலன்",1,"","blemish, fault; he who is without (faultless one)"],["ஆதல்",1,"","becoming, to be"],["அனைத்தறன்",1,"","that much, only that; virtue"],["ஆகுல",2,"","(things that are) clamour/show"],["நீர",2,"","are of (such) nature"],["பிற",2,"","the others, rest"]]},{"n":35,"l":["அழுக்காறு அவாவெகுளி இன்னாச்சொல் நான்கும்","இழுக்கா இயன்றது அறம்."],"w":[["அழுக்காறு",1,"Azhukkaaru","envy"],["அவாவெகுளி",1,"Avaavekuli","desire, lust; anger"],["இன்னாச்சொல்",1,"Innaachchol","harsh, painful; word, speech"],["நான்கும்",1,"Naankum","four; all (the four)"],["இழுக்கா",2,"Izhukkaa","without lapsing into / not letting (them) in"],["இயன்றது",2,"Iyandradhu","that which is carried out / practised"],["அறம்",2,"Aram","virtue"]]},{"n":36,"l":["அன்றறிவாம் என்னாது அறஞ்செய்க மற்றது","பொன்றுங்கால் பொன்றாத் துணை."],"w":[["அன்றறிவாம்",1,"Andrarivaam","that day, later; we shall know / find out"],["என்னாது",1,"Ennaadhu","without saying (so)"],["அறஞ்செய்க",1,"Aranjeyka","virtue (as object); let (one) do! / one should do"],["மற்றது",1,"Matradhu","moreover, and (connective); it (that virtue)"],["பொன்றுங்கால்",2,"Pondrungaal","(at the time) one perishes; time, when"],["பொன்றாத்",2,"Pondraath","imperishable, undying (qualifying துணை)"],["துணை",2,"Thunai","aid, support, companion"]]},{"n":37,"l":["அறத்தாறு இதுவென வேண்டா சிவிகை","பொறுத்தானோடு ஊர்ந்தான் இடை."],"w":[["அறத்தாறு",1,"Araththaaru","the way/fruit of virtue"],["இதுவென",1,"Ithuvena","this; saying (that), as"],["வேண்டா",1,"Ventaa","is not needed, do not require"],["சிவிகை",1,"Sivikai","palanquin, litter (object)"],["பொறுத்தானோடு",2,"Poruththaanotu","the one who bore (the palanquin); with (3rd case உடன்)"],["ஊர்ந்தான்",2,"Oorndhaan","the one who rode"],["இடை",2,"Itai","between, in the midst of"]]},{"n":38,"l":["வீழ்நாள் படாஅமை நன்றாற்றின் அஃதொருவன்","வாழ்நாள் வழியடைக்கும் கல்."],"w":[["வீழ்நாள்",1,"Veezhnaal","wasted/fallen day"],["படாஅமை",1,"Pataaamai","so that (a day) does not occur / not letting fall"],["நன்றாற்றின்",1,"Nandraatrin","good (as object); if (one) performs (conditional)"],["அஃதொருவன்",1,"Aqdhoruvan","that (deed); a person's"],["வாழ்நாள்",2,"Vaazhnaal","lifespan, days of life"],["வழியடைக்கும்",2,"Vazhiyataikkum","way, path (as object); that closes (the path), qualifying கல்"],["கல்",2,"Kal","stone"]]},{"n":39,"l":["அறத்தான் வருவதே இன்பம் மற்றெல்லாம்","புறத்த புகழும் இல."],"w":[["அறத்தான்",1,"","by/through virtue"],["வருவதே",1,"","that which comes; alone, only (emphatic restriction)"],["இன்பம்",1,"","joy, pleasure"],["மற்றெல்லாம்",1,"","other, the rest (connective); all (the rest)"],["புறத்த",2,"","are external/outside (it)"],["புகழும்",2,"","fame, glory; also (even fame)"],["இல",2,"","(they) are not"]]},{"n":40,"l":["செயற்பால தோரும் அறனே ஒருவற்கு","உயற்பால தோரும் பழி."],"w":[["செயற்பால",1,"Seyarpaala","things fit to be done"],["தோரும்",1,"Thorum","each, every (distributive)"],["அறனே",1,"Arane","virtue; alone, indeed (restrictive)"],["ஒருவற்கு",1,"Oruvarku","for a person"],["உயற்பால",2,"Uyarpaala","things fit to be avoided/escaped from"],["தோரும்",2,"Thorum","each, every (distributive)"],["பழி",2,"Pazhi","blame, blameworthy act"]]}]}