{"n":100,"kurals":[{"n":991,"l":["எண்பதத்தால் எய்தல் எளிதென்ப யார்மாட்டும்","பண்புடைமை என்னும் வழக்கு."],"w":[["எண்பதத்தால்",1,"Enpadhaththaal","by easy accessibility / easy approachability"],["எய்தல்",1,"Eydhal","attaining"],["எளிதென்ப",1,"Elidhenpa","easy; they say"],["யார்மாட்டும்",1,"Yaarmaattum","whoever; in/towards; even (inclusive)"],["பண்புடைமை",2,"Panputaimai","courtesy/having good qualities"],["என்னும்",2,"Ennum","called/named"],["வழக்கு",2,"Vazhakku","the (good) way/usage"]]},{"n":992,"l":["அன்புடைமை ஆன்ற குடிப்பிறத்தல் இவ்விரண்டும்","பண்புடைமை என்னும் வழக்கு."],"w":[["அன்புடைமை",1,"Anputaimai","being loving"],["ஆன்ற",1,"Aandra","abundant/full (noble)"],["குடிப்பிறத்தல்",1,"Kutippiraththal","in (good) family; being born"],["இவ்விரண்டும்",1,"Ivvirantum","these; two; both (and)"],["பண்புடைமை",2,"Panputaimai","courtesy"],["என்னும்",2,"Ennum","called"],["வழக்கு",2,"Vazhakku","the good way"]]},{"n":993,"l":["உறுப்பொத்தல் மக்களொப்பு அன்றால் வெறுத்தக்க","பண்பொத்தல் ஒப்பதாம் ஒப்பு."],"w":[["உறுப்பொத்தல்",1,"Uruppoththal","in/by limbs; being alike"],["மக்களொப்பு",1,"Makkaloppu","with humankind; likeness"],["அன்றால்",1,"Andraal","is not; (expletive)"],["வெறுத்தக்க",1,"Veruththakka","worthy/fitting (to be valued)"],["பண்பொத்தல்",2,"Panpoththal","by character; being alike"],["ஒப்பதாம்",2,"Oppadhaam","that which is likeness; is/becomes"],["ஒப்பு",2,"Oppu","(true) likeness"]]},{"n":994,"l":["நயனொடு நன்றி புரிந்த பயனுடையார்","பண்புபா ராட்டும் உலகு."],"w":[["நயனொடு",1,"Nayanotu","justice/equity; with (sociative)"],["நன்றி",1,"Nandri","goodness/benefit"],["புரிந்த",1,"Purindha","having done/performed"],["பயனுடையார்",1,"Payanutaiyaar","the useful/beneficent ones"],["பண்புபா",2,"Panpupaa","(their) character"],["ராட்டும்",2,"Raattum","praises/applauds"],["உலகு",2,"Ulaku","the world (its people)"]]},{"n":995,"l":["நகையுள்ளும் இன்னா திகழ்ச்சி பகையுள்ளும்","பண்புள பாடறிவார் மாட்டு."],"w":[["நகையுள்ளும்",1,"Nakaiyullum","in jest/laughter; within; even"],["இன்னா",1,"Innaa","painful/harmful (things)"],["திகழ்ச்சி",1,"Thikazhchchi","contempt/derision"],["பகையுள்ளும்",1,"Pakaiyullum","in enmity; within; even"],["பண்புள",2,"Panpula","good qualities; exist/are present"],["பாடறிவார்",2,"Paatarivaar","(others') nature/worth; those who know"],["மாட்டு",2,"Maattu","in/with regard to"]]},{"n":996,"l":["பண்புடையார்ப் பட்டுண்டு உலகம் அதுஇன்றேல்","மண்புக்கு மாய்வது மன்."],"w":[["பண்புடையார்ப்",1,"Panputaiyaarp","in/on the courteous"],["பட்டுண்டு",1,"Pattuntu","being attached/resting (on); exists"],["உலகம்",1,"Ulakam","the world"],["அதுஇன்றேல்",1,"Adhuindrel","that; if (it) is not"],["மண்புக்கு",2,"Manpukku","into the earth; having entered"],["மாய்வது",2,"Maaivadhu","(it) would perish"],["மன்",2,"Man","(expletive/emphatic)"]]},{"n":997,"l":["அரம்போலும் கூர்மைய ரேனும் மரம்போல்வர்","மக்கட்பண்பு இல்லா தவர்."],"w":[["அரம்போலும்",1,"Arampolum","file (tool); resembling"],["கூர்மைய",1,"Koormaiya","sharpness (of intellect)"],["ரேனும்",1,"Renum","even though (they) are"],["மரம்போல்வர்",1,"Marampolvar","tree; they are like"],["மக்கட்பண்பு",2,"Makkatpanpu","for/of humanity; the (proper) quality"],["இல்லா",2,"Illaa","not having"],["தவர்",2,"Thavar","those (who) [are without]"]]},{"n":998,"l":["நண்பாற்றார் ஆகி நயமில செய்வார்க்கும்","பண்பாற்றார் ஆதல் கடை."],"w":[["நண்பாற்றார்",1,"Nanpaatraar","friendship; (those who) do-not/cannot maintain"],["ஆகி",1,"Aaki","having become/being"],["நயமில",1,"Nayamila","good/agreeableness; (things) lacking good"],["செய்வார்க்கும்",1,"Seyvaarkkum","to those who do; even"],["பண்பாற்றார்",2,"Panpaatraar","courtesy; (those who) do-not/cannot maintain"],["ஆதல்",2,"Aadhal","becoming/being"],["கடை",2,"Katai","lowest/base (disgrace)"]]},{"n":999,"l":["நகல்வல்லர் அல்லார்க்கு மாயிரு ஞாலம்","பகலும்பாற் பட்டன்று இருள்."],"w":[["நகல்வல்லர்",1,"Nakalvallar","smiling/mingling joyfully; (those) able/skilled"],["அல்லார்க்கு",1,"Allaarkku","those who are not; to/for (dative)"],["மாயிரு",1,"Maayiru","great/vast; large/vast"],["ஞாலம்",1,"Gnaalam","the earth/world"],["பகலும்பாற்",2,"Pakalumpaar","daytime; even; in the state/side of"],["பட்டன்று",2,"Pattandru","has fallen into/become"],["இருள்",2,"Irul","darkness"]]},{"n":1000,"l":["பண்பிலான் பெற்ற பெருஞ்செல்வம் நன்பால்","கலந்தீமை யால்திரிந் தற்று."],"w":[["பண்பிலான்",1,"Panpilaan","the man without good qualities"],["பெற்ற",1,"Petra","(that he) obtained"],["பெருஞ்செல்வம்",1,"Perunjelvam","great/large; wealth"],["நன்பால்",1,"Nanpaal","good; milk"],["கலந்தீமை",2,"Kalandheemai","vessel/pot; badness/defect"],["யால்திரிந்",2,"Yaaldhirin","by/through (instrumental); having spoilt/changed"],["தற்று",2,"Thatru","is like that / as if"]]}]}