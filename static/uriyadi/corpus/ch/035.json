{"n":35,"kurals":[{"n":341,"l":["யாதனின் யாதனின் நீங்கியான் நோதல்","அதனின் அதனின் இலன்."],"w":[["யாதனின்",1,"Yaadhanin","from what (interrog.)"],["யாதனின்",1,"Yaadhanin","from what (repeated)"],["நீங்கியான்",1,"Neengiyaan","he who has parted/freed himself"],["நோதல்",1,"Nodhal","suffering, pain"],["அதனின்",2,"Adhanin","from that"],["அதனின்",2,"Adhanin","from that (repeated)"],["இலன்",2,"Ilan","he is without / does not suffer"]]},{"n":342,"l":["வேண்டின்உண் டாகத் துறக்க துறந்தபின்","ஈண்டுஇயற் பால பல."],"w":[["வேண்டின்உண்",1,"","if (one) desires (conditional); there is / exists (உண்டு)"],["டாகத்",1,"","so as to be / become"],["துறக்க",1,"","let (one) renounce"],["துறந்தபின்",1,"","having renounced; after"],["ஈண்டுஇயற்",2,"","here, in this world; by nature / proper"],["பால",2,"","things that are attainable/befitting"],["பல",2,"","many"]]},{"n":343,"l":["அடல்வேண்டும் ஐந்தன் புலத்தை விடல்வேண்டும்","வேண்டிய வெல்லாம் ஒருங்கு."],"w":[["அடல்வேண்டும்",1,"Atalventum","subduing, conquering; is necessary"],["ஐந்தன்",1,"Aindhan","of the five (senses)"],["புலத்தை",1,"Pulaththai","the sense-field (object)"],["விடல்வேண்டும்",1,"Vitalventum","giving up, renouncing; is necessary"],["வேண்டிய",2,"Ventiya","(those) desired"],["வெல்லாம்",2,"Vellaam","all (of them)"],["ஒருங்கு",2,"Orungu","together, at once"]]},{"n":344,"l":["இயல்பாகும் நோன்பிற்கொன்று இன்மை உடைமை","மயலாகும் மற்றும் பெயர்த்து."],"w":[["இயல்பாகும்",1,"Iyalpaakum","nature, proper character; becomes / is"],["நோன்பிற்கொன்று",1,"Nonpirkondru","for the vow/penance; one (thing)"],["இன்மை",1,"Inmai","not-having, absence"],["உடைமை",1,"Utaimai","having, possession"],["மயலாகும்",2,"Mayalaakum","delusion; becomes / will be"],["மற்றும்",2,"Matrum","again, moreover"],["பெயர்த்து",2,"Peyarththu","anew, again (having turned)"]]},{"n":345,"l":["மற்றும் தொடர்ப்பாடு எவன்கொல் பிறப்பறுக்கல்","உற்றார்க்கு உடம்பும் மிகை."],"w":[["மற்றும்",1,"Matrum","besides, further"],["தொடர்ப்பாடு",1,"Thotarppaatu","attachment, connection"],["எவன்கொல்",1,"Evankol","why / what (interrog.); doubt/query particle"],["பிறப்பறுக்கல்",1,"Pirapparukkal","birth (obj., உருபு மறை); cutting off, severing"],["உற்றார்க்கு",2,"Utraarkku","to those who undertake (to be rid of birth)"],["உடம்பும்",2,"Utampum","body; even (சிறப்பு உம்மை)"],["மிகை",2,"Mikai","excess, surplus"]]},{"n":346,"l":["யான்எனது என்னும் செருக்குஅறுப்பான் வானோர்க்கு","உயர்ந்த உலகம் புகும்."],"w":[["யான்எனது",1,"","I; mine"],["என்னும்",1,"","called, saying (which says)"],["செருக்குஅறுப்பான்",1,"","pride, arrogance (obj., உருபு மறை); he who severs"],["வானோர்க்கு",1,"","to/for the celestials"],["உயர்ந்த",2,"","exalted, lofty"],["உலகம்",2,"","the world/realm (obj., உருபு மறை)"],["புகும்",2,"","(he) will enter/attain"]]},{"n":347,"l":["பற்றி விடாஅ இடும்பைகள் பற்றினைப்","பற்றி விடாஅ தவர்க்கு."],"w":[["பற்றி",1,"Patri","having seized"],["விடாஅ",1,"Vitaaa","who do not let go (விடாஅத-)"],["இடும்பைகள்",1,"Itumpaikal","sorrows, miseries"],["பற்றினைப்",1,"Patrinaip","the attachment (obj.)"],["பற்றி",2,"Patri","having seized"],["விடாஅ",2,"Vitaaa","who do not let go (விடாஅத-)"],["தவர்க்கு",2,"Thavarkku",""]]},{"n":348,"l":["தலைப்பட்டார் தீரத் துறந்தார் மயங்கி","வலைப்பட்டார் மற்றை யவர்."],"w":[["தலைப்பட்டார்",1,"Thalaippattaar","those who attained (the goal)"],["தீரத்",1,"Theerath","completely, so as to be rid"],["துறந்தார்",1,"Thurandhaar","those who renounced"],["மயங்கி",1,"Mayangi","being deluded"],["வலைப்பட்டார்",2,"Valaippattaar","those who fell into the net"],["மற்றை",2,"Matrai","the other"],["யவர்",2,"Yavar","those (other persons = அவர்)"]]},{"n":349,"l":["பற்றற்ற கண்ணே பிறப்பறுக்கும் மற்று","நிலையாமை காணப் படும்."],"w":[["பற்றற்ற",1,"Patratra","attachment; from which (attachment) is gone"],["கண்ணே",1,"Kanne","at/in (locative உருபு); emphatic ஏ (only when)"],["பிறப்பறுக்கும்",1,"Pirapparukkum","birth (obj., உருபு மறை); (it) cuts off/severs"],["மற்று",1,"Matru","else, otherwise (connective)"],["நிலையாமை",2,"Nilaiyaamai","impermanence"],["காணப்",2,"Kaanap","so as to be seen"],["படும்",2,"Patum","(it) will be (seen)"]]},{"n":350,"l":["பற்றுக பற்றற்றான் பற்றினை அப்பற்றைப்","பற்றுக பற்று விடற்கு."],"w":[["பற்றுக",1,"Patruka","do cling / hold on"],["பற்றற்றான்",1,"Patratraan","the one without attachment (God) — whose பற்று"],["பற்றினை",1,"Patrinai","the attachment/bond (obj.)"],["அப்பற்றைப்",1,"Appatraip","that (demonstrative சுட்டு); that attachment (obj.)"],["பற்றுக",2,"Patruka","do cling / hold on"],["பற்று",2,"Patru","attachment (obj., உருபு மறை)"],["விடற்கு",2,"Vitarku","for the giving-up"]]}]}