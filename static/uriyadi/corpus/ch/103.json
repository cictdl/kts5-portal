{"n":103,"kurals":[{"n":1021,"l":["கருமம் செயஒருவன் கைதூவேன் என்னும்","பெருமையின் பீடுடையது இல்."],"w":[["கருமம்",1,"Karumam","deed, duty (the deed to be done)"],["செயஒருவன்",1,"Seyaoruvan","to do (செய்தற்பொருட்டு, infinitive of purpose); a man, one"],["கைதூவேன்",1,"Kaidhooven","I will not slacken/withdraw the hand (கைவிடேன்)"],["என்னும்",1,"Ennum","saying / that which says (என்னும் பெருமை)"],["பெருமையின்",2,"Perumaiyin","than the greatness (of)"],["பீடுடையது",2,"Peetutaiyadhu","loftiness, eminence; that which possesses"],["இல்",2,"Il","is not, none"]]},{"n":1022,"l":["ஆள்வினையும் ஆன்ற அறிவும் எனஇரண்டின்","நீள்வினையால் நீளும் குடி."],"w":[["ஆள்வினையும்",1,"Aalvinaiyum","ardent effort, endeavour (ஆளும் வினை); and (enumerative)"],["ஆன்ற",1,"Aandra","full, abundant, ripe (ஆன்ற அறிவு)"],["அறிவும்",1,"Arivum","wisdom; and (enumerative)"],["எனஇரண்டின்",1,"Enairantin","saying, called; of the two"],["நீள்வினையால்",2,"Neelvinaiyaal","by ceaseless action (நீளும் வினை)"],["நீளும்",2,"Neelum","will rise, grow long"],["குடி",2,"Kuti","family, lineage"]]},{"n":1023,"l":["குடிசெய்வல் என்னும் ஒருவற்குத் தெய்வம்","மடிதற்றுத் தான்முந் துறும்."],"w":[["குடிசெய்வல்",1,"Kutiseyval","family, lineage; I will raise/do (செய்வேன்)"],["என்னும்",1,"Ennum","saying / who says"],["ஒருவற்குத்",1,"Oruvarkuth","for the one (who)"],["தெய்வம்",1,"Theyvam","God, fate, deity"],["மடிதற்றுத்",2,"Matidhatruth","fold of cloth, garment-end; having girt/tucked tight (கட்டிக்கொண்டு)"],["தான்முந்",2,"Thaanmun","itself (refers to தெய்வம்); (part of முந்துறும்) will come forward, precede"],["துறும்",2,"Thurum","will come forward, precede (with முந்-)"]]},{"n":1024,"l":["சூழாமல் தானே முடிவெய்தும் தம்குடியைத்","தாழாது உஞற்று பவர்க்கு."],"w":[["சூழாமல்",1,"Soozhaamal","without planning/scheming"],["தானே",1,"Thaane","itself (the deed); (emphatic) by itself"],["முடிவெய்தும்",1,"Mutiveydhum","completion, end; will attain/reach"],["தம்குடியைத்",1,"Thamkutiyaith","their own; the family (acc.)"],["தாழாது",2,"Thaazhaadhu","without delay"],["உஞற்று",2,"Ugnatru","striving, exerting (முதனிலை of உஞற்றுபவர்)"],["பவர்க்கு",2,"Pavarkku","for those who (do)"]]},{"n":1025,"l":["குற்றம் இலனாய்க் குடிசெய்து வாழ்வானைச்","சுற்றமாச் சுற்றும் உலகு."],"w":[["குற்றம்",1,"Kutram","fault, blame"],["இலனாய்க்",1,"Ilanaaik","being one without (fault) — குற்றம் இல்லாதவனாய்"],["குடிசெய்து",1,"Kutiseydhu","family; having done/raised"],["வாழ்வானைச்",1,"Vaazhvaanaich","him who lives"],["சுற்றமாச்",2,"Chutramaach","as kinsfolk (சுற்றமாக)"],["சுற்றும்",2,"Chutrum","surrounds, gathers around"],["உலகு",2,"Ulaku","the world, people of the world"]]},{"n":1026,"l":["நல்லாண்மை என்பது ஒருவற்குத் தான்பிறந்த","இல்லாண்மை ஆக்கிக் கொளல்."],"w":[["நல்லாண்மை",1,"Nallaanmai","good; manliness, capability"],["என்பது",1,"Enpadhu","that which is called"],["ஒருவற்குத்",1,"Oruvarkuth","for a man"],["தான்பிறந்த",1,"Thaanpirandha","he himself; in which (he) was born (பிறந்த இல்)"],["இல்லாண்மை",2,"Illaanmai","house, home (lineage); rule/mastery (of the house)"],["ஆக்கிக்",2,"Aakkik","having made"],["கொளல்",2,"Kolal","the taking/acquiring (for oneself)"]]},{"n":1027,"l":["அமரகத்து வன்கண்ணர் போலத் தமரகத்தும்","ஆற்றுவார் மேற்றே பொறை."],"w":[["அமரகத்து",1,"Amarakaththu","in the battlefield (அமரின்கண்)"],["வன்கண்ணர்",1,"Vankannar","the dauntless/fearless ones"],["போலத்",1,"Polath","like, as (உவம உருபு)"],["தமரகத்தும்",1,"Thamarakaththum","among one's own kin (தமரின்கண்); also (even among)"],["ஆற்றுவார்",2,"Aatruvaar","those who are able / who bear"],["மேற்றே",2,"Metre","is upon (rests on) — மேலது; (emphatic/assertive)"],["பொறை",2,"Porai","the burden, endurance"]]},{"n":1028,"l":["குடிசெய்வார்க் கில்லை பருவம் மடிசெய்து","மானங் கருதக் கெடும்."],"w":[["குடிசெய்வார்க்",1,"Kutiseyvaark","family; for those who raise (the family)"],["கில்லை",1,"Killai","there is not"],["பருவம்",1,"Paruvam","season, fixed time"],["மடிசெய்து",1,"Matiseydhu","sloth, idleness; having indulged in (sloth)"],["மானங்",2,"Maanang","honour, pride"],["கருதக்",2,"Karudhak","(if/when) one thinks of"],["கெடும்",2,"Ketum","(it) will perish/be ruined"]]},{"n":1029,"l":["இடும்பைக்கே கொள்கலம் கொல்லோ குடும்பத்தைக்","குற்ற மறைப்பான் உடம்பு."],"w":[["இடும்பைக்கே",1,"Itumpaikke","for sorrow/suffering; (emphatic/பிரிநிலை) only for"],["கொள்கலம்",1,"Kolkalam","vessel, receptacle (கொள்ளும் கலம்)"],["கொல்லோ",1,"Kollo","(doubt/interrogative particle); (interrogative/wonder)"],["குடும்பத்தைக்",1,"Kutumpaththaik","the family (acc.)"],["குற்ற",2,"Kutra","fault, harm (குற்றத்தை)"],["மறைப்பான்",2,"Maraippaan","he who wards off/conceals"],["உடம்பு",2,"Utampu","the body"]]},{"n":1030,"l":["இடுக்கண்கால் கொன்றிட வீழும் அடுத்தூன்றும்","நல்லாள் இலாத குடி."],"w":[["இடுக்கண்கால்",1,"Itukkankaal","affliction, calamity; the foot/base (of the trunk)"],["கொன்றிட",1,"Kondrita","having struck/cut down (வெட்டிவிட)"],["வீழும்",1,"Veezhum","(it/the house) will fall"],["அடுத்தூன்றும்",1,"Atuththoondrum","drawing near, coming alongside; that props up/supports (ஊன்றும் நல்லாள்)"],["நல்லாள்",2,"Nallaal","good; person, capable one"],["இலாத",2,"Ilaadha","which does not have"],["குடி",2,"Kuti","the family/house"]]}]}