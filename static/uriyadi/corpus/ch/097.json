{"n":97,"kurals":[{"n":961,"l":["இன்றி அமையாச் சிறப்பின ஆயினும்","குன்ற வருப விடல்."],"w":[["இன்றி",1,"Indri","without (it)"],["அமையாச்",1,"Amaiyaach","not being complete (without)"],["சிறப்பின",1,"Chirappina","are of (such) excellence (they/those)"],["ஆயினும்",1,"Aayinum","though they be; even (concessive)"],["குன்ற",2,"Kundra","so that (dignity) declines"],["வருப",2,"Varupa","things that come/result"],["விடல்",2,"Vital","abandoning / one must abandon"]]},{"n":962,"l":["சீரினும் சீரல்ல செய்யாரே சீரொடு","பேராண்மை வேண்டு பவர்."],"w":[["சீரினும்",1,"Seerinum","than fame/honour; even (intensive)"],["சீரல்ல",1,"Seeralla","honourable / proper things; are not / un-honourable (things)"],["செய்யாரே",1,"Seyyaare","they will not do; indeed (emphatic)"],["சீரொடு",1,"Seerotu","along with fame"],["பேராண்மை",2,"Peraanmai","great; manliness/valour"],["வேண்டு",2,"Ventu","(those who) desire"],["பவர்",2,"Pavar","those who desire"]]},{"n":963,"l":["பெருக்கத்து வேண்டும் பணிதல் சிறிய","சுருக்கத்து வேண்டும் உயர்வு."],"w":[["பெருக்கத்து",1,"Perukkaththu","in (time of) abundance"],["வேண்டும்",1,"Ventum","is needed"],["பணிதல்",1,"Panidhal","humility / bowing"],["சிறிய",1,"Siriya","small (small decline)"],["சுருக்கத்து",2,"Surukkaththu","in (time of) decline/poverty"],["வேண்டும்",2,"Ventum","is needed"],["உயர்வு",2,"Uyarvu","loftiness / not bending"]]},{"n":964,"l":["தலையின் இழிந்த மயிரனையர் மாந்தர்","நிலையின் இழிந்தக் கடை."],"w":[["தலையின்",1,"Thalaiyin","from the head"],["இழிந்த",1,"Izhindha","that fell down"],["மயிரனையர்",1,"Mayiranaiyar","hair; are like / those resembling"],["மாந்தர்",1,"Maandhar","men/people"],["நிலையின்",2,"Nilaiyin","from (their) status"],["இழிந்தக்",2,"Izhindhak","when fallen / having fallen"],["கடை",2,"Katai","at the point/time (when)"]]},{"n":965,"l":["குன்றின் அனையாரும் குன்றுவர் குன்றுவ","குன்றி அனைய செயின்."],"w":[["குன்றின்",1,"Kundrin","(like) a hill/mountain"],["அனையாரும்",1,"Anaiyaarum","those who are like; even (those)"],["குன்றுவர்",1,"Kundruvar","will sink/decline"],["குன்றுவ",1,"Kundruva","things that cause decline"],["குன்றி",2,"Kundri","abrus/gunja seed"],["அனைய",2,"Anaiya","(things) of like (small) measure"],["செயின்",2,"Seyin","if (they) do"]]},{"n":966,"l":["புகழ்இன்றால் புத்தேள்நாட்டு உய்யாதால் என்மற்று","இகழ்வார்பின் சென்று நிலை."],"w":[["புகழ்இன்றால்",1,"Pukazhindraal","fame; (there) is not; (expletive)"],["புத்தேள்நாட்டு",1,"Puththelnaattu","god/celestial; to/in the gods' land (heaven)"],["உய்யாதால்",1,"Uyyaadhaal","does not save/elevate; (expletive)"],["என்மற்று",1,"Enmatru","what (use); moreover/then (expletive)"],["இகழ்வார்பின்",2,"Ikazhvaarpin","those who scorn; behind/after"],["சென்று",2,"Sendru","having gone (following)"],["நிலை",2,"Nilai","standing/abiding (state)"]]},{"n":967,"l":["ஒட்டார்பின் சென்றொருவன் வாழ்தலின் அந்நிலையே","கெட்டான் எனப்படுதல் நன்று."],"w":[["ஒட்டார்பின்",1,"Ottaarpin","those who do not befriend (foes); behind/after"],["சென்றொருவன்",1,"Sendroruvan","having gone; a man/one"],["வாழ்தலின்",1,"Vaazhdhalin","than living"],["அந்நிலையே",1,"Annilaiye","that; state/condition; in that very state"],["கெட்டான்",2,"Kettaan","he perished"],["எனப்படுதல்",2,"Enappatudhal","saying that; being said (to be)"],["நன்று",2,"Nandru","is good"]]},{"n":968,"l":["மருந்தோமற்று ஊன்ஓம்பும் வாழ்க்கை பெருந்தகைமை","பீடழிய வந்த இடத்து."],"w":[["மருந்தோமற்று",1,"Marundhomatru","medicine (for deathlessness); is it? (interrogative); (expletive)"],["ஊன்ஓம்பும்",1,"Oonompum","flesh/body (acc.); that protects/nurses"],["வாழ்க்கை",1,"Vaazhkkai","life/living"],["பெருந்தகைமை",1,"Perundhakaimai","great; nobility/worth"],["பீடழிய",2,"Peetazhiya","greatness/honour; so as to be destroyed"],["வந்த",2,"Vandha","that came/befell"],["இடத்து",2,"Itaththu","at the time/occasion (when)"]]},{"n":969,"l":["மயிர்நீப்பின் வாழாக் கவரிமா அன்னார்","உயிர்நீப்பர் மானம் வரின்."],"w":[["மயிர்நீப்பின்",1,"Mayirneeppin","hair; if (hair) is removed"],["வாழாக்",1,"Vaazhaak","that does not live"],["கவரிமா",1,"Kavarimaa","the yak (chamari deer)"],["அன்னார்",1,"Annaar","those resembling (it)"],["உயிர்நீப்பர்",2,"Uyirneeppar","life (acc.); they will give up"],["மானம்",2,"Maanam","honour/self-respect"],["வரின்",2,"Varin","if (loss of honour) comes"]]},{"n":970,"l":["இளிவரின் வாழாத மானம் உடையார்","ஒளிதொழுது ஏத்தும் உலகு."],"w":[["இளிவரின்",1,"Ilivarin","disgrace/contempt; if (it) comes"],["வாழாத",1,"Vaazhaadha","who would not live"],["மானம்",1,"Maanam","honour/self-respect"],["உடையார்",1,"Utaiyaar","those who possess (honour)"],["ஒளிதொழுது",2,"Olidhozhudhu","glory/fame (acc.); worshipping/revering"],["ஏத்தும்",2,"Eththum","(the world) praises"],["உலகு",2,"Ulaku","the world (people)"]]}]}