{"n":99,"kurals":[{"n":981,"l":["கடன்என்ப நல்லவை எல்லாம் கடன்அறிந்து","சான்றாண்மை மேற்கொள் பவர்க்கு."],"w":[["கடன்என்ப",1,"Katanenpa","duty; they say"],["நல்லவை",1,"Nallavai","good things"],["எல்லாம்",1,"Ellaam","all"],["கடன்அறிந்து",1,"Katanarindhu","duty (obj); having known"],["சான்றாண்மை",2,"Saandraanmai","perfectness (obj)"],["மேற்கொள்",2,"Merkol","who undertake (stem of பவர்)"],["பவர்க்கு",2,"Pavarkku","to those who undertake; (4th case marker)"]]},{"n":982,"l":["குணநலம் சான்றோர் நலனே பிறநலம்","எந்நலத்து உள்ளதூஉம் அன்று."],"w":[["குணநலம்",1,"Kunanalam","goodness of character"],["சான்றோர்",1,"Saandror","the noble/perfect ones'"],["நலனே",1,"Nalane","goodness/beauty; (emphatic/தேற்றம் ஏ)"],["பிறநலம்",1,"Piranalam","other beauty"],["எந்நலத்து",2,"Ennalaththu","in which beauty"],["உள்ளதூஉம்",2,"Ulladhooum","that which is present; even/also"],["அன்று",2,"Andru","is not"]]},{"n":983,"l":["அன்புநாண் ஒப்புரவு கண்ணோட்டம் வாய்மையொடு","ஐந்துசால்பு ஊன்றிய தூண்."],"w":[["அன்புநாண்",1,"Anpunaan","love; modesty/shame"],["ஒப்புரவு",1,"Oppuravu","benevolence/social grace"],["கண்ணோட்டம்",1,"Kannottam","graciousness/regard"],["வாய்மையொடு",1,"Vaaimaiyotu","truthfulness; with (3rd case)"],["ஐந்துசால்பு",2,"Aindhusaalpu","five; abounding/perfection (சால்பு)"],["ஊன்றிய",2,"Oondriya","that supported/propped"],["தூண்",2,"Thoon","pillars"]]},{"n":984,"l":["கொல்லா நலத்தது நோன்மை பிறர்தீமை","சொல்லா நலத்தது சால்பு."],"w":[["கொல்லா",1,"Kollaa","not killing (that does not kill)"],["நலத்தது",1,"Nalaththadhu","is of the nature of goodness"],["நோன்மை",1,"Nonmai","penance/austerity"],["பிறர்தீமை",1,"Pirardheemai","others'; evil/fault"],["சொல்லா",2,"Sollaa","not speaking (that does not utter)"],["நலத்தது",2,"Nalaththadhu","is of the nature of goodness"],["சால்பு",2,"Saalpu","perfectness"]]},{"n":985,"l":["ஆற்றுவார் ஆற்றல் பணிதல் அதுசான்றோர்","மாற்றாரை மாற்றும் படை."],"w":[["ஆற்றுவார்",1,"Aatruvaar","those who are capable/accomplish (their)"],["ஆற்றல்",1,"Aatral","strength/ability"],["பணிதல்",1,"Panidhal","being humble/humility"],["அதுசான்றோர்",1,"Adhusaandror","that; the noble ones'"],["மாற்றாரை",2,"Maatraarai","the enemies (obj); (2nd case marker)"],["மாற்றும்",2,"Maatrum","that changes/converts"],["படை",2,"Patai","weapon/army"]]},{"n":986,"l":["சால்பிற்குக் கட்டளை யாதெனின் தோல்வி","துலையல்லார் கண்ணும் கொளல்."],"w":[["சால்பிற்குக்",1,"Saalpirkuk","for perfectness; (இன் சாரியை); (4th case marker)"],["கட்டளை",1,"Kattalai","measuring-stone/touchstone"],["யாதெனின்",1,"Yaadhenin","what; if (one) says"],["தோல்வி",1,"Tholvi","defeat (obj of கொளல்)"],["துலையல்லார்",2,"Thulaiyallaar","equal/par; those who are not (one's equal)"],["கண்ணும்",2,"Kannum","at/in (7th case); even"],["கொளல்",2,"Kolal","(one should) accept"]]},{"n":987,"l":["இன்னாசெய் தார்க்கும் இனியவே செய்யாக்கால்","என்ன பயத்ததோ சால்பு."],"w":[["இன்னாசெய்",1,"Innaasey","harmful/painful things; having done (செய்து)"],["தார்க்கும்",1,"Thaarkkum","to those who did; even"],["இனியவே",1,"Iniyave","sweet/good things; (emphatic ஏ)"],["செய்யாக்கால்",1,"Seyyaakkaal","if (one) does not do"],["என்ன",2,"Enna","what"],["பயத்ததோ",2,"Payaththadho","of what benefit it is; (interrogative ஓ)"],["சால்பு",2,"Saalpu","perfectness"]]},{"n":988,"l":["இன்மை ஒருவற்கு இளிவன்று சால்பென்னும்","திண்மை உண்டாகப் பெறின்."],"w":[["இன்மை",1,"","poverty/lack"],["ஒருவற்கு",1,"","to a person; (4th case marker)"],["இளிவன்று",1,"","disgrace; is not"],["சால்பென்னும்",1,"","perfectness; called/named (qualifies திண்மை)"],["திண்மை",2,"","firmness/strength"],["உண்டாகப்",2,"",""],["பெறின்",2,"","if (one) obtains"]]},{"n":989,"l":["ஊழி பெயரினும் தாம்பெயரார் சான்றாண்மைக்கு","ஆழி எனப்படு வார்."],"w":[["ஊழி",1,"Oozhi","aeon/cosmic age"],["பெயரினும்",1,"Peyarinum","even if (it) shifts/moves; even (concessive)"],["தாம்பெயரார்",1,"Thaampeyaraar","they (themselves); do not shift/change"],["சான்றாண்மைக்கு",1,"Saandraanmaikku","to perfectness; (4th case marker)"],["ஆழி",2,"Aazhi","sea/ocean"],["எனப்படு",2,"Enappatu","(that is) called (as)"],["வார்",2,"Vaar","those who are (called)"]]},{"n":990,"l":["சான்றவர் சான்றாண்மை குன்றின் இருநிலந்தான்","தாங்காது மன்னோ பொறை."],"w":[["சான்றவர்",1,"Saandravar","the noble/perfect ones'"],["சான்றாண்மை",1,"Saandraanmai","perfectness"],["குன்றின்",1,"Kundrin","if (it) declines/diminishes"],["இருநிலந்தான்",1,"Irunilandhaan","the great earth; (emphatic/expletive)"],["தாங்காது",2,"Thaangaadhu","will not bear/support"],["மன்னோ",2,"Manno","(expletive மன்); (emphatic/lament ஓ)"],["பொறை",2,"Porai","burden/weight (obj of தாங்காது)"]]}]}