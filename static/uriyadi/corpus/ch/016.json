{"n":16,"kurals":[{"n":151,"l":["அகழ்வாரைத் தாங்கும் நிலம்போலத் தம்மை","இகழ்வார்ப் பொறுத்தல் தலை."],"w":[["அகழ்வாரைத்",1,"Akazhvaaraith","those who dig (down)"],["தாங்கும்",1,"Thaangum","which bears/supports"],["நிலம்போலத்",1,"Nilampolath","earth, ground; like (comparison particle)"],["தம்மை",1,"Thammai","them(selves)"],["இகழ்வார்ப்",2,"Ikazhvaarp","those who despise/revile"],["பொறுத்தல்",2,"Poruththal","bearing, forbearing"],["தலை",2,"Thalai","foremost, prime (virtue)"]]},{"n":152,"l":["பொறுத்தல் இறப்பினை என்றும் அதனை","மறத்தல் அதனினும் நன்று."],"w":[["பொறுத்தல்",1,"Poruththal","bearing, forbearing"],["இறப்பினை",1,"Irappinai","transgression, excess (harm)"],["என்றும்",1,"Endrum","always, ever"],["அதனை",1,"Adhanai","it (that harm)"],["மறத்தல்",2,"Maraththal","forgetting"],["அதனினும்",2,"Adhaninum","than that; even (emphatic)"],["நன்று",2,"Nandru","(is) good"]]},{"n":153,"l":["இன்மையுள் இன்மை விருந்தொரால் வன்மையுள்","வன்மை மடவார்ப் பொறை."],"w":[["இன்மையுள்",1,"Inmaiyul","among poverties"],["இன்மை",1,"Inmai","poverty, lack"],["விருந்தொரால்",1,"Virundhoraal","guest; turning away, neglecting"],["வன்மையுள்",1,"Vanmaiyul","among strengths"],["வன்மை",2,"Vanmai","strength"],["மடவார்ப்",2,"Matavaarp","the ignorant/foolish (ones)"],["பொறை",2,"Porai","forbearance, patience"]]},{"n":154,"l":["நிறையுடைமை நீங்காமை வேண்டின் பொறையுடைமை","போற்றி யொழுகப் படும்."],"w":[["நிறையுடைமை",1,"Niraiyutaimai","possession of integrity/self-restraint"],["நீங்காமை",1,"Neengaamai","not departing"],["வேண்டின்",1,"Ventin","if (one) desires"],["பொறையுடைமை",1,"Poraiyutaimai","possession of patience"],["போற்றி",2,"Potri","cherishing, esteeming"],["யொழுகப்",2,"Yozhukap","so as to live/conduct"],["படும்",2,"Patum","will be (done)"]]},{"n":155,"l":["ஒறுத்தாரை ஒன்றாக வையாரே வைப்பர்","பொறுத்தாரைப் பொன்போற் பொதிந்து."],"w":[["ஒறுத்தாரை",1,"Oruththaarai","those who punished"],["ஒன்றாக",1,"Ondraaka","as one thing (of worth)"],["வையாரே",1,"Vaiyaare","will not regard/place; indeed (emphatic)"],["வைப்பர்",1,"Vaippar","they will hold/place"],["பொறுத்தாரைப்",2,"Poruththaaraip","those who forbore"],["பொன்போற்",2,"Ponpor","gold; like"],["பொதிந்து",2,"Podhindhu","enclosing, treasuring up"]]},{"n":156,"l":["ஒறுத்தார்க்கு ஒருநாளை இன்பம் பொறுத்தார்க்குப்","பொன்றுந் துணையும் புகழ்."],"w":[["ஒறுத்தார்க்கு",1,"Oruththaarkku","for those who punished"],["ஒருநாளை",1,"Orunaalai","one; (one) day's"],["இன்பம்",1,"Inpam","joy, pleasure"],["பொறுத்தார்க்குப்",1,"Poruththaarkkup","for those who forbore"],["பொன்றுந்",2,"Pondrun","(until the world) perishes"],["துணையும்",2,"Thunaiyum","extent, as long as; even (up to)"],["புகழ்",2,"Pukazh","fame, praise"]]},{"n":157,"l":["திறனல்ல தற்பிறர் செய்யினும் நோநொந்து","அறனல்ல செய்யாமை நன்று."],"w":[["திறனல்ல",1,"Thiranalla","propriety, fitness; (things that) are not"],["தற்பிறர்",1,"Tharpirar","to oneself; others"],["செய்யினும்",1,"Seyyinum","even if (they) do; even (concessive)"],["நோநொந்து",1,"Nonondhu","pain, distress (of others); grieving (over)"],["அறனல்ல",2,"Aranalla","virtue, righteousness; (things that) are not"],["செய்யாமை",2,"Seyyaamai","not doing, refraining"],["நன்று",2,"Nandru","(is) good"]]},{"n":158,"l":["மிகுதியான் மிக்கவை செய்தாரைத் தாந்தம்","தகுதியான் வென்று விடல்."],"w":[["மிகுதியான்",1,"Mikudhiyaan","through arrogance/excess"],["மிக்கவை",1,"Mikkavai","excessive things (evil deeds)"],["செய்தாரைத்",1,"Seydhaaraith","those who did (them)"],["தாந்தம்",1,"Thaandham","they themselves; their own"],["தகுதியான்",2,"Thakudhiyaan","through (their) worthiness/forbearance"],["வென்று",2,"Vendru","having conquered"],["விடல்",2,"Vital","let (one) do / one should"]]},{"n":159,"l":["துறந்தாரின் தூய்மை உடையர் இறந்தார்வாய்","இன்னாச்சொல் நோற்கிற் பவர்."],"w":[["துறந்தாரின்",1,"Thurandhaarin","than/compared to ascetics"],["தூய்மை",1,"Thooimai","purity"],["உடையர்",1,"Utaiyar","(they) possess / are endowed"],["இறந்தார்வாய்",1,"Irandhaarvaai","those who transgressed (bounds); (from the) mouth of"],["இன்னாச்சொல்",2,"Innaachchol","harsh, bitter; word(s)"],["நோற்கிற்",2,"Norkir","if (they) endure"],["பவர்",2,"Pavar","those who (endure)"]]},{"n":160,"l":["உண்ணாது நோற்பார் பெரியர் பிறர்சொல்லும்","இன்னாச்சொல் நோற்பாரின் பின்."],"w":[["உண்ணாது",1,"Unnaadhu","without eating"],["நோற்பார்",1,"Norpaar","those who do penance/fast"],["பெரியர்",1,"Periyar","(they) are great"],["பிறர்சொல்லும்",1,"Pirarsollum","others; which (others) speak"],["இன்னாச்சொல்",2,"Innaachchol","harsh, bitter; harsh word(s)"],["நோற்பாரின்",2,"Norpaarin","than those who endure"],["பின்",2,"Pin","after, next (in rank)"]]}]}