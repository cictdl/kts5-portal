{"n":89,"kurals":[{"n":881,"l":["நிழல்நீரும் இன்னாத இன்னா தமர்நீரும்","இன்னாவாம் இன்னா செயின்."],"w":[["நிழல்நீரும்",1,"Nizhalneerum","shade; water (and); and (எண்ணும்மை)"],["இன்னாத",1,"Innaadha","(those that are normally) not-harmful"],["இன்னா",1,"Innaa","harmful/evil things"],["தமர்நீரும்",1,"Thamarneerum","kinsmen; nature/quality (of kin) too; too (எண்ணும்மை)"],["இன்னாவாம்",2,"Innaavaam","become harmful/evil"],["இன்னா",2,"Innaa","harm/evil"],["செயின்",2,"Seyin","if (they) do/cause"]]},{"n":882,"l":["வாள்போல் பகைவரை அஞ்சற்க அஞ்சுக","கேள்போல் பகைவர் தொடர்பு."],"w":[["வாள்போல்",1,"Vaalpol","sword; like (உவம உருபு)"],["பகைவரை",1,"Pakaivarai","(the) enemies (acc.)"],["அஞ்சற்க",1,"Anjarka","do not fear (எதிர்மறை வியங்கோள்)"],["அஞ்சுக",1,"Anjuka","(you should) fear"],["கேள்போல்",2,"Kelpol","kinsman/relative; like (உவம உருபு)"],["பகைவர்",2,"Pakaivar","enemies"],["தொடர்பு",2,"Thotarpu","association, contact"]]},{"n":883,"l":["உட்பகை அஞ்சித்தற் காக்க உலைவிடத்து","மட்பகையின் மாணத் தெறும்."],"w":[["உட்பகை",1,"Utpakai","internal/secret enmity"],["அஞ்சித்தற்",1,"Anjiththar","having feared; oneself (acc.)"],["காக்க",1,"Kaakka","let (one) guard/protect"],["உலைவிடத்து",1,"Ulaivitaththu","at the time/place of weakness/distress"],["மட்பகையின்",2,"Matpakaiyin","like/than the tool that cuts clay-pots"],["மாணத்",2,"Maanath","greatly, intensely (மிக)"],["தெறும்",2,"Therum","(it) will destroy/cut"]]},{"n":884,"l":["மனமாணா உட்பகை தோன்றின் இனமாணா","ஏதம் பலவும் தரும்."],"w":[["மனமாணா",1,"Manamaanaa","(of) unreformed mind"],["உட்பகை",1,"Utpakai","internal enmity"],["தோன்றின்",1,"Thondrin","if (it) arises"],["இனமாணா",1,"Inamaanaa","(causing) kin to be unreconciled / of unworthy kin"],["ஏதம்",2,"Edham","fault, harm"],["பலவும்",2,"Palavum","many; all/even (எண்ணும்மை)"],["தரும்",2,"Tharum","(it) will give/cause"]]},{"n":885,"l":["உறல்முறையான் உட்பகை தோன்றின் இறல்முறையான்","ஏதம் பலவும் தரும்."],"w":[["உறல்முறையான்",1,"Uralmuraiyaan","one of (close) kinship / through kinship"],["உட்பகை",1,"Utpaka