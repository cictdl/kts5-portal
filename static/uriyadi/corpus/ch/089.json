ll size; (தேற்ற ஏகாரம்)"],["ஆயினும்",1,"Aayinum","even though (it) be; even (இழிவுசிறப்பு உம்மை)"],["உட்பகை",2,"Utpakai","internal enmity"],["உள்ளதாங்",2,"Ulladhaang","(it) exists/is present (there)"],["கேடு",2,"Ketu","ruin, harm"]]},{"n":890,"l":["உடம்பாடு இலாதவர் வாழ்க்கை குடங்கருள்","பாம்போடு உடனுறைந் தற்று."],"w":[["உடம்பாடு",1,"Utampaatu","agreement, concord"],["இலாதவர்",1,"Ilaadhavar","those who lack (it)"],["வாழ்க்கை",1,"Vaazhkkai","life, living (with)"],["குடங்கருள்",1,"Kutangarul","inside a hut"],["பாம்போடு",2,"Paampotu","(together) with a snake"],["உடனுறைந்",2,"Utanurain","together (உடனிகழ்ச்சி); having dwelt"],["தற்று",2,"Thatru","is of that nature / is like that (உவம உறழ்வு predicate)"]]}]}