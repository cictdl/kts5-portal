{"n":22,"kurals":[{"n":211,"l":["கைம்மாறு வேண்டா கடப்பாடு மாரிமாட்டு","என்னாற்றுங் கொல்லோ உலகு."],"w":[["கைம்மாறு",1,"","recompense, return-favour"],["வேண்டா",1,"","(duty) does not require/desire"],["கடப்பாடு",1,"","duty, obligation"],["மாரிமாட்டு",1,"","rain, cloud; in, towards (locative)"],["என்னாற்றுங்",2,"",""],["கொல்லோ",2,"","doubt particle; interrogative/wonder particle"],["உலகு",2,"","the world / its people"]]},{"n":212,"l":["தாளாற்றித் தந்த பொருளெல்லாம் தக்கார்க்கு","வேளாண்மை செய்தற் பொருட்டு."],"w":[["தாளாற்றித்",1,"Thaalaatrith","effort, toil (lit. leg); having exerted/performed"],["தந்த",1,"Thandha","(that was) earned/given"],["பொருளெல்லாம்",1,"Porulellaam","wealth; all"],["தக்கார்க்கு",1,"Thakkaarkku","the worthy/deserving; to/for (dative)"],["வேளாண்மை",2,"Velaanmai","helpfulness, beneficence"],["செய்தற்",2,"Seydhar","the doing of"],["பொருட்டு",2,"Poruttu","for the sake of, in order to"]]},{"n":213,"l":["புத்தே ளுலகத்தும் ஈண்டும் பெறலரிதே","ஒப்புரவின் நல்ல பிற."],"w":[["புத்தே",1,"Puththe","celestial / god (heaven-)"],["ளுலகத்தும்",1,"Lulakaththum","in the world; even/too (concessive)"],["ஈண்டும்",1,"Eentum","here (this world); even/too"],["பெறலரிதே",1,"Peralaridhe","obtaining; is difficult/rare; emphatic particle"],["ஒப்புரவின்",2,"Oppuravin","than benevolence (comparison); than (ablative of comparison)"],["நல்ல",2,"Nalla","good (things)"],["பிற",2,"Pira","other (virtues)"]]},{"n":214,"l":["ஒத்த தறிவான் உயிர்வாழ்வான் மற்றையான்","செத்தாருள் வைக்கப் படும்."],"w":[["ஒத்த",1,"Oththa","that which is fitting"],["தறிவான்",1,"Tharivaan","the righteous one"],["உயிர்வாழ்வான்",1,"Uyirvaazhvaan","life, soul; he who lives"],["மற்றையான்",1,"Matraiyaan","the other one"],["செத்தாருள்",2,"Seththaarul","the dead; among (in)"],["வைக்கப்",2,"Vaikkap","to be placed/reckoned (passive complement)"],["படும்",2,"Patum","will be (reckoned)"]]},{"n":215,"l":["ஊருணி நீர்நிறைந் தற்றே உலகவாம்","பேரறி வாளன் திரு."],"w":[["ஊருணி",1,"Ooruni","village tank/pond"],["நீர்நிறைந்",1,"Neernirain","water; having become full"],["தற்றே",1,"Thatre","like that (உவம உருபு / comparison particle); emphatic"],["உலகவாம்",1,"Ulakavaam","the world; (that the) world desires/lives by"],["பேரறி",2,"Perari","great; wisdom"],["வாளன்",2,"Vaalan","the man (of great wisdom)"],["திரு",2,"Thiru","wealth, fortune"]]},{"n":216,"l":["பயன்மரம் உள்ளூர்ப் பழுத்தற்றால் செல்வம்","நயனுடை யான்கண் படின்."],"w":[["பயன்மரம்",1,"Payanmaram","useful/fruit-bearing; tree"],["உள்ளூர்ப்",1,"Ulloorp","within the town"],["பழுத்தற்றால்",1,"Pazhuththatraal","having ripened/fruited; like (உவம உருபு); expletive/emphatic"],["செல்வம்",1,"Selvam","wealth"],["நயனுடை",2,"Nayanutai","goodness, kindliness; possessing (who has)"],["யான்கண்",2,"Yaankan","the man (who has); in/at (locative)"],["படின்",2,"Patin","if it falls/comes (conditional)"]]},{"n":217,"l":["மருந்தாகித் தப்பா மரத்தற்றால் செல்வம்","பெருந்தகை யான்கண் படின்."],"w":[["மருந்தாகித்",1,"Marundhaakith","medicine; having become"],["தப்பா",1,"Thappaa","that does not fail"],["மரத்தற்றால்",1,"Maraththatraal","tree; like (உவம உருபு); expletive/emphatic"],["செல்வம்",1,"Selvam","wealth"],["பெருந்தகை",2,"Perundhakai","great; nobility, worth"],["யான்கண்",2,"Yaankan","in the man (of great worth); in/at (locative)"],["படின்",2,"Patin","if it falls/comes (conditional)"]]},{"n":218,"l":["இடனில் பருவத்தும் ஒப்புரவிற்கு ஒல்கார்","கடனறி காட்சி யவர்."],"w":[["இடனில்",1,"Itanil","means, scope; without, lacking"],["பருவத்தும்",1,"Paruvaththum","in the season/time; even (concessive)"],["ஒப்புரவிற்கு",1,"Oppuravirku","for benevolence; for (dative)"],["ஒல்கார்",1,"Olkaar","do not slacken/shrink"],["கடனறி",2,"Katanari","duty; knowing"],["காட்சி",2,"Kaatchi","vision, insight"],["யவர்",2,"Yavar","those (who have)"]]},{"n":219,"l":["நயனுடையான் நல்கூர்ந்தா னாதல் செயும்நீர","செய்யாது அமைகலா வாறு."],"w":[["நயனுடையான்",1,"Nayanutaiyaan","goodness; he who possesses"],["நல்கூர்ந்தா",1,"Nalkoorndhaa","one who became poor"],["னாதல்",1,"Naadhal","becoming"],["செயும்நீர",1,"Seyumneera","that (one) should do; deeds, fitting acts"],["செய்யாது",2,"Seyyaadhu","without doing"],["அமைகலா",2,"Amaikalaa","not being able to remain content"],["வாறு",2,"Vaaru","manner, way"]]},{"n":220,"l":["ஒப்புரவி னால்வரும் கேடெனின் அஃதொருவன்","விற்றுக்கோள் தக்க துடைத்து."],"w":[["ஒப்புரவி",1,"Oppuravi","by benevolence"],["னால்வரும்",1,"Naalvarum","by/through (instrumental); that comes"],["கேடெனின்",1,"Ketenin","harm, ruin; if (one says)"],["அஃதொருவன்",1,"Aqdhoruvan","that (harm); a person, one"],["விற்றுக்கோள்",2,"Vitrukkol","having sold (oneself); taking, acquisition"],["தக்க",2,"Thakka","worthy, fit (to)"],["துடைத்து",2,"Thutaiththu","it; (it) is of (the nature/worth)"]]}]}