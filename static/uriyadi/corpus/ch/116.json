{"n":116,"kurals":[{"n":1151,"l":["செல்லாமை உண்டேல் எனக்குரை மற்றுநின்","வல்வரவு வாழ்வார்க் குரை."],"w":[["செல்லாமை",1,"Sellaamai","non-departure (the state of not going)"],["உண்டேல்",1,"Untel","if there is"],["எனக்குரை",1,"Enakkurai","to me; tell (you)"],["மற்றுநின்",1,"Matrunin","moreover / but; your"],["வல்வரவு",2,"Valvaravu","quick/strong; coming/return"],["வாழ்வார்க்",2,"Vaazhvaark","to those who will live"],["குரை",2,"Kurai","tell (you)"]]},{"n":1152,"l":["இன்கண் உடைத்தவர் பார்வல் பிரிவஞ்சும்","புன்கண் உடைத்தால் புணர்வு."],"w":[["இன்கண்",1,"Inkan","pleasantness/joy"],["உடைத்தவர்",1,"Utaiththavar","possessed/had; he (the lord, honorific)"],["பார்வல்",1,"Paarval","look/gaze"],["பிரிவஞ்சும்",1,"Pirivanjum","separation; that fears"],["புன்கண்",2,"Punkan","misery/sorrow"],["உடைத்தால்",2,"Utaiththaal","possesses; (expletive)"],["புணர்வு",2,"Punarvu","union/embrace"]]},{"n":1153,"l":["அரிதரோ தேற்றம் அறிவுடையார் கண்ணும்","பிரிவோ ரிடத்துண்மை யான்."],"w":[["அரிதரோ",1,"Aridharo","is difficult/rare; (expletive)"],["தேற்றம்",1,"Thetram","certainty/conviction"],["அறிவுடையார்",1,"Arivutaiyaar","wisdom; those who have (the wise)"],["கண்ணும்",1,"Kannum","in/at (locative); even"],["பிரிவோ",2,"Pirivo","separation; (particle, lament/emphasis)"],["ரிடத்துண்மை",2,"Ritaththunmai","at some place/time; existence/being"],["யான்",2,"Yaan","by/because of (instrumental, joined to உண்மை)"]]},{"n":1154,"l":["அளித்தஞ்சல் என்றவர் நீப்பின் தெளித்தசொல்","தேறியார்க்கு உண்டோ தவறு."],"w":[["அளித்தஞ்சல்",1,"Aliththanjal","showing grace; fear not (negative imperative)"],["என்றவர்",1,"Endravar","who said; he (the lord, honorific)"],["நீப்பின்",1,"Neeppin","if (he) departs"],["தெளித்தசொல்",1,"Theliththasol","the assuring (word); word/promise"],["தேறியார்க்கு",2,"Theriyaarkku","to those who trusted"],["உண்டோ",2,"Unto","is there; ? (interrogative)"],["தவறு",2,"Thavaru","fault/error"]]},{"n":1155,"l":["ஓம்பின் அமைந்தார் பிரிவோம்பல் மற்றவர்","நீங்கின் அரிதால் புணர்வு."],"w":[["ஓம்பின்",1,"Ompin","if (one) guards"],["அமைந்தார்",1,"Amaindhaar","the one suited (lover)"],["பிரிவோம்பல்",1,"Pirivompal","separation; guarding/preventing"],["மற்றவர்",1,"Matravar","moreover; he (the lord, honorific)"],["நீங்கின்",2,"Neengin","if (he) departs"],["அரிதால்",2,"Aridhaal","is rare/difficult; (expletive)"],["புணர்வு",2,"Punarvu","union/reunion"]]},{"n":1156,"l":["பிரிவுரைக்கும் வன்கண்ணர் ஆயின் அரிதவர்","நல்குவர் என்னும் நசை."],"w":[["பிரிவுரைக்கும்",1,"Pirivuraikkum","separation; who will declare"],["வன்கண்ணர்",1,"Vankannar","hard-hearted ones"],["ஆயின்",1,"Aayin","if (they) be"],["அரிதவர்",1,"Aridhavar","is futile/rare; they"],["நல்குவர்",2,"Nalkuvar","(they) will show love"],["என்னும்",2,"Ennum","(the hope) that says"],["நசை",2,"Nasai","desire/hope"]]},{"n":1157,"l":["துறைவன் துறந்தமை தூற்றாகொல் முன்கை","இறைஇறவா நின்ற வளை."],"w":[["துறைவன்",1,"Thuraivan","the shore-lord"],["துறந்தமை",1,"Thurandhamai","the having-forsaken"],["தூற்றாகொல்",1,"Thootraakol","will (it) not noise abroad; (doubt/interrogative particle)"],["முன்கை",1,"Munkai","forearm"],["இறைஇறவா",2,"Iraiiravaa","the wrist-joint; not staying / slipping past"],["நின்ற",2,"Nindra","that stood/remained"],["வளை",2,"Valai","bangles"]]},{"n":1158,"l":["இன்னாது இனன்இல்ஊர் வாழ்தல் அதனினும்","இன்னாது இனியார்ப் பிரிவு."],"w":[["இன்னாது",1,"Innaadhu","is painful"],["இனன்இல்ஊர்",1,"Inaniloor","kin/companion; without; town"],["வாழ்தல்",1,"Vaazhdhal","living"],["அதனினும்",1,"Adhaninum","than that; even"],["இன்னாது",2,"Innaadhu","is (more) painful"],["இனியார்ப்",2,"Iniyaarp","the sweet/dear ones"],["பிரிவு",2,"Pirivu","separation"]]},{"n":1159,"l":["தொடிற்சுடின் அல்லது காமநோய் போல","விடிற்சுடல் ஆற்றுமோ தீ."],"w":[["தொடிற்சுடின்",1,"Thotirsutin","if touched; if it burns"],["அல்லது",1,"Alladhu","other than / unless"],["காமநோய்",1,"Kaamanoi","love/passion; malady"],["போல",1,"Pola","like (simile particle)"],["விடிற்சுடல்",2,"Vitirsutal","if released/away; burning"],["ஆற்றுமோ",2,"Aatrumo","is (it) able; ? (interrogative)"],["தீ",2,"Thee","fire"]]},{"n":1160,"l":["அரிதாற்றி அல்லல்நோய் நீக்கிப் பிரிவாற்றிப்","பின்இருந்து வாழ்வார் பலர்."],"w":[["அரிதாற்றி",1,"Aridhaatri","the difficult (thing); having endured"],["அல்லல்நோய்",1,"Allalnoi","distress; malady"],["நீக்கிப்",1,"Neekkip","having removed"],["பிரிவாற்றிப்",1,"Pirivaatrip","separation; having borne"],["பின்இருந்து",2,"Pinirundhu","afterward; remaining"],["வாழ்வார்",2,"Vaazhvaar","those who live"],["பலர்",2,"Palar","many (people)"]]}]}