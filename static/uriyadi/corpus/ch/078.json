{"n":78,"kurals":[{"n":771,"l":["என்னைமுன் நில்லன்மின் தெவ்விர் பலரென்னை","முன்நின்று கல்நின் றவர்."],"w":[["என்னைமுன்",1,"Ennaimun","my chief/leader; in front of"],["நில்லன்மின்",1,"Nillanmin","do not stand (ye)"],["தெவ்விர்",1,"Thevvir","O foes!"],["பலரென்னை",1,"Palarennai","many people; my chief"],["முன்நின்று",2,"Munnindru","in front; having stood"],["கல்நின்",2,"Kalnin","stone (memorial stone)"],["றவர்",2,"Ravar","those who stood (became stone)"]]},{"n":772,"l":["கான முயலெய்த அம்பினில் யானை","பிழைத்தவேல் ஏந்தல் இனிது."],"w":[["கான",1,"Kaana","forest (of)"],["முயலெய்த",1,"Muyaleydha","hare; that shot/hit"],["அம்பினில்",1,"Ampinil","than the arrow"],["யானை",1,"Yaanai","elephant (on)"],["பிழைத்தவேல்",2,"Pizhaiththavel","that missed; spear/lance"],["ஏந்தல்",2,"Endhal","holding/bearing"],["இனிது",2,"Inidhu","is sweet/better"]]},{"n":773,"l":["பேராண்மை என்ப தறுகண்ஒன் றுற்றக்கால்","ஊராண்மை மற்றதன் எஃகு."],"w":[["பேராண்மை",1,"Peraanmai","great valour/manliness"],["என்ப",1,"Enpa","they say"],["தறுகண்ஒன்",1,"Tharukanon","fierce courage/fearlessness; one (a hardship)"],["றுற்றக்கால்",1,"Rutrakkaal","when (it) befalls"],["ஊராண்மை",2,"Ooraanmai","magnanimity/helpfulness"],["மற்றதன்",2,"Matradhan","and/moreover; of that (valour)"],["எஃகு",2,"Eqku","edge/steel (the sharpness)"]]},{"n":774,"l":["கைவேல் களிற்றொடு போக்கி வருபவன்","மெய்வேல் பறியா நகும்."],"w":[["கைவேல்",1,"Kaivel","spear in hand"],["களிற்றொடு",1,"Kalitrotu","with/at the elephant"],["போக்கி",1,"Pokki","having hurled/sent off"],["வருபவன்",1,"Varupavan","he who comes (seeking)"],["மெய்வேல்",2,"Meyvel","spear (lodged) in body"],["பறியா",2,"Pariyaa","plucking out (having plucked)"],["நகும்",2,"Nakum","(he) smiles/rejoices"]]},{"n":775,"l":["விழித்தகண் வேல்கொண் டெறிய அழித்திமைப்பின்","ஓட்டன்றோ வன்க ணவர்க்கு."],"w":[["விழித்தகண்",1,"Vizhiththakan","that glared open; eye"],["வேல்கொண்",1,"Velkon","spear; taking (with)"],["டெறிய",1,"Teriya","when (they) hurl"],["அழித்திமைப்பின்",1,"Azhiththimaippin","closing/destroying (the glare); if (the eye) winks"],["ஓட்டன்றோ",2,"Ottandro","defeat/yielding; is it not?"],["வன்க",2,"Vanka","stout-heartedness/bravery"],["ணவர்க்கு",2,"Navarkku","for the brave/stout-hearted ones"]]},{"n":776,"l":["விழுப்புண் படாதநாள் எல்லாம் வழுக்கினுள்","வைக்கும்தன் நாளை எடுத்து."],"w":[["விழுப்புண்",1,"Vizhuppun","honourable battle-wound"],["படாதநாள்",1,"Pataadhanaal","that did not occur; day(s)"],["எல்லாம்",1,"Ellaam","all"],["வழுக்கினுள்",1,"Vazhukkinul","among the wasted/lapsed (days)"],["வைக்கும்தன்",2,"Vaikkumdhan","(he) will place/count; his own"],["நாளை",2,"Naalai","the day(s)"],["எடுத்து",2,"Etuththu","having taken/reckoned"]]},{"n":777,"l":["சுழலும் இசைவேண்டி வேண்டா உயிரார்","கழல்யாப்புக் காரிகை நீர்த்து."],"w":[["சுழலும்",1,"Suzhalum","that spreads/whirls around"],["இசைவேண்டி",1,"Isaiventi","fame/renown; desiring"],["வேண்டா",1,"Ventaa","not desiring"],["உயிரார்",1,"Uyiraar","those (who hold) life (lightly)"],["கழல்யாப்புக்",2,"Kazhalyaappuk","warrior's anklet; binding/tying"],["காரிகை",2,"Kaarikai","beauty/adornment"],["நீர்த்து",2,"Neerththu","has the nature/quality of"]]},{"n":778,"l":["உறின்உயிர் அஞ்சா மறவர் இறைவன்","செறினும் சீர்குன்றல் இலர்."],"w":[["உறின்உயிர்",1,"Urinuyir","if (war) befalls; for/about life"],["அஞ்சா",1,"Anjaa","fearless, not fearing"],["மறவர்",1,"Maravar","warriors"],["இறைவன்",1,"Iraivan","the king/lord"],["செறினும்",2,"Serinum","even if (he) is angry"],["சீர்குன்றல்",2,"Seerkundral","glory/excellence; diminishing"],["இலர்",2,"Ilar","they are without (it)"]]},{"n":779,"l":["இழைத்தது இகவாமைச் சாவாரை யாரே","பிழைத்தது ஒறுக்கிற் பவர்."],"w":[["இழைத்தது",1,"Izhaiththadhu","that which (one) vowed/resolved"],["இகவாமைச்",1,"Ikavaamaich","without departing from/failing"],["சாவாரை",1,"Chaavaarai","those who (will) die"],["யாரே",1,"Yaare","who?; (interrogative emphasis)"],["பிழைத்தது",2,"Pizhaiththadhu","the fault/failing"],["ஒறுக்கிற்",2,"Orukkir","(part of) those who would blame/punish"],["பவர்",2,"Pavar","those who would blame/punish"]]},{"n":780,"l":["புரந்தார்கண் நீர்மல்கச் சாகிற்பின் சாக்காடு","இரந்துகோள் தக்கது உடைத்து."],"w":[["புரந்தார்கண்",1,"Purandhaarkan","those who protected/cherished; eye(s)"],["நீர்மல்கச்",1,"Neermalkach","water/tears; so as to brim/swell"],["சாகிற்பின்",1,"Chaakirpin","if (one) is able to die"],["சாக்காடு",1,"Saakkaatu","death"],["இரந்துகோள்",2,"Irandhukol","having begged; obtaining/taking"],["தக்கது",2,"Thakkadhu","that which is fitting/worthy"],["உடைத்து",2,"Utaiththu","(it) possesses/has"]]}]}