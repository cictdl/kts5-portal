{"n":6,"kurals":[{"n":51,"l":["மனைத்தக்க மாண்புடையள் ஆகித்தற் கொண்டான்","வளத்தக்காள் வாழ்க்கைத் துணை."],"w":[["மனைத்தக்க",1,"Manaiththakka","for the home; befitting"],["மாண்புடையள்",1,"Maanputaiyal","she who has merit"],["ஆகித்தற்",1,"Aakiththar","having become; her (whom he wedded)"],["கொண்டான்",1,"Kontaan","he who took (wedded; husband)"],["வளத்தக்காள்",2,"Valaththakkaal","to the (his) wealth/means; she who lives befittingly"],["வாழ்க்கைத்",2,"Vaazhkkaith","of/for life"],["துணை",2,"Thunai","companion/mate"]]},{"n":52,"l":["மனைமாட்சி இல்லாள்கண் இல்லாயின் வாழ்க்கை","எனைமாட்சித் தாயினும் இல்."],"w":[["மனைமாட்சி",1,"Manaimaatchi","home/household; excellence/virtue"],["இல்லாள்கண்",1,"Illaalkan","the wife (lady of the house); in/at (locative)"],["இல்லாயின்",1,"Illaayin","if (it) is not"],["வாழ்க்கை",1,"Vaazhkkai","the (married) life"],["எனைமாட்சித்",2,"Enaimaatchith","however much / what; of excellence"],["தாயினும்",2,"Thaayinum","even though it be; even (concessive)"],["இல்",2,"Il","is not / nil"]]},{"n":53,"l":["இல்லதென் இல்லவள் மாண்பானால் உள்ளதென்","இல்லவள் மாணாக் கடை?"],"w":[["இல்லதென்",1,"Illadhen","that which is absent; what?"],["இல்லவள்",1,"Illaval","she of the house (wife)"],["மாண்பானால்",1,"Maanpaanaal","merit/virtue; if (she) becomes"],["உள்ளதென்",1,"Ulladhen","that which exists; what?"],["இல்லவள்",2,"Illaval","she of the house (wife)"],["மாணாக்",2,"Maanaak","not having merit"],["கடை",2,"Katai","lowness/worst state"]]},{"n":54,"l":["பெண்ணின் பெருந்தக்க யாவுள கற்பென்னும்","திண்மைஉண் டாகப் பெறின்."],"w":[["பெண்ணின்",1,"Pennin","than (a) woman"],["பெருந்தக்க",1,"Perundhakka","great; worthy/befitting"],["யாவுள",1,"Yaavula","what (things); are there"],["கற்பென்னும்",1,"Karpennum","chastity/fidelity; called/named"],["திண்மைஉண்",2,"Thinmaiun","firmness/strength; exists (part of உண்டாக)"],["டாகப்",2,"Taakap","so as to come to be"],["பெறின்",2,"Perin","if (one) attains"]]},{"n":55,"l":["தெய்வம் தொழாஅள் கொழுநன் தொழுதெழுவாள்","பெய்யெனப் பெய்யும் மழை."],"w":[["தெய்வம்",1,"Theyvam","(other) god(s) (object)"],["தொழாஅள்",1,"Thozhaaal","she who does not worship"],["கொழுநன்",1,"Kozhunan","husband (object of worship)"],["தொழுதெழுவாள்",1,"Thozhudhezhuvaal","having worshipped; she who rises (each morning)"],["பெய்யெனப்",2,"Peyyenap","rain! (command); saying (so)"],["பெய்யும்",2,"Peyyum","will rain"],["மழை",2,"Mazhai","rain"]]},{"n":56,"l":["தற்காத்துத் தற்கொண்டாற் பேணித் தகைசான்ற","சொற்காத்துச் சோர்விலாள் பெண்."],"w":[["தற்காத்துத்",1,"Tharkaaththuth","herself (object); having guarded"],["தற்கொண்டாற்",1,"Tharkontaar","her (own); him who wedded her (husband)"],["பேணித்",1,"Penith","having cherished/tended"],["தகைசான்ற",1,"Thakaisaandra","worthiness/distinction; that is full of"],["சொற்காத்துச்",2,"Sorkaaththuch","fame/good name (object); having guarded"],["சோர்விலாள்",2,"Chorvilaal","slackness; she who is without (it)"],["பெண்",2,"Pen","(the true) woman/wife"]]},{"n":57,"l":["சிறைகாக்கும் காப்பெவன் செய்யும் மகளிர்","நிறைகாக்கும் காப்பே தலை."],"w":[["சிறைகாக்கும்",1,"Siraikaakkum","by confinement/guard; that guards"],["காப்பெவன்",1,"Kaappevan","the guarding/protection; what (use)?"],["செய்யும்",1,"Seyyum","will it accomplish?"],["மகளிர்",1,"Makalir","women('s)"],["நிறைகாக்கும்",2,"Niraikaakkum","(self-)restraint, modesty; that guards"],["காப்பே",2,"Kaappe","the guard; indeed (emphatic)"],["தலை",2,"Thalai","the foremost/chief"]]},{"n":58,"l":["பெற்றாற் பெறின்பெறுவர் பெண்டிர் பெருஞ்சிறப்புப்","புத்தேளிர் வாழும் உலகு."],"w":[["பெற்றாற்",1,"Petraar","if (she) gets (such a one)"],["பெறின்பெறுவர்",1,"Perinperuvar","if (they) attain; they will attain"],["பெண்டிர்",1,"Pentir","women/wives"],["பெருஞ்சிறப்புப்",1,"Perunjirappup","great; distinction/glory"],["புத்தேளிர்",2,"Puththelir","gods/celestials (subject of வாழும்)"],["வாழும்",2,"Vaazhum","where (they) dwell"],["உலகு",2,"Ulaku","the world (of gods)"]]},{"n":59,"l":["புகழ்புரிந்த இல்லிலோர்க்கு இல்லை இகழ்வார்முன்","ஏறுபோல் பீடு நடை."],"w":[["புகழ்புரிந்த",1,"Pukazhpurindha","fame (object); that desired/cherished"],["இல்லிலோர்க்கு",1,"Illilorkku","in (married) home; to those (who lack such a wife)"],["இல்லை",1,"Illai","there is not"],["இகழ்வார்முன்",1,"Ikazhvaarmun","those who scorn; before/in front of"],["ஏறுபோல்",2,"Erupol","bull/lion; like (simile particle)"],["பீடு",2,"Peetu","majesty/pride"],["நடை",2,"Natai","(proud) gait"]]},{"n":60,"l":["மங்கலம் என்ப மனைமாட்சி மற்றதன்","நன்கலம் நன்மக்கட் பேறு."],"w":[["மங்கலம்",1,"","auspicious adornment/blessing"],["என்ப",1,"","(the wise) say"],["மனைமாட்சி",1,"","of the household; the (wife's) excellence"],["மற்றதன்",1,"",""],["நன்கலம்",2,"","good; ornament/jewel"],["நன்மக்கட்",2,"","good; good children (object of பேறு)"],["பேறு",2,"","the gaining/attainment"]]}]}