{"n":109,"kurals":[{"n":1081,"l":["அணங்குகொல் ஆய்மயில் கொல்லோ கனங்குழை","மாதர்கொல் மாலும்என் நெஞ்சு."],"w":[["அணங்குகொல்",1,"","celestial maiden / deity; interrogative-doubt particle"],["ஆய்மயில்",1,"","choice, fine, select; peacock"],["கொல்லோ",1,"","interrogative-doubt particle; interrogative O"],["கனங்குழை",1,"","she of heavy ear-jewels (the woman)"],["மாதர்கொல்",2,"","woman; interrogative-doubt particle"],["மாலும்என்",2,"",""],["நெஞ்சு",2,"","heart, mind"]]},{"n":1082,"l":["நோக்கினாள் நோக்கெதிர் நோக்குதல் தாக்கணங்கு","தானைக்கொண் டன்ன துடைத்து."],"w":[["நோக்கினாள்",1,"Nokkinaal","she who looked"],["நோக்கெதிர்",1,"Nokkedhir","the gaze; facing, opposite"],["நோக்குதல்",1,"Nokkudhal","looking back (the act)"],["தாக்கணங்கு",1,"Thaakkanangu","attacking; attacking deity"],["தானைக்கொண்",2,"Thaanaikkon","army; having taken/marshalled"],["டன்ன",2,"Tanna","like, resembling"],["துடைத்து",2,"Thutaiththu","is of that nature (possesses)"]]},{"n":1083,"l":["பண்டறியேன் கூற்றென் பதனை இனியறிந்தேன்","பெண்டகையால் பேரமர்க் கட்டு."],"w":[["பண்டறியேன்",1,"Pantariyen","formerly, of old; I did not know"],["கூற்றென்",1,"Kootren","Yama, Death; that which is called"],["பதனை",1,"Padhanai","it (that thing)"],["இனியறிந்தேன்",1,"Iniyarindhen","now, henceforth; I have known"],["பெண்டகையால்",2,"Pentakaiyaal","with womanly nature"],["பேரமர்க்",2,"Peramark","great, big; battle, war"],["கட்டு",2,"Kattu","has eyes / is of eyes (கண்ணை உடைத்து)"]]},{"n":1084,"l":["கண்டார் உயிருண்ணும் தோற்றத்தால் பெண்டகைப்","பேதைக்கு அமர்த்தன கண்."],"w":[["கண்டார்",1,"Kantaar","those who saw (their)"],["உயிருண்ணும்",1,"Uyirunnum","life (object); that consumes"],["தோற்றத்தால்",1,"Thotraththaal","by their appearance"],["பெண்டகைப்",1,"Pentakaip","womanly natured"],["பேதைக்கு",2,"Pedhaikku","for the innocent girl"],["அமர்த்தன",2,"Amarththana","warred / became contending"],["கண்",2,"Kan","eyes"]]},{"n":1085,"l":["கூற்றமோ கண்ணோ பிணையோ மடவரல்","நோக்கமிம் மூன்றும் உடைத்து."],"w":[["கூற்றமோ",1,"Kootramo","Yama, Death; interrogative O"],["கண்ணோ",1,"Kanno","eye; interrogative O"],["பிணையோ",1,"Pinaiyo","doe (female deer); interrogative O"],["மடவரல்",1,"Matavaral","young woman (her)"],["நோக்கமிம்",2,"Nokkamim","the look, glance; this"],["மூன்றும்",2,"Moondrum","three; inclusive um (all three)"],["உடைத்து",2,"Utaiththu","possesses (is of)"]]},{"n":1086,"l":["கொடும்புருவம் கோடா மறைப்பின் நடுங்கஞர்","செய்யல மன்இவள் கண்."],"w":[["கொடும்புருவம்",1,"Kotumpuruvam","curved, cruel; eyebrows"],["கோடா",1,"Kotaa","without bending/swerving"],["மறைப்பின்",1,"Maraippin","if (they) screen/hide"],["நடுங்கஞர்",1,"Natungagnar","trembling-causing; grief, distress"],["செய்யல",2,"Seyyala","(eyes) would not do/cause (negative finite)"],["மன்இவள்",2,"Manival","particle (regret / contrary-to-fact); this woman (her)"],["கண்",2,"Kan","eyes"]]},{"n":1087,"l":["கடாஅக் களிற்றின்மேற் கட்படாம் மாதர்","படாஅ முலைமேல் துகில்."],"w":[["கடாஅக்",1,"Kataaak","rutting (in must)"],["களிற்றின்மேற்",1,"Kalitrinmer","male elephant (on); upon, over"],["கட்படாம்",1,"Katpataam","face-cover / eye-screen (of elephant)"],["மாதர்",1,"Maadhar","of the woman"],["படாஅ",2,"Pataaa","not-sagging, unbending"],["முலைமேல்",2,"Mulaimel","breast (on); upon"],["துகில்",2,"Thukil","fine cloth, garment"]]},{"n":1088,"l":["ஒண்ணுதற் கோஒ உடைந்ததே ஞாட்பினுள்","நண்ணாரும் உட்குமென் பீடு."],"w":[["ஒண்ணுதற்",1,"Onnudhar","bright, lustrous; forehead (to/before)"],["கோஒ",1,"Koo","interrogative/wonder O (with alapedai)"],["உடைந்ததே",1,"Utaindhadhe","that which broke/was shattered; emphatic/lament E"],["ஞாட்பினுள்",1,"Gnaatpinul","in the battlefield"],["நண்ணாரும்",2,"Nannaarum","enemies (those who do not approach); even (concessive um)"],["உட்குமென்",2,"Utkumen","that (they) fear/dread; my"],["பீடு",2,"Peetu","greatness, valour, might"]]},{"n":1089,"l":["பிணையேர் மடநோக்கும் நாணும் உடையாட்கு","அணியெவனோ ஏதில தந்து."],"w":[["பிணையேர்",1,"Pinaiyer","doe; beauty, likeness"],["மடநோக்கும்",1,"Matanokkum","naive, tender; look, glance; and (enumerative um)"],["நாணும்",1,"Naanum","modesty, shame; and (enumerative um)"],["உடையாட்கு",1,"Utaiyaatku","for her who possesses"],["அணியெவனோ",2,"Aniyevano","ornament, jewel; what / why; interrogative O"],["ஏதில",2,"Edhila","unrelated/alien things"],["தந்து",2,"Thandhu","having given/adorned"]]},{"n":1090,"l":["உண்டார்கண் அல்லது அடுநறாக் காமம்போல்","கண்டார் மகிழ்செய்தல் இன்று."],"w":[["உண்டார்கண்",1,"Untaarkan","those who drank (in/at); locative 'in/at'"],["அல்லது",1,"Alladhu","except, other than"],["அடுநறாக்",1,"Atunaraak","distilled/boiled (toddy); toddy, liquor"],["காமம்போல்",1,"Kaamampol","love, desire; like"],["கண்டார்",2,"Kantaar","in those who saw"],["மகிழ்செய்தல்",2,"Makizhseydhal","joy, intoxication; the causing (of joy)"],["இன்று",2,"Indru","is not, does not (exist)"]]}]}