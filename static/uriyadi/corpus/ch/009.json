{"n":9,"kurals":[{"n":81,"l":["இருந்தோம்பி இல்வாழ்வ தெல்லாம் விருந்தோம்பி","வேளாண்மை செய்தற் பொருட்டு."],"w":[["இருந்தோம்பி",1,"Irundhompi","staying/being; guarding/tending"],["இல்வாழ்வ",1,"Ilvaazhva","home; living (the act of)"],["தெல்லாம்",1,"Thellaam","all"],["விருந்தோம்பி",1,"Virundhompi","guest; tending"],["வேளாண்மை",2,"Velaanmai","help/good turn"],["செய்தற்",2,"Seydhar","for doing"],["பொருட்டு",2,"Poruttu","for the sake of"]]},{"n":82,"l":["விருந்து புறத்ததாத் தானுண்டல் சாவா","மருந்தெனினும் வேண்டற்பாற் றன்று."],"w":[["விருந்து",1,"Virundhu","guest"],["புறத்ததாத்",1,"Puraththadhaath","being outside"],["தானுண்டல்",1,"Thaanuntal","self (oneself); eating"],["சாவா",1,"Saavaa","deathless (un-dying)"],["மருந்தெனினும்",2,"Marundheninum","medicine/nectar; even if"],["வேண்டற்பாற்",2,"Ventarpaar",""],["றன்று",2,"Randru","is not"]]},{"n":83,"l":["வருவிருந்து வைகலும் ஓம்புவான் வாழ்க்கை","பருவந்து பாழ்படுதல் இன்று."],"w":[["வருவிருந்து",1,"Varuvirundhu","coming (that comes); guest"],["வைகலும்",1,"Vaikalum","day; every (each day)"],["ஓம்புவான்",1,"Ompuvaan","he who tends"],["வாழ்க்கை",1,"Vaazhkkai","life"],["பருவந்து",2,"Paruvandhu","suffering/grieving"],["பாழ்படுதல்",2,"Paazhpatudhal","ruin/waste; becoming (ruined)"],["இன்று",2,"Indru","is not / never"]]},{"n":84,"l":["அகனமர்ந்து செய்யாள் உறையும் முகனமர்ந்து","நல்விருந்து ஓம்புவான் இல்."],"w":[["அகனமர்ந்து",1,"Akanamarndhu","inner self / mind (inside); being content/seated"],["செய்யாள்",1,"Seyyaal","the red one (Lakshmi)"],["உறையும்",1,"Uraiyum","(in which she) dwells — qualifies இல்"],["முகனமர்ந்து",1,"Mukanamarndhu","face; being pleasant (of face)"],["நல்விருந்து",2,"Nalvirundhu","good; guest"],["ஓம்புவான்",2,"Ompuvaan","he who tends"],["இல்",2,"Il","home (in the house of)"]]},{"n":85,"l":["வித்தும் இடல்வேண்டும் கொல்லோ விருந்தோம்பி","மிச்சில் மிசைவான் புலம்."],"w":[["வித்தும்",1,"Viththum","seed; even (the seed too)"],["இடல்வேண்டும்",1,"Italventum","sowing/placing; is needed"],["கொல்லோ",1,"Kollo","doubt particle (interrogative); question/wonder ஓ"],["விருந்தோம்பி",1,"Virundhompi","guest; having tended"],["மிச்சில்",2,"Michchil","leftover (food)"],["மிசைவான்",2,"Misaivaan","he who eats"],["புலம்",2,"Pulam","field/land"]]},{"n":86,"l":["செல்விருந்து ஓம்பி வருவிருந்து பார்த்திருப்பான்","நல்விருந்து வானத் தவர்க்கு."],"w":[["செல்விருந்து",1,"Selvirundhu","departing (that goes); guest"],["ஓம்பி",1,"Ompi","having tended"],["வருவிருந்து",1,"Varuvirundhu","coming (that comes); guest"],["பார்த்திருப்பான்",1,"Paarththiruppaan","he who waits watching"],["நல்விருந்து",2,"Nalvirundhu","good; guest"],["வானத்",2,"Vaanath","in the heavens"],["தவர்க்கு",2,"Thavarkku","to those of (heaven)"]]},{"n":87,"l":["இனைத்துணைத் தென்பதொன் றில்லை விருந்தின்","துணைத்துணை வேள்விப் பயன்."],"w":[["இனைத்துணைத்",1,"Inaiththunaith","of such-and-such measure"],["தென்பதொன்",1,"Thenpadhon","that which is said (to be); one (a single thing)"],["றில்லை",1,"Rillai","there is not"],["விருந்தின்",1,"Virundhin","of the guest"],["துணைத்துணை",2,"Thunaiththunai","according to the measure (of)"],["வேள்விப்",2,"Velvip","sacrifice/yagna"],["பயன்",2,"Payan","benefit/fruit"]]},{"n":88,"l":["பரிந்தோம்பிப் பற்றற்றேம் என்பர் விருந்தோம்பி","வேள்வி தலைப்படா தார்."],"w":[["பரிந்தோம்பிப்",1,"Parindhompip","with effort/grieving; having guarded"],["பற்றற்றேம்",1,"Patratrem","support/attachment; we have lost (became without)"],["என்பர்",1,"Enpar","they will say"],["விருந்தோம்பி",1,"Virundhompi","guest; tending"],["வேள்வி",2,"Velvi","sacrifice"],["தலைப்படா",2,"Thalaippataa","not attaining"],["தார்",2,"Thaar","those who do not attain"]]},{"n":89,"l":["உடைமையுள் இன்மை விருந்தோம்பல் ஓம்பா","மடமை மடவார்கண் உண்டு."],"w":[["உடைமையுள்",1,"Utaimaiyul","wealth/possession; within (locative உருபு)"],["இன்மை",1,"Inmai","poverty/lack"],["விருந்தோம்பல்",1,"Virundhompal","guest; tending (the act)"],["ஓம்பா",1,"Ompaa","not tending (that does not cherish)"],["மடமை",2,"Matamai","folly/ignorance"],["மடவார்கண்",2,"Matavaarkan","the foolish; in/at (locative உருபு)"],["உண்டு",2,"Untu","exists / there is"]]},{"n":90,"l":["மோப்பக் குழையும் அனிச்சம் முகந்திரிந்து","நோக்கக் குழையும் விருந்து."],"w":[["மோப்பக்",1,"Moppak","on smelling"],["குழையும்",1,"Kuzhaiyum","withers/softens"],["அனிச்சம்",1,"Anichcham","anicham flower"],["முகந்திரிந்து",1,"Mukandhirindhu","face; having changed/turned"],["நோக்கக்",2,"Nokkak","on looking"],["குழையும்",2,"Kuzhaiyum","withers"],["விருந்து",2,"Virundhu","guest"]]}]}