{"n":73,"kurals":[{"n":721,"l":["வகையறிந்து வல்லவை வாய்சோரார் சொல்லின்","தொகையறிந்த தூய்மை யவர்."],"w":[["வகையறிந்து",1,"Vakaiyarindhu","kind, mode; having known"],["வல்லவை",1,"Vallavai","the able/learned council"],["வாய்சோரார்",1,"Vaaisoraar","mouth/speech; do not slip/err"],["சொல்லின்",1,"Sollin","of words"],["தொகையறிந்த",2,"Thokaiyarindha","totality, classification; who knew"],["தூய்மை",2,"Thooimai","purity"],["யவர்",2,"Yavar","those who have (purity)"]]},{"n":722,"l":["கற்றாருள் கற்றார் எனப்படுவர் கற்றார்முன்","கற்ற செலச்சொல்லு வார்."],"w":[["கற்றாருள்",1,"Katraarul","among the learned"],["கற்றார்",1,"Katraar","the learned"],["எனப்படுவர்",1,"Enappatuvar","as, thus; are called/reckoned"],["கற்றார்முன்",1,"Katraarmun","the learned; before, in front of"],["கற்ற",2,"Katra","the things learned"],["செலச்சொல்லு",2,"Selachchollu","so as to reach/impress; speaking (part of சொல்லுவார்)"],["வார்",2,"Vaar","those who (will speak)"]]},{"n":723,"l":["பகையகத்துச் சாவார் எளியர் அரியர்","அவையகத்து அஞ்சா தவர்."],"w":[["பகையகத்துச்",1,"Pakaiyakaththuch","in the battlefield of enemies"],["சாவார்",1,"Chaavaar","those who dare to die"],["எளியர்",1,"Eliyar","are many/common"],["அரியர்",1,"Ariyar","are rare/few"],["அவையகத்து",2,"Avaiyakaththu","in the assembly/council"],["அஞ்சா",2,"Anjaa","who fear not"],["தவர்",2,"Thavar","those who (do not fear)"]]},{"n":724,"l":["கற்றார்முன் கற்ற செலச்சொல்லித் தாம்கற்ற","மிக்காருள் மிக்க கொளல்."],"w":[["கற்றார்முன்",1,"Katraarmun","the learned; before"],["கற்ற",1,"Katra","the things learned"],["செலச்சொல்லித்",1,"Selachchollith","so as to impress; having spoken"],["தாம்கற்ற",1,"Thaamkatra","themselves/oneself; what (they) learned"],["மிக்காருள்",2,"Mikkaarul","among those who excel"],["மிக்க",2,"Mikka","the superior (knowledge)"],["கொளல்",2,"Kolal","let (one) acquire/learn"]]},{"n":725,"l":["ஆற்றின் அளவறிந்து கற்க அவையஞ்சா","மாற்றங் கொடுத்தற் பொருட்டு."],"w":[["ஆற்றின்",1,"Aatrin","by/in the (proper) way/method"],["அளவறிந்து",1,"Alavarindhu","measure, extent (logic/alavai); having known"],["கற்க",1,"Karka","let one learn"],["அவையஞ்சா",1,"Avaiyanjaa","(in the) assembly; without fearing"],["மாற்றங்",2,"Maatrang","reply, answer"],["கொடுத்தற்",2,"Kotuththar","the giving (of)"],["பொருட்டு",2,"Poruttu","for the sake/purpose of"]]},{"n":726,"l":["வாளொடென் வன்கண்ணர் அல்லார்க்கு நூலொடென்","நுண்ணவை அஞ்சு பவர்க்கு."],"w":[["வாளொடென்",1,"Vaaloten","with a sword; what (use)?"],["வன்கண்ணர்",1,"Vankannar","the brave/stout-hearted"],["அல்லார்க்கு",1,"Allaarkku","to those who are not (brave)"],["நூலொடென்",1,"Nooloten","with a book/learning; what (use)?"],["நுண்ணவை",2,"Nunnavai","subtle, fine; the (subtle/wise) assembly"],["அஞ்சு",2,"Anju","(who) fear"],["பவர்க்கு",2,"Pavarkku","to those who (fear)"]]},{"n":727,"l":["பகையகத்துப் பேடிகை ஒள்வாள் அவையகத்து","அஞ்சு மவன்கற்ற நூல்."],"w":[["பகையகத்துப்",1,"Pakaiyakaththup","in the battlefield"],["பேடிகை",1,"Petikai","eunuch/coward; (in the) hand"],["ஒள்வாள்",1,"Olvaal","bright, sharp; sword"],["அவையகத்து",1,"Avaiyakaththu","in the assembly"],["அஞ்சு",2,"Anju","who fears"],["மவன்கற்ற",2,"Mavankatra","he (who); learned"],["நூல்",2,"Nool","the (learned) book/lore"]]},{"n":728,"l":["பல்லவை கற்றும் பயமிலரே நல்லவையுள்","நன்கு செலச்சொல்லா தார்."],"w":[["பல்லவை",1,"Pallavai","many; many (books/subjects)"],["கற்றும்",1,"Katrum","though having learned"],["பயமிலரே",1,"Payamilare","use, benefit; are without (use); indeed (emphatic)"],["நல்லவையுள்",1,"Nallavaiyul","good; in the good assembly"],["நன்கு",2,"Nanku","the good (matter), well"],["செலச்சொல்லா",2,"Selachchollaa","so as to impress; who cannot say"],["தார்",2,"Thaar","those who (do not say)"]]},{"n":729,"l":["கல்லா தவரின் கடையென்ப கற்றறிந்தும்","நல்லா ரவையஞ்சு வார்."],"w":[["கல்லா",1,"Kallaa","unlearned"],["தவரின்",1,"Thavarin","than those (unlearned)"],["கடையென்ப",1,"Kataiyenpa","lowest, base; they say"],["கற்றறிந்தும்",1,"Katrarindhum","having learned; though having understood"],["நல்லா",2,"Nallaa","the good (people)"],["ரவையஞ்சு",2,"Ravaiyanju","the assembly; (who) fear"],["வார்",2,"Vaar","those who (fear)"]]},{"n":730,"l":["உளரெனினும் இல்லாரொடு ஒப்பர் களன்அஞ்சிக்","கற்ற செலச்சொல்லா தார்."],"w":[["உளரெனினும்",1,"Ulareninum","(they) exist/are alive; even though"],["இல்லாரொடு",1,"Illaarotu","with those who are not (dead)"],["ஒப்பர்",1,"Oppar","are equal/similar"],["களன்அஞ்சிக்",1,"Kalananjik","the (assembly) arena; having feared"],["கற்ற",2,"Katra","the things learned"],["செலச்சொல்லா",2,"Selachchollaa","so as to impress; who cannot say"],["தார்",2,"Thaar","those who (do not say)"]]}]}