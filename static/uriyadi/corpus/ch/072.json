{"n":72,"kurals":[{"n":711,"l":["அவையறிந்து ஆராய்ந்து சொல்லுக சொல்லின்","தொகையறிந்த தூய்மை யவர்."],"w":[["அவையறிந்து",1,"Avaiyarindhu","assembly/council; having known"],["ஆராய்ந்து",1,"Aaraaindhu","having examined"],["சொல்லுக",1,"Solluka","let (one) speak"],["சொல்லின்",1,"Sollin","of words/word"],["தொகையறிந்த",2,"Thokaiyarindha","totality/classification (of words); (who has) known"],["தூய்மை",2,"Thooimai","purity"],["யவர்",2,"Yavar","those (who have purity)"]]},{"n":712,"l":["இடைதெரிந்து நன்குணர்ந்து சொல்லுக சொல்லின்","நடைதெரிந்த நன்மை யவர்."],"w":[["இடைதெரிந்து",1,"Itaidherindhu","occasion/timeliness (செவ்வி); having discerned"],["நன்குணர்ந்து",1,"Nankunarndhu","well/properly; having understood"],["சொல்லுக",1,"Solluka","let (one) speak"],["சொல்லின்",1,"Sollin","of words/word"],["நடைதெரிந்த",2,"Nataidherindha","style/manner (of speech); (who has) discerned"],["நன்மை",2,"Nanmai","goodness"],["யவர்",2,"Yavar","those (who have goodness)"]]},{"n":713,"l":["அவையறியார் சொல்லல்மேற் கொள்பவர் சொல்லின்","வகையறியார் வல்லதூஉம் இல்."],"w":[["அவையறியார்",1,"Avaiyariyaar","assembly; those who do not know"],["சொல்லல்மேற்",1,"Sollalmer","speaking; upon/undertaking"],["கொள்பவர்",1,"Kolpavar","those who take up"],["சொல்லின்",1,"Sollin","of words/word"],["வகையறியார்",2,"Vakaiyariyaar","kind/classification; are those who know not"],["வல்லதூஉம்",2,"Valladhooum","ability/that which is capable; even/also (emphatic)"],["இல்",2,"Il","is not / none"]]},{"n":714,"l":["ஒளியார்முன் ஒள்ளிய ராதல் வெளியார்முன்","வான்சுதை வண்ணம் கொளல்."],"w":[["ஒளியார்முன்",1,"Oliyaarmun","the brilliant/wise ones; before/in front of"],["ஒள்ளிய",1,"Olliya","brilliant ones"],["ராதல்",1,"Raadhal","becoming/being"],["வெளியார்முன்",1,"Veliyaarmun","the dull/unlearned ones; before"],["வான்சுதை",2,"Vaansudhai","white/bright; lime plaster"],["வண்ணம்",2,"Vannam","colour/appearance"],["கொளல்",2,"Kolal","taking on / one should adopt"]]},{"n":715,"l":["நன்றென்ற வற்றுள்ளும் நன்றே முதுவருள்","முந்து கிளவாச் செறிவு."],"w":[["நன்றென்ற",1,"Nandrendra","good; said/called"],["வற்றுள்ளும்",1,"Vatrullum","among those; even/all (inclusive)"],["நன்றே",1,"Nandre","(is) good/best; indeed (emphatic/தேற்றம்)"],["முதுவருள்",1,"Mudhuvarul","among elders/the wise"],["முந்து",2,"Mundhu","going ahead/first"],["கிளவாச்",2,"Kilavaach","without speaking"],["செறிவு",2,"Cherivu","restraint/self-control"]]},{"n":716,"l":["ஆற்றின் நிலைதளர்ந் தற்றே வியன்புலம்","ஏற்றுணர்வார் முன்னர் இழுக்கு."],"w":[["ஆற்றின்",1,"Aatrin","from the (righteous) path"],["நிலைதளர்ந்",1,"Nilaidhalarn","standing/footing; having slipped/weakened"],["தற்றே",1,"Thatre","like that / of that sort; indeed (தேற்றம்)"],["வியன்புலம்",1,"Viyanpulam","vast/wide; fields of knowledge"],["ஏற்றுணர்வார்",2,"Etrunarvaar","receiving/accepting; those who grasp/understand"],["முன்னர்",2,"Munnar","before/in presence of"],["இழுக்கு",2,"Izhukku","fault/blemish/slip"]]},{"n":717,"l":["கற்றறிந்தார் கல்வி விளங்கும் கசடறச்","சொல்தெரிதல் வல்லார் அகத்து."],"w":[["கற்றறிந்தார்",1,"Katrarindhaar","having learnt; those who learnt and knew"],["கல்வி",1,"Kalvi","learning/scholarship"],["விளங்கும்",1,"Vilangum","will shine forth"],["கசடறச்",1,"Kasatarach","flaw/defect; so as to be free of"],["சொல்தெரிதல்",2,"Choldheridhal","word; discerning"],["வல்லார்",2,"Vallaar","those skilled"],["அகத்து",2,"Akaththu","within/among"]]},{"n":718,"l":["உணர்வ துடையார்முன் சொல்லல் வளர்வதன்","பாத்தியுள் நீர்சொரிந் தற்று."],"w":[["உணர்வ",1,"Unarva","the faculty of understanding"],["துடையார்முன்",1,"Thutaiyaarmun","those who possess; before"],["சொல்லல்",1,"Sollal","speaking"],["வளர்வதன்",1,"Valarvadhan","of that which grows"],["பாத்தியுள்",2,"Paaththiyul","in the seed-bed/plot"],["நீர்சொரிந்",2,"Neersorin","water; having poured"],["தற்று",2,"Thatru","like that / is so"]]},{"n":719,"l":["புல்லவையுள் பொச்சாந்தும் சொல்லற்க நல்லவையுள்","நன்குசெலச் சொல்லு வார்."],"w":[["புல்லவையுள்",1,"Pullavaiyul","mean/base; in the assembly"],["பொச்சாந்தும்",1,"Pochchaandhum","even forgetting/inadvertently; even (இழிவுசிறப்பு)"],["சொல்லற்க",1,"Sollarka","let (one) not speak (prohibitive)"],["நல்லவையுள்",1,"Nallavaiyul","good/noble; in the good assembly"],["நன்குசெலச்",2,"Nankuselach","well; so as to sink in / penetrate (the mind)"],["சொல்லு",2,"Chollu","those who (can) speak"],["வார்",2,"Vaar","(suffix completing 'சொல்லுவார்')"]]},{"n":720,"l":["அங்கணத்துள் உக்க அமிழ்தற்றால் தங்கணத்தர்","அல்லார்முன் கோட்டி கொளல்."],"w":[["அங்கணத்துள்",1,"Anganaththul","in the (foul) courtyard"],["உக்க",1,"Ukka","(that which) spilled"],["அமிழ்தற்றால்",1,"Amizhdhatraal","ambrosia/nectar; like (simile-marker); (expletive அசை)"],["தங்கணத்தர்",1,"Thanganaththar","their own; kinsfolk/of their own group"],["அல்லார்முன்",2,"Allaarmun","those who are not (of one's group); before"],["கோட்டி",2,"Kotti","discourse/disputation"],["கொளல்",2,"Kolal","taking up (a discourse)"]]}]}