{"n":95,"kurals":[{"n":941,"l":["மிகினும் குறையினும் நோய்செய்யும் நூலோர்","வளிமுதலா எண்ணிய மூன்று."],"w":[["மிகினும்",1,"Mikinum","even if it exceeds"],["குறையினும்",1,"Kuraiyinum","even if it falls short"],["நோய்செய்யும்",1,"Noiseyyum","disease; (which) cause"],["நூலோர்",1,"Noolor","the learned (in medical texts)"],["வளிமுதலா",2,"Valimudhalaa","wind (vata); beginning with"],["எண்ணிய",2,"Enniya","(which they) reckoned"],["மூன்று",2,"Moondru","three"]]},{"n":942,"l":["மருந்தென வேண்டாவாம் யாக்கைக்கு அருந்தியது","அற்றது போற்றி உணின்."],"w":[["மருந்தென",1,"Marundhena","medicine; as / so-called"],["வேண்டாவாம்",1,"Ventaavaam","is not needed"],["யாக்கைக்கு",1,"Yaakkaikku","for the body"],["அருந்தியது",1,"Arundhiyadhu","what was eaten"],["அற்றது",2,"Atradhu","that which has been digested/ceased"],["போற்றி",2,"Potri","having ascertained/heeded"],["உணின்",2,"Unin","if one eats"]]},{"n":943,"l":["அற்றால் அளவறிந்து உண்க அஃதுடம்பு","பெற்றான் நெடிதுய்க்கும் ஆறு."],"w":[["அற்றால்",1,"Atraal","if (the food) is digested"],["அளவறிந்து",1,"Alavarindhu","fully / so as to be complete; having known"],["உண்க",1,"Unka","let one eat"],["அஃதுடம்பு",1,"Aqdhutampu","that; body"],["பெற்றான்",2,"Petraan","he who obtained"],["நெடிதுய்க்கும்",2,"Netidhuykkum","(for) long; (which) carries/sustains"],["ஆறு",2,"Aaru","way / means"]]},{"n":944,"l":["அற்றது அறிந்து கடைப்பிடித்து மாறல்ல","துய்க்க துவரப் பசித்து."],"w":[["அற்றது",1,"Atradhu","that which has been digested"],["அறிந்து",1,"Arindhu","having known"],["கடைப்பிடித்து",1,"Kataippitiththu","having held firm to"],["மாறல்ல",1,"Maaralla","contrariety; are not"],["துய்க்க",2,"Thuykka","let one consume"],["துவரப்",2,"Thuvarap","thoroughly / fully"],["பசித்து",2,"Pasiththu","having grown hungry"]]},{"n":945,"l":["மாறுபாடு இல்லாத உண்டி மறுத்துண்ணின்","ஊறுபாடு இல்லை உயிர்க்கு."],"w":[["மாறுபாடு",1,"Maarupaatu","incompatibility"],["இல்லாத",1,"Illaadha","which has no"],["உண்டி",1,"Unti","food"],["மறுத்துண்ணின்",1,"Maruththunnin","having refused (excess); if one eats"],["ஊறுபாடு",2,"Oorupaatu","harm / affliction"],["இல்லை",2,"Illai","there is not"],["உயிர்க்கு",2,"Uyirkku","to/for the life"]]},{"n":946,"l":["இழிவறிந்து உண்பான்கண் இன்பம்போல் நிற்கும்","கழிபேர் இரையான்கண் நோய்."],"w":[["இழிவறிந்து",1,"Izhivarindhu","moderation / lowness (small measure); having known"],["உண்பான்கண்",1,"Unpaankan","he who eats; in/with (locative)"],["இன்பம்போல்",1,"Inpampol","happiness; like"],["நிற்கும்",1,"Nirkum","will stay/abide"],["கழிபேர்",2,"Kazhiper","very great (excess)"],["இரையான்கண்",2,"Iraiyaankan","he who (eats) food greedily; in/with (locative)"],["நோய்",2,"Noi","disease"]]},{"n":947,"l":["தீயள வன்றித் தெரியான் பெரிதுண்ணின்","நோயள வின்றிப் படும்."],"w":[["தீயள",1,"Theeyala","fire (of hunger/digestion); measure"],["வன்றித்",1,"Vandrith","not being (according to)"],["தெரியான்",1,"Theriyaan","he, without discerning"],["பெரிதுண்ணின்",1,"Peridhunnin","greatly / much; if one eats"],["நோயள",2,"Noyala","disease; measure"],["வின்றிப்",2,"Vindrip","without (limit)"],["படும்",2,"Patum","will befall/arise"]]},{"n":948,"l":["நோய்நாடி நோய்முதல் நாடி அதுதணிக்கும்","வாய்நாடி வாய்ப்பச் செயல்."],"w":[["நோய்நாடி",1,"Noinaati","disease; having examined"],["நோய்முதல்",1,"Noimudhal","disease; cause / origin"],["நாடி",1,"Naati","having examined"],["அதுதணிக்கும்",1,"Adhudhanikkum","that; (which) subdues"],["வாய்நாடி",2,"Vaainaati","(right) way / means; having examined"],["வாய்ப்பச்",2,"Vaaippach","so as to fit/suit"],["செயல்",2,"Cheyal","let one act / one should do"]]},{"n":949,"l":["உற்றான் அளவும் பிணியளவும் காலமும்","கற்றான் கருதிச் செயல்."],"w":[["உற்றான்",1,"Utraan","the afflicted (patient)"],["அளவும்",1,"Alavum","extent (age/state); and (enumerative)"],["பிணியளவும்",1,"Piniyalavum","disease; extent; and (enumerative)"],["காலமும்",1,"Kaalamum","time / season; and (enumerative)"],["கற்றான்",2,"Katraan","he who has learned"],["கருதிச்",2,"Karudhich","having considered"],["செயல்",2,"Cheyal","let one act / should do"]]},{"n":950,"l":["உற்றவன் தீர்ப்பான் மருந்துழைச் செல்வானென்று","அப்பால்நாற் கூற்றே மருந்து."],"w":[["உற்றவன்",1,"","the patient (one afflicted)"],["தீர்ப்பான்",1,"","the healer (doctor)"],["மருந்துழைச்",1,"","medicine; near / at (the place of)"],["செல்வானென்று",1,"","he who attends (nurse/helper); thus (quotative)"],["அப்பால்நாற்",2,"",""],["கூற்றே",2,"","division / part; (emphatic/assertive)"],["மருந்து",2,"","medicine (the medical system)"]]}]}