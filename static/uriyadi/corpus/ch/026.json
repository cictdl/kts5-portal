{"n":26,"kurals":[{"n":251,"l":["தன்னூன் பெருக்கற்குத் தான்பிறிது ஊனுண்பான்","எங்ஙனம் ஆளும் அருள்?"],"w":[["தன்னூன்",1,"Thannoon","one's own; flesh, body"],["பெருக்கற்குத்",1,"Perukkarkuth","for the purpose of increasing"],["தான்பிறிது",1,"Thaanpiridhu","he himself; another (creature)"],["ஊனுண்பான்",1,"Oonunpaan","flesh (object); he who eats"],["எங்ஙனம்",2,"Engnganam","how"],["ஆளும்",2,"Aalum","will wield/possess"],["அருள்",2,"Arul","grace, compassion"]]},{"n":252,"l":["பொருளாட்சி போற்றாதார்க்கு இல்லை அருளாட்சி","ஆங்கில்லை ஊன்தின் பவர்க்கு."],"w":[["பொருளாட்சி",1,"Porulaatchi","wealth; possession, mastery"],["போற்றாதார்க்கு",1,"Potraadhaarkku","to those who do not cherish"],["இல்லை",1,"Illai","is not, does not exist"],["அருளாட்சி",1,"Arulaatchi","grace; possession, mastery"],["ஆங்கில்லை",2,"Aangillai","there, likewise (expletive); is not"],["ஊன்தின்",2,"Oondhin","flesh (object); eat (stem joining பவர்க்கு)"],["பவர்க்கு",2,"Pavarkku","to those who (eat)"]]},{"n":253,"l":["படைகொண்டார் நெஞ்சம்போல் நன்றூக்காது ஒன்றன்","உடல்சுவை உண்டார் மனம்."],"w":[["படைகொண்டார்",1,"Pataikontaar","weapon; those who held"],["நெஞ்சம்போல்",1,"Nenjampol","heart, mind; like (comparison)"],["நன்றூக்காது",1,"Nandrookkaadhu","without regarding goodness/grace"],["ஒன்றன்",1,"Ondran","of one (creature)"],["உடல்சுவை",2,"Utalsuvai","body; taste, savour"],["உண்டார்",2,"Untaar","those who ate"],["மனம்",2,"Manam","mind"]]},{"n":254,"l":["அருளல்ல தியாதெனிற் கொல்லாமை கோறல்","பொருளல்லது அவ்வூன் தினல்."],"w":[["அருளல்ல",1,"Arulalladhu","grace, mercy; (it is) not"],["தியாதெனிற்",1,"Yaadhenin","that which (is not grace); what; if (one asks)"],["கொல்லாமை",1,"Kollaamai","non-killing"],["கோறல்",1,"Koral","killing"],["பொருளல்லது",2,"Porulalladhu","righteous thing (அறம்); (it is) not"],["அவ்வூன்",2,"Avvoon","that; that flesh"],["தினல்",2,"Thinal","eating"]]},{"n":255,"l":["உண்ணாமை உள்ளது உயிர்நிலை ஊனுண்ண","அண்ணாத்தல் செய்யாது அளறு."],"w":[["உண்ணாமை",1,"Unnaamai","abstaining from eating"],["உள்ளது",1,"Ulladhu","(it) rests upon / exists"],["உயிர்நிலை",1,"Uyirnilai","life; state, standing"],["ஊனுண்ண",1,"Oonunna","flesh (object); on eating / if (one) eats"],["அண்ணாத்தல்",2,"Annaaththal","opening (the mouth), gasping (to release)"],["செய்யாது",2,"Seyyaadhu","does not do"],["அளறு",2,"Alaru","hell, the mire of hell"]]},{"n":256,"l":["தினற்பொருட்டால் கொல்லாது உலகெனின் யாரும்","விலைப்பொருட்டால் ஊன்றருவா ரில்."],"w":[["தினற்பொருட்டால்",1,"Thinarporuttaal","eating; for the sake of"],["கொல்லாது",1,"Kollaadhu","without killing"],["உலகெனின்",1,"Ulakenin","the world / worldly people; if (it be so)"],["யாரும்",1,"Yaarum","anyone; even, indeed (inclusive)"],["விலைப்பொருட்டால்",2,"Vilaipporuttaal","price; for the sake of"],["ஊன்றருவா",2,"Oondraruvaa","flesh (object); those who give/sell"],["ரில்",2,"Ril","there will be none"]]},{"n":257,"l":["உண்ணாமை வேண்டும் புலாஅல் பிறிதொன்றன்","புண்ணது உணர்வார்ப் பெறின்."],"w":[["உண்ணாமை",1,"Unnaamai","abstaining (from eating)"],["வேண்டும்",1,"Ventum","is needful, ought"],["புலாஅல்",1,"Pulaaal","flesh (with alapedai ‘அ’)"],["பிறிதொன்றன்",1,"Piridhondran","another; of one (creature)"],["புண்ணது",2,"Punnadhu","wound; it (is the wound)"],["உணர்வார்ப்",2,"Unarvaarp","those who realise"],["பெறின்",2,"Perin","if (one) obtains/gets"]]},{"n":258,"l":["செயிரின் தலைப்பிரிந்த காட்சியார் உண்ணார்","உயிரின் தலைப்பிரிந்த ஊன்."],"w":[["செயிரின்",1,"Seyirin","from fault/blemish"],["தலைப்பிரிந்த",1,"Thalaippirindha","having departed/separated from"],["காட்சியார்",1,"Kaatchiyaar","those of (clear) insight"],["உண்ணார்",1,"Unnaar","they will not eat"],["உயிரின்",2,"Uyirin","from the life"],["தலைப்பிரிந்த",2,"Thalaippirindha","which has departed/separated"],["ஊன்",2,"Oon","flesh"]]},{"n":259,"l":["அவிசொரிந் தாயிரம் வேட்டலின் ஒன்றன்","உயிர்செகுத் துண்ணாமை நன்று."],"w":[["அவிசொரிந்",1,"Avisorin","oblation (ghee etc.); pouring (out)"],["தாயிரம்",1,"Thaayiram","thousand"],["வேட்டலின்",1,"Vettalin","than performing sacrifice"],["ஒன்றன்",1,"Ondran","of one (creature)"],["உயிர்செகுத்",2,"Uyirsekuth","life (object); having destroyed/slain"],["துண்ணாமை",2,"Thunnaamai","not eating"],["நன்று",2,"Nandru","(it) is good"]]},{"n":260,"l":["கொல்லான் புலாலை மறுத்தானைக் கைகூப்பி","எல்லா உயிருந் தொழும்."],"w":[["கொல்லான்",1,"Kollaan","he who does not kill"],["புலாலை",1,"Pulaalai","flesh (object)"],["மறுத்தானைக்",1,"Maruththaanaik","him who refused"],["கைகூப்பி",1,"Kaikooppi","hand(s); joining (in salutation)"],["எல்லா",2,"Ellaa","all"],["உயிருந்",2,"Uyirun","lives, creatures; all (inclusive உம்)"],["தொழும்",2,"Thozhum","will worship"]]}]}