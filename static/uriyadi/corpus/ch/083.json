{"n":83,"kurals":[{"n":821,"l":["சீரிடம் காணின் எறிதற்குப் பட்டடை","நேரா நிரந்தவர் நட்பு."],"w":[["சீரிடம்",1,"Seeritam","fitting/excellence; place/occasion"],["காணின்",1,"Kaanin","if (one) sees/finds (conditional)"],["எறிதற்குப்",1,"Eridharkup","for striking/cutting"],["பட்டடை",1,"Pattatai","anvil/base block"],["நேரா",2,"Neraa","not agreeing (inwardly)"],["நிரந்தவர்",2,"Nirandhavar","those who align (outwardly)"],["நட்பு",2,"Natpu","friendship"]]},{"n":822,"l":["இனம்போன்று இனமல்லார் கேண்மை மகளிர்","மனம்போல வேறு படும்."],"w":[["இனம்போன்று",1,"Inampondru","kindred/kind; resembling/like (simile particle)"],["இனமல்லார்",1,"Inamallaar","kindred; those who are not (kin)"],["கேண்மை",1,"Kenmai","friendship/intimacy"],["மகளிர்",1,"Makalir","women (courtesans)"],["மனம்போல",2,"Manampola","mind/heart; like (simile particle)"],["வேறு",2,"Veru","different/apart"],["படும்",2,"Patum","will become/turn"]]},{"n":823,"l":["பலநல்ல கற்றக் கடைத்தும் மனநல்லர்","ஆகுதல் மாணார்க் கரிது."],"w":[["பலநல்ல",1,"Palanalla","many; good (books)"],["கற்றக்",1,"Katrak","having learned (relative participle)"],["கடைத்தும்",1,"Kataiththum","in the end / even so"],["மனநல்லர்",1,"Mananallar","mind/heart; (those who are) good-hearted"],["ஆகுதல்",2,"Aakudhal","becoming"],["மாணார்க்",2,"Maanaark","for the unworthy"],["கரிது",2,"Karidhu","is hard/rare"]]},{"n":824,"l":["முகத்தின் இனிய நகாஅ அகத்தின்னா","வஞ்சரை அஞ்சப் படும்."],"w":[["முகத்தின்",1,"Mukaththin","by the face"],["இனிய",1,"Iniya","sweet things"],["நகாஅ",1,"Nakaaa","smiling/laughing"],["அகத்தின்னா",1,"Akaththinnaa","in the heart/inside; evil/painful"],["வஞ்சரை",2,"Vanjarai","the deceitful ones"],["அஞ்சப்",2,"Anjap","so as to fear"],["படும்",2,"Patum","it is fitting (to fear)"]]},{"n":825,"l":["மனத்தின் அமையா தவரை எனைத்தொன்றும்","சொல்லினால் தேறற்பாற்று அன்று."],"w":[["மனத்தின்",1,"Manaththin","by/with the mind"],["அமையா",1,"Amaiyaa","not reconciling/agreeing"],["தவரை",1,"Thavarai","those (who do not agree)"],["எனைத்தொன்றும்",1,"Enaiththondrum","however much; one (thing); even (inclusive)"],["சொல்லினால்",2,"Sollinaal","by their words"],["தேறற்பாற்று",2,"Therarpaatru","that which is to be trusted"],["அன்று",2,"Andru","is not"]]},{"n":826,"l":["நட்டார்போல் நல்லவை சொல்லினும் ஒட்டார்சொல்","ஒல்லை உணரப் படும்."],"w":[["நட்டார்போல்",1,"Nattaarpol","friends; like (simile particle)"],["நல்லவை",1,"Nallavai","good things"],["சொல்லினும்",1,"Sollinum","even though they say; even (concessive)"],["ஒட்டார்சொல்",1,"Ottaarsol","non-allies/foes; words"],["ஒல்லை",2,"Ollai","quickly/soon"],["உணரப்",2,"Unarap","so as to be understood"],["படும்",2,"Patum","will be (understood)"]]},{"n":827,"l":["சொல்வணக்கம் ஒன்னார்கண் கொள்ளற்க வில்வணக்கம்","தீங்கு குறித்தமை யான்."],"w":[["சொல்வணக்கம்",1,"Solvanakkam","word; humbleness/bowing"],["ஒன்னார்கண்",1,"Onnaarkan","foes/enemies; at/in (locative)"],["கொள்ளற்க",1,"Kollarka","do not accept (prohibitive)"],["வில்வணக்கம்",1,"Vilvanakkam","bow; bending"],["தீங்கு",2,"Theengu","harm/evil"],["குறித்தமை",2,"Kuriththamai","the fact of aiming at"],["யான்",2,"Yaan","because of (instrumental)"]]},{"n":828,"l":["தொழுதகை யுள்ளும் படையொடுங்கும் ஒன்னார்","அழுதகண் ணீரும் அனைத்து."],"w":[["தொழுதகை",1,"Thozhudhakai","that worshipped/saluted; hand"],["யுள்ளும்",1,"Yullum","within; even"],["படையொடுங்கும்",1,"Pataiyotungum","weapon; will lie hidden"],["ஒன்னார்",1,"Onnaar","of the foes"],["அழுதகண்",2,"Azhudhakan","that wept; eye"],["ணீரும்",2,"Neerum","tears/water; also"],["அனைத்து",2,"Anaiththu","of like (nature)"]]},{"n":829,"l":["மிகச்செய்து தம்மெள்ளு வாரை நகச்செய்து","நட்பினுள் சாப்புல்லற் பாற்று."],"w":[["மிகச்செய்து",1,"Mikachcheydhu","abundantly/excessively; having done/shown"],["தம்மெள்ளு",1,"Thammellu","them (themselves); (who) despise"],["வாரை",1,"Vaarai","those (who despise)"],["நகச்செய்து",1,"Nakachcheydhu","(making them) laugh; having made"],["நட்பினுள்",2,"Natpinul","within friendship"],["சாப்புல்லற்",2,"Saappullar","embracing unto death"],["பாற்று",2,"Paatru","is of the nature (to be done)"]]},{"n":830,"l":["பகைநட்பாம் காலம் வருங்கால் முகநட்டு","அகநட்பு ஒரீஇ விடல்."],"w":[["பகைநட்பாம்",1,"Pakainatpaam","enmity/foe; that becomes friendship"],["காலம்",1,"Kaalam","time/occasion"],["வருங்கால்",1,"Varungaal","when (it) comes"],["முகநட்டு",1,"Mukanattu","face (outwardly); having befriended"],["அகநட்பு",2,"Akanatpu","heart/inner; friendship"],["ஒரீஇ",2,"Oreei","having removed/cast off"],["விடல்",2,"Vital","let (one) abandon"]]}]}