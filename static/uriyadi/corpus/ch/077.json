{"n":77,"kurals":[{"n":761,"l":["உறுப்பமைந்து ஊறஞ்சா வெல்படை வேந்தன்","வெறுக்கையுள் எல்லாம் தலை."],"w":[["உறுப்பமைந்து",1,"Uruppamaindhu","limb/component; being complete"],["ஊறஞ்சா",1,"Ooranjaa","harm/injury; not fearing"],["வெல்படை",1,"Velpatai","winning (= வெல்லும்); army"],["வேந்தன்",1,"Vendhan","king (king's)"],["வெறுக்கையுள்",2,"Verukkaiyul","wealth/treasure; among/within"],["எல்லாம்",2,"Ellaam","all"],["தலை",2,"Thalai","the chief/foremost"]]},{"n":762,"l":["உலைவிடத்து ஊறஞ்சா வன்கண் தொலைவிடத்துத்","தொல்படைக் கல்லால் அரிது."],"w":[["உலைவிடத்து",1,"Ulaivitaththu","ruin/defeat; at the place/time"],["ஊறஞ்சா",1,"Ooranjaa","harm/injury; not fearing"],["வன்கண்",1,"Vankan","fearlessness/courage"],["தொலைவிடத்துத்",1,"Tholaivitaththuth","loss/destruction; at the place/occasion"],["தொல்படைக்",2,"Tholpataik","ancient/age-old; army (for/to the army)"],["கல்லால்",2,"Kallaal","except/other than"],["அரிது",2,"Aridhu","is difficult/rare"]]},{"n":763,"l":["ஒலித்தக்கால் என்னாம் உவரி எலிப்பகை","நாகம் உயிர்ப்பக் கெடும்."],"w":[["ஒலித்தக்கால்",1,"Oliththakkaal","if (they) make noise"],["என்னாம்",1,"Ennaam","what will it be/avail"],["உவரி",1,"Uvari","sea"],["எலிப்பகை",1,"Elippakai","rat; enemy (rat-foe)"],["நாகம்",2,"Naakam","cobra"],["உயிர்ப்பக்",2,"Uyirppak","on (its) breathing"],["கெடும்",2,"Ketum","will perish"]]},{"n":764,"l":["அழிவின்று அறைபோகா தாகி வழிவந்த","வன்க ணதுவே படை."],"w":[["அழிவின்று",1,"Azhivindru","destruction; without"],["அறைபோகா",1,"Araipokaa","not being betrayed"],["தாகி",1,"Thaaki","being/having become"],["வழிவந்த",1,"Vazhivandha","lineage/way; that came (down)"],["வன்க",2,"Vanka","fearlessness (சீர் இடையே பிரிந்தது)"],["ணதுவே",2,"Nadhuve","that very thing; emphatic (தேற்றம்)"],["படை",2,"Patai","army"]]},{"n":765,"l":["கூற்றுடன்று மேல்வரினும் கூடி எதிர்நிற்கும்","ஆற்ற லதுவே படை."],"w":[["கூற்றுடன்று",1,"Kootrutandru","Death-god (Yama); having grown angry"],["மேல்வரினும்",1,"Melvarinum","upon/against; even if (it) comes"],["கூடி",1,"Kooti","uniting/together"],["எ