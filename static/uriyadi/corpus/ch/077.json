ns (victorious)"],["படை",2,"Patai","army"]]},{"n":770,"l":["நிலைமக்கள் சால உடைத்தெனினும் தானை","தலைமக்கள் இல்வழி இல்."],"w":[["நிலைமக்கள்",1,"Nilaimakkal","steadfast/long-standing; warriors/men"],["சால",1,"Saala","very much/abundantly"],["உடைத்தெனினும்",1,"Utaiththeninum","possesses; even though (it be)"],["தானை",1,"Thaanai","army"],["தலைமக்கள்",2,"Thalaimakkal","chief/leading; leaders/commanders"],["இல்வழி",2,"Ilvazhi","without/absent; in the case/when"],["இல்",2,"Il","(there) is not / no greatness"]]}]}