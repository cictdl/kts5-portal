{"n":124,"kurals":[{"n":1231,"l":["சிறுமை நமக்கொழியச் சேட்சென்றார் உள்ளி","நறுமலர் நாணின கண்."],"w":[["சிறுமை",1,"Sirumai","the misery/littleness (of separation)"],["நமக்கொழியச்",1,"Namakkozhiyach","for/to us; to/for (4th case); (misery) being left behind / remaining"],["சேட்சென்றார்",1,"Chetchendraar","(to) a far/distant place; the one (lover) who went"],["உள்ளி",1,"Ulli","having thought of / recalling"],["நறுமலர்",2,"Narumalar","fragrant; flower(s) (which the eyes shrank from)"],["நாணின",2,"Naanina","(the eyes) felt shame / shrank"],["கண்",2,"Kan","eyes (subject)"]]},{"n":1232,"l":["நயந்தவர் நல்காமை சொல்லுவ போலும்","பசந்து பனிவாரும் கண்."],"w":[["நயந்தவர்",1,"Nayandhavar","the one (lover) whom (I) desired"],["நல்காமை",1,"Nalkaamai","(his) not granting love / unkindness (object of சொல்லுதல்)"],["சொல்லுவ",1,"Solluva","those (eyes) that would tell"],["போலும்",1,"Polum","(it) seems / as if (ஒப்பில் போலி)"],["பசந்து",2,"Pasandhu","having turned pallid"],["பனிவாரும்",2,"Panivaarum","tears / cool water; (that) flow/stream down"],["கண்",2,"Kan","eyes (subject)"]]},{"n":1233,"l":["தணந்தமை சால அறிவிப்ப போலும்","மணந்தநாள் வீங்கிய தோள்."],"w":[["தணந்தமை",1,"Thanandhamai","the parting / separation (object of அறிவித்தல்)"],["சால",1,"Saala","very much / fully"],["அறிவிப்ப",1,"Arivippa","those (shoulders) that would make known"],["போலும்",1,"Polum","(it) seems / as if (ஒப்பில் போலி)"],["மணந்தநாள்",2,"Manandhanaal","(the day) when (he) wedded/united; (on the) day"],["வீங்கிய",2,"Veengiya","(that) swelled/grew plump"],["தோள்",2,"Thol","shoulders/arms (subject)"]]},{"n":1234,"l":["பணைநீங்கிப் பைந்தொடி சோரும் துணைநீங்கித்","தொல்கவின் வாடிய தோள்."],"w":[["பணைநீங்கிப்",1,"Panaineengip","the plumpness/girth; having lost / departed from"],["பைந்தொடி",1,"Paindhoti","fresh/green (gold); bangle(s)/armlet(s)"],["சோரும்",1,"Sorum","(they/bangles) slip off / loosen"],["துணைநீங்கித்",1,"Thunaineengith","the companion/mate (lover); having parted from"],["தொல்கவின்",2,"Tholkavin","old/ancient; (o