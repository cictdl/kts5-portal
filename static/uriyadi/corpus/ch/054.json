{"n":54,"kurals":[{"n":531,"l":["இறந்த வெகுளியின் தீதே சிறந்த","உவகை மகிழ்ச்சியிற் சோர்வு."],"w":[["இறந்த",1,"Irandha","exceeded/excessive (adj.)"],["வெகுளியின்",1,"Vekuliyin","than wrath/anger"],["தீதே",1,"Theedhe","evil/harm (predicate); emphatic/affirmative (தேற்றேகாரம்)"],["சிறந்த",1,"Sirandha","great/excelling (adj.)"],["உவகை",2,"Uvakai","joy/delight"],["மகிழ்ச்சியிற்",2,"Makizhchchiyir","in/during the rejoicing"],["சோர்வு",2,"Sorvu","slackness/forgetfulness (lapse)"]]},{"n":532,"l":["பொச்சாப்புக் கொல்லும் புகழை அறிவினை","நிச்ச நிரப்புக்கொன் றாங்கு."],"w":[["பொச்சாப்புக்",1,"","negligence/forgetfulness"],["கொல்லும்",1,"","kills/will kill (predicate; subj. பொச்சாப்பு)"],["புகழை",1,"","fame/renown (obj.)"],["அறிவினை",1,"","wisdom (obj. of கொன்)"],["நிச்ச",2,"","daily/everyday (Skt. nitya)"],["நிரப்புக்கொன்",2,"",""],["றாங்கு",2,"","thus/in that manner (உவம அசை)"]]},{"n":533,"l":["பொச்சாப்பார்க் கில்லை புகழ்மை அதுஉலகத்து","எப்பால்நூ லோர்க்கும் துணிவு."],"w":[["பொச்சாப்பார்க்",1,"Pochchaappaark","for the forgetful ones"],["கில்லை",1,"Killai","there is not"],["புகழ்மை",1,"Pukazhmai","(undimmed) fame / state of having fame"],["அதுஉலகத்து",1,"Adhuulakaththu","that (the foregoing); in the world"],["எப்பால்நூ",2,"Eppaalnoo","of which/any branch; treatise/learning"],["லோர்க்கும்",2,"Lorkkum","to the learned ones (நூலோர்); inclusive 'um' (all alike)"],["துணிவு",2,"Thunivu","settled conclusion"]]},{"n":534,"l":["அச்ச முடையார்க்கு அரணில்லை ஆங்கில்லை","பொச்சாப் புடையார்க்கு நன்கு."],"w":[["அச்ச",1,"Achcha","fear"],["முடையார்க்கு",1,"Mutaiyaarkku","for those who have"],["அரணில்லை",1,"Aranillai","fortress/defence; is of no avail/not"],["ஆங்கில்லை",1,"Aangillai","likewise/there; is not"],["பொச்சாப்",2,"Pochchaap","negligence/forgetfulness"],["புடையார்க்கு",2,"Putaiyaarkku","for those who have"],["நன்கு",2,"Nanku","good/benefit"]]},{"n":535,"l":["முன்னுறக் காவாது இழுக்கியான் தன்பிழை","பின்னூறு இரங்கி விடும்."],"w":[["முன்னுறக்",1,"Munnurak","before/beforehand; so as to befall/anticipating"],["காவாது",1,"Kaavaadhu","without guarding"],["இழுக்கியான்",1,"Izhukkiyaan","he who erred/slipped (subject)"],["தன்பிழை",1,"Thanpizhai","his own; fault/error"],["பின்னூறு",2,"Pinnooru","afterwards/later; harm/affliction"],["இரங்கி",2,"Irangi","grieving/repenting"],["விடும்",2,"Vitum","will (do completely) — auxiliary"]]},{"n":536,"l":["இழுக்காமை யார்மாட்டும் என்றும் வழுக்காமை","வாயின் அஃதொப்பது இல்."],"w":[["இழுக்காமை",1,"Izhukkaamai","not-erring/non-negligence (neg. verbal noun)"],["யார்மாட்டும்",1,"Yaarmaattum","whoever/anyone (loc.); in/towards (7th case உருபு); inclusive 'um' (in anyone)"],["என்றும்",1,"Endrum","always/at all times; inclusive 'um' (ever)"],["வழுக்காமை",1,"Vazhukkaamai","not-slipping/unfailing care (neg. verbal noun)"],["வாயின்",2,"Vaayin","if it comes to pass/obtains (conditional)"],["அஃதொப்பது",2,"Aqdhoppadhu","that; that which equals it"],["இல்",2,"Il","there is none"]]},{"n":537,"l":["அரியஎன்று ஆகாத இல்லைபொச் சாவாக்","கருவியால் போற்றிச் செயின்."],"w":[["அரியஎன்று",1,"Ariyaendru","difficult things; saying/deeming that"],["ஆகாத",1,"Aakaadha","that cannot be achieved"],["இல்லைபொச்",1,"Illaipoch","there is not (none)"],["சாவாக்",1,"Chaavaak","non-forgetting (adj., modifies கருவி)"],["கருவியால்",2,"Karuviyaal","by the instrument (of unforgetfulness)"],["போற்றிச்",2,"Potrich","cherishing/with care"],["செயின்",2,"Cheyin","if (one) does (conditional)"]]},{"n":538,"l":["புகழ்ந்தவை போற்றிச் செயல்வேண்டும் செய்யாது","இகழ்ந்தார்க்கு எழுமையும் இல்."],"w":[["புகழ்ந்தவை",1,"Pukazhndhavai","the things (the wise) praised (obj.)"],["போற்றிச்",1,"Potrich","cherishing/with care"],["செயல்வேண்டும்",1,"Cheyalventum","doing/the act; is needful/ought"],["செய்யாது",1,"Seyyaadhu","without doing"],["இகழ்ந்தார்க்கு",2,"Ikazhndhaarkku","for those who slighted/neglected"],["எழுமையும்",2,"Ezhumaiyum","the seven births; inclusive 'um' (even in)"],["இல்",2,"Il","there is no (good)"]]},{"n":539,"l":["இகழ்ச்சியின் கெட்டாரை உள்ளுக தாந்தம்","மகிழ்ச்சியின் மைந்துறும் போழ்து."],"w":[["இகழ்ச்சியின்",1,"Ikazhchchiyin","through negligence/slight (cause)"],["கெட்டாரை",1,"Kettaarai","those who were ruined (obj.)"],["உள்ளுக",1,"Ulluka","let (one) remember/think on"],["தாந்தம்",1,"Thaandham","they themselves; their own"],["மகிழ்ச்சியின்",2,"Makizhchchiyin","through (their) joy (cause)"],["மைந்துறும்",2,"Maindhurum","(when they) gain pride/strength — modifies போழ்து"],["போழ்து",2,"Pozhdhu","the time/when"]]},{"n":540,"l":["உள்ளியது எய்தல் எளிதுமன் மற்றுந்தான்","உள்ளியது உள்ளப் பெறின்."],"w":[["உள்ளியது",1,"Ulliyadhu","that which was intended/desired"],["எய்தல்",1,"Eydhal","attaining/reaching"],["எளிதுமன்",1,"Elidhuman","easy (predicate); expletive 'man' (certainty/emphasis)"],["மற்றுந்தான்",1,"Matrundhaan","moreover/again (connective expletive); expletive 'taan' (emphatic)"],["உள்ளியது",2,"Ulliyadhu","that which was intended (obj.)"],["உள்ளப்",2,"Ullap","so as to keep thinking on"],["பெறின்",2,"Perin","if (one) gets/is able (conditional)"]]}]}