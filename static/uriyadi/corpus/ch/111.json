{"n":111,"kurals":[{"n":1101,"l":["கண்டுகேட்டு உண்டுயிர்த்து உற்றறியும் ஐம்புலனும்","ஒண்தொடி கண்ணே உள."],"w":[["கண்டுகேட்டு",1,"Kantukettu","having seen; having heard"],["உண்டுயிர்த்து",1,"Untuyirththu","having tasted/eaten; having smelt/breathed"],["உற்றறியும்",1,"Utrariyum","having touched/felt; that knows/perceives (qualifies ஐம்புலன்)"],["ஐம்புலனும்",1,"Aimpulanum","the five senses/sensations; all (inclusive)"],["ஒண்தொடி",2,"Ondhoti","the bright-bangled woman (=she)"],["கண்ணே",2,"Kanne","in/at (locative); only (emphatic/restrictive)"],["உள",2,"Ula","they exist/are present"]]},{"n":1102,"l":["பிணிக்கு மருந்து பிறமன் அணியிழை","தன்நோய்க்குத் தானே மருந்து."],"w":[["பிணிக்கு",1,"Pinikku","for ailment/disease"],["மருந்து",1,"Marundhu","medicine/cure"],["பிறமன்",1,"Piraman","other (things); (asai / particle; here oziyisai 'but / other')"],["அணியிழை",1,"Aniyizhai","the jewel-adorned woman (=she)"],["தன்நோய்க்குத்",2,"Thannoikkuth","her own; for the ailment (she caused)"],["தானே",2,"Thaane","she herself; alone/only (emphatic)"],["மருந்து",2,"Marundhu","medicine/cure"]]},{"n":1103,"l":["தாம்வீழ்வார் மென்றோள் துயிலின் இனிதுகொல்","தாமரைக் கண்ணான் உலகு."],"w":[["தாம்வீழ்வார்",1,"Thaamveezhvaar","they (themselves); those whom (they) love"],["மென்றோள்",1,"Mendrol","soft shoulders/arms"],["துயிலின்",1,"Thuyilin","than (the) sleep"],["இனிதுகொல்",1,"Inidhukol","sweet/pleasant (thing); (doubt/interrogative particle)"],["தாமரைக்",2,"Thaamaraik","lotus (likened to eye)"],["கண்ணான்",2,"Kannaan","the lotus-eyed one (Vishnu)"],["உலகு",2,"Ulaku","world/heaven"]]},{"n":1104,"l":["நீங்கின் தெறூஉம் குறுகுங்கால் தண்ணென்னும்","தீயாண்டுப் பெற்றாள் இவள்?"],"w":[["நீங்கின்",1,"Neengin","if (one) moves away"],["தெறூஉம்",1,"Theruum","(it) burns/scorches"],["குறுகுங்கால்",1,"Kurukungaal","(when one) draws near; at the time / when"],["தண்ணென்னும்",1,"Thannennum","(it) feels/says cool"],["தீயாண்டுப்",2,"Theeyaantup","fire (object of பெற்றாள்); from where?"],["பெற்றாள்",2,"Petraal","(she) got/obtained"],["இவள்",2,"Ival","this woman/she"]]},{"n":1105,"l":["வேட்ட பொழுதின் அவையவை போலுமே","தோட்டார் கதுப்பினாள் தோள்."],"w":[["வேட்ட",1,"Vetta","desired (that one wished)"],["பொழுதின்",1,"Pozhudhin","at the time (when)"],["அவையவை",1,"Avaiyavai","those very (things)"],["போலுமே",1,"Polume","are like / resemble; (emphatic/assertive)"],["தோட்டார்",2,"Thottaar","flower-petal/blossom; filled/decked with"],["கதுப்பினாள்",2,"Kadhuppinaal","she of flower-decked tresses"],["தோள்",2,"Thol","shoulders/arms"]]},{"n":1106,"l":["உறுதோறு உயிர்தளிர்ப்பத் தீண்டலால் பேதைக்கு","அமிழ்தின் இயன்றன தோள்."],"w":[["உறுதோறு",1,"Urudhoru","each time (we) embrace"],["உயிர்தளிர்ப்பத்",1,"Uyirdhalirppath","life/soul; so as to sprout/revive"],["தீண்டலால்",1,"Theentalaal","by (the) touching"],["பேதைக்கு",1,"Pedhaikku","for the (naive) maiden"],["அமிழ்தின்",2,"Amizhdhin","of/with nectar"],["இயன்றன",2,"Iyandrana","were made/formed"],["தோள்",2,"Thol","shoulders/arms"]]},{"n":1107,"l":["தம்மில் இருந்து தமதுபாத்து உண்டற்றால்","அம்மா அரிவை முயக்கு."],"w":[["தம்மில்",1,"Thammil","one's own; in (the) home"],["இருந்து",1,"Irundhu","being/staying"],["தமதுபாத்து",1,"Thamadhupaaththu","one's own (earnings); having shared/divided"],["உண்டற்றால்",1,"Untatraal","eating; like / similar to; (asai particle)"],["அம்மா",2,"Ammaa","beautiful (qualifying); dark/mango-hued (complexion)"],["அரிவை",2,"Arivai","young woman"],["முயக்கு",2,"Muyakku","embrace"]]},{"n":1108,"l":["வீழும் இருவர்க்கு இனிதே வளியிடை","போழப் படாஅ முயக்கு."],"w":[["வீழும்",1,"Veezhum","who love (each other)"],["இருவர்க்கு",1,"Iruvarkku","to the two (lovers)"],["இனிதே",1,"Inidhe","sweet/pleasant; (emphatic/assertive)"],["வளியிடை",1,"Valiyitai","wind/air; in between"],["போழப்",2,"Pozhap","to split/pass through"],["படாஅ",2,"Pataaa","that does not get (split)"],["முயக்கு",2,"Muyakku","embrace"]]},{"n":1109,"l":["ஊடல் உணர்தல் புணர்தல் இவைகாமம்","கூடியார் பெற்ற பயன்."],"w":[["ஊடல்",1,"Ootal","sulking/love-quarrel"],["உணர்தல்",1,"Unardhal","reconciliation/realizing"],["புணர்தல்",1,"Punardhal","union/clasping"],["இவைகாமம்",1,"Ivaikaamam","these; love/desire"],["கூடியார்",2,"Kootiyaar","those who united (in love)"],["பெற்ற",2,"Petra","(that they) obtained"],["பயன்",2,"Payan","benefit(s)/fruit"]]},{"n":1110,"l":["அறிதோறு அறியாமை கண்டற்றால் காமம்","செறிதோறும் சேயிழை மாட்டு."],"w":[["அறிதோறு",1,"Aridhoru","as one learns (each time)"],["அறியாமை",1,"Ariyaamai","(prior) ignorance"],["கண்டற்றால்",1,"Kantatraal","having seen/perceived; like / similar to; (asai particle)"],["காமம்",1,"Kaamam","love/desire"],["செறிதோறும்",2,"Seridhorum","every time (we) unite closely"],["சேயிழை",2,"Seyizhai","she of red/fine jewels (=she)"],["மாட்டு",2,"Maattu","in/at (locative)"]]}]}