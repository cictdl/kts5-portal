{"n":39,"kurals":[{"n":381,"l":["படைகுடி கூழ்அமைச்சு நட்பரண் ஆறும்","உடையான் அரசருள் ஏறு."],"w":[["படைகுடி",1,"Pataikuti","army; citizenry / people"],["கூழ்அமைச்சு",1,"Koozhamaichchu","wealth / treasury; ministers / council"],["நட்பரண்",1,"Natparan","alliance / friendship; fortress"],["ஆறும்",1,"Aarum","six; and (inclusive)"],["உடையான்",2,"Utaiyaan","he who possesses"],["அரசருள்",2,"Arasarul","among kings; in / among (locative)"],["ஏறு",2,"Eru","male of the species — here lion of kings (உரை)"]]},{"n":382,"l":["அஞ்சாமை ஈகை அறிவூக்கம் இந்நான்கும்","எஞ்சாமை வேந்தர்க் கியல்பு."],"w":[["அஞ்சாமை",1,"Anjaamai","fearlessness / courage"],["ஈகை",1,"Eekai","liberality / giving"],["அறிவூக்கம்",1,"Arivookkam","wisdom / knowledge; zeal / energy"],["இந்நான்கும்",1,"Innaankum","this (proximal demonstrative); four; and / all (inclusive)"],["எஞ்சாமை",2,"Enjaamai","not falling short / completeness"],["வேந்தர்க்",2,"Vendhark","for kings; to / for (dative)"],["கியல்பு",2,"Kiyalpu","natural quality / proper trait"]]},{"n":383,"l":["தூங்காமை கல்வி துணிவுடைமை இம்மூன்றும்","நீங்கா நிலனாள் பவர்க்கு."],"w":[["தூங்காமை",1,"Thoongaamai","non-procrastination / alertness"],["கல்வி",1,"Kalvi","learning"],["துணிவுடைமை",1,"Thunivutaimai","courage / resolve; possession of"],["இம்மூன்றும்",1,"Immoondrum","this (proximal); three; and / all (inclusive)"],["நீங்கா",2,"Neengaa","not departing / inseparable (qualifies the three traits)"],["நிலனாள்",2,"Nilanaal","the land (object of ruling)"],["பவர்க்கு",2,"Pavarkku","for those who rule; to / for (dative)"]]},{"n":384,"l":["அறனிழுக்கா தல்லவை நீக்கி மறனிழுக்கா","மானம் உடைய தரசு."],"w":[["அறனிழுக்கா",1,"Aranizhukkaa","virtue / dharma; without swerving (from virtue)"],["தல்லவை",1,"Thallavai","things that are not (the wrong / non-virtuous things)"],["நீக்கி",1,"Neekki","having removed"],["மறனிழுக்கா",1,"Maranizhukkaa","valour / bravery; not swerving (from valour) — modifies மானம்"],["மானம்",2,"Maanam","honour / self-respect"],["உடைய",2,"Utaiya","that which possesses"],["தரசு",2,"Tharasu","kingship / the king (rule)"]]},{"n":385,"l":["இயற்றலும் ஈட்டலுங் காத்தலும் காத்த","வகுத்தலும் வல்ல தரசு."],"w":[["இயற்றலும்",1,"Iyatralum","producing (revenue); and (inclusive)"],["ஈட்டலுங்",1,"Eettalung","amassing / accumulating; and (inclusive)"],["காத்தலும்",1,"Kaaththalum","guarding; and (inclusive)"],["காத்த",1,"Kaaththa","that which was guarded (modifies வகுத்தல்)"],["வகுத்தலும்",2,"Vakuththalum","apportioning / distributing; and (inclusive)"],["வல்ல",2,"Valla","is capable / skilled"],["தரசு",2,"Tharasu","the king / kingship"]]},{"n":386,"l":["காட்சிக் கெளியன் கடுஞ்சொல்லன் அல்லனேல்","மீக்கூறும் மன்னன் நிலம்"],"w":[["காட்சிக்",1,"Kaatchik","for seeing / for audience; to / for (dative)"],["கெளியன்",1,"Keliyan","(he) is easy / accessible"],["கடுஞ்சொல்லன்",1,"Katunjollan","harsh word; (he) is one of harsh words (predicative -அன்)"],["அல்லனேல்",1,"Allanel","if (he) is not"],["மீக்கூறும்",2,"Meekkoorum","(the world) will exalt / praise"],["மன்னன்",2,"Mannan","king('s)"],["நிலம்",2,"Nilam","land / realm"]]},{"n":387,"l":["இன்சொலால் ஈத்தளிக்க வல்லார்க்குத் தன்சொலால்","தான்கண் டனைத்திவ் வுலகு."],"w":[["இன்சொலால்",1,"Insolaal","with sweet word; by / with (instrumental)"],["ஈத்தளிக்க",1,"Eeththalikka","having given; so as to protect / cherish"],["வல்லார்க்குத்",1,"Vallaarkkuth","for those capable; to / for (dative)"],["தன்சொலால்",1,"Thansolaal","his / one's own; word; by / with (instrumental)"],["தான்கண்",2,"Thaankan","itself (the world); having seen / regarded"],["டனைத்திவ்",2,"Tanaiththiv","all that much / to that extent; this"],["வுலகு",2,"Vulaku","world"]]},{"n":388,"l":["முறைசெய்து காப்பாற்றும் மன்னவன் மக்கட்கு","இறையென்று வைக்கப் படும்."],"w":[["முறைசெய்து",1,"Muraiseydhu","justice / due order; having done / administering"],["காப்பாற்றும்",1,"Kaappaatrum","(who) protects — modifies மன்னவன்"],["மன்னவன்",1,"Mannavan","king"],["மக்கட்கு",1,"Makkatku","to the people; to / for (dative)"],["இறையென்று",2,"Iraiyendru","god / lord / chief; (saying / regarding) as"],["வைக்கப்",2,"Vaikkap","to be regarded / placed"],["படும்",2,"Patum","will be (passive auxiliary)"]]},{"n":389,"l":["செவிகைப்பச் சொற்பொறுக்கும் பண்புடை வேந்தன்","கவிகைக்கீழ்த் தங்கும் உலகு."],"w":[["செவிகைப்பச்",1,"Sevikaippach","ear; so as to taste bitter (to the ear)"],["சொற்பொறுக்கும்",1,"Chorporukkum","word(s); (who) endures — modifies வேந்தன்"],["பண்புடை",1,"Panputai","good quality; possessing (modifies வேந்தன்)"],["வேந்தன்",1,"Vendhan","king('s)"],["கவிகைக்கீழ்த்",2,"Kavikaikkeezhth","(royal) parasol / umbrella; under / beneath"],["தங்கும்",2,"Thangum","will abide / dwell"],["உலகு",2,"Ulaku","world (here: people of the world)"]]},{"n":390,"l":["கொடையளி செங்கோல் குடியோம்பல் நான்கும்","உடையானாம் வேந்தர்க் கொளி."],"w":[["கொடையளி",1,"Kotaiyali","bounty / giving; grace / compassion"],["செங்கோல்",1,"Sengol","sceptre / just rule"],["குடியோம்பல்",1,"Kutiyompal","the people / subjects; cherishing / protecting"],["நான்கும்",1,"Naankum","four; and / all (inclusive)"],["உடையானாம்",2,"Utaiyaanaam","he who possesses (with copular ஆம்)"],["வேந்தர்க்",2,"Vendhark","for / among kings; to / for (dative)"],["கொளி",2,"Koli","light / lamp"]]}]}