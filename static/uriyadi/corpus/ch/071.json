{"n":71,"kurals":[{"n":701,"l":["கூறாமை நோக்கிக் குறிப்பறிவான் எஞ்ஞான்றும்","மாறாநீர் வையக் கணி."],"w":[["கூறாமை",1,"Kooraamai","without telling"],["நோக்கிக்",1,"Nokkik","on looking"],["குறிப்பறிவான்",1,"Kuripparivaan","inner thought; he who knows"],["எஞ்ஞான்றும்",1,"Egngnaandrum","every time; ever (inclusive)"],["மாறாநீர்",2,"Maaraaneer","unchanging (water); water/sea"],["வையக்",2,"Vaiyak","the world"],["கணி",2,"Kani","ornament"]]},{"n":702,"l":["ஐயப் படாஅது அகத்தது உணர்வானைத்","தெய்வத்தோ டொப்பக் கொளல்."],"w":[["ஐயப்",1,"Aiyap","doubt"],["படாஅது",1,"Pataaadhu","without falling (into doubt)"],["அகத்தது",1,"Akaththadhu","that which is within"],["உணர்வானைத்",1,"Unarvaanaith","him who perceives"],["தெய்வத்தோ",2,"Theyvaththo","with God"],["டொப்பக்",2,"Toppak","equally / as alike"],["கொளல்",2,"Kolal","(should) accept/take"]]},{"n":703,"l":["குறிப்பிற் குறிப்புணர் வாரை உறுப்பினுள்","யாது கொடுத்தும் கொளல்."],"w":[["குறிப்பிற்",1,"Kurippir","by a sign"],["குறிப்புணர்",1,"Kurippunar","(inner) thought; perceiving"],["வாரை",1,"Vaarai","him who (perceives)"],["உறுப்பினுள்",1,"Uruppinul","among the parts/resources"],["யாது",2,"Yaadhu","whatever"],["கொடுத்தும்",2,"Kotuththum","having given; even (concessive)"],["கொளல்",2,"Kolal","(should) take as ally"]]},{"n":704,"l":["குறித்தது கூறாமைக் கொள்வாரோ டேனை","உறுப்போ ரனையரால் வேறு."],"w":[["குறித்தது",1,"Kuriththadhu","that which was intended"],["கூறாமைக்",1,"Kooraamaik","without telling"],["கொள்வாரோ",1,"Kolvaaro","those who grasp; with"],["டேனை",1,"Tenai","the others"],["உறுப்போ",2,"Uruppo","by limb/form; (emphatic ō)"],["ரனையரால்",2,"Ranaiyaraal","they are alike; (expletive āl)"],["வேறு",2,"Veru","different (in wisdom)"]]},{"n":705,"l":["குறிப்பிற் குறிப்புணரா வாயின் உறுப்பினுள்","என்ன பயத்தவோ கண்?"],"w":[["குறிப்பிற்",1,"Kurippir","by a sign"],["குறிப்புணரா",1,"Kurippunaraa","(inner) thought; not perceiving"],["வாயின்",1,"Vaayin","if it be"],["உறுப்பினுள்",1,"Uruppinul","among the organs"],["என்ன",2,"Enna","what"],["பயத்தவோ",2,"Pay