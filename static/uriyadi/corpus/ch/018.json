{"n":18,"kurals":[{"n":171,"l":["நடுவின்றி நன்பொருள் வெஃகின் குடிபொன்றிக்","குற்றமும் ஆங்கே தரும்."],"w":[["நடுவின்றி",1,"Natuvindri","impartiality/justice; being without"],["நன்பொருள்",1,"Nanporul","good/honest; wealth"],["வெஃகின்",1,"Veqkin","if (one) covets"],["குடிபொன்றிக்",1,"Kutipondrik","family/household; perishing"],["குற்றமும்",2,"Kutramum","fault/blame; also/even"],["ஆங்கே",2,"Aange","there/then; (emphatic) right then"],["தரும்",2,"Tharum","(it) will give/bring"]]},{"n":172,"l":["படுபயன் வெஃகிப் பழிப்படுவ செய்யார்","நடுவன்மை நாணு பவர்."],"w":[["படுபயன்",1,"Patupayan","accruing/resulting; benefit/profit"],["வெஃகிப்",1,"Veqkip","having coveted"],["பழிப்படுவ",1,"Pazhippatuva","blameworthy things"],["செய்யார்",1,"Seyyaar","(they) will not do"],["நடுவன்மை",2,"Natuvanmai","injustice/partiality"],["நாணு",2,"Naanu","who feel shame"],["பவர்",2,"Pavar","those who"]]},{"n":173,"l":["சிற்றின்பம் வெஃகி அறனல்ல செய்யாரே","மற்றின்பம் வேண்டு பவர்."],"w":[["சிற்றின்பம்",1,"Sitrinpam","petty/small; pleasure"],["வெஃகி",1,"Veqki","having craved"],["அறனல்ல",1,"Aranalla","virtue; (things) that are not virtue"],["செய்யாரே",1,"Seyyaare","(they) will not do; (emphatic/assertive)"],["மற்றின்பம்",2,"Matrinpam","the other / moreover; (other) bliss"],["வேண்டு",2,"Ventu","who desire"],["பவர்",2,"Pavar","those who"]]},{"n":174,"l":["இலமென்று வெஃகுதல் செய்யார் புலம்வென்ற","புன்மையில் காட்சி யவர்."],"w":[["இலமென்று",1,"Ilamendru","we are without/poor; saying/thinking that"],["வெஃகுதல்",1,"Veqkudhal","coveting (act)"],["செய்யார்",1,"Seyyaar","(they) will not do"],["புலம்வென்ற",1,"Pulamvendra","the senses; having conquered"],["புன்மையில்",2,"Punmaiyil","meanness/flaw; without (flawless)"],["காட்சி",2,"Kaatchi","vision/insight"],["யவர்",2,"Yavar","those who have"]]},{"n":175,"l":["அஃகி அகன்ற அறிவென்னாம் யார்மாட்டும்","வெஃகி வெறிய செயின்."],"w":[["அஃகி",1,"Aqki","being subtle/refined"],["அகன்ற",1,"Akandra","broadened/expansive"],["அறிவென்னாம்",1,"Arivennaam","wisdom; what; is/will become"],["யார்மாட்டும்",1,"Yaarmaattum","whoever/anyone; in/towards; even/any"],["வெஃகி",2,"Veqki","having coveted"],["வெறிய",2,"Veriya","senseless/improper things"],["செயின்",2,"Seyin","if (one) does"]]},{"n":176,"l":["அருள்வெஃகி ஆற்றின்கண் நின்றான் பொருள்வெஃகிப்","பொல்லாத சூழக் கெடும்."],"w":[["அருள்வெஃகி",1,"Arulveqki","grace/compassion; desiring"],["ஆற்றின்கண்",1,"Aatrinkan","of the (righteous) path; in/at"],["நின்றான்",1,"Nindraan","(he) who stood/abided"],["பொருள்வெஃகிப்",1,"Porulveqkip","(others') wealth; coveting"],["பொல்லாத",2,"Pollaadha","evil/wicked (things)"],["சூழக்",2,"Soozhak","to scheme/contemplate"],["கெடும்",2,"Ketum","(he) will be ruined"]]},{"n":177,"l":["வேண்டற்க வெஃகியாம் ஆக்கம் விளைவயின்","மாண்டற் கரிதாம் பயன்."],"w":[["வேண்டற்க",1,"Ventarka","let (one) not desire"],["வெஃகியாம்",1,"Veqkiyaam","by coveting; that accrues"],["ஆக்கம்",1,"Aakkam","gain/prosperity"],["விளைவயின்",1,"Vilaivayin","yielding/result; at the time of"],["மாண்டற்",2,"Maantar","for being excellent"],["கரிதாம்",2,"Karidhaam","rare/difficult; that is/will be"],["பயன்",2,"Payan","fruit/benefit"]]},{"n":178,"l":["அஃகாமை செல்வத்திற்கு யாதெனின் வெஃகாமை","வேண்டும் பிறன்கைப் பொருள்."],"w":[["அஃகாமை",1,"Aqkaamai","non-diminishing (state)"],["செல்வத்திற்கு",1,"Selvaththirku","for wealth"],["யாதெனின்",1,"Yaadhenin","what; if (you ask)"],["வெஃகாமை",1,"Veqkaamai","not coveting (state)"],["வேண்டும்",2,"Ventum","is needed/wanted"],["பிறன்கைப்",2,"Pirankaip","another's; hand/possession"],["பொருள்",2,"Porul","wealth"]]},{"n":179,"l":["அறனறிந்து வெஃகா அறிவுடையார்ச் சேரும்","திறன்அறிந் தாங்கே திரு."],"w":[["அறனறிந்து",1,"Aranarindhu","virtue; having known"],["வெஃகா",1,"Veqkaa","not coveting (who)"],["அறிவுடையார்ச்",1,"Arivutaiyaarch","wisdom; the wise (acc.)"],["சேரும்",1,"Cherum","(Fortune) will join"],["திறன்அறிந்",2,"Thiranarin","the way/means; having known"],["தாங்கே",2,"Thaange","(expletive) itself; right (then)"],["திரு",2,"Thiru","Fortune (Lakshmi)"]]},{"n":180,"l":["இறலீனும் எண்ணாது வெஃகின் விறல்ஈனும்","வேண்டாமை என்னுஞ் செருக்கு."],"w":[["இறலீனும்",1,"Iraleenum","ruin/death; (it) yields"],["எண்ணாது",1,"Ennaadhu","without thinking"],["வெஃகின்",1,"Veqkin","if (one) covets"],["விறல்ஈனும்",1,"Viraleenum","victory/glory; (it) yields"],["வேண்டாமை",2,"Ventaamai","non-desire/contentment"],["என்னுஞ்",2,"Ennunj","called/named"],["செருக்கு",2,"Cherukku","pride/exalted state"]]}]}