{"n":85,"kurals":[{"n":841,"l":["அறிவின்மை இன்மையுள் இன்மை பிறிதின்மை","இன்மையா வையா துலகு."],"w":[["அறிவின்மை",1,"Arivinmai","want of wisdom"],["இன்மையுள்",1,"Inmaiyul","among wants; among/in (7th case)"],["இன்மை",1,"Inmai","(the worst) want"],["பிறிதின்மை",1,"Piridhinmai","other thing; other want"],["இன்மையா",2,"Inmaiyaa","as a want"],["வையா",2,"Vaiyaa","(the world) does not regard/place"],["துலகு",2,"Thulaku","not (neg ending split by yappu); the world"]]},{"n":842,"l":["அறிவிலான் நெஞ்சுவந்து ஈதல் பிறிதியாதும்","இல்லை பெறுவான் தவம்."],"w":[["அறிவிலான்",1,"Arivilaan","the unwise man"],["நெஞ்சுவந்து",1,"Nenjuvandhu","heart/mind; rejoicing"],["ஈதல்",1,"Eedhal","giving (act of)"],["பிறிதியாதும்",1,"Piridhiyaadhum","any other (cause); anything; even/at all (emphatic)"],["இல்லை",2,"Illai","there is not"],["பெறுவான்",2,"Peruvaan","the receiver's"],["தவம்",2,"Thavam","merit/good deed (of receiver)"]]},{"n":843,"l":["அறிவிலார் தாந்தம்மைப் பீழிக்கும் பீழை","செறுவார்க்கும் செய்தல் அரிது."],"w":[["அறிவிலார்",1,"Arivilaar","the unwise (ones)"],["தாந்தம்மைப்",1,"Thaandhammaip","they themselves; themselves (obj); accusative marker"],["பீழிக்கும்",1,"Peezhikkum","that torments"],["பீழை",1,"Peezhai","the torment/affliction"],["செறுவார்க்கும்",2,"Seruvaarkkum","even for foes; dative marker; even (concessive)"],["செய்தல்",2,"Seydhal","to do/inflict"],["அரிது",2,"Aridhu","is difficult/rare"]]},{"n":844,"l":["வெண்மை எனப்படுவ தியாதெனின் ஒண்மை","உடையம்யாம் என்னும் செருக்கு."],"w":[["வெண்மை",1,"Venmai","folly/shallow-mindedness"],["எனப்படுவ",1,"Enappatuva","that which is called"],["தியாதெனின்",1,"Thiyaadhenin","that-which (neuter ending split by yappu); what; if (one) asks"],["ஒண்மை",1,"Onmai","wisdom/brilliance"],["உடையம்யாம்",2,"Utaiyamyaam","we possess; we"],["என்னும்",2,"Ennum","that says/thinks"],["செருக்கு",2,"Serukku","pride/conceit"]]},{"n":845,"l":["கல்லாத மேற்கொண் டொழுகல் கசடற","வல்லதூஉம் ஐயம் தரும்."],"w":[["கல்லாத",1,"Kallaadha","unlearned (things)"],["மேற்கொண்",1,"Merkon","upon (oneself); having taken up"],["டொழுகல்",1,"Tozhukal","having (verbal-ending split by yappu); behaving/conducting"],["கசடற",1,"Kasatara","fault/flaw; free of (faults)"],["வல்லதூஉம்",2,"Valladhooum","that which (one) is skilled in; even (concessive)"],["ஐயம்",2,"Aiyam","doubt"],["தரும்",2,"Tharum","will give/cause"]]},{"n":846,"l":["அற்றம் மறைத்தலோ புல்லறிவு தம்வயின்","குற்றம் மறையா வழி."],"w":[["அற்றம்",1,"Atram","nakedness/private parts"],["மறைத்தலோ",1,"Maraiththalo","the concealing; interrogative/emphatic ō"],["புல்லறிவு",1,"Pullarivu","shallow/petty wisdom (folly)"],["தம்வயின்",1,"Thamvayin","their (own); at/in (locative)"],["குற்றம்",2,"Kutram","fault/flaw"],["மறையா",2,"Maraiyaa","without concealing/removing"],["வழி",2,"Vazhi","when/in the case (that)"]]},{"n":847,"l":["அருமறை சோரும் அறிவிலான் செய்யும்","பெருமிறை தானே தனக்கு."],"w":[["அருமறை",1,"Arumarai","rare/precious; secret/sacred lore"],["சோரும்",1,"Sorum","who lets slip/divulges"],["அறிவிலான்",1,"Arivilaan","the unwise man"],["செய்யும்",1,"Seyyum","that (he) does/inflicts"],["பெருமிறை",2,"Perumirai","great; harm/injury"],["தானே",2,"Thaane","himself; indeed (emphatic)"],["தனக்கு",2,"Thanakku","to himself; dative marker"]]},{"n":848,"l":["ஏவவும் செய்கலான் தான்தேறான் அவ்வுயிர்","போஒம் அளவுமோர் நோய்."],"w":[["ஏவவும்",1,"Evavum","though (others) urge; even though (concessive)"],["செய்கலான்",1,"Seykalaan","(he) does not do"],["தான்தேறான்",1,"Thaandheraan","himself; does not discern/realize"],["அவ்வுயிர்",1,"Avvuyir","that; that life/soul"],["போஒம்",2,"Poom","(until it) departs"],["அளவுமோர்",2,"Alavumor","until the extent (that); up to/until (inclusive); a (single)"],["நோய்",2,"Noi","a disease/plague"]]},{"n":849,"l":["காணாதான் காட்டுவான் தான்காணான் காணாதான்","கண்டானாம் தான்கண்ட வாறு."],"w":[["காணாதான்",1,"Kaanaadhaan","to the one who cannot see"],["காட்டுவான்",1,"Kaattuvaan","the one who shows/teaches"],["தான்காணான்",1,"Thaankaanaan","himself; does not see"],["காணாதான்",1,"Kaanaadhaan","the one who cannot see"],["கண்டானாம்",2,"Kantaanaam","one who has seen; becomes/is reckoned (as)"],["தான்கண்ட",2,"Thaankanta","he himself; that (he) saw/knew"],["வாறு",2,"Vaaru","the manner/way"]]},{"n":850,"l":["உலகத்தார் உண்டென்பது இல்லென்பான் வையத்து","அலகையா வைக்கப் படும்."],"w":[["உலகத்தார்",1,"Ulakaththaar","people of the world / the wise"],["உண்டென்பது",1,"Untenpadhu","(it) exists; that which (they) say exists"],["இல்லென்பான்",1,"Illenpaan","is not / no; he who says 'it is not'"],["வையத்து",1,"Vaiyaththu","in the world/earth"],["அலகையா",2,"Alakaiyaa","as a ghoul/demon"],["வைக்கப்",2,"Vaikkap","to be reckoned/placed"],["படும்",2,"Patum","will be (passive auxiliary)"]]}]}