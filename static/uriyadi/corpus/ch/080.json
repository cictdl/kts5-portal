{"n":80,"kurals":[{"n":791,"l":["நாடாது நட்டலிற் கேடில்லை நட்டபின்","வீடில்லை நட்பாள் பவர்க்கு."],"w":[["நாடாது",1,"Naataadhu","without investigating"],["நட்டலிற்",1,"Nattalir","than befriending"],["கேடில்லை",1,"Ketillai","harm; there is not"],["நட்டபின்",1,"Nattapin","having befriended; after"],["வீடில்லை",2,"Veetillai","release/escape; there is not"],["நட்பாள்",2,"Natpaal","for those who hold friendship (சொல் pos 2-3 இடையே பிரிந்தது)"],["பவர்க்கு",2,"Pavarkku","for those (who hold) — ஈற்றுப்பகுதி of நட்பாள்பவர்"]]},{"n":792,"l":["ஆய்ந்தாய்ந்து கொள்ளாதான் கேண்மை கடைமுறை","தான்சாம் துயரம் தரும்."],"w":[["ஆய்ந்தாய்ந்து",1,"Aaindhaaindhu","investigating (1st); investigating (repeated)"],["கொள்ளாதான்",1,"Kollaadhaan","he who does not take/form (his friendship = கேண்மை)"],["கேண்மை",1,"Kenmai","friendship (subject of தரும்)"],["கடைமுறை",1,"Kataimurai","at the end / ultimately"],["தான்சாம்",2,"Thaansaam","he himself; (that causes him) to die — qualifies துயரம்"],["துயரம்",2,"Thuyaram","grief (object of தரும்)"],["தரும்",2,"Tharum","(it) will give"]]},{"n":793,"l":["குணனும் குடிமையும் குற்றமும் குன்றா","இனனும் அறிந்தியாக்க நட்பு."],"w":[["குணனும்",1,"Kunanum","temper/character; and (enumerative)"],["குடிமையும்",1,"Kutimaiyum","good descent; and"],["குற்றமும்",1,"Kutramum","defect/fault; and"],["குன்றா",1,"Kundraa","undiminishing (qualifies இனன்)"],["இனனும்",2,"Inanum","kinsfolk/nature of kin; and"],["அறிந்தியாக்க",2,"Arindhiyaakka","having known; let (one) form/make"],["நட்பு",2,"Natpu","friendship (object of ஆக்க)"]]},{"n":794,"l":["குடிப்பிறந்து தன்கண் பழிநாணு வானைக்","கொடுத்தும் கொளல்வேண்டும் நட்பு."],"w":[["குடிப்பிறந்து",1,"Kutippirandhu","in (good) family; having been born"],["தன்கண்",1,"Thankan","his/one's own; in/upon (locative)"],["பழிநாணு",1,"Pazhinaanu","to blame/disgrace; him who fears (split across சீர்)"],["வானைக்",1,"Vaanaik","him (who) — accusative tail of நாணுவானை"],["கொடுத்தும்",2,"Kotuththum","by giving; even (concessive)"],["கொளல்வேண்டும்",2,"Kolalventum","the taking/forming; is necessary / ought"],["நட்பு",2,"Natpu","friendship (object of கொளல்)"]]},{"n":795,"l":["அழச்சொல்லி அல்லது இடித்து வழக்கறிய","வல்லார்நட்பு ஆய்ந்து கொளல்."],"w":[["அழச்சொல்லி",1,"Azhachcholli","so as to weep; having spoken/chiding"],["அல்லது",1,"Alladhu","otherwise / or else"],["இடித்து",1,"Itiththu","having reproved/chided"],["வழக்கறிய",1,"Vazhakkariya","worldly usage/custom; so as to know"],["வல்லார்நட்பு",2,"Vallaarnatpu","those who are able; friendship (of the able ones; source spells நடபு)"],["ஆய்ந்து",2,"Aaindhu","having investigated"],["கொளல்",2,"Kolal","(one) should take/form"]]},{"n":796,"l":["கேட்டினும் உண்டோர் உறுதி கிளைஞரை","நீட்டி அளப்பதோர் கோல்."],"w":[["கேட்டினும்",1,"Kettinum","in misfortune; even (concessive)"],["உண்டோர்",1,"Untor","there is; one (a)"],["உறுதி",1,"Urudhi","benefit/firmness"],["கிளைஞரை",1,"Kilaignarai","kinsmen/friends (object)"],["நீட்டி",2,"Neetti","extending/stretching out"],["அளப்பதோர்",2,"Alappadhor","that which measures; a (one)"],["கோல்",2,"Kol","measuring-rod"]]},{"n":797,"l":["ஊதியம் என்பது ஒருவற்குப் பேதையார்","கேண்மை ஒரீஇ விடல்."],"w":[["ஊதியம்",1,"Oodhiyam","profit/gain"],["என்பது",1,"Enpadhu","that which is called"],["ஒருவற்குப்",1,"Oruvarkup","for a (certain) person"],["பேதையார்",1,"Pedhaiyaar","of the foolish ones"],["கேண்மை",2,"Kenmai","friendship (object)"],["ஒரீஇ",2,"Oreei","having removed/avoided"],["விடல்",2,"Vital","the abandoning (predicate)"]]},{"n":798,"l":["உள்ளற்க உள்ளம் சிறுகுவ கொள்ளற்க","அல்லற்கண் ஆற்றறுப்பார் நட்பு."],"w":[["உள்ளற்க",1,"Ullarka","let (one) not think of"],["உள்ளம்",1,"Ullam","(the) mind/spirit (subject of சிறுகுவ)"],["சிறுகுவ",1,"Sirukuva","(things) that shrink/diminish"],["கொள்ளற்க",1,"Kollarka","let (one) not form/take"],["அல்லற்கண்",2,"Allarkan","in distress/affliction; at/in (locative)"],["ஆற்றறுப்பார்",2,"Aatraruppaar","those who cut off (their) support"],["நட்பு",2,"Natpu","friendship (object of கொள்ளற்க)"]]},{"n":799,"l":["கெடுங்காலைக் கைவிடுவார் கேண்மை அடுங்காலை","உள்ளினும் உள்ளஞ் சுடும்."],"w":[["கெடுங்காலைக்",1,"Ketungaalaik","(time) when ruin comes; time (locative)"],["கைவிடுவார்",1,"Kaivituvaar","those who abandon"],["கேண்மை",1,"Kenmai","friendship (object of உள்ளினும்)"],["அடுங்காலை",1,"Atungaalai","(time) when (death) kills; time (locative)"],["உள்ளினும்",2,"Ullinum","if (one) thinks of; even (concessive)"],["உள்ளஞ்",2,"Ullanj","(the) mind/heart (subject)"],["சுடும்",2,"Chutum","(it) will burn"]]},{"n":800,"l":["மருவுக மாசற்றார் கேண்மைஒன் றீத்தும்","ஒருவுக ஒப்பிலார் நட்பு."],"w":[["மருவுக",1,"Maruvuka","let (one) embrace/join"],["மாசற்றார்",1,"Maasatraar","the blameless ones (whose friendship)"],["கேண்மைஒன்",1,"Kenmaion","friendship (object of மருவுக); one thing (object of ஈத்தும்; சீர் split: ஒன்-றீத்தும்)"],["றீத்தும்",1,"Reeththum","even by giving; even (concessive)"],["ஒருவுக",2,"Oruvuka","let (one) shun/leave"],["ஒப்பிலார்",2,"Oppilaar","those without equal/likeness (whose friendship)"],["நட்பு",2,"Natpu","friendship (object of ஒருவுக)"]]}]}