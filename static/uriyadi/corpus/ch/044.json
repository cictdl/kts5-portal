{"n":44,"kurals":[{"n":431,"l":["செருக்குஞ் சினமும் சிறுமையும் இல்லார்","பெருக்கம் பெருமித நீர்த்து."],"w":[["செருக்குஞ்",1,"Serukkunj","pride/arrogance; and (enumerative)"],["சினமும்",1,"Chinamum","anger; and"],["சிறுமையும்",1,"Sirumaiyum","meanness/lust; and"],["இல்லார்",1,"Illaar","those who do not have"],["பெருக்கம்",2,"Perukkam","prosperity/abundance"],["பெருமித",2,"Perumidha","lofty/noble"],["நீர்த்து",2,"Neerththu","is of (such) quality"]]},{"n":432,"l":["இவறலும் மாண்பிறந்த மானமும் மாணா","உவகையும் ஏதம் இறைக்கு."],"w":[["இவறலும்",1,"Ivaralum","miserliness/stinginess; and"],["மாண்பிறந்த",1,"Maanpirandha","lacking dignity"],["மானமும்",1,"Maanamum","pride/honour; and"],["மாணா",1,"Maanaa","unworthy/improper"],["உவகையும்",2,"Uvakaiyum","joy/pleasure; and"],["ஏதம்",2,"Edham","fault/blemish"],["இறைக்கு",2,"Iraikku","to the king/ruler"]]},{"n":433,"l":["தினைத்துணையாங் குற்றம் வரினும் பனைத்துணையாக்","கொள்வர் பழிநாணு வார்."],"w":[["தினைத்துணையாங்",1,"Thinaiththunaiyaang","as small as a millet"],["குற்றம்",1,"Kutram","fault"],["வரினும்",1,"Varinum","even if it comes"],["பனைத்துணையாக்",1,"Panaiththunaiyaak","as large as a palmyra"],["கொள்வர்",2,"Kolvar","they will reckon"],["பழிநாணு",2,"Pazhinaanu","those who fear disgrace"],["வார்",2,"Vaar","those who (fear disgrace)"]]},{"n":434,"l":["குற்றமே காக்க பொருளாகக் குற்றமே","அற்றந் தரூஉம் பகை."],"w":[["குற்றமே",1,"Kutrame","fault (itself); emphatic ē"],["காக்க",1,"Kaakka","let (one) guard"],["பொருளாகக்",1,"Porulaakak","as the aim/object"],["குற்றமே",1,"Kutrame","fault (itself); emphatic ē"],["அற்றந்",2,"Atran","ruin/destruction"],["தரூஉம்",2,"Tharooum","that brings about"],["பகை",2,"Pakai","enemy/foe"]]},{"n":435,"l":["வருமுன்னர்க் காவாதான் வாழ்க்கை எரிமுன்னர்","வைத்தூறு போலக் கெடும்."],"w":[["வருமுன்னர்க்",1,"Varumunnark","that will come; before (in time)"],["காவாதான்",1,"Kaavaadhaan","he who does not guard"],["வாழ்க்கை",1,"Vaazhkkai","life"],["எரிமுன்னர்",1,"Erimunnar","fire; in front of"],["வைத்தூறு",2,"Vaiththooru","heap of straw"],["போலக்",2,"Polak","like"],["கெடும்",2,"Ketum","will perish"]]},{"n":436,"l":["தன்குற்றம் நீக்கிப் பிறர்குற்றங் காண்கிற்பின்","என்குற்ற மாகும் இறைக்கு?"],"w":[["தன்குற்றம்",1,"Thankutram","one's own; fault"],["நீக்கிப்",1,"Neekkip","having removed"],["பிறர்குற்றங்",1,"Pirarkutrang","others'; fault"],["காண்கிற்பின்",1,"Kaankirpin","if (one) is able to discern"],["என்குற்ற",2,"Enkutra","what; fault"],["மாகும்",2,"Maakum","will be"],["இறைக்கு",2,"Iraikku","to the king"]]},{"n":437,"l":["செயற்பால செய்யா திவறியான் செல்வம்","உயற்பால தன்றிக் கெடும்."],"w":[["செயற்பால",1,"Seyarpaala","things fit to be done"],["செய்யா",1,"Seyyaa","without doing"],["திவறியான்",1,"Thivariyaan","the miser (who hoards)"],["செல்வம்",1,"Selvam","wealth"],["உயற்பால",2,"Uyarpaala","fit to survive"],["தன்றிக்",2,"Thandrik","not being / without"],["கெடும்",2,"Ketum","will perish"]]},{"n":438,"l":["பற்றுள்ளம் என்னும் இவறன்மை எற்றுள்ளும்","எண்ணப் படுவதொன் றன்று."],"w":[["பற்றுள்ளம்",1,"Patrullam","attachment; heart/mind"],["என்னும்",1,"Ennum","called/named (so)"],["இவறன்மை",1,"Ivaranmai","stinginess/non-giving"],["எற்றுள்ளும்",1,"Etrullum","among which faults; in/among; even (among)"],["எண்ணப்",2,"Ennap","to be reckoned"],["படுவதொன்",2,"Patuvadhon","that which is (reckoned); one (thing)"],["றன்று",2,"Randru","is not"]]},{"n":439,"l":["வியவற்க எஞ்ஞான்றும் தன்னை நயவற்க","நன்றி பயவா வினை."],"w":[["வியவற்க",1,"Viyavarka","boast not"],["எஞ்ஞான்றும்",1,"Egngnaandrum","at all times; ever (inclusive)"],["தன்னை",1,"Thannai","oneself"],["நயவற்க",1,"Nayavarka","desire not"],["நன்றி",2,"Nandri","good/benefit"],["பயவா",2,"Payavaa","that yields no (good)"],["வினை",2,"Vinai","deed/action"]]},{"n":440,"l":["காதல காதல் அறியாமை உய்க்கிற்பின்","ஏதில ஏதிலார் நூல்."],"w":[["காதல",1,"Kaadhala","desirable things"],["காதல்",1,"Kaadhal","(one's) desire"],["அறியாமை",1,"Ariyaamai","(others') not knowing"],["உய்க்கிற்பின்",1,"Uykkirpin","if (one) can carry out"],["ஏதில",2,"Edhila","become futile/alien"],["ஏதிலார்",2,"Edhilaar","enemies/strangers"],["நூல்",2,"Nool","stratagem/scheme"]]}]}