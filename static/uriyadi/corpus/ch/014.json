{"n":14,"kurals":[{"n":131,"l":["ஒழுக்கம் விழுப்பந் தரலான் ஒழுக்கம்","உயிரினும் ஓம்பப் படும்."],"w":[["ஒழுக்கம்",1,"Ozhukkam","decorum/good conduct"],["விழுப்பந்",1,"Vizhuppan","dignity/eminence"],["தரலான்",1,"Tharalaan","because it gives (cause)"],["ஒழுக்கம்",1,"Ozhukkam","decorum (repeated)"],["உயிரினும்",2,"Uyirinum","than life (ஒப்பு — 5ஆம் வேற்றுமை); even (intensive um)"],["ஓம்பப்",2,"Ompap","to guard/cherish (செய்யப் வினையெச்சம், ஓம்பப்படும் செயப்பாட்டு)"],["படும்",2,"Patum","is/will be (passive aux)"]]},{"n":132,"l":["பரிந்தோம்பிக் காக்க ஒழுக்கம் தெரிந்தோம்பித்","தேரினும் அஃதே துணை."],"w":[["பரிந்தோம்பிக்",1,"Parindhompik","grieving/with care; cherishing/guarding"],["காக்க",1,"Kaakka","let (one) guard"],["ஒழுக்கம்",1,"Ozhukkam","decorum (object)"],["தெரிந்தோம்பித்",1,"Therindhompith","discerning/examining; cherishing/guarding"],["தேரினும்",2,"Therinum","if (one) examines (நிபந்தனை வினையெச்சம்); even (concessive um)"],["அஃதே",2,"Aqdhe","that (decorum); indeed (emphatic)"],["துணை",2,"Thunai","aid/companion"]]},{"n":133,"l":["ஒழுக்கம் உடைமை குடிமை இழுக்கம்","இழிந்த பிறப்பாய் விடும்."],"w":[["ஒழுக்கம்",1,"Ozhukkam","good conduct"],["உடைமை",1,"Utaimai","possession (of)"],["குடிமை",1,"Kutimai","(good) lineage/nobility"],["இழுக்கம்",1,"Izhukkam","(moral) lapse"],["இழிந்த",2,"Izhindha","low/debased (adj)"],["பிறப்பாய்",2,"Pirappaai","as birth/lineage"],["விடும்",2,"Vitum","becomes/ends up (aux)"]]},{"n":134,"l":["மறப்பினும் ஓத்துக் கொளலாகும் பார்ப்பான்","பிறப்பொழுக்கங் குன்றக் கெடும்."],"w":[["மறப்பினும்",1,"Marappinum","if (one) forgets (நிபந்தனை வினையெச்சம்); even (concessive)"],["ஓத்துக்",1,"Oththuk","having recited/learnt"],["கொளலாகும்",1,"Kolalaakum","taking/acquiring; is possible"],["பார்ப்பான்",1,"Paarppaan","the Brahmin/reciter"],["பிறப்பொழுக்கங்",2,"Pirappozhukkang","birth/lineage; conduct of (his) birth"],["குன்றக்",2,"Kundrak","if it diminishes"],["கெடும்",2,"Ketum","is ruined/lost"]]},{"n":135,"l":["அழுக்கா றுடையான்கண் ஆக்கம்போன்று இல்லை","ஒழுக்க மிலான்கண