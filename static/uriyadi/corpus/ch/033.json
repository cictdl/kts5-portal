{"n":33,"kurals":[{"n":321,"l":["அறவினை யாதெனின் கொல்லாமை கோறல்","பிறவினை எல்லாந் தரும்."],"w":[["அறவினை",1,"Aravinai","virtuous deed"],["யாதெனின்",1,"Yaadhenin","what; if (one) says"],["கொல்லாமை",1,"Kollaamai","non-killing (the act of not killing)"],["கோறல்",1,"Koral","killing"],["பிறவினை",2,"Piravinai","other (sinful) deeds"],["எல்லாந்",2,"Ellaan","all"],["தரும்",2,"Tharum","yields/causes"]]},{"n":322,"l":["பகுத்துண்டு பல்லுயிர் ஓம்புதல் நூலோர்","தொகுத்தவற்றுள் எல்லாந் தலை."],"w":[["பகுத்துண்டு",1,"Pakuththuntu","having shared; having eaten"],["பல்லுயிர்",1,"Palluyir","many; lives"],["ஓம்புதல்",1,"Ompudhal","protecting/cherishing"],["நூலோர்",1,"Noolor","the learned / authors of texts"],["தொகுத்தவற்றுள்",2,"Thokuththavatrul","of those compiled (virtues); among"],["எல்லாந்",2,"Ellaan","all"],["தலை",2,"Thalai","foremost/chief"]]},{"n":323,"l":["ஒன்றாக நல்லது கொல்லாமை மற்றதன்","பின்சாரப் பொய்யாமை நன்று."],"w":[["ஒன்றாக",1,"Ondraaka","as one/uniquely"],["நல்லது",1,"Nalladhu","is good"],["கொல்லாமை",1,"Kollaamai","non-killing"],["மற்றதன்",1,"Matradhan","and/then; its/of that"],["பின்சாரப்",2,"Pinsaarap","after/next; to follow/be next to"],["பொய்யாமை",2,"Poiyaamai","non-lying/truthfulness"],["நன்று",2,"Nandru","is good"]]},{"n":324,"l":["நல்லாறு எனப்படுவது யாதெனின் யாதொன்றும்","கொல்லாமை சூழும் நெறி."],"w":[["நல்லாறு",1,"Nallaaru","good path/way"],["எனப்படுவது",1,"Enappatuvadhu","that which is called"],["யாதெனின்",1,"Yaadhenin","what; if (one) says"],["யாதொன்றும்",1,"Yaadhondrum","any one (creature); even/any (inclusive)"],["கொல்லாமை",2,"Kollaamai","non-killing"],["சூழும்",2,"Soozhum","that upholds/considers"],["நெறி",2,"Neri","way/path"]]},{"n":325,"l":["நிலைஅஞ்சி நீத்தாருள் எல்லாம் கொலைஅஞ்சிக்","கொல்லாமை சூழ்வான் தலை."],"w":[["நிலைஅஞ்சி",1,"Nilaianji","the (transient) state of life; having feared"],["நீத்தாருள்",1,"Neeththaarul","those who renounced; among"],["எல்லாம்",1,"Ellaam","all"],["கொலைஅஞ்சிக்",1,"Kolaianjik","killing; having feared"],["கொல்லாமை",2,"Kollaamai","no