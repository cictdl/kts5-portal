{"n":68,"kurals":[{"n":671,"l":["சூழ்ச்சி முடிவு துணிவெய்தல் அத்துணிவு","தாழ்ச்சியுள் தங்குதல் தீது."],"w":[["சூழ்ச்சி",1,"Soozhchchi","deliberation/counsel"],["முடிவு",1,"Mutivu","conclusion/end"],["துணிவெய்தல்",1,"Thuniveydhal","resolve/decision; attaining"],["அத்துணிவு",1,"Aththunivu","that; resolve"],["தாழ்ச்சியுள்",2,"Thaazhchchiyul","delay; in/within"],["தங்குதல்",2,"Thangudhal","lingering/staying"],["தீது",2,"Theedhu","is evil/harmful"]]},{"n":672,"l":["தூங்குக தூங்கிச் செயற்பால தூங்கற்க","தூங்காது செய்யும் வினை."],"w":[["தூங்குக",1,"Thoonguka","let it be delayed"],["தூங்கிச்",1,"Thoongich","having delayed"],["செயற்பால",1,"Cheyarpaala","things fit to be done"],["தூங்கற்க",1,"Thoongarka","delay not"],["தூங்காது",2,"Thoongaadhu","without delay"],["செய்யும்",2,"Seyyum","(that one) does"],["வினை",2,"Vinai","action/deed"]]},{"n":673,"l":["ஒல்லும்வா யெல்லாம் வினைநன்றே ஒல்லாக்கால்","செல்லும்வாய் நோக்கிச் செயல்."],"w":[["ஒல்லும்வா",1,"Ollumvaa","(where) it is possible; place/occasion"],["யெல்லாம்",1,"Yellaam","all/totality"],["வினைநன்றே",1,"Vinainandre","action; is good; (emphatic)"],["ஒல்லாக்கால்",1,"Ollaakkaal","when not possible"],["செல்லும்வாய்",2,"Sellumvaai","(where) it will work; place/means"],["நோக்கிச்",2,"Nokkich","having observed"],["செயல்",2,"Cheyal","should do"]]},{"n":674,"l":["வினைபகை என்றிரண்டின் எச்சம் நினையுங்கால்","தீயெச்சம் போலத் தெறும்."],"w":[["வினைபகை",1,"Vinaipakai","action; enmity/foe"],["என்றிரண்டின்",1,"Endrirantin","saying/named-as; of the two"],["எச்சம்",1,"Echcham","remnant/leftover"],["நினையுங்கால்",1,"Ninaiyungaal","when considered; time/when"],["தீயெச்சம்",2,"Theeyechcham","fire; remnant of fire"],["போலத்",2,"Polath","like (comparison particle)"],["தெறும்",2,"Therum","will destroy/scorch"]]},{"n":675,"l":["பொருள்கருவி காலம் வினையிடனொடு ஐந்தும்","இருள்தீர எண்ணிச் செயல்."],"w":[["பொருள்கருவி",1,"Porulkaruvi","money/wealth; means/instrument"],["காலம்",1,"Kaalam","time"],["வினையிடனொடு",1,"Vinaiyitanotu","deed/action; place, along with; with/and"],["ஐந்தும்",1,"Aindhum","the five; (inclusive) all"],["இருள்தீர",2,"Iruldheera","darkness/doubt; so as to be removed"],["எண்ணிச்",2,"Ennich","having considered"],["செயல்",2,"Cheyal","should do"]]},{"n":676,"l":["முடிவும் இடையூறும் முற்றியாங்கு எய்தும்","படுபயனும் பார்த்துச் செயல்."],"w":[["முடிவும்",1,"Mutivum","completion/end; and (enumerative)"],["இடையூறும்",1,"Itaiyoorum","obstacle/hindrance; and"],["முற்றியாங்கு",1,"Mutriyaangu","having been completed; thus/then"],["எய்தும்",1,"Eydhum","(that) accrues"],["படுபயனும்",2,"Patupayanum","that occurs; benefit/profit; and"],["பார்த்துச்",2,"Paarththuch","having examined"],["செயல்",2,"Cheyal","should do"]]},{"n":677,"l":["செய்வினை செய்வான் செயன்முறை அவ்வினை","உள்ளறிவான் உள்ளம் கொளல்."],"w":[["செய்வினை",1,"Seyvinai","to-be-done; action to do"],["செய்வான்",1,"Seyvaan","the one who does"],["செயன்முறை",1,"Seyanmurai","of doing; method/way"],["அவ்வினை",1,"Avvinai","that; that action"],["உள்ளறிவான்",2,"Ullarivaan","the inner truth; the one who knows"],["உள்ளம்",2,"Ullam","mind/intent"],["கொளல்",2,"Kolal","should take/grasp"]]},{"n":678,"l":["வினையான் வினையாக்கிக் கோடல் நனைகவுள்","யானையால் யானையாத் தற்று."],"w":[["வினையான்",1,"Vinaiyaan","by an action; by/with"],["வினையாக்கிக்",1,"Vinaiyaakkik","(another) action; having made/produced"],["கோடல்",1,"Kotal","taking/accomplishing"],["நனைகவுள்",1,"Nanaikavul","wet/moist (with rut); cheek/temple (of elephant)"],["யானையால்",2,"Yaanaiyaal","by an elephant; by/with"],["யானையாத்",2,"Yaanaiyaath","(another) elephant"],["தற்று",2,"Thatru","is like that"]]},{"n":679,"l":["நட்டார்க்கு நல்ல செயலின் விரைந்ததே","ஒட்டாரை ஒட்டிக் கொளல்."],"w":[["நட்டார்க்கு",1,"Nattaarkku","to friends; to/for"],["நல்ல",1,"Nalla","good things"],["செயலின்",1,"Seyalin","than doing; than (comparison)"],["விரைந்ததே",1,"Viraindhadhe","the urgent thing; (emphatic)"],["ஒட்டாரை",2,"Ottaarai","the foes; (accusative)"],["ஒட்டிக்",2,"Ottik","having joined/befriended"],["கொளல்",2,"Kolal","should take/win over"]]},{"n":680,"l":["உறைசிறியார் உள்நடுங்கல் அஞ்சிக் குறைபெறின்","கொள்வர் பெரியார்ப் பணிந்து."],"w":[["உறைசிறியார்",1,"Uraisiriyaar","dwelling/abode; lesser/weak men"],["உள்நடுங்கல்",1,"Ulnatungal","inner (people/heart); trembling"],["அஞ்சிக்",1,"Anjik","having feared"],["குறைபெறின்",1,"Kuraiperin","the desired thing/request; if (they) obtain"],["கொள்வர்",2,"Kolvar","(they) will accept"],["பெரியார்ப்",2,"Periyaarp","the greater men"],["பணிந்து",2,"Panindhu","having bowed/submitted"]]}]}