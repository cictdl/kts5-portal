{"n":29,"kurals":[{"n":281,"l":["எள்ளாமை வேண்டுவான் என்பான் எனைத்தொன்றும்","கள்ளாமை காக்கதன் நெஞ்சு."],"w":[["எள்ளாமை",1,"Ellaamai","not being despised"],["வேண்டுவான்",1,"Ventuvaan","he who desires"],["என்பான்",1,"Enpaan","he who is so called"],["எனைத்தொன்றும்",1,"Enaiththondrum","however much; one (thing); even (inclusive)"],["கள்ளாமை",2,"Kallaamai","not stealing/defrauding"],["காக்கதன்",2,"Kaakkadhan","let (him) guard; his (own)"],["நெஞ்சு",2,"Nenju","heart/mind"]]},{"n":282,"l":["உள்ளத்தால் உள்ளலும் தீதே பிறன்பொருளைக்","கள்ளத்தால் கள்வேம் எனல்."],"w":[["உள்ளத்தால்",1,"Ullaththaal","by the mind"],["உள்ளலும்",1,"Ullalum","thinking; even"],["தீதே",1,"Theedhe","evil/bad; (emphatic) indeed"],["பிறன்பொருளைக்",1,"Piranporulaik","another's; the wealth/property"],["கள்ளத்தால்",2,"Kallaththaal","by fraud/deceit"],["கள்வேம்",2,"Kalvem","we will steal"],["எனல்",2,"Enal","the saying that"]]},{"n":283,"l":["களவினால் ஆகிய ஆக்கம் அளவிறந்து","ஆவது போலக் கெடும்."],"w":[["களவினால்",1,"Kalavinaal","by theft"],["ஆகிய",1,"Aakiya","that arose/became"],["ஆக்கம்",1,"Aakkam","gain/wealth"],["அளவிறந்து",1,"Alavirandhu","measure/limit; exceeding"],["ஆவது",2,"Aavadhu","that which grows"],["போலக்",2,"Polak","like/as if"],["கெடும்",2,"Ketum","will perish"]]},{"n":284,"l":["களவின்கண் கன்றிய காதல் விளைவின்கண்","வீயா விழுமம் தரும்."],"w":[["களவின்கண்",1,"Kalavinkan","in theft"],["கன்றிய",1,"Kandriya","that grew strong/matured"],["காதல்",1,"Kaadhal","desire/love"],["விளைவின்கண்",1,"Vilaivinkan","at the time of result"],["வீயா",2,"Veeyaa","undying/imperishable"],["விழுமம்",2,"Vizhumam","grief/distress"],["தரும்",2,"Tharum","will give"]]},{"n":285,"l":["அருள்கருதி அன்புடைய ராதல் பொருள்கருதிப்","பொச்சாப்புப் பார்ப்பார்கண் இல்."],"w":[["அருள்கருதி",1,"Arulkarudhi","grace/compassion; considering/valuing"],["அன்புடைய",1,"Anputaiya","love; having/possessing"],["ராதல்",1,"Raadhal","being/becoming"],["பொருள்கருதிப்",1,"Porulkarudhip","wealth; intending"],["பொச்சாப்புப்",2,"Pochchaappup","forgetfulness/heedlessness"],["பார்ப்பார்கண்",2,"Paarppaarkan","those who watch; in/at (locative)"],["இல்",2,"Il","is not/absent"]]},{"n":286,"l":["அளவின்கண் நின்றொழுகல் ஆற்றார் களவின்கண்","கன்றிய காத லவர்."],"w":[["அளவின்கண்",1,"Alavinkan","in the (right) measure"],["நின்றொழுகல்",1,"Nindrozhukal","standing (firm); conducting/living"],["ஆற்றார்",1,"Aatraar","are unable"],["களவின்கண்",1,"Kalavinkan","in theft"],["கன்றிய",2,"Kandriya","that grew strong"],["காத",2,"Kaadha","desire"],["லவர்",2,"Lavar","those who have"]]},{"n":287,"l":["களவென்னும் காரறி வாண்மை அளவென்னும்","ஆற்றல் புரிந்தார்கண் இல்."],"w":[["களவென்னும்",1,"Kalavennum","theft; called/named"],["காரறி",1,"Kaarari","dark/black; knowledge/mind"],["வாண்மை",1,"Vaanmai","the state of having"],["அளவென்னும்",1,"Alavennum","measure/moderation; called"],["ஆற்றல்",2,"Aatral","ability/strength"],["புரிந்தார்கண்",2,"Purindhaarkan","those who desired/practised; in/at (locative)"],["இல்",2,"Il","is not/absent"]]},{"n":288,"l":["அளவறிந்தார் நெஞ்சத் தறம்போல நிற்கும்","களவறிந்தார் நெஞ்சில் கரவு."],"w":[["அளவறிந்தார்",1,"Alavarindhaar","measure; those who know"],["நெஞ்சத்",1,"Nenjath","in the heart"],["தறம்போல",1,"Tharampola","virtue; like"],["நிற்கும்",1,"Nirkum","that stands/abides"],["களவறிந்தார்",2,"Kalavarindhaar","theft; those who know/practise"],["நெஞ்சில்",2,"Nenjil","in the heart"],["கரவு",2,"Karavu","deceit/concealment"]]},{"n":289,"l":["அளவல்ல செய்தாங்கே வீவர் களவல்ல","மற்றைய தேற்றா தவர்."],"w":[["அளவல்ல",1,"Alavalla","measure/proper things; (things) that are not (proper)"],["செய்தாங்கே",1,"Seydhaange","having done; right there/then; (emphatic)"],["வீவர்",1,"Veevar","will perish"],["களவல்ல",1,"Kalavalla","theft; other than"],["மற்றைய",2,"Matraiya","the other (ways)"],["தேற்றா",2,"Thetraa","not discerning/trusting"],["தவர்",2,"Thavar","those (people)"]]},{"n":290,"l":["கள்வார்க்குத் தள்ளும் உயிர்நிலை கள்ளார்க்குத்","தள்ளாது புத்தே ளுலகு."],"w":[["கள்வார்க்குத்",1,"Kalvaarkkuth","for thieves"],["தள்ளும்",1,"Thallum","slips away/fails"],["உயிர்நிலை",1,"Uyirnilai","life; abode/state (of life)"],["கள்ளார்க்குத்",1,"Kallaarkkuth","for those who do not steal (contextual)"],["தள்ளாது",2,"Thallaadhu","does not slip away"],["புத்தே",2,"Puththe","gods/deva"],["ளுலகு",2,"Lulaku","world (of the gods)"]]}]}