{"n":86,"kurals":[{"n":851,"l":["இகலென்ப எல்லா உயிர்க்கும் பகலென்னும்","பண்பின்மை பாரிக்கும் நோய்"],"w":[["இகலென்ப",1,"Ikalenpa","hostility, discord; (they) say"],["எல்லா",1,"Ellaa","all"],["உயிர்க்கும்",1,"Uyirkkum","to (all) lives; even/all (inclusive)"],["பகலென்னும்",1,"Pakalennum","divisiveness, discord; called/named"],["பண்பின்மை",2,"Panpinmai","lack of (good) quality, vice"],["பாரிக்கும்",2,"Paarikkum","that fosters/spreads"],["நோய்",2,"Noi","disease, plague"]]},{"n":852,"l":["பகல்கருதிப் பற்றா செயினும் இகல்கருதி","இன்னாசெய் யாமை தலை"],"w":[["பகல்கருதிப்",1,"Pakalkarudhip","divisiveness (obj.); intending, with a view to"],["பற்றா",1,"Patraa","unloving (things), hostile"],["செயினும்",1,"Seyinum","if (he) does; even (concessive)"],["இகல்கருதி",1,"Ikalkarudhi","hostility (obj.); harbouring, intending"],["இன்னாசெய்",2,"Innaasey","harm, evil (things); do(ing) — stem of செய்யாமை"],["யாமை",2,"Yaamai","not doing (harm)"],["தலை",2,"Thalai","best, supreme (predicate)"]]},{"n":853,"l":["இகலென்னும் எவ்வநோய் நீக்கின் தவலில்லாத்","தாவில் விளக்கம் தரும்"],"w":[["இகலென்னும்",1,"Ikalennum","hostility; called"],["எவ்வநோய்",1,"Evvanoi","affliction, distress; disease"],["நீக்கின்",1,"Neekkin","if (one) removes"],["தவலில்லாத்",1,"Thavalillaath","perishing, decay; without, imperishable"],["தாவில்",2,"Thaavil","blemish, fault; without (flawless)"],["விளக்கம்",2,"Vilakkam","brightness, fame"],["தரும்",2,"Tharum","(it) gives"]]},{"n":854,"l":["இன்பத்துள் இன்பம் பயக்கும் இகலென்னும்","துன்பத்துள் துன்பங் கெடின்"],"w":[["இன்பத்துள்",1,"Inpaththul","among pleasures"],["இன்பம்",1,"Inpam","pleasure, joy"],["பயக்கும்",1,"Payakkum","(it) yields"],["இகலென்னும்",1,"Ikalennum","hostility; called"],["துன்பத்துள்",2,"Thunpaththul","among sorrows"],["துன்பங்",2,"Thunpang","sorrow (worst of)"],["கெடின்",2,"Ketin","if (it) is destroyed"]]},{"n":855,"l":["இகலெதிர் சாய்ந்தொழுக வல்லாரை யாரே","மிகலூக்கும் தன்மை யவர்"],"w":[["இகலெதிர்",1,"Ikaledhir","hostility; facing, opposite"],["சாய்ந்தொழுக",1,"Saaindhozhuka","yielding, bending; to behave/conduct"],["வல்லாரை",1,"Vallaarai","those able (obj.)"],["யாரே",1,"Yaare","who; (interrogative emphatic)"],["மிகலூக்கும்",2,"Mikalookkum","overcoming, victory; that strives to (win)"],["தன்மை",2,"Thanmai","capacity, nature"],["யவர்",2,"Yavar","those who have (the capacity)"]]},{"n":856,"l":["இகலின் மிகலினிது என்பவன் வாழ்க்கை","தவலும் கெடலும் நணித்து"],"w":[["இகலின்",1,"Ikalin","by/through hostility"],["மிகலினிது",1,"Mikalinidhu","prevailing, winning; is sweet/good"],["என்பவன்",1,"Enpavan","he who says"],["வாழ்க்கை",1,"Vaazhkkai","life"],["தவலும்",2,"Thavalum","stumbling, faltering; and (conjunctive)"],["கெடலும்",2,"Ketalum","ruin, destruction; and (conjunctive)"],["நணித்து",2,"Naniththu","is near/imminent"]]},{"n":857,"l":["மிகல்மேவல் மெய்ப்பொருள் காணார் இகல்மேவல்","இன்னா அறிவி னவர்"],"w":[["மிகல்மேவல்",1,"Mikalmeval","victory (for); attaining, cause of"],["மெய்ப்பொருள்",1,"Meypporul","true; truth, principle"],["காணார்",1,"Kaanaar","(they) do not see"],["இகல்மேவல்",1,"Ikalmeval","hostility (obj.); desiring, embracing"],["இன்னா",2,"Innaa","evil, harmful"],["அறிவி",2,"Arivi","(with) intellect"],["னவர்",2,"Navar","those who have (such mind)"]]},{"n":858,"l":["இகலிற்கு எதிர்சாய்தல் ஆக்கம் அதனை","மிகலூக்கின் ஊக்குமாம் கேடு"],"w":[["இகலிற்கு",1,"Ikalirku","to/for hostility"],["எதிர்சாய்தல்",1,"Edhirsaaidhal","opposite, against; yielding, turning aside"],["ஆக்கம்",1,"Aakkam","gain, prosperity"],["அதனை",1,"Adhanai","it (obj.)"],["மிகலூக்கின்",2,"Mikalookkin","for increasing/winning; if (one) urges/fosters"],["ஊக்குமாம்",2,"Ookkumaam","(it) fosters/brings on; (emphatic/expletive)"],["கேடு",2,"Ketu","ruin, harm"]]},{"n":859,"l":["இகல்காணான் ஆக்கம் வருங்கால் அதனை","மிகல்காணும் கேடு தரற்கு"],"w":[["இகல்காணான்",1,"Ikalkaanaan","hostility (obj.); (he) does not regard"],["ஆக்கம்",1,"Aakkam","fortune, gain"],["வருங்கால்",1,"Varungaal","(when) coming; time, when"],["அதனை",1,"Adhanai","it (obj.)"],["மிகல்காணும்",2,"Mikalkaanum","increasing (of it); (he) seeks/regards"],["கேடு",2,"Ketu","ruin"],["தரற்கு",2,"Thararku","in order to bring (on himself)"]]},{"n":860,"l":["இகலானாம் இன்னாத எல்லாம் நகலானாம்","நன்னயம் என்னும் செருக்கு"],"w":[["இகலானாம்",1,"Ikalaanaam","by hostility; (they) come to be"],["இன்னாத",1,"Innaadha","harmful (things)"],["எல்லாம்",1,"Ellaam","all"],["நகலானாம்",1,"Nakalaanaam","by amity/friendliness; (it) comes to be"],["நன்னயம்",2,"Nannayam","good; justice, good-nature"],["என்னும்",2,"Ennum","called"],["செருக்கு",2,"Serukku","pride, exultation"]]}]}