{"n":52,"kurals":[{"n":511,"l":["நன்மையும் தீமையும் நாடி நலம்புரிந்த","தன்மையான் ஆளப் படும்."],"w":[["நன்மையும்",1,"Nanmaiyum","goodness; and (inclusive)"],["தீமையும்",1,"Theemaiyum","evil; and (inclusive)"],["நாடி",1,"Naati","having examined"],["நலம்புரிந்த",1,"Nalampurindha","good (acc.); that desired/cherished"],["தன்மையான்",2,"Thanmaiyaan","one of (such) nature"],["ஆளப்",2,"Aalap","to be employed/ruled"],["படும்",2,"Patum","will be (employed)"]]},{"n":512,"l":["வாரி பெருக்கி வளம்படுத்து உற்றவை","ஆராய்வான் செய்க வினை."],"w":[["வாரி",1,"Vaari","income source/revenue (acc.)"],["பெருக்கி",1,"Perukki","having multiplied"],["வளம்படுத்து",1,"Valampatuththu","wealth (acc.); having made/fostered"],["உற்றவை",1,"Utravai","the things that occur (obstacles, acc.)"],["ஆராய்வான்",2,"Aaraaivaan","one who will examine"],["செய்க",2,"Seyka","let (him) do"],["வினை",2,"Vinai","the deed/action (acc.)"]]},{"n":513,"l":["அன்பறிவு தேற்றம் அவாவின்மை இந்நான்கும்","நன்குடையான் கட்டே தெளிவு."],"w":[["அன்பறிவு",1,"Anparivu","love; wisdom"],["தேற்றம்",1,"Thetram","firmness/clarity"],["அவாவின்மை",1,"Avaavinmai","desire/craving; absence (non-craving)"],["இந்நான்கும்",1,"Innaankum","this; four; all (these four)"],["நன்குடையான்",2,"Nankutaiyaan","well/fully; one who possesses"],["கட்டே",2,"Katte","in/at (locative); indeed (emphatic)"],["தெளிவு",2,"Thelivu","(the means of) discernment"]]},{"n":514,"l":["எனைவகையான் தேறியக் கண்ணும் வினைவகையான்","வேறாகும் மாந்தர் பலர்."],"w":[["எனைவகையான்",1,"Enaivakaiyaan","what(ever) (how many); by (every) means"],["தேறியக்",1,"Theriyak","having ascertained"],["கண்ணும்",1,"Kannum","even when/in the case; even (concessive)"],["வினைவகையான்",1,"Vinaivakaiyaan","action; by manner of action"],["வேறாகும்",2,"Veraakum","different; that become"],["மாந்தர்",2,"Maandhar","people"],["பலர்",2,"Palar","many (persons)"]]},{"n":515,"l":["அறிந்தாற்றிச் செய்கிற்பாற்கு அல்லால் வினைதான்","சிறந்தானென்று ஏவற்பாற் றன்று."],"w":[["அறிந்தாற்றிச்",1,"Arindhaatrich","having known; having endured/accomplished"],["செய்கிற்பாற்கு",1,"Cheykirpaarku","to one who can do"],["அல்லால்",1,"Allaal","except/other than"],["வினைதான்",1,"Vinaidhaan","the task; (emphatic particle)"],["சிறந்தானென்று",2,"Sirandhaanendru","(one) excelled / superior; saying/thinking that"],["ஏவற்பாற்",2,"Evarpaar","commanding/assigning; fitting nature/duty"],["றன்று",2,"Randru","is not (proper)"]]},{"n":516,"l":["செய்வானை நாடி வினைநாடிக் காலத்தோடு","எய்த உணர்ந்து செயல்."],"w":[["செய்வானை",1,"Seyvaanai","the doer (acc.)"],["நாடி",1,"Naati","having examined"],["வினைநாடிக்",1,"Vinainaatik","the deed (acc.); having examined"],["காலத்தோடு",1,"Kaalaththotu","with the (proper) time"],["எய்த",2,"Eydha","so as to fit/attain"],["உணர்ந்து",2,"Unarndhu","having understood"],["செயல்",2,"Seyal","let (one) do / should do"]]},{"n":517,"l":["இதனை இதனால் இவன்முடிக்கும் என்றாய்ந்து","அதனை அவன்கண் விடல்."],"w":[["இதனை",1,"Ithanai","this (acc.)"],["இதனால்",1,"Ithanaal","by this (means)"],["இவன்முடிக்கும்",1,"Ivanmutikkum","this man; will accomplish"],["என்றாய்ந்து",1,"Endraaindhu","thus (quotative); having examined"],["அதனை",2,"Adhanai","that (acc.)"],["அவன்கண்",2,"Avankan","to/with him; in/at (locative)"],["விடல்",2,"Vital","let (one) entrust / should leave"]]},{"n":518,"l":["வினைக்குரிமை நாடிய பின்றை அவனை","அதற்குரிய னாகச் செயல்."],"w":[["வினைக்குரிமை",1,"","for the task; fitness/eligibility"],["நாடிய",1,"","having examined (that)"],["பின்றை",1,"","afterwards"],["அவனை",1,"","him (acc.)"],["அதற்குரிய",2,"","for that; fitting/proper"],["னாகச்",2,"","so as to become"],["செயல்",2,"","let (one) do / should do"]]},{"n":519,"l":["வினைக்கண் வினையுடையான் கேண்மைவே றாக","நினைப்பானை நீங்கும் திரு."],"w":[["வினைக்கண்",1,"Vinaikkan","in the task; in/at (locative)"],["வினையுடையான்",1,"Vinaiyutaiyaan","effort/action; one possessing (diligence)"],["கேண்மைவே",1,"Kenmaive","friendship/relationship (acc.)"],["றாக",1,"Raaka","(as) other/wrongly"],["நினைப்பானை",2,"Ninaippaanai","one who thinks (acc.)"],["நீங்கும்",2,"Neengum","will depart"],["திரு",2,"Thiru","wealth/fortune"]]},{"n":520,"l":["நாடோறும் நாடுக மன்னன் வினைசெய்வான்","கோடாமை கோடா துலகு."],"w":[["நாடோறும்",1,"Naatorum","day; every (distributive)"],["நாடுக",1,"Naatuka","let (him) examine"],["மன்னன்",1,"Mannan","the king"],["வினைசெய்வான்",1,"Vinaiseyvaan","the deed (acc.); the one who does (the worker)"],["கோடாமை",2,"Kotaamai","not deviating (so long as)"],["கோடா",2,"Kotaa","does not go astray"],["துலகு",2,"Thulaku","the world"]]}]}