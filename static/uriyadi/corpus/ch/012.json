{"n":12,"kurals":[{"n":111,"l":["தகுதி எனவொன்று நன்றே பகுதியால்","பாற்பட்டு ஒழுகப் பெறின்."],"w":[["தகுதி",1,"Thakudhi","fitness, equity"],["எனவொன்று",1,"Enavondru","saying / so-called (named); one (thing)"],["நன்றே",1,"Nandre","good thing; emphatic (தேற்றம்)"],["பகுதியால்",1,"Pakudhiyaal","by/through the division (party-wise); by/through (instrumental)"],["பாற்பட்டு",2,"Paarpattu","having conformed to (right) order"],["ஒழுகப்",2,"Ozhukap","to conduct / behave"],["பெறின்",2,"Perin","if (one) attains/obtains"]]},{"n":112,"l":["செப்பம் உடையவன் ஆக்கஞ் சிதைவின்றி","எச்சத்திற் கேமாப்பு உடைத்து."],"w":[["செப்பம்",1,"Seppam","uprightness, justice"],["உடையவன்",1,"Utaiyavan","he who possesses"],["ஆக்கஞ்",1,"Aakkanj","wealth, prosperity"],["சிதைவின்றி",1,"Chidhaivindri","destruction, ruin; without"],["எச்சத்திற்",2,"Echchaththir","for the posterity / heirs (what is left behind)"],["கேமாப்பு",2,"Kemaappu","security, protection"],["உடைத்து",2,"Utaiththu","possesses / is (having)"]]},{"n":113,"l":["நன்றே தரினும் நடுவிகந்தாம் ஆக்கத்தை","அன்றே யொழிய விடல்."],"w":[["நன்றே",1,"Nandre","good, benefit; even (சிறப்பு/தேற்றம்)"],["தரினும்",1,"Tharinum","if it gives; even though (இழிவுசிறப்பு)"],["நடுவிகந்தாம்",1,"Natuvikandhaam","the middle, impartiality; (the gain) that has deviated (from impartiality)"],["ஆக்கத்தை",1,"Aakkaththai","the gain/profit (acc.)"],["அன்றே",2,"Andre","that very (time), at once; emphatic (தேற்றம்)"],["யொழிய",2,"Yozhiya","so as to leave/abandon"],["விடல்",2,"Vital","abandoning (it is right to abandon)"]]},{"n":114,"l":["தக்கார் தகவிலர் என்பது அவரவர்","எச்சத்தாற் காணப் படும்."],"w":[["தக்கார்",1,"Thakkaar","the worthy (ones)"],["தகவிலர்",1,"Thakavilar","are unworthy / those-without-worth"],["என்பது",1,"Enpadhu","that which is said (the distinction)"],["அவரவர்",1,"Avaravar","each one's (respective)"],["எச்சத்தாற்",2,"Echchaththaar","by what is left behind (posterity/fame/blame)"],["காணப்",2,"Kaanap","so as to be seen (passive infinitive)"],["படும்",2,"Patum","will be (seen)"]]},{"n":115,"l":["கேடும் பெருக்கமும் இல்லல்ல நெஞ்சத்துக்","கோடாமை சான்றோர்க் கணி."],"w":[["கேடும்",1,"Ketum","loss, ruin; and (எண்ணும்மை)"],["பெருக்கமும்",1,"Perukkamum","increase, prosperity; and (எண்ணும்மை)"],["இல்லல்ல",1,"Illalla","the non-existent ones (things that are absent); are not (they are not absent things)"],["நெஞ்சத்துக்",1,"Nenjaththuk","in the heart/mind"],["கோடாமை",2,"Kotaamai","not swerving / impartiality (the not-bending)"],["சான்றோர்க்",2,"Saandrork","to the wise/noble"],["கணி",2,"Kani","ornament, adornment"]]},{"n":116,"l":["கெடுவல்யான் என்பது அறிகதன் நெஞ்சம்","நடுவொரீஇ அல்ல செயின்."],"w":[["கெடுவல்யான்",1,"Ketuvalyaan","I shall perish; I"],["என்பது",1,"Enpadhu","that (such a thought) as"],["அறிகதன்",1,"Arikadhan","let (him) know; his own"],["நெஞ்சம்",1,"Nenjam","heart, mind"],["நடுவொரீஇ",2,"Natuvoreei","the middle, impartiality; having departed/swerved (from); அளபெடை"],["அல்ல",2,"Alla","wrong things, that which is not (right)"],["செயின்",2,"Seyin","if (the mind) does"]]},{"n":117,"l":["கெடுவாக வையாது உலகம் நடுவாக","நன்றிக்கண் தங்கியான் தாழ்வு."],"w":[["கெடுவாக",1,"Ketuvaaka","as a ruin/downfall (to be reckoned)"],["வையாது",1,"Vaiyaadhu","without reckoning/regarding"],["உலகம்",1,"Ulakam","the world (the wise) — ஆகுபெயர்"],["நடுவாக",1,"Natuvaaka","being impartial / in justice"],["நன்றிக்கண்",2,"Nandrikkan","in virtue / the good path; in/at (locative உருபு)"],["தங்கியான்",2,"Thangiyaan","he who abode/remained (in virtue)"],["தாழ்வு",2,"Thaazhvu","lowliness, decline"]]},{"n":118,"l":["சமன்செய்து சீர்தூக்குங் கோல்போல் அமைந்தொருபால்","கோடாமை சான்றோர்க் கணி."],"w":[["சமன்செய்து",1,"Samanseydhu","balance, evenness; having made/set"],["சீர்தூக்குங்",1,"Seerdhookkung","weight, the goods (acc., உருபு மறைந்தது); that weighs"],["கோல்போல்",1,"Kolpol","rod, balance-beam; like (உவம உருபு)"],["அமைந்தொருபால்",1,"Amaindhorupaal","being composed/set; to one side"],["கோடாமை",2,"Kotaamai","not swerving (to one side) — the not-bending"],["சான்றோர்க்",2,"Saandrork","to the wise/noble"],["கணி",2,"Kani","ornament, adornment"]]},{"n":119,"l":["சொற்கோட்டம் இல்லது செப்பம் ஒருதலையா","உட்கோட்டம் இன்மை பெறின்."],"w":[["சொற்கோட்டம்",1,"Sorkottam","crookedness in speech"],["இல்லது",1,"Illadhu","that which is without (it)"],["செப்பம்",1,"Seppam","uprightness, justice"],["ஒருதலையா",1,"Orudhalaiyaa","being firm/certain (one-pointed)"],["உட்கோட்டம்",2,"Utkottam","inner crookedness (of mind)"],["இன்மை",2,"Inmai","absence, lack"],["பெறின்",2,"Perin","if (one) obtains/attains"]]},{"n":120,"l":["வாணிகம் செய்வார்க்கு வாணிகம் பேணிப்","பிறவும் தமபோல் செயின்."],"w":[["வாணிகம்",1,"Vaanikam","trade, commerce"],["செய்வார்க்கு",1,"Seyvaarkku","for those who do (trade)"],["வாணிகம்",1,"Vaanikam","the (proper) trade-way"],["பேணிப்",1,"Penip","cherishing, guarding"],["பிறவும்",2,"Piravum","other things (others' goods); also (சிறப்பும்மை)"],["தமபோல்",2,"Thamapol","one's own (goods); like (உவம உருபு)"],["செயின்",2,"Seyin","if (one) does/treats"]]}]}