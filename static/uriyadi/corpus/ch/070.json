{"n":70,"kurals":[{"n":691,"l":["அகலாது அணுகாது தீக்காய்வார் போல்க","இகல்வேந்தர்ச் சேர்ந்தொழுகு வார்."],"w":[["அகலாது",1,"Akalaadhu","without moving away"],["அணுகாது",1,"Anukaadhu","without approaching"],["தீக்காய்வார்",1,"Theekkaaivaar","fire (at the fire); those who warm themselves"],["போல்க",1,"Polka","let (them) be like"],["இகல்வேந்தர்ச்",2,"Ikalvendharch","hostility; kings (acc.)"],["சேர்ந்தொழுகு",2,"Cherndhozhuku","having joined; conducting"],["வார்",2,"Vaar","those who conduct themselves"]]},{"n":692,"l":["மன்னர் விழைப விழையாமை மன்னரால்","மன்னிய ஆக்கந் தரும்."],"w":[["மன்னர்",1,"Mannar","kings"],["விழைப",1,"Vizhaipa","things (they) desire"],["விழையாமை",1,"Vizhaiyaamai","not desiring (the act of)"],["மன்னரால்",1,"Mannaraal","by the king"],["மன்னிய",2,"Manniya","lasting / enduring"],["ஆக்கந்",2,"Aakkan","prosperity (acc.)"],["தரும்",2,"Tharum","will give"]]},{"n":693,"l":["போற்றின் அரியவை போற்றல் கடுத்தபின்","தேற்றுதல் யார்க்கும் அரிது."],"w":[["போற்றின்",1,"Potrin","if (one) guards / wishes to protect"],["அரியவை",1,"Ariyavai","grave / hard (to bear); those (things)"],["போற்றல்",1,"Potral","guarding (against)"],["கடுத்தபின்",1,"Katuththapin","having suspected; after"],["தேற்றுதல்",2,"Thetrudhal","convincing / clearing doubt"],["யார்க்கும்",2,"Yaarkkum","for anyone; even (inclusive)"],["அரிது",2,"Aridhu","is difficult"]]},{"n":694,"l":["செவிச்சொல்லும் சேர்ந்த நகையும் அவித்தொழுகல்","ஆன்ற பெரியா ரகத்து."],"w":[["செவிச்சொல்லும்",1,"Sevichchollum","(into the) ear; whispered word; and (conjunctive)"],["சேர்ந்த",1,"Serndha","joined / accompanying"],["நகையும்",1,"Nakaiyum","laughter / smile; and (conjunctive)"],["அவித்தொழுகல்",1,"Aviththozhukal","having suppressed; conduct / to conduct oneself"],["ஆன்ற",2,"Aandra","abundant / accomplished"],["பெரியா",2,"Periyaa","great ones"],["ரகத்து",2,"Rakaththu","in the presence of"]]},{"n":695,"l":["எப்பொருளும் ஓரார் தொடரார்மற் றப்பொருளை","விட்டக்கால் கேட்க மறை."],"w":[["எப்பொருளும்",1,"Epporulum","any matter; any (whole-inclusive)"],["ஓரார்",1,"Oraar","(they) heed not"],["தொடரார்மற்",1,"Thotaraarmar","(they) pursue not; moreover (expletive)"],["றப்பொருளை",1,"Rapporulai","that matter (acc.)"],["விட்டக்கால்",2,"Vittakkaal","when (he) lets out"],["கேட்க",2,"Ketka","let (one) hear"],["மறை",2,"Marai","secret"]]},{"n":696,"l":["குறிப்பறிந்து காலங் கருதி வெறுப்பில","வேண்டுப வேட்பச் சொலல்."],"w":[["குறிப்பறிந்து",1,"Kuripparindhu","(the) inner mood; having known"],["காலங்",1,"Kaalang","(the) time"],["கருதி",1,"Karudhi","having considered"],["வெறுப்பில",1,"Veruppila","things without dislike"],["வேண்டுப",2,"Ventupa","things (he) desires"],["வேட்பச்",2,"Vetpach","so that (he) likes"],["சொலல்",2,"Cholal","(one should) tell / the telling"]]},{"n":697,"l":["வேட்பன சொல்லி வினையில எஞ்ஞான்றும்","கேட்பினும் சொல்லா விடல்."],"w":[["வேட்பன",1,"Vetpana","things (he) desires"],["சொல்லி",1,"Solli","having told"],["வினையில",1,"Vinaiyila","useless / fruitless things"],["எஞ்ஞான்றும்",1,"Egngnaandrum","always / at all times; ever (whole-inclusive)"],["கேட்பினும்",2,"Ketpinum","even if (he) asks; even (concessive)"],["சொல்லா",2,"Sollaa","without telling"],["விடல்",2,"Vital","(one should) leave / refrain"]]},{"n":698,"l":["இளையர் இனமுறையர் என்றிகழார் நின்ற","ஒளியோடு ஒழுகப் படும்."],"w":[["இளையர்",1,"Ilaiyar","(they are) younger"],["இனமுறையர்",1,"Inamuraiyar","kin / class; (they are) of (such) relation"],["என்றிகழார்",1,"Endrikazhaar","saying (thus); (they) despise not"],["நின்ற",1,"Nindra","established / abiding"],["ஒளியோடு",2,"Oliyotu","with (their) lustre / fame"],["ஒழுகப்",2,"Ozhukap","so as to conduct"],["படும்",2,"Patum","it is fitting (impersonal)"]]},{"n":699,"l":["கொளப்பட்டேம் என்றெண்ணிக் கொள்ளாத செய்யார்","துளக்கற்ற காட்சி யவர்."],"w":[["கொளப்பட்டேம்",1,"Kolappattem","we have been accepted"],["என்றெண்ணிக்",1,"Endrennik","(thinking) thus; having thought"],["கொள்ளாத",1,"Kollaadha","unacceptable (things)"],["செய்யார்",1,"Seyyaar","(they) will not do"],["துளக்கற்ற",2,"Thulakkatra","wavering / agitation; free of"],["காட்சி",2,"Kaatchi","vision / clear knowledge"],["யவர்",2,"Yavar","those (who have)"]]},{"n":700,"l":["பழையம் எனக்கருதிப் பண்பல்ல செய்யும்","கெழுதகைமை கேடு தரும்."],"w":[["பழையம்",1,"Pazhaiyam","we are of old (acquaintance)"],["எனக்கருதிப்",1,"Enakkarudhip","(thinking) thus; having presumed"],["பண்பல்ல",1,"Panpalla","propriety / good quality; (things) that are not"],["செய்யும்",1,"Seyyum","that does / makes (one do)"],["கெழுதகைமை",2,"Kezhudhakaimai","(presumed) intimacy / liberty"],["கேடு",2,"Ketu","ruin"],["தரும்",2,"Tharum","will give"]]}]}