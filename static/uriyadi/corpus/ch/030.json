{"n":30,"kurals":[{"n":291,"l":["வாய்மை எனப்படுவது யாதெனின் யாதொன்றும்","தீமை இலாத சொலல்."],"w":[["வாய்மை",1,"Vaaimai","truth"],["எனப்படுவது",1,"Enappatuvadhu","that which is said to be"],["யாதெனின்",1,"Yaadhenin","what; if (one) says"],["யாதொன்றும்",1,"Yaadhondrum","any whatever; one (even a little); even (inclusive)"],["தீமை",2,"Theemai","evil/harm"],["இலாத",2,"Ilaadha","having none / free of"],["சொலல்",2,"Solal","speaking"]]},{"n":292,"l":["பொய்மையும் வாய்மை யிடத்த புரைதீர்ந்த","நன்மை பயக்கும் எனின்."],"w":[["பொய்மையும்",1,"Poimaiyum","falsehood; even (concessive)"],["வாய்மை",1,"Vaaimai","truth"],["யிடத்த",1,"Yitaththa","in the place/standing of"],["புரைதீர்ந்த",1,"Puraidheerndha","fault/flaw; removed/cleared"],["நன்மை",2,"Nanmai","good"],["பயக்கும்",2,"Payakkum","will yield/produce"],["எனின்",2,"Enin","if (it does)"]]},{"n":293,"l":["தன்நெஞ் சறிவது பொய்யற்க பொய்த்தபின்","தன்நெஞ்சே தன்னைச் சுடும்."],"w":[["தன்நெஞ்",1,"Thannenj","his own; heart/mind"],["சறிவது",1,"Charivadhu","that which (the heart) knows"],["பொய்யற்க",1,"Poiyarka","let one not lie"],["பொய்த்தபின்",1,"Poiththapin","having lied; after"],["தன்நெஞ்சே",2,"Thannenje","his own; heart/mind; itself (emphatic)"],["தன்னைச்",2,"Thannaich","himself (obj)"],["சுடும்",2,"Chutum","will burn/scorch"]]},{"n":294,"l":["உள்ளத்தாற் பொய்யா தொழுகின் உலகத்தார்","உள்ளத்து ளெல்லாம் உளன்."],"w":[["உள்ளத்தாற்",1,"Ullaththaar","by/with the mind"],["பொய்யா",1,"Poiyaa","without lying"],["தொழுகின்",1,"Thozhukin","if (one) conducts oneself"],["உலகத்தார்",1,"Ulakaththaar","people of the world"],["உள்ளத்து",2,"Ullaththu","in the heart"],["ளெல்லாம்",2,"Lellaam","all"],["உளன்",2,"Ulan","he exists/abides"]]},{"n":295,"l":["மனத்தொடு வாய்மை மொழியின் தவத்தொடு","தானஞ்செய் வாரின் தலை."],"w":[["மனத்தொடு",1,"Manaththotu","along with the mind"],["வாய்மை",1,"Vaaimai","truth (obj)"],["மொழியின்",1,"Mozhiyin","if (one) speaks"],["தவத்தொடு",1,"Thavaththotu","along with penance"],["தானஞ்செய்",2,"Thaananjey","charity (obj); doing"],["வாரின்",2,"Vaarin","than those who (do)"],["தலை",2,"Thalai","superior/foremost"]]},{"n":296,"l":["பொய்யாமை அன்ன புகழில்லை எய்யாமை","எல்லா அறமுந் தரும்."],"w":[["பொய்யாமை",1,"Poiyaamai","not-lying / truthfulness"],["அன்ன",1,"Anna","like/equal to"],["புகழில்லை",1,"Pukazhillai","fame; there is not"],["எய்யாமை",1,"Eyyaamai","unawares / unknowingly (it=truthfulness)"],["எல்லா",2,"Ellaa","all"],["அறமுந்",2,"Aramun","virtue; all (inclusive)"],["தரும்",2,"Tharum","will give"]]},{"n":297,"l":["பொய்யாமை பொய்யாமை ஆற்றின் அறம்பிற","செய்யாமை செய்யாமை நன்று."],"w":[["பொய்யாமை",1,"Poiyaamai","not-lying (truthfulness)"],["பொய்யாமை",1,"Poiyaamai","not-lying (repeated for emphasis)"],["ஆற்றின்",1,"Aatrin","if (one) is able/practises"],["அறம்பிற",1,"Arampira","virtue(s); other"],["செய்யாமை",2,"Seyyaamai","not-doing"],["செய்யாமை",2,"Seyyaamai","not-doing (repeated)"],["நன்று",2,"Nandru","is good"]]},{"n":298,"l":["புறந்தூய்மை நீரான் அமையும் அகந்தூய்மை","வாய்மையால் காணப் படும்."],"w":[["புறந்தூய்மை",1,"Purandhooimai","outer; purity"],["நீரான்",1,"Neeraan","by water"],["அமையும்",1,"Amaiyum","is achieved"],["அகந்தூய்மை",1,"Akandhooimai","inner; purity"],["வாய்மையால்",2,"Vaaimaiyaal","by truth"],["காணப்",2,"Kaanap","to be seen"],["படும்",2,"Patum","is (made) — passive aux."]]},{"n":299,"l":["எல்லா விளக்கும் விளக்கல்ல சான்றோர்க்குப்","பொய்யா விளக்கே விளக்கு."],"w":[["எல்லா",1,"Ellaa","all"],["விளக்கும்",1,"Vilakkum","lamp(s); even (all)"],["விளக்கல்ல",1,"Vilakkalla","lamp; are not"],["சான்றோர்க்குப்",1,"Saandrorkkup","for the noble/wise"],["பொய்யா",2,"Poiyaa","non-lying (lamp)"],["விளக்கே",2,"Vilakke","lamp; alone (emphatic)"],["விளக்கு",2,"Vilakku","(is the true) lamp"]]},{"n":300,"l":["யாமெய்யாக் கண்டவற்றுள் இல்லை எனைத்தொன்றும்","வாய்மையின் நல்ல பிற."],"w":[["யாமெய்யாக்",1,"Yaameyyaak","we; truly / as true"],["கண்டவற்றுள்",1,"Kantavatrul","among things (we) saw; among/within"],["இல்லை",1,"Illai","there is not"],["எனைத்தொன்றும்",1,"Enaiththondrum","of whatever measure; any one (thing); even (any at all)"],["வாய்மையின்",2,"Vaaimaiyin","than truth"],["நல்ல",2,"Nalla","good (ones)"],["பிற",2,"Pira","other (things)"]]}]}