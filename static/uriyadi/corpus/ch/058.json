{"n":58,"kurals":[{"n":571,"l":["கண்ணோட்டம் என்னும் கழிபெருங் காரிகை","உண்மையான் உண்டிவ் வுலகு."],"w":[["கண்ணோட்டம்",1,"Kannottam","benignity, kindly regard"],["என்னும்",1,"Ennum","which is called"],["கழிபெருங்",1,"Kazhiperung","exceedingly great"],["காரிகை",1,"Kaarikai","beauty, charm"],["உண்மையான்",2,"Unmaiyaan","because of (its) existence"],["உண்டிவ்",2,"Untiv","exists, is; this"],["வுலகு",2,"Vulaku","world"]]},{"n":572,"l":["கண்ணோட்டத் துள்ளது உலகியல் அஃதிலார்","உண்மை நிலக்குப் பொறை."],"w":[["கண்ணோட்டத்",1,"Kannottath","in benignity"],["துள்ளது",1,"Thulladhu","that which exists (in)"],["உலகியல்",1,"Ulakiyal","the way of the world"],["அஃதிலார்",1,"Aqdhilaar","that; those who lack"],["உண்மை",2,"Unmai","(their) being / living"],["நிலக்குப்",2,"Nilakkup","to the earth"],["பொறை",2,"Porai","burden, load"]]},{"n":573,"l":["பண்என்னாம் பாடற்கு இயைபின்றேல் கண்என்னாம்","கண்ணோட்டம் இல்லாத கண்."],"w":[["பண்என்னாம்",1,"Panennaam","melody, tune; what is the use?"],["பாடற்கு",1,"Paatarku","to/with the song"],["இயைபின்றேல்",1,"Iyaipindrel","concord, harmony; if there is not"],["கண்என்னாம்",1,"Kanennaam","eye; what is the use?"],["கண்ணோட்டம்",2,"Kannottam","benignity"],["இல்லாத",2,"Illaadha","lacking, without"],["கண்",2,"Kan","eye"]]},{"n":574,"l":["உளபோல் முகத்தெவன் செய்யும் அளவினால்","கண்ணோட்டம் இல்லாத கண்."],"w":[["உளபோல்",1,"Ulapol","are present; like, as if"],["முகத்தெவன்",1,"Mukaththevan","in/on the face; what?"],["செய்யும்",1,"Seyyum","will do / achieve"],["அளவினால்",1,"Alavinaal","by/with measure"],["கண்ணோட்டம்",2,"Kannottam","benignity"],["இல்லாத",2,"Illaadha","lacking, without"],["கண்",2,"Kan","eye"]]},{"n":575,"l":["கண்ணிற்கு அணிகலம் கண்ணோட்டம் அஃதின்றேல்","புண்ணென்று உணரப் படும்"],"w":[["கண்ணிற்கு",1,"Kannirku","for the eye"],["அணிகலம்",1,"Anikalam","ornament, jewel"],["கண்ணோட்டம்",1,"Kannottam","benignity"],["அஃதின்றேல்",1,"Aqdhindrel","that; if (it) is not"],["புண்ணென்று",2,"Punnendru","wound, sore; as, saying"],["உணரப்",2,"Unarap","to be perceived"],["படும்",2,"Patum","will be (auxiliary, passive)"]]},{"n":576,"l":["மண்ணோ டியைந்த மரத்தனையர் கண்ணோ","டியைந்துகண் ணோடா தவர்."],"w":[["மண்ணோ",1,"Manno","with the earth"],["டியைந்த",1,"Tiyaindha","that is joined"],["மரத்தனையர்",1,"Maraththanaiyar","tree; are like / resemble"],["கண்ணோ",1,"Kanno","with the eye"],["டியைந்துகண்",2,"Tiyaindhukan","having joined; eye (object of ணோடா)"],["ணோடா",2,"Notaa","not showing regard"],["தவர்",2,"Thavar","those (people)"]]},{"n":577,"l":["கண்ணோட்டம் இல்லவர் கண்ணிலர் கண்ணுடையார்","கண்ணோட்டம் இன்மையும் இல்."],"w":[["கண்ணோட்டம்",1,"Kannottam","benignity"],["இல்லவர்",1,"Illavar","those who lack"],["கண்ணிலர்",1,"Kannilar","eye; are without (eyes)"],["கண்ணுடையார்",1,"Kannutaiyaar","eye; those who possess"],["கண்ணோட்டம்",2,"Kannottam","benignity"],["இன்மையும்",2,"Inmaiyum","absence, lacking; even, also (emphatic)"],["இல்",2,"Il","is not / does not happen"]]},{"n":578,"l":["கருமம் சிதையாமல் கண்ணோட வல்லார்க்கு","உரிமை உடைத்திவ் வுலகு."],"w":[["கருமம்",1,"Karumam","deed, duty"],["சிதையாமல்",1,"Sidhaiyaamal","without spoiling / harming"],["கண்ணோட",1,"Kannota","to show benignity"],["வல்லார்க்கு",1,"Vallaarkku","to those who are able"],["உரிமை",2,"Urimai","right, ownership"],["உடைத்திவ்",2,"Utaiththiv","possesses / has; this"],["வுலகு",2,"Vulaku","world"]]},{"n":579,"l":["ஒறுத்தாற்றும் பண்பினார் கண்ணும்கண் ணோடிப்","பொறுத்தாற்றும் பண்பே தலை."],"w":[["ஒறுத்தாற்றும்",1,"Oruththaatrum","having punished; (who) is capable of"],["பண்பினார்",1,"Panpinaar","those of (such) nature"],["கண்ணும்கண்",1,"Kannumkan","even in the matter of (them); even; eye (begins கண்ணோடி)"],["ணோடிப்",1,"Notip","having shown benignity"],["பொறுத்தாற்றும்",2,"Poruththaatrum","having forgiven; (which) is able"],["பண்பே",2,"Panpe","the quality/virtue; alone, indeed (emphatic)"],["தலை",2,"Thalai","supreme, best"]]},{"n":580,"l":["பெயக்கண்டும் நஞ்சுண் டமைவர் நயத்தக்க","நாகரிகம் வேண்டு பவர்."],"w":[["பெயக்கண்டும்",1,"Peyakkantum","(poison) being poured/given; even having seen; even (concessive)"],["நஞ்சுண்",1,"Nanjun","poison; having eaten (joins அமைவர்)"],["டமைவர்",1,"Tamaivar","they will accept / settle"],["நயத்தக்க",1,"Nayaththakka","worthy of being desired"],["நாகரிகம்",2,"Naakarikam","refinement, courtesy"],["வேண்டு",2,"Ventu","desiring (joins பவர்)"],["பவர்",2,"Pavar","those who (desire)"]]}]}