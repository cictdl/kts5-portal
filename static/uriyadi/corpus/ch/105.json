{"n":105,"kurals":[{"n":1041,"l":["இன்மையின் இன்னாதது யாதெனின் இன்மையின்","இன்மையே இன்னா தது."],"w":[["இன்மையின்",1,"Inmaiyin","than poverty (compared with)"],["இன்னாதது",1,"Innaadhadhu","that which is painful"],["யாதெனின்",1,"Yaadhenin","what; if (one) asks/says"],["இன்மையின்",1,"Inmaiyin","than poverty (compared with)"],["இன்மையே",2,"Inmaiye","poverty itself; only/alone (emphatic)"],["இன்னா",2,"Innaa","painful, distressing"],["தது",2,"Thadhu","that (one thing)"]]},{"n":1042,"l":["இன்மை எனவொரு பாவி மறுமையும்","இம்மையும் இன்றி வரும்."],"w":[["இன்மை",1,"Inmai","poverty, want"],["எனவொரு",1,"Enavoru","called/named (as); one, a"],["பாவி",1,"Paavi","sinner, evil one"],["மறுமையும்",1,"Marumaiyum","the next world, afterlife; and/also (joining)"],["இம்மையும்",2,"Immaiyum","this world, present life; and/also (joining)"],["இன்றி",2,"Indri","being without, lacking"],["வரும்",2,"Varum","(it) will come/result"]]},{"n":1043,"l":["தொல்வரவும் தோலும் கெடுக்கும் தொகையாக","நல்குரவு என்னும் நசை."],"w":[["தொல்வரவும்",1,"Tholvaravum","ancient, old; lineage, descent; and/also"],["தோலும்",1,"Tholum","fame, renown, dignity; and/also"],["கெடுக்கும்",1,"Ketukkum","(it) destroys"],["தொகையாக",1,"Thokaiyaaka","totality, all together; as, becoming (collectively)"],["நல்குரவு",2,"Nalkuravu","poverty, destitution"],["என்னும்",2,"Ennum","(which is) called"],["நசை",2,"Nasai","craving, desire"]]},{"n":1044,"l":["இற்பிறந்தார் கண்ணேயும் இன்மை இளிவந்த","சொற்பிறக்கும் சோர்வு தரும்."],"w":[["இற்பிறந்தார்",1,"Irpirandhaar","in (good) house/family; those who were born"],["கண்ணேயும்",1,"Kanneyum","in/at (locative urupu); even (emphatic); even (concessive)"],["இன்மை",1,"Inmai","poverty, want"],["இளிவந்த",1,"Ilivandha","(which is) demeaning/base"],["சொற்பிறக்கும்",2,"Sorpirakkum","word, speech; (in which) words arise"],["சோர்வு",2,"Sorvu","weakness, decline"],["தரும்",2,"Tharum","(it) gives/causes"]]},{"n":1045,"l":["நல்குரவு என்னும் இடும்பையுள் பல்குரைத்","துன்பங்கள் சென்று படும்."],"w":[["நல்குரவு",1,"Nalkuravu","poverty, destitution"],["என்னும்",1,"Ennum","(which is) called"],["இடும்பையுள்",1,"Itumpaiyul","affliction, distress; within, inside"],["பல்குரைத்",1,"Palkuraith","many, various; many/multiple (intensive)"],["துன்பங்கள்",2,"Thunpangal","sorrows, miseries"],["சென்று",2,"Sendru","having gone (into)"],["படும்",2,"Patum","(they) occur/arise"]]},{"n":1046,"l":["நற்பொருள் நன்குணர்ந்து சொல்லினும் நல்கூர்ந்தார்","சொற்பொருள் சோர்வு படும்."],"w":[["நற்பொருள்",1,"Narporul","good; (good) matter/truth"],["நன்குணர்ந்து",1,"Nankunarndhu","well, properly; having understood"],["சொல்லினும்",1,"Sollinum","even if (one) says"],["நல்கூர்ந்தார்",1,"Nalkoorndhaar","the poor (their)"],["சொற்பொருள்",2,"Sorporul","of (their) word; meaning, substance"],["சோர்வு",2,"Sorvu","decline, failure"],["படும்",2,"Patum","(it) comes to / suffers"]]},{"n":1047,"l":["அறஞ்சாரா நல்குரவு ஈன்றதா யானும்","பிறன்போல நோக்கப் படும்."],"w":[["அறஞ்சாரா",1,"Aranjaaraa","virtue, righteousness; (which) joins not"],["நல்குரவு",1,"Nalkuravu","poverty, want"],["ஈன்றதா",1,"Eendradhaa","(who) bore/gave birth; mother (by the mother)"],["யானும்",1,"Yaanum","by/through (instrumental urupu of தாய்); even (concessive)"],["பிறன்போல",2,"Piranpola","a stranger, another man; like, as (comparison)"],["நோக்கப்",2,"Nokkap","to be looked upon"],["படும்",2,"Patum","(he) will be (looked upon)"]]},{"n":1048,"l":["இன்றும் வருவது கொல்லோ நெருநலும்","கொன்றது போலும் நிரப்பு."],"w":[["இன்றும்",1,"Indrum","today; also/even"],["வருவது",1,"Varuvadhu","that which comes"],["கொல்லோ",1,"Kollo","(doubt particle); (interrogative/lament ஓ)"],["நெருநலும்",1,"Nerunalum","yesterday; also/even"],["கொன்றது",2,"Kondradhu","that which killed"],["போலும்",2,"Polum","as if, like (with uncertainty)"],["நிரப்பு",2,"Nirappu","want, poverty"]]},{"n":1049,"l":["நெருப்பினுள் துஞ்சலும் ஆகும் நிரப்பினுள்","யாதொன்றும் கண்பாடு அரிது."],"w":[["நெருப்பினுள்",1,"Neruppinul","within fire; in, within"],["துஞ்சலும்",1,"Thunjalum","sleeping; even (concessive)"],["ஆகும்",1,"Aakum","(it) is possible"],["நிரப்பினுள்",1,"Nirappinul","within want/poverty; in, within"],["யாதொன்றும்",2,"Yaadhondrum","what(ever); one; any (with negation)"],["கண்பாடு",2,"Kanpaatu","eye; closing (of eye), sleep"],["அரிது",2,"Aridhu","(it) is hard/rare"]]},{"n":1050,"l":["துப்புர வில்லார் துவரத் துறவாமை","உப்பிற்கும் காடிக்கும் கூற்று."],"w":[["துப்புர",1,"Thuppura","things to enjoy, comforts"],["வில்லார்",1,"Villaar","those without (it)"],["துவரத்",1,"Thuvarath","completely, fully"],["துறவாமை",1,"Thuravaamai","not renouncing"],["உப்பிற்கும்",2,"Uppirkum","for salt; and/also"],["காடிக்கும்",2,"Kaatikkum","for gruel/sour rice-water; and/also"],["கூற்று",2,"Kootru","Death/Yama, destroyer"]]}]}