{"n":84,"kurals":[{"n":831,"l":["பேதைமை என்பதொன்று யாதெனின் ஏதங்கொண்டு","ஊதியம் போக விடல்."],"w":[["பேதைமை",1,"Pedhaimai","folly"],["என்பதொன்று",1,"Enpadhondru","that which is said; one thing"],["யாதெனின்",1,"Yaadhenin","what; if (one) says/asks"],["ஏதங்கொண்டு",1,"Edhangontu","harm/loss; having taken"],["ஊதியம்",2,"Oodhiyam","gain/profit"],["போக",2,"Poka","(letting it) go"],["விடல்",2,"Vital","abandoning"]]},{"n":832,"l":["பேதைமையுள் எல்லாம் பேதைமை காதன்மை","கையல்ல தன்கட் செயல்."],"w":[["பேதைமையுள்",1,"Pedhaimaiyul","among follies"],["எல்லாம்",1,"Ellaam","all"],["பேதைமை",1,"Pedhaimai","folly"],["காதன்மை",1,"Kaadhanmai","fondness/desire"],["கையல்ல",2,"Kaiyalla","(things) of/fitting; are not (fitting)"],["தன்கட்",2,"Thankat","one's own; in/upon"],["செயல்",2,"Seyal","doing/action"]]},{"n":833,"l":["நாணாமை நாடாமை நாரின்மை யாதொன்றும்","பேணாமை பேதை தொழில்"],"w":[["நாணாமை",1,"Naanaamai","shamelessness (not being ashamed)"],["நாடாமை",1,"Naataamai","not seeking"],["நாரின்மை",1,"Naarinmai","lovelessness"],["யாதொன்றும்",1,"Yaadhondrum","what(ever); (any)one thing; even/at all (emphatic)"],["பேணாமை",2,"Penaamai","not cherishing"],["பேதை",2,"Pedhai","fool"],["தொழில்",2,"Thozhil","(fool's) deeds"]]},{"n":834,"l":["ஓதி உணர்ந்தும் பிறர்க்குரைத்தும் தானடங்காப்","பேதையின் பேதையார் இல்."],"w":[["ஓதி",1,"Odhi","having read/learnt"],["உணர்ந்தும்",1,"Unarndhum","having understood; even/and"],["பிறர்க்குரைத்தும்",1,"Pirarkkuraiththum","to others; having told; even/and"],["தானடங்காப்",1,"Thaanatangaap","self; not restraining (oneself)"],["பேதையின்",2,"Pedhaiyin","than the fool"],["பேதையார்",2,"Pedhaiyaar","fools"],["இல்",2,"Il","there are none"]]},{"n":835,"l":["ஒருமைச் செயலாற்றும் பேதை எழுமையும்","தான்புக் கழுந்தும் அளறு."],"w":[["ஒருமைச்",1,"Orumaich","in one birth"],["செயலாற்றும்",1,"Cheyalaatrum","deed/karma; (who) accomplishes"],["பேதை",1,"Pedhai","the fool"],["எழுமையும்",1,"Ezhumaiyum","in (all) seven births; even/also"],["தான்புக்",2,"Thaanpuk","self; having entered"],["கழுந்தும்",2,"Kazhundhum","(in which) sinks"],["அளறு",2,"Alaru","mire/hell"]]},{"n":836,"l":["பொய்படும் ஒன்றோ புனைபூணும் கையறியாப்","பேதை வினைமேற் கொளின்."],"w":[["பொய்படும்",1,"Poipatum","(it) will fail/fall false"],["ஒன்றோ",1,"Ondro","one (thing only?); (rhetorical/interrogative) ?"],["புனைபூணும்",1,"Punaipoonum","fetter/ornament; (he) will wear/bear"],["கையறியாப்",1,"Kaiyariyaap","way/skill (of doing); not knowing"],["பேதை",2,"Pedhai","fool"],["வினைமேற்",2,"Vinaimer","task/deed; upon"],["கொளின்",2,"Kolin","if (he) takes up"]]},{"n":837,"l":["ஏதிலார் ஆரத் தமர்பசிப்பர் பேதை","பெருஞ்செல்வம் உற்றக் கடை."],"w":[["ஏதிலார்",1,"Edhilaar","strangers/aliens"],["ஆரத்",1,"Aarath","(so as) to be sated"],["தமர்பசிப்பர்",1,"Thamarpasippar","kinsfolk; (they) will starve"],["பேதை",1,"Pedhai","the fool"],["பெருஞ்செல்வம்",2,"Perunjelvam","great; wealth"],["உற்றக்",2,"Utrak","(when) attained"],["கடை",2,"Katai","at the time/when"]]},{"n":838,"l":["மையல் ஒருவன் களித்தற்றால் பேதைதன்","கையொன்று உடைமை பெறின்."],"w":[["மையல்",1,"Maiyal","madness/derangement"],["ஒருவன்",1,"Oruvan","a (mad) man"],["களித்தற்றால்",1,"Kaliththatraal","like being intoxicated; (expletive)"],["பேதைதன்",1,"Pedhaidhan","fool; his own"],["கையொன்று",2,"Kaiyondru","in hand; one thing"],["உடைமை",2,"Utaimai","possessing"],["பெறின்",2,"Perin","if (he) gets"]]},{"n":839,"l":["பெரிதினிது பேதையார் கேண்மை பிரிவின்கண்","பீழை தருவதொன் றில்."],"w":[["பெரிதினிது",1,"Peridhinidhu","greatly; is sweet"],["பேதையார்",1,"Pedhaiyaar","of fools"],["கேண்மை",1,"Kenmai","friendship"],["பிரிவின்கண்",1,"Pirivinkan","at parting"],["பீழை",2,"Peezhai","distress/pain"],["தருவதொன்",2,"Tharuvadhon","that which gives; (any) one"],["றில்",2,"Ril","there is not"]]},{"n":840,"l":["கழாஅக்கால் பள்ளியுள் வைத்தற்றால் சான்றோர்","குழாஅத்துப் பேதை புகல்."],"w":[["கழாஅக்கால்",1,"Kazhaaakkaal","unwashed; foot"],["பள்ளியுள்",1,"Palliyul","in the bed"],["வைத்தற்றால்",1,"Vaiththatraal","like placing; (expletive)"],["சான்றோர்",1,"Saandror","the noble/wise"],["குழாஅத்துப்",2,"Kuzhaaaththup","into the assembly"],["பேதை",2,"Pedhai","fool"],["புகல்",2,"Pukal","entering"]]}]}