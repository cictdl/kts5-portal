{"n":74,"kurals":[{"n":731,"l":["தள்ளா விளையுளும் தக்காரும் தாழ்விலாச்","செல்வரும் சேர்வது நாடு."],"w":[["தள்ளா",1,"Thallaa","unfailing (not failing) — விளையுளை அடைகொடுக்கும்"],["விளையுளும்",1,"Vilaiyulum","produce/yield; and (inclusive)"],["தக்காரும்",1,"Thakkaarum","the worthy/fit ones; and"],["தாழ்விலாச்",1,"Thaazhvilaach","decline/loss; without (modifying செல்வர்)"],["செல்வரும்",2,"Chelvarum","the wealthy ones; and"],["சேர்வது",2,"Servadhu","that which joins/has"],["நாடு",2,"Naatu","country/land"]]},{"n":732,"l":["பெரும்பொருளால் பெட்டக்க தாகி அருங்கேட்டால்","ஆற்ற விளைவது நாடு."],"w":[["பெரும்பொருளால்",1,"Perumporulaal","great/much; by wealth/resources"],["பெட்டக்க",1,"Pettakka","desirable/to-be-loved"],["தாகி",1,"Thaaki","being/having become"],["அருங்கேட்டால்",1,"Arungettaal","rare/hard; by/from harm (free of)"],["ஆற்ற",2,"Aatra","abundantly/much"],["விளைவது",2,"Vilaivadhu","that which yields"],["நாடு",2,"Naatu","country/land"]]},{"n":733,"l":["பொறையொருங்கு மேல்வருங்கால் தாங்கி இறைவற்கு","இறையொருங்கு நேர்வது நாடு."],"w":[["பொறையொருங்கு",1,"Poraiyorungu","burden/load; together/at once"],["மேல்வருங்கால்",1,"Melvarungaal","upon/over; when (it) comes"],["தாங்கி",1,"Thaangi","bearing/having borne"],["இறைவற்கு",1,"Iraivarku","to the king"],["இறையொருங்கு",2,"Iraiyorungu","tax/tribute; wholly/together"],["நேர்வது",2,"Nervadhu","that which gives/grants"],["நாடு",2,"Naatu","country/land"]]},{"n":734,"l":["உறுபசியும் ஓவாப் பிணியும் செறுபகையும்","சேரா தியல்வது நாடு."],"w":[["உறுபசியும்",1,"Urupasiyum","much/severe; hunger; and"],["ஓவாப்",1,"Ovaap","unceasing (modifies பிணி)"],["பிணியும்",1,"Piniyum","disease/plague; and"],["செறுபகையும்",1,"Serupakaiyum","destroying/hostile; enmity; and"],["சேரா",2,"Seraa","not joining/without coming"],["தியல்வது",2,"Thiyalvadhu","that which functions/proceeds"],["நாடு",2,"Naatu","country/land"]]},{"n":735,"l":["பல்குழுவும் பாழ்செய்யும் உட்பகையும் வேந்தலைக்கும்","கொல்குறும்பும் இல்லது நாடு."],"w":[["பல்குழுவும்",1,"Palkuzhuvum","many/various