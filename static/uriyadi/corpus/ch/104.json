{"n":104,"kurals":[{"n":1031,"l":["சுழன்றும்ஏர்ப் பின்னது உலகம் அதனால்","உழந்தும் உழவே தலை."],"w":[["சுழன்றும்ஏர்ப்",1,"Suzhandrumerp","though revolving/toiling; even/concessive um; plough"],["பின்னது",1,"Pinnadhu","(stays) behind it"],["உலகம்",1,"Ulakam","world"],["அதனால்",1,"Adhanaal","therefore/by that"],["உழந்தும்",2,"Uzhandhum","though suffering/labouring; even/concessive um"],["உழவே",2,"Uzhave","farming (itself); emphatic/exclusive ē"],["தலை",2,"Thalai","foremost/best"]]},{"n":1032,"l":["உழுவார் உலகத்தார்க்கு ஆணிஅஃ தாற்றாது","எழுவாரை எல்லாம் பொறுத்து."],"w":[["உழுவார்",1,"Uzhuvaar","those who plough"],["உலகத்தார்க்கு",1,"Ulakaththaarkku","to the people of the world; augment sariyai"],["ஆணிஅஃ",1,"Aaniaq","linch-pin/axle-pin; that (it)"],["தாற்றாது",1,"Thaatraadhu","as they (others) cannot do/sustain"],["எழுவாரை",2,"Ezhuvaarai","those who rise/go (to other trades)"],["எல்லாம்",2,"Ellaam","all"],["பொறுத்து",2,"Poruththu","bearing/supporting"]]},{"n":1033,"l":["உழுதுண்டு வாழ்வாரே வாழ்வார்மற் றெல்லாம்","தொழுதுண்டு பின்செல் பவர்."],"w":[["உழுதுண்டு",1,"Uzhudhuntu","having ploughed; having eaten"],["வாழ்வாரே",1,"Vaazhvaare","those who live; exclusive/emphatic ē"],["வாழ்வார்மற்",1,"Vaazhvaarmar","(truly) live; moreover/as for the rest"],["றெல்லாம்",1,"Rellaam","all (the rest)"],["தொழுதுண்டு",2,"Thozhudhuntu","having worshipped/bowed; having eaten"],["பின்செல்",2,"Pinsel","behind/after; who go (following)"],["பவர்",2,"Pavar","those who (go behind)"]]},{"n":1034,"l":["பலகுடை நீழலும் தங்குடைக்கீழ்க் காண்பர்","அலகுடை நீழ லவர்."],"w":[["பலகுடை",1,"Palakutai","many; umbrella (of kings)"],["நீழலும்",1,"Neezhalum","shade; even/inclusive um"],["தங்குடைக்கீழ்க்",1,"Thangutaikkeezhk","their own; umbrella; under/beneath"],["காண்பர்",1,"Kaanpar","they will see/cause to be seen"],["அலகுடை",2,"Alakutai","abundance (of grain); possessing"],["நீழ",2,"Neezha","shade"],["லவர்",2,"Lavar","those who (have shade)"]]},{"n":1035,"l":["இரவார் இரப்பார்க்கொன்று ஈவர் கரவாது","கைசெய்தூண் மாலை யவர்."],"w":[["இரவார்",1,"Iravaar","they do not beg"],["இரப்பார்க்கொன்று",1,"Irappaarkkondru","to those who beg; one (thing)"],["ஈவர்",1,"Eevar","they will give"],["கரவாது",1,"Karavaadhu","without hiding/concealing"],["கைசெய்தூண்",2,"Kaiseydhoon","(by) hand; having worked/made; food/eating"],["மாலை",2,"Maalai","nature/disposition"],["யவர்",2,"Yavar","those of (such) nature"]]},{"n":1036,"l":["உழவினார் கைம்மடங்கின் இல்லை விழைவதூஉம்","விட்டேம்என் பார்க்கு நிலை."],"w":[["உழவினார்",1,"Uzhavinaar","of the farmers; augment sariyai"],["கைம்மடங்கின்",1,"Kaimmatangin","hand; if (it) folds/ceases"],["இல்லை",1,"Illai","(there) is not"],["விழைவதூஉம்",1,"Vizhaivadhooum","that which is desired; even/inclusive um (with alapedai)"],["விட்டேம்என்",2,"Vittemen","we have given up; (those who) say"],["பார்க்கு",2,"Paarkku","even to those who say; even um"],["நிலை",2,"Nilai","stability/state (of life)"]]},{"n":1037,"l":["தொடிப்புழுதி கஃசா உணக்கின் பிடித்தெருவும்","வேண்டாது சாலப் படும்."],"w":[["தொடிப்புழுதி",1,"Thotippuzhudhi","a palam (weight measure); dust/fine soil"],["கஃசா",1,"Kaqsaa","becoming a quarter-palam"],["உணக்கின்",1,"Unakkin","if (one) dries (it)"],["பிடித்தெருவும்",1,"Pitiththeruvum","a handful; manure; even um"],["வேண்டாது",2,"Ventaadhu","without needing/requiring"],["சாலப்",2,"Saalap","abundantly/much"],["படும்",2,"Patum","(the crop) will yield/grow"]]},{"n":1038,"l":["ஏரினும் நன்றால் எருவிடுதல் கட்டபின்","நீரினும் நன்றதன் காப்பு."],"w":[["ஏரினும்",1,"Erinum","than ploughing; even um"],["நன்றால்",1,"Nandraal","is good; expletive āl"],["எருவிடுதல்",1,"Eruvitudhal","manure; applying/putting"],["கட்டபின்",1,"Kattapin","having weeded; after"],["நீரினும்",2,"Neerinum","than irrigating/water; even um"],["நன்றதன்",2,"Nandradhan","is good; of that (crop)"],["காப்பு",2,"Kaappu","guarding/protection"]]},{"n":1039,"l":["செல்லான் கிழவன் இருப்பின் நிலம்புலந்து","இல்லாளின் ஊடி விடும்."],"w":[["செல்லான்",1,"Sellaan","(he) not going"],["கிழவன்",1,"Kizhavan","owner (of the land)"],["இருப்பின்",1,"Iruppin","if (he) stays/sits idle"],["நிலம்புலந்து",1,"Nilampulandhu","land; being displeased/sulking"],["இல்லாளின்",2,"Illaalin","like the wife/housewife"],["ஊடி",2,"Ooti","sulking/being estranged"],["விடும்",2,"Vitum","(the land) will (sulk and) leave/fail"]]},{"n":1040,"l":["இலமென்று அசைஇ இருப்பாரைக் காணின்","நிலமென்னும் நல்லாள் நகும்."],"w":[["இலமென்று",1,"Ilamendru","we are without/poor; saying (thus)"],["அசைஇ",1,"Asaii","being slothful/idle"],["இருப்பாரைக்",1,"Iruppaaraik","those who sit (idle)"],["காணின்",1,"Kaanin","if (she) sees"],["நிலமென்னும்",2,"Nilamennum","land; called/named"],["நல்லாள்",2,"Nallaal","the good lady"],["நகும்",2,"Nakum","(she) will laugh/mock"]]}]}