{"n":130,"kurals":[{"n":1291,"l":["அவர்நெஞ்சு அவர்க்காதல் கண்டும் எவன்நெஞ்சே","நீஎமக்கு ஆகா தது."],"w":[["அவர்நெஞ்சு",1,"Avarnenju","his (honorific him); heart, mind"],["அவர்க்காதல்",1,"Avarkkaadhal","to him (as a help); love, attachment (being a help to him)"],["கண்டும்",1,"Kantum","having seen; even (concessive um)"],["எவன்நெஞ்சே",1,"Evannenje","why / what (interrogative); O heart! (vocative)"],["நீஎமக்கு",2,"Neeemakku","you (heart, addressed); to us / for me (a help)"],["ஆகா",2,"Aakaa","not becoming (a help)"],["தது",2,"Thadhu","(reason for) that not-becoming (interrogated)"]]},{"n":1292,"l":["உறாஅ தவர்க்கண்ட கண்ணும் அவரைச்","செறாஅரெனச் சேறியென் நெஞ்சு."],"w":[["உறாஅ",1,"Uraaa","(love) not having for (us)"],["தவர்க்கண்ட",1,"Thavarkkanta","him (who loves us not); having seen / that saw"],["கண்ணும்",1,"Kannum","at the time/occasion (when); even (concessive um)"],["அவரைச்",1,"Avaraich","him (object)"],["செறாஅரெனச்",2,"Cheraaarenach","(he) will not be angry/will not hate; thinking that / saying that"],["சேறியென்",2,"Cheriyen","you go (towards him); my"],["நெஞ்சு",2,"Nenju","O heart! (addressed)"]]},{"n":1293,"l":["கெட்டார்க்கு நட்டார்இல் என்பதோ நெஞ்சேநீ","பெட்டாங்கு அவர்பின் செலல்."],"w":[["கெட்டார்க்கு",1,"Kettaarkku","to/for those who are ruined"],["நட்டார்இல்",1,"Nattaaril","friends, those who befriend; there are none / not"],["என்பதோ",1,"Enpadho","that which is said / the saying; interrogative O (is it because...?)"],["நெஞ்சேநீ",1,"Nenjenee","O heart! (vocative); you"],["பெட்டாங்கு",2,"Pettaangu","as (you) desire / according to liking"],["அவர்பின்",2,"Avarpin","his; behind / after (him)"],["செலல்",2,"Selal","the going / to go"]]},{"n":1294,"l":["இனிஅன்ன நின்னொடு சூழ்வார்யார் நெஞ்சே","துனிசெய்து துவ்வாய்காண் மற்று."],"w":[["இனிஅன்ன",1,"Inianna","henceforth, now; such things (the like)"],["நின்னொடு",1,"Ninnotu","with you (heart)"],["சூழ்வார்யார்",1,"Soozhvaaryaar","those who will deliberate/consult; who?"],["நெஞ்சே",1,"Nenje","O heart! (vocative)"],["துனிசெய்து",2,"Thuniseydhu","sulking, love-quarrel (ஊடல்); having made/done"],["துவ்வாய்காண்",2,"Thuvvaaikaan","you will not enjoy/taste (the fruit); see! (emphatic asai particle)"],["மற்று",2,"Matru","moreover / and then (expletive)"]]},{"n":1295,"l":["பெறாஅமை அஞ்சும் பெறின்பிரிவு அஞ்சும்","அறாஅ இடும்பைத்தென் நெஞ்சு."],"w":[["பெறாஅமை",1,"Peraaamai","not-getting (failing to obtain him)"],["அஞ்சும்",1,"Anjum","(my heart) fears"],["பெறின்பிரிவு",1,"Perinpirivu","if (one) gets/obtains; separation, parting"],["அஞ்சும்",1,"Anjum","(my heart) fears"],["அறாஅ",2,"Araaa","unceasing, never-severing"],["இடும்பைத்தென்",2,"Itumpaiththen","is sorrow-possessed / has affliction; my"],["நெஞ்சு",2,"Nenju","(my) heart"]]},{"n":1296,"l":["தனியே இருந்து நினைத்தக்கால் என்னைத்","தினிய இருந்ததென் நெஞ்சு."],"w":[["தனியே",1,"Thaniye","alone, in solitude; emphatic/asai ē"],["இருந்து",1,"Irundhu","having stayed/sat"],["நினைத்தக்கால்",1,"Ninaiththakkaal","when (I) thought of (him)"],["என்னைத்",1,"Ennaith","me (object)"],["தினிய",2,"Thiniya","so as to devour/eat (me)"],["இருந்ததென்",2,"Irundhadhen","(my heart) was / remained (in such a state); my"],["நெஞ்சு",2,"Nenju","(my) heart"]]},{"n":1297,"l":["நாணும் மறந்தேன் அவர்மறக் கல்லாஎன்","மாணா மடநெஞ்சிற் பட்டு."],"w":[["நாணும்",1,"Naanum","modesty, shame; even / also (um)"],["மறந்தேன்",1,"Marandhen","I forgot"],["அவர்மறக்",1,"Avarmarak","him (object of forgetting); to forget (infinitive feeding கல்லா)"],["கல்லாஎன்",1,"Kallaaen","that cannot learn/manage (to forget); my"],["மாணா",2,"Maanaa","unworthy, not noble"],["மடநெஞ்சிற்",2,"Matanenjir","foolish, naive (qualifier); in (my) foolish heart"],["பட்டு",2,"Pattu","having fallen into / joined with"]]},{"n":1298,"l":["எள்ளின் இளிவாம்என்று எண்ணி அவர்திறம்","உள்ளும் உயிர்க்காதல் நெஞ்சு."],"w":[["எள்ளின்",1,"Ellin","if (one) despises/slights (him)"],["இளிவாம்என்று",1,"Ilivaamendru","it will become disgrace; thinking thus / that"],["எண்ணி",1,"Enni","having considered/thought"],["அவர்திறம்",1,"Avardhiram","his; (his) qualities / excellence"],["உள்ளும்",2,"Ullum","(the heart) keeps thinking of"],["உயிர்க்காதல்",2,"Uyirkkaadhal","on/for life (towards the life); love (love-of-life, qualifying நெஞ்சு)"],["நெஞ்சு",2,"Nenju","(my) heart (subject of உள்ளும்)"]]},{"n":1299,"l":["துன்பத்திற்கு யாரே துணையாவார் தாமுடைய","நெஞ்சந் துணையல் வழி."],"w":[["துன்பத்திற்கு",1,"Thunpaththirku","for (one's) sorrow"],["யாரே",1,"Yaare","who?; interrogative/emphatic ē"],["துணையாவார்",1,"Thunaiyaavaar","those who will become a help"],["தாமுடைய",1,"Thaamutaiya","they / one's own; owned / belonging to (them)"],["நெஞ்சந்",2,"Nenjan","(one's own) heart"],["துணையல்",2,"Thunaiyal","not being a help (when it is not)"],["வழி",2,"Vazhi","when / in the case that (vazhi = 'when')"]]},{"n":1300,"l":["தஞ்சம் தமரல்லர் ஏதிலார் தாமுடைய","நெஞ்சம் தமரல் வழி."],"w":[["தஞ்சம்",1,"Thanjam","easy, a trifle"],["தமரல்லர்",1,"Thamarallar","kinsfolk, one's own people; (they) are not (kin)"],["ஏதிலார்",1,"Edhilaar","strangers, the unrelated"],["தாமுடைய",1,"Thaamutaiya","they / one's own; owned / belonging to (them)"],["நெஞ்சம்",2,"Nenjam","(one's own) heart"],["தமரல்",2,"Thamaral","when (it) is not kin/friendly"],["வழி",2,"Vazhi","when / in the case that"]]}]}