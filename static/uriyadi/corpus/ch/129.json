{"n":129,"kurals":[{"n":1281,"l":["உள்ளக் களித்தலும் காண மகிழ்தலும்","கள்ளுக்கில் காமத்திற் குண்டு."],"w":[["உள்ளக்",1,"Ullak","on thinking / when remembered (செயவெனெச்சம்)"],["களித்தலும்",1,"Kaliththalum","rejoicing, being elated; and (enumerative um)"],["காண",1,"Kaana","on seeing (செயவெனெச்சம்)"],["மகிழ்தலும்",1,"Makizhdhalum","rejoicing, gladdening; and (enumerative um)"],["கள்ளுக்கில்",2,"Kallukkil","to/for liquor (toddy); is not, absent"],["காமத்திற்",2,"Kaamaththir","to/for love (kaamam)"],["குண்டு",2,"Kuntu","exists, is present (it is)"]]},{"n":1282,"l":["தினைத்துணையும் ஊடாமை வேண்டும் பனைத்துணையும்","காமம் நிறைய வரின்."],"w":[["தினைத்துணையும்",1,"","millet-measure, a tiny amount; even (concessive um)"],["ஊடாமை",1,"","not-sulking, refraining from quarrel (எதிர்மறைத் தொழிற்பெயர்)"],["வேண்டும்",1,"","is needed, one must"],["பனைத்துணையும்",1,"","palmyra-measure, a huge amount; even (concessive um)"],["காமம்",2,"","love, passion"],["நிறைய",2,"","fully, to abundance (செயவெனெச்சம், adverbial)"],["வரின்",2,"","if (it) comes/grows (conditional)"]]},{"n":1283,"l":["பேணாது பெட்பவே செய்யினும் கொண்கனைக்","காணா தமையல கண்."],"w":[["பேணாது",1,"Penaadhu","without cherishing/regarding (me)"],["பெட்பவே",1,"Petpave","the things (he) desires; only (restrictive ee)"],["செய்யினும்",1,"Seyyinum","even though (he) does (conditional); even (concessive um)"],["கொண்கனைக்",1,"Konkanaik","the lord/lover (shore-king, accusative); accusative case suffix"],["காணா",2,"Kaanaa","without seeing"],["தமையல",2,"Thamaiyala","(they = eyes) do not rest/abide"],["கண்",2,"Kan","(my) eyes"]]},{"n":1284,"l":["ஊடற்கண் சென்றேன்மன் தோழி அதுமறந்து","கூடற்கண் சென்றதென் னெஞ்சு."],"w":[["ஊடற்கண்",1,"","for/in sulking (love-quarrel); locative case suffix (in/at)"],["சென்றேன்மன்",1,"","I went / set out; but (regret/contrast particle man)"],["தோழி",1,"","O friend! (vocative)"],["அதுமறந்து",1,"","that (purpose); having forgotten"],["கூடற்கண்",2,"","for/in union (embrace); locative case suffix (in/at)"],["சென்றதென்",2,"",""],["னெஞ்சு",2,"","(my) heart, mind"]]},{"n":1285,"l":["எழுதுங்கால் கோல்காணாக் கண்ணேபோல் கொண்கன்","பழிகாணேன் கண்ட இடத்து."],"w":[["எழுதுங்கால்",1,"Ezhudhungaal","at the time of painting (eyes)"],["கோல்காணாக்",1,"Kolkaanaak","the (collyrium) stick/rod; that does not see (rel. participle)"],["கண்ணேபோல்",1,"Kannepol","eyes; indeed (asai/restrictive ee); like, as (comparative உவம உருபு)"],["கொண்கன்",1,"Konkan","the lord/lover (shore-king)"],["பழிகாணேன்",2,"Pazhikaanen","fault, blame; I do not see"],["கண்ட",2,"Kanta","that (I) saw (rel. participle)"],["இடத்து",2,"Itaththu","at the place/moment (when seen)"]]},{"n":1286,"l":["காணுங்கால் காணேன் தவறாய காணாக்கால்","காணேன் தவறல் லவை."],"w":[["காணுங்கால்",1,"Kaanungaal","when (I) see (him)"],["காணேன்",1,"Kaanen","I do not see"],["தவறாய",1,"Thavaraaya","the things that are faults"],["காணாக்கால்",1,"Kaanaakkaal","when (I) do not see (him)"],["காணேன்",2,"Kaanen","I do not see"],["தவறல்",2,"Thavaral","fault; not (that which is not)"],["லவை",2,"Lavai","the things that are not faults"]]},{"n":1287,"l":["உய்த்தல் அறிந்து புனல்பாய் பவரேபோல்","பொய்த்தல் அறிந்தென் புலந்து."],"w":[["உய்த்தல்",1,"Uyththal","(its) carrying off / sweeping away"],["அறிந்து",1,"Arindhu","knowing / having known"],["புனல்பாய்",1,"Punalpaai","water, flood (stream); leap (into) — verb element feeding பவர்"],["பவரேபோல்",1,"Pavarepol","those who leap (into water); indeed (asai ee); like, as (comparative உவம உருபு)"],["பொய்த்தல்",2,"Poiththal","(its) failing / being futile"],["அறிந்தென்",2,"Arindhen","knowing / having known; what (use)? (interrogative en)"],["புலந்து",2,"Pulandhu","having sulked / by quarrelling"]]},{"n":1288,"l":["இளித்தக்க இன்னா செயினும் களித்தார்க்குக்","கள்ளற்றே கள்வநின் மார்பு."],"w":[["இளித்தக்க",1,"Iliththakka","such as to bring disgrace (rel. participle)"],["இன்னா",1,"Innaa","painful/harmful things"],["செயினும்",1,"Seyinum","even though (you) do (conditional); even (concessive um)"],["களித்தார்க்குக்",1,"Kaliththaarkkuk","for those who got intoxicated/elated; dative case suffix (to/for)"],["கள்ளற்றே",2,"Kallatre","liquor, toddy; like, of that nature (உவம உருபு); indeed (teerram ee)"],["கள்வநின்",2,"Kalvanin","O thief! (vocative); your"],["மார்பு",2,"Maarpu","(your) chest, bosom"]]},{"n":1289,"l":["மலரினும் மெல்லிது காமம் சிலர்அதன்","செவ்வி தலைப்படு வார்."],"w":[["மலரினும்",1,"Malarinum","than a flower (ablative of comparison); even (concessive um)"],["மெல்லிது",1,"Mellidhu","is delicate/soft (it is)"],["காமம்",1,"Kaamam","love, passion"],["சிலர்அதன்",1,"Silaradhan","(a) few (people); its (of that — love's)"],["செவ்வி",2,"Sevvi","the right season / fine quality (of it)"],["தலைப்படு",2,"Thalaippatu","who attain/obtain (feeding வார்)"],["வார்",2,"Vaar","those who obtain (its fine quality)"]]},{"n":1290,"l":["கண்ணின் துனித்தே கலங்கினாள் புல்லுதல்","என்னினும் தான்விதுப் புற்று."],"w":[["கண்ணின்",1,"Kannin","with/by the eye(s)"],["துனித்தே",1,"Thuniththe","having sulked / shown displeasure; indeed (asai ee)"],["கலங்கினாள்",1,"Kalanginaal","she got agitated / mingled (with me)"],["புல்லுதல்",1,"Pulludhal","embracing"],["என்னினும்",2,"Enninum","than me (ablative of comparison); even (concessive um)"],["தான்விதுப்",2,"Thaanvidhup","she herself (reflexive); haste, eager longing"],["புற்று",2,"Putru","having become eager (viduppu-utru = hastening)"]]}]}