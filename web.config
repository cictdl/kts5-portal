<?xml version="1.0" encoding="utf-8"?>
<!--
  KTS 5.0 portal · web.config for Plesk-managed IIS hosting.

  Put the whole portal package in the (sub)domain's document root (httpdocs);
  this file starts serve.py through IIS's HttpPlatformHandler module and
  forwards every request to it. Python libraries are vendored in lib\, so only
  python.exe has to exist on the server.

  If Python is not on the system PATH, replace processPath="python.exe" with
  the absolute path reported by the probe (deploy\plesk\probe), for example
  processPath="C:\Program Files\Python313\python.exe".
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="python.exe"
                  arguments="serve.py"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:10:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="KTS_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="KTS_HOST" value="127.0.0.1" />
        <environmentVariable name="KTS_THREADS" value="8" />
        <environmentVariable name="KTS_HTTPS" value="1" />
        <environmentVariable name="KTS_BEHIND_PROXY" value="1" />
        <environmentVariable name="KTS_BASE_URL" value="https://kts5.digitalarchives.cict.in" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONDONTWRITEBYTECODE" value="1" />
        <!-- Outgoing mail: fill in, save, and the site restarts by itself.
        <environmentVariable name="KTS_SMTP_HOST" value="smtp.example.gov.in" />
        <environmentVariable name="KTS_SMTP_PORT" value="587" />
        <environmentVariable name="KTS_SMTP_USER" value="kts5@cict.in" />
        <environmentVariable name="KTS_SMTP_PASSWORD" value="" />
        <environmentVariable name="KTS_SMTP_FROM" value="kts5@cict.in" />
        -->
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="26214400" />
        <!-- never let IIS serve source, data or uploads directly -->
        <hiddenSegments>
          <add segment="kts" />
          <add segment="lib" />
          <add segment="data" />
          <add segment="templates" />
          <add segment="instance" />
          <add segment="uploads" />
          <add segment="logs" />
          <add segment="deploy" />
          <add segment="tools" />
          <add segment="tests" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".sqlite3" allowed="false" />
          <add fileExtension=".key" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
